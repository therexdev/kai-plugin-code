{"manifest":{"schema":1,"apiVersion":2,"id":"kai.code","version":"0.1.0","name":"Koinos Code","description":"Open a local coding project, browse text files, ask an installed model for a change, and apply a reviewed edit. Existing project sessions are preserved. Requires KAI Core 0.2.0.","entry":"index.html","permissions":["models.read","code.read","code.assist","code.write"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id), api = (method, input) => window.kai.call(method, input);\n  let grant = null, selected = null, proposal = null, directory = \"\", revision = 0, pending = false;\n  const esc = value => String(value ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n  const notify = (message, error = false) => { $(\"notice\").textContent = message; $(\"notice\").hidden = false; $(\"notice\").classList.toggle(\"error\", error); };\n  function status(message) { $(\"status\").textContent = message; }\n  async function run(fn) {\n    if (pending) return; pending = true;\n    document.querySelectorAll(\"button\").forEach(b => { b.dataset.wasDisabled = String(b.disabled); b.disabled = true; });\n    try { await fn(); } catch (error) { notify(error.message.replace(/^Error invoking remote method '[^']+': (?:Error: )?/, \"\"), true); status(\"Action stopped · no automatic retry\"); }\n    finally { pending = false; document.querySelectorAll(\"button\").forEach(b => { b.disabled = b.dataset.wasDisabled === \"true\"; delete b.dataset.wasDisabled; }); update(); }\n  }\n  function update() { $(\"reload\").disabled = !selected; $(\"up\").disabled = !grant || !directory; $(\"revoke\").hidden = !grant; $(\"suggest\").disabled = !selected || !$(\"model\").value; $(\"apply\").disabled = !proposal; }\n  async function projects() {\n    const result = await api(\"code.projects\");\n    $(\"projects\").innerHTML = result.projects.length ? result.projects.map(p => `<button class=\"project ${grant?.project.id === p.id ? \"selected\" : \"\"}\" data-project=\"${esc(p.id)}\" ${p.missing ? \"disabled\" : \"\"}><strong>${esc(p.name)}</strong><small>${p.missing ? \"Folder unavailable\" : `${p.sessions} saved sessions`}</small></button>`).join(\"\") : '<p class=\"muted\">No projects yet. Open a folder to get started.</p>';\n  }\n  async function browse(relative = \"\") {\n    if (!grant) return; const result = await api(\"code.browse\", { handle: grant.handle, path: relative }); directory = result.path;\n    $(\"directory\").textContent = directory || grant.project.name;\n    $(\"files\").innerHTML = result.entries.length ? result.entries.map(f => `<button class=\"file ${selected?.path === f.path ? \"selected\" : \"\"}\" data-file=\"${esc(f.path)}\" data-kind=\"${f.kind}\"><span class=\"file-icon\">${f.kind === \"directory\" ? \"▸\" : \"·\"}</span><span>${esc(f.name)}</span></button>`).join(\"\") : '<p class=\"muted\">No supported files in this folder.</p>';\n    if (result.truncated) $(\"files\").insertAdjacentHTML(\"beforeend\", '<p class=\"muted\">Showing the first 500 entries.</p>'); update();\n  }\n  async function sessions() {\n    if (!grant) { $(\"sessions\").replaceChildren(); return; }\n    const result = await api(\"code.sessions\", { handle: grant.handle });\n    $(\"sessions\").innerHTML = result.sessions.length ? result.sessions.slice(0, 20).map(s => `<button class=\"project\" data-session=\"${esc(s.id)}\"><strong>${esc(s.title)}</strong><small>${s.turns} messages</small></button>`).join(\"\") : '<p class=\"muted\">Your coding suggestions will appear here.</p>';\n  }\n  function clearProposal() { proposal = null; $(\"proposal\").hidden = true; $(\"diff\").textContent = \"\"; $(\"result\").textContent = \"\"; }\n  async function openGrant(result) {\n    if (result.cancelled) return; if (grant) await api(\"code.revoke\", { handle: grant.handle });\n    grant = result; selected = null; revision++; clearProposal(); $(\"empty\").hidden = false; $(\"editor-area\").hidden = true; $(\"history\").hidden = true;\n    $(\"filename\").textContent = grant.project.name; status(`Project open · ${grant.project.name}`); await projects(); await browse(); await sessions(); update();\n  }\n  async function readFile(relative) {\n    const r = await api(\"code.read\", { handle: grant.handle, path: relative }); selected = r; revision++; clearProposal();\n    $(\"filename\").textContent = r.path; $(\"file-size\").textContent = `${r.size.toLocaleString()} bytes`; $(\"editor\").value = r.content;\n    $(\"empty\").hidden = true; $(\"editor-area\").hidden = false; status(\"File loaded · nothing has been changed\"); await browse(directory); update();\n  }\n  function showProposal(result) {\n    proposal = result; $(\"proposal-title\").textContent = result.path; $(\"summary\").textContent = result.summary;\n    $(\"diff\").textContent = result.diff; $(\"result\").textContent = result.content; $(\"proposal\").hidden = false;\n    $(\"diff\").hidden = false; $(\"result\").hidden = true; $(\"tab-diff\").classList.add(\"active\"); $(\"tab-file\").classList.remove(\"active\");\n    status(\"Proposal ready · no file has been changed\"); $(\"proposal\").scrollIntoView({ block: \"start\", behavior: \"auto\" }); update();\n  }\n  $(\"choose\").onclick = () => run(async () => openGrant(await api(\"code.choose\")));\n  $(\"projects\").onclick = e => { const b = e.target.closest(\"[data-project]\"); if (b) void run(async () => openGrant(await api(\"code.open\", { projectId: b.dataset.project }))); };\n  $(\"files\").onclick = e => { const b = e.target.closest(\"[data-file]\"); if (b) void run(() => b.dataset.kind === \"directory\" ? browse(b.dataset.file) : readFile(b.dataset.file)); };\n  $(\"up\").onclick = () => run(() => browse(directory.split(\"/\").slice(0, -1).join(\"/\")));\n  $(\"reload\").onclick = () => run(() => readFile(selected.path));\n  $(\"editor\").oninput = () => { revision++; clearProposal(); status(\"Draft edited · file on disk is unchanged\"); };\n  $(\"instruction\").oninput = () => { revision++; };\n  $(\"model\").onchange = update;\n  $(\"stage\").onclick = () => run(async () => showProposal(await api(\"code.stage\", { handle: grant.handle, path: selected.path, hash: selected.hash, content: $(\"editor\").value })));\n  $(\"suggest\").onclick = () => run(async () => {\n    if ($(\"editor\").value !== selected.content) throw Error(\"Review and apply your manual edits, or reload the file, before asking AI for a change.\");\n    const expected = revision; status(\"Generating a local suggestion…\");\n    const result = await api(\"code.propose\", { handle: grant.handle, path: selected.path, hash: selected.hash, model: $(\"model\").value, instruction: $(\"instruction\").value });\n    if (revision !== expected) throw Error(\"Your draft or instruction changed. The returned suggestion was not applied.\");\n    showProposal(result); await sessions();\n  });\n  $(\"discard\").onclick = () => { clearProposal(); status(\"Proposal discarded · no file has been changed\"); update(); };\n  $(\"apply\").onclick = () => run(async () => {\n    const result = await api(\"code.apply\", { proposalId: proposal.id });\n    if (!result.applied) { notify(\"Change kept as a proposal. Nothing was written.\"); return; }\n    const file = result.path; await readFile(file); await sessions(); notify(`Applied your reviewed change to ${file}.`); status(\"Reviewed change saved\");\n  });\n  $(\"tab-diff\").onclick = () => { $(\"diff\").hidden = false; $(\"result\").hidden = true; $(\"tab-diff\").classList.add(\"active\"); $(\"tab-file\").classList.remove(\"active\"); };\n  $(\"tab-file\").onclick = () => { $(\"diff\").hidden = true; $(\"result\").hidden = false; $(\"tab-file\").classList.add(\"active\"); $(\"tab-diff\").classList.remove(\"active\"); };\n  $(\"revoke\").onclick = () => run(async () => { await api(\"code.revoke\", { handle: grant.handle }); grant = null; selected = null; revision++; clearProposal(); $(\"editor\").value = \"\"; $(\"editor-area\").hidden = true; $(\"empty\").hidden = false; $(\"history\").hidden = true; $(\"files\").replaceChildren(); $(\"directory\").textContent = \"No project open\"; $(\"filename\").textContent = \"A clear view of your work\"; await projects(); await sessions(); status(\"Project access closed\"); });\n  $(\"sessions\").onclick = e => { const b = e.target.closest(\"[data-session]\"); if (b) void run(async () => { const result = await api(\"code.session\", { handle: grant.handle, sessionId: b.dataset.session }); $(\"history-title\").textContent = result.title; $(\"turns\").innerHTML = result.turns.map(t => `<div class=\"turn\"><strong>${esc(t.role)}</strong><p>${esc(t.content)}</p></div>`).join(\"\"); $(\"history\").hidden = false; $(\"history\").scrollIntoView({ block: \"start\" }); }); };\n  $(\"close-history\").onclick = () => { $(\"history\").hidden = true; };\n  void run(async () => { await projects(); const models = await api(\"models.list\"); for (const m of models.filter(m => m.status === \"ready\")) { const option = document.createElement(\"option\"); option.value = m.alias; option.textContent = m.label || m.alias; $(\"model\").append(option); } if ($(\"model\").options.length === 2) $(\"model\").selectedIndex = 1; });\n})();\n","index.html":"<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Koinos Code</title><link rel=\"stylesheet\" href=\"style.css\"></head><body>\n<header><div><span class=\"eyebrow\">KAI WORKSPACE / DEVELOPER TOOLS</span><h1>Koinos Code<span class=\"badge\">LOCAL</span></h1><p>Make a focused change. Understand every edit.</p></div><button id=\"choose\" class=\"primary\">Open a folder <span>↗</span></button></header>\n<div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n<div class=\"layout\"><aside><div class=\"section-label\">YOUR PROJECTS</div><div id=\"projects\"><p class=\"muted\">Loading saved projects…</p></div><div class=\"section-label spaced\">PROJECT FILES</div><div class=\"crumb\"><button id=\"up\" disabled aria-label=\"Parent directory\">↑</button><span id=\"directory\">No project open</span></div><div id=\"files\"><p class=\"muted\">Choose a project to browse its files.</p></div><div class=\"section-label spaced\">SAVED SESSIONS</div><div id=\"sessions\"></div><button id=\"revoke\" class=\"quiet\" hidden>Close project access</button></aside>\n<main><div class=\"workspace-head\"><div><div class=\"section-label\">SELECTED FILE</div><h2 id=\"filename\">A clear view of your work</h2></div><button id=\"reload\" disabled>Reload file</button></div><div id=\"empty\" class=\"empty\"><div class=\"code-mark\">{ }</div><h2>Your project, with you in control.</h2><p>Select a folder or open an existing project. Read a file, describe your change, then review the proposal before anything is written.</p><div class=\"trust-pills\"><span>Local models</span><span>Reviewed edits</span><span>No shell access</span></div></div>\n<div id=\"editor-area\" hidden><div class=\"editor-bar\"><span id=\"file-size\"></span><span>UTF-8 · editable</span></div><label for=\"editor\" class=\"sr-only\">File content</label><textarea id=\"editor\" spellcheck=\"false\" wrap=\"off\"></textarea><div class=\"editor-actions\"><span class=\"muted\">Edits stay here until you review and apply them.</span><button id=\"stage\">Review my edits</button></div>\n<section class=\"assist\"><div><span class=\"eyebrow\">LOCAL CODING ASSISTANT</span><h2>What would you like to change?</h2></div><label for=\"instruction\" class=\"sr-only\">Describe a change</label><textarea id=\"instruction\" rows=\"3\" maxlength=\"2000\" placeholder=\"For example: add validation to this function and preserve its existing behavior.\"></textarea><div class=\"assist-bottom\"><label for=\"model\" class=\"sr-only\">Installed local model</label><select id=\"model\"><option value=\"\">Choose an installed model</option></select><button id=\"suggest\" class=\"primary\">Suggest a change →</button></div><p class=\"fine\">Only the selected file and your instruction are sent to your installed model. Files over 12,000 characters can be read and edited manually.</p></section></div>\n<section id=\"proposal\" hidden class=\"proposal\"><div class=\"proposal-heading\"><div><span class=\"eyebrow\">READY FOR REVIEW</span><h2 id=\"proposal-title\">Proposed change</h2></div><span class=\"badge amber\">NOT APPLIED</span></div><p id=\"summary\"></p><div class=\"review-tabs\"><button id=\"tab-diff\" class=\"active\">Changes</button><button id=\"tab-file\">Complete result</button></div><pre id=\"diff\" tabindex=\"0\"></pre><pre id=\"result\" hidden tabindex=\"0\"></pre><div class=\"proposal-actions\"><span class=\"fine\">Applying opens a native review and checks that the file has not changed.</span><button id=\"discard\">Discard</button><button id=\"apply\" class=\"primary\">Review &amp; apply</button></div></section>\n<section id=\"history\" hidden class=\"history\"><div class=\"row\"><h2 id=\"history-title\">Session</h2><button id=\"close-history\">Close</button></div><div id=\"turns\"></div></section>\n</main></div><footer><span class=\"status-dot\"></span><span id=\"status\">Ready · nothing has been changed</span><span class=\"foot-right\">Koinos Code · requires KAI Core 0.2.0</span></footer><script src=\"app.js\"></script></body></html>\n","style.css":":root{color-scheme:dark;font:14px/1.6 \"Segoe UI\",system-ui,sans-serif;color:#e9eef7;background:#0d121b;--panel:#151d29;--line:#2a3547;--muted:#97a6bc;--green:#b4f0ce}*{box-sizing:border-box}body{margin:0}header{display:flex;align-items:center;justify-content:space-between;padding:32px 36px 26px;border-bottom:1px solid var(--line);background:linear-gradient(120deg,#17262b,#101724)}h1{font-size:30px;letter-spacing:-1px;margin:8px 0 0;display:flex;align-items:center;gap:14px}header p{margin:6px 0 0;color:var(--muted)}.eyebrow,.section-label{font-size:10px;letter-spacing:1.8px;font-weight:700;color:var(--muted)}.eyebrow{color:var(--green)}.badge{font-size:10px;letter-spacing:1px;border:1px solid #395849;color:#b4f0ce;border-radius:20px;padding:4px 9px;white-space:nowrap}.amber{border-color:#6c5d35;color:#ead395}button,input,textarea,select{font:inherit}button{border:1px solid #3d4b61;border-radius:8px;background:#222e40;color:#e8f0fd;padding:9px 14px;cursor:pointer;white-space:nowrap}button:hover{background:#33435b}button:disabled{opacity:.42;cursor:default}.primary{background:var(--green);border-color:var(--green);color:#183528;font-weight:650}.primary:hover{background:#d1ffe5}.primary span{margin-left:12px}button:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--green);outline-offset:3px}.layout{display:grid;grid-template-columns:250px 1fr;min-height:calc(100vh - 195px)}aside{padding:24px 18px;border-right:1px solid var(--line);background:#111925;overflow:hidden}main{min-width:0;padding:24px 30px 54px;max-width:1400px}.section-label{margin-bottom:12px}.spaced{margin-top:28px}.project{display:block;width:100%;border:0;background:transparent;text-align:left;padding:10px;border-radius:8px;margin-bottom:4px;white-space:normal}.project strong{display:block;overflow:hidden;text-overflow:ellipsis}.project small{display:block;color:var(--muted);font-size:11px}.project.selected{background:#263748;border:1px solid #3c5a68}.muted{color:var(--muted);font-size:12px}.crumb{display:flex;align-items:center;gap:8px;min-width:0;margin-bottom:8px}.crumb span{font-size:11px;color:var(--muted);overflow-wrap:anywhere}.crumb button{padding:3px 9px}.file{display:flex;align-items:center;gap:9px;width:100%;border:0;background:transparent;padding:7px 9px;text-align:left;font-size:12px;min-width:0;white-space:normal}.file span:last-child{overflow-wrap:anywhere}.file.selected{background:#263748;color:var(--green)}.file-icon{color:#7f94af;font-size:12px}.workspace-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:20px}.workspace-head .section-label{margin:0}h2{font-size:18px;letter-spacing:-.2px;margin:5px 0 12px}#filename{overflow-wrap:anywhere;margin-bottom:0}.empty{border:1px dashed #344158;border-radius:14px;text-align:center;padding:70px 30px;max-width:850px}.empty p{max-width:480px;margin:0 auto;color:var(--muted)}.code-mark{font:36px/1.4 ui-monospace,monospace;color:var(--green);margin-bottom:22px}.trust-pills{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:28px}.trust-pills span{border:1px solid #34444e;color:#b3c6c9;border-radius:20px;padding:4px 12px;font-size:11px}.editor-bar{display:flex;justify-content:space-between;padding:9px 14px;border:1px solid var(--line);background:#192230;border-radius:9px 9px 0 0;font-size:11px;color:var(--muted)}textarea,select{background:#0b111b;border:1px solid #35435b;border-radius:8px;color:#e5edf9;padding:12px;max-width:100%}#editor{font:13px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;resize:vertical;width:100%;min-height:320px;border-radius:0 0 9px 9px;margin:0;tab-size:2;white-space:pre}textarea{display:block}.editor-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:12px}.assist,.proposal,.history{margin-top:28px;padding:22px;border:1px solid var(--line);border-radius:12px;background:var(--panel)}#instruction{width:100%;resize:vertical;min-height:88px}.assist-bottom{display:flex;gap:12px;justify-content:space-between;margin-top:12px}.assist-bottom select{min-width:0;flex:1}.fine{font-size:11px;line-height:1.6;color:var(--muted)}.proposal-heading,.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.proposal-heading h2{margin:4px 0}.review-tabs{display:flex;gap:8px;margin:18px 0 0}.review-tabs button{border-radius:8px 8px 0 0;border-bottom:0;background:#121a27;font-size:12px}.review-tabs button.active{background:#263748;color:var(--green)}pre{padding:18px;margin:0;background:#0b111b;border:1px solid var(--line);font:12px/1.7 ui-monospace,Consolas,monospace;overflow:auto;max-height:480px;white-space:pre;tab-size:2}.proposal-actions{display:flex;gap:10px;align-items:center;margin-top:18px}.proposal-actions span{flex:1}.turn{border-bottom:1px solid var(--line);padding:12px 0}.turn strong{font-size:11px;text-transform:uppercase;color:var(--green)}.turn p{white-space:pre-wrap;overflow-wrap:anywhere}.quiet{margin-top:20px;background:transparent;font-size:11px}footer{position:fixed;bottom:0;left:0;right:0;background:#151f2d;border-top:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:9px 22px;font-size:11px;color:var(--muted);z-index:2}.status-dot{width:6px;height:6px;border-radius:100%;background:var(--green)}.foot-right{margin-left:auto}#notice{margin:16px 30px 0;padding:12px 15px;border:1px solid #496c6d;border-radius:8px;background:#20363a;overflow-wrap:anywhere}#notice.error{border-color:#89595e;background:#3c252c;color:#f5c9ce}.sr-only{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}[hidden]{display:none!important}@media(max-width:850px){header{padding:22px}.layout{grid-template-columns:200px 1fr}main{padding:20px}.assist-bottom{flex-wrap:wrap}.proposal-actions{flex-wrap:wrap}.foot-right{display:none}.editor-actions{align-items:flex-start;flex-direction:column}}@media(max-width:600px){.layout{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line)}header{align-items:flex-start;gap:12px}h1{font-size:24px}.empty{padding:35px 20px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"eBIKcJwk5ZV9HVYUsOaaQdsFHzI/N14Uf2DH2DkGNXb3I2C8NcOjenHUyg/RB+EHvSzv6kCfi+YD1ijxXLvwCw=="}