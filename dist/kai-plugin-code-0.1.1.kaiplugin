{"manifest":{"schema":1,"apiVersion":2,"id":"kai.code","version":"0.1.1","name":"Koinos Code","description":"Open a local coding project, browse text files, ask an installed model for a change, and apply a reviewed edit. Existing project sessions are preserved. Requires KAI Core 0.2.0.","entry":"index.html","permissions":["models.read","code.read","code.assist","code.write"]},"files":{"app.js":"\"use strict\";\n(() => {\n  const $ = id => document.getElementById(id), api = (method, input) => window.kai.call(method, input);\n  let grant = null, selected = null, proposal = null, directory = \"\", revision = 0, pending = false;\n  const esc = value => String(value ?? \"\").replace(/[&<>\"']/g, c => ({ \"&\": \"&amp;\", \"<\": \"&lt;\", \">\": \"&gt;\", '\"': \"&quot;\", \"'\": \"&#39;\" }[c]));\n  const banner = window.KaiPluginNotice.attach($(\"notice\"), { focusTarget: () => selected ? $(\"instruction\") : $(\"choose\") });\n  const notify = (message, error = false) => banner.show(message, { error, force: true });\n  function status(message) { $(\"status\").textContent = message; }\n  async function run(fn) {\n    if (pending) return; pending = true; banner.clear();\n    document.querySelectorAll(\"button:not(.kai-notice-close)\").forEach(b => { b.dataset.wasDisabled = String(b.disabled); b.disabled = true; });\n    try { await fn(); } catch (error) { notify(error.message.replace(/^Error invoking remote method '[^']+': (?:Error: )?/, \"\"), true); status(\"Action stopped · no automatic retry\"); }\n    finally { pending = false; document.querySelectorAll(\"button:not(.kai-notice-close)\").forEach(b => { b.disabled = b.dataset.wasDisabled === \"true\"; delete b.dataset.wasDisabled; }); update(); }\n  }\n  function update() {\n    $(\"workspace-heading\").hidden = !grant; $(\"project-files\").hidden = !grant; $(\"assist\").hidden = !selected;\n    $(\"choose-start\").hidden = !!grant; $(\"file-hint\").hidden = !grant;\n    $(\"start-title\").textContent = grant ? grant.project.name : \"Koinos Code\";\n    $(\"start-detail\").textContent = grant ? \"Choose a file from your project, describe a change, and review the result before applying it.\" : \"Point it at a folder and tell it what to do. It shows you every change before anything happens.\";\n    $(\"reload\").disabled = !selected; $(\"up\").disabled = !grant || !directory; $(\"revoke\").hidden = !grant; $(\"suggest\").disabled = !selected || !$(\"model\").value; $(\"apply\").disabled = !proposal; }\n  async function projects() {\n    const result = await api(\"code.projects\");\n    $(\"projects\").innerHTML = result.projects.length ? result.projects.map(p => `<button class=\"project ${grant?.project.id === p.id ? \"selected\" : \"\"}\" data-project=\"${esc(p.id)}\" ${p.missing ? \"disabled\" : \"\"}><strong>${esc(p.name)}</strong><small>${p.missing ? \"Folder unavailable\" : `${p.sessions} saved sessions`}</small></button>`).join(\"\") : '<p class=\"muted\">No projects yet. Open a folder to get started.</p>';\n  }\n  async function browse(relative = \"\") {\n    if (!grant) return; const result = await api(\"code.browse\", { handle: grant.handle, path: relative }); directory = result.path;\n    $(\"directory\").textContent = directory || grant.project.name;\n    $(\"files\").innerHTML = result.entries.length ? result.entries.map(f => `<button class=\"file ${selected?.path === f.path ? \"selected\" : \"\"}\" data-file=\"${esc(f.path)}\" data-kind=\"${f.kind}\"><span class=\"file-icon\">${f.kind === \"directory\" ? \"▸\" : \"·\"}</span><span>${esc(f.name)}</span></button>`).join(\"\") : '<p class=\"muted\">No supported files in this folder.</p>';\n    if (result.truncated) $(\"files\").insertAdjacentHTML(\"beforeend\", '<p class=\"muted\">Showing the first 500 entries.</p>'); update();\n  }\n  async function sessions() {\n    if (!grant) { $(\"sessions\").replaceChildren(); return; }\n    const result = await api(\"code.sessions\", { handle: grant.handle });\n    $(\"sessions\").innerHTML = result.sessions.length ? result.sessions.slice(0, 20).map(s => `<button class=\"project\" data-session=\"${esc(s.id)}\"><strong>${esc(s.title)}</strong><small>${s.turns} messages</small></button>`).join(\"\") : '<p class=\"muted\">Your coding suggestions will appear here.</p>';\n  }\n  function clearProposal() { proposal = null; $(\"proposal\").hidden = true; $(\"diff\").textContent = \"\"; $(\"result\").textContent = \"\"; }\n  async function openGrant(result) {\n    if (result.cancelled) return; if (grant) await api(\"code.revoke\", { handle: grant.handle });\n    grant = result; selected = null; revision++; clearProposal(); $(\"empty\").hidden = false; $(\"editor-area\").hidden = true; $(\"history\").hidden = true;\n    $(\"filename\").textContent = grant.project.name; status(`Project open · ${grant.project.name}`); await projects(); await browse(); await sessions(); update();\n  }\n  async function readFile(relative) {\n    const r = await api(\"code.read\", { handle: grant.handle, path: relative }); selected = r; revision++; clearProposal();\n    $(\"filename\").textContent = r.path; $(\"file-size\").textContent = `${r.size.toLocaleString()} bytes`; $(\"editor\").value = r.content;\n    $(\"empty\").hidden = true; $(\"editor-area\").hidden = false; status(\"File loaded · nothing has been changed\"); await browse(directory); update();\n  }\n  function showProposal(result) {\n    proposal = result; $(\"proposal-title\").textContent = result.path; $(\"summary\").textContent = result.summary;\n    $(\"diff\").textContent = result.diff; $(\"result\").textContent = result.content; $(\"proposal\").hidden = false;\n    $(\"diff\").hidden = false; $(\"result\").hidden = true; $(\"tab-diff\").classList.add(\"active\"); $(\"tab-file\").classList.remove(\"active\"); $(\"tab-diff\").setAttribute(\"aria-selected\", \"true\"); $(\"tab-file\").setAttribute(\"aria-selected\", \"false\");\n    status(\"Proposal ready · no file has been changed\"); $(\"proposal\").scrollIntoView({ block: \"start\", behavior: \"auto\" }); update();\n  }\n  $(\"choose\").onclick = () => run(async () => openGrant(await api(\"code.choose\")));\n  $(\"choose-start\").onclick = () => $(\"choose\").onclick();\n  $(\"projects\").onclick = e => { const b = e.target.closest(\"[data-project]\"); if (b) void run(async () => openGrant(await api(\"code.open\", { projectId: b.dataset.project }))); };\n  $(\"files\").onclick = e => { const b = e.target.closest(\"[data-file]\"); if (b) void run(() => b.dataset.kind === \"directory\" ? browse(b.dataset.file) : readFile(b.dataset.file)); };\n  $(\"up\").onclick = () => run(() => browse(directory.split(\"/\").slice(0, -1).join(\"/\")));\n  $(\"reload\").onclick = () => run(() => readFile(selected.path));\n  $(\"editor\").oninput = () => { revision++; clearProposal(); status(\"Draft edited · file on disk is unchanged\"); };\n  $(\"instruction\").oninput = () => { revision++; };\n  $(\"model\").onchange = update;\n  $(\"stage\").onclick = () => run(async () => showProposal(await api(\"code.stage\", { handle: grant.handle, path: selected.path, hash: selected.hash, content: $(\"editor\").value })));\n  $(\"suggest\").onclick = () => run(async () => {\n    if ($(\"editor\").value !== selected.content) throw Error(\"Review and apply your manual edits, or reload the file, before asking AI for a change.\");\n    const expected = revision; status(\"Generating a local suggestion…\");\n    const result = await api(\"code.propose\", { handle: grant.handle, path: selected.path, hash: selected.hash, model: $(\"model\").value, instruction: $(\"instruction\").value });\n    if (revision !== expected) throw Error(\"Your draft or instruction changed. The returned suggestion was not applied.\");\n    showProposal(result); await sessions();\n  });\n  $(\"discard\").onclick = () => { clearProposal(); status(\"Proposal discarded · no file has been changed\"); update(); };\n  $(\"apply\").onclick = () => run(async () => {\n    const result = await api(\"code.apply\", { proposalId: proposal.id });\n    if (!result.applied) { notify(\"Change kept as a proposal. Nothing was written.\"); return; }\n    const file = result.path; await readFile(file); await sessions(); notify(`Applied your reviewed change to ${file}.`); status(\"Reviewed change saved\");\n  });\n  $(\"tab-diff\").onclick = () => { $(\"diff\").hidden = false; $(\"result\").hidden = true; $(\"tab-diff\").classList.add(\"active\"); $(\"tab-file\").classList.remove(\"active\"); $(\"tab-diff\").setAttribute(\"aria-selected\", \"true\"); $(\"tab-file\").setAttribute(\"aria-selected\", \"false\"); };\n  $(\"tab-file\").onclick = () => { $(\"diff\").hidden = true; $(\"result\").hidden = false; $(\"tab-file\").classList.add(\"active\"); $(\"tab-diff\").classList.remove(\"active\"); $(\"tab-diff\").setAttribute(\"aria-selected\", \"false\"); $(\"tab-file\").setAttribute(\"aria-selected\", \"true\"); };\n  $(\"revoke\").onclick = () => run(async () => { await api(\"code.revoke\", { handle: grant.handle }); grant = null; selected = null; revision++; clearProposal(); $(\"editor\").value = \"\"; $(\"editor-area\").hidden = true; $(\"empty\").hidden = false; $(\"history\").hidden = true; $(\"files\").replaceChildren(); $(\"directory\").textContent = \"No project open\"; $(\"filename\").textContent = \"No file selected\"; await projects(); await sessions(); status(\"Project access closed\"); });\n  $(\"sessions\").onclick = e => { const b = e.target.closest(\"[data-session]\"); if (b) void run(async () => { const result = await api(\"code.session\", { handle: grant.handle, sessionId: b.dataset.session }); $(\"history-title\").textContent = result.title; $(\"turns\").innerHTML = result.turns.map(t => `<div class=\"turn\"><strong>${esc(t.role)}</strong><p>${esc(t.content)}</p></div>`).join(\"\"); $(\"history\").hidden = false; $(\"history\").scrollIntoView({ block: \"start\" }); }); };\n  $(\"close-history\").onclick = () => { $(\"history\").hidden = true; };\n  void run(async () => { await projects(); const models = await api(\"models.list\"); for (const m of models.filter(m => m.status === \"ready\")) { const option = document.createElement(\"option\"); option.value = m.alias; option.textContent = m.label || m.alias; $(\"model\").append(option); } if ($(\"model\").options.length === 2) $(\"model\").selectedIndex = 1; });\n})();\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Koinos Code</title><link rel=\"stylesheet\" href=\"kai-theme.css\"><link rel=\"stylesheet\" href=\"style.css\"></head>\n<body>\n<header class=\"workspace-header\"><div class=\"workspace-title\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16\"/></svg><h1>Koinos Code</h1></div><span class=\"workspace-caption\">LOCAL WORKSPACE</span></header>\n<div id=\"notice\" role=\"status\" aria-live=\"polite\" hidden></div>\n<div class=\"layout kc-shell\">\n  <aside class=\"kc-rail\" aria-label=\"Projects and files\">\n    <button id=\"choose\" class=\"kc-new\">+ Open project</button>\n    <div class=\"section-label\">Projects</div><div id=\"projects\" class=\"kc-list\"><p class=\"muted\">Loading saved projects…</p></div>\n    <div class=\"section-label spaced\">Chats</div><div id=\"sessions\" class=\"kc-list\"><p class=\"muted\">Select a project to see its chats.</p></div>\n    <details id=\"project-files\" class=\"project-files\" hidden open><summary>Project files</summary><div class=\"crumb\"><button id=\"up\" disabled aria-label=\"Parent directory\">↑</button><span id=\"directory\">No project open</span></div><div id=\"files\"><p class=\"muted\">Choose a project to browse its files.</p></div></details>\n    <div class=\"kc-rail-foot\"><button id=\"revoke\" class=\"quiet\" hidden>Close project access</button></div>\n  </aside>\n  <main class=\"kc-pane\">\n    <div id=\"workspace-heading\" class=\"workspace-head\" hidden><div><h2 id=\"filename\">No file selected</h2><p class=\"muted\">Select a file to review or describe a change.</p></div><button id=\"reload\" disabled>Reload file</button></div>\n    <div class=\"workspace-body\">\n      <div id=\"empty\" class=\"kc-start\"><h2 id=\"start-title\">Koinos Code</h2><p id=\"start-detail\">Point it at a folder and tell it what to do. It shows you every change before anything happens.</p><div class=\"kc-choices\"><button id=\"choose-start\" class=\"kc-choice\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7V5h6l2 2h10v13H3ZM3 7h18\"/></svg><span class=\"kc-choice-title\">Select a folder</span><span class=\"kc-choice-sub\">Work on something already on this machine</span></button></div><p id=\"file-hint\" class=\"fine\" hidden>Choose a file from Project files to begin.</p></div>\n      <div id=\"editor-area\" hidden><details class=\"file-preview\" open><summary><span>File content</span><span id=\"file-size\"></span></summary><label for=\"editor\" class=\"sr-only\">File content</label><textarea id=\"editor\" spellcheck=\"false\" wrap=\"off\"></textarea><div class=\"editor-actions\"><span class=\"muted\">Edits stay here until you review and apply them.</span><button id=\"stage\">Review my edits</button></div></details></div>\n      <section id=\"proposal\" hidden class=\"proposal\"><div class=\"proposal-heading\"><h2 id=\"proposal-title\">Proposed change</h2><span class=\"badge amber\">Not applied</span></div><p id=\"summary\"></p><div class=\"review-tabs\" role=\"tablist\" aria-label=\"Proposal preview\"><button id=\"tab-diff\" class=\"active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"diff\">Changes</button><button id=\"tab-file\" role=\"tab\" aria-selected=\"false\" aria-controls=\"result\">Complete result</button></div><pre id=\"diff\" role=\"tabpanel\" aria-labelledby=\"tab-diff\" tabindex=\"0\"></pre><pre id=\"result\" hidden role=\"tabpanel\" aria-labelledby=\"tab-file\" tabindex=\"0\"></pre><div class=\"proposal-actions\"><span class=\"fine\">Review the exact change before applying.</span><button id=\"discard\">Discard</button><button id=\"apply\" class=\"primary\">Review &amp; apply</button></div></section>\n      <section id=\"history\" hidden class=\"history\"><div class=\"row\"><h2 id=\"history-title\">Chat</h2><button id=\"close-history\" class=\"close-button\" aria-label=\"Close saved chat\" title=\"Close saved chat\">×</button></div><div id=\"turns\"></div></section>\n    </div>\n    <section id=\"assist\" class=\"assist\" hidden aria-label=\"Coding assistant\"><div class=\"kc-composer\"><label for=\"instruction\" class=\"sr-only\">Describe a change</label><textarea id=\"instruction\" rows=\"2\" maxlength=\"2000\" placeholder=\"What should it do? Describe a change to the selected file.\"></textarea><button id=\"suggest\" class=\"primary\">Send</button></div><div class=\"assist-bottom\"><label for=\"model\">Model</label><select id=\"model\"><option value=\"\">Choose an installed model</option></select><span class=\"fine\">Selected file only · Local model</span></div></section>\n  </main>\n</div>\n<footer><span class=\"status-dot\"></span><span id=\"status\" role=\"status\">Ready · nothing has been changed</span></footer>\n<script src=\"kai-notices.js\"></script><script src=\"app.js\"></script>\n</body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","style.css":"/* The original Koinos Code project rail, start pane and review workspace. */\n:root{color-scheme:light;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:#14284e;background:#f4f7fd;--panel:#fff;--line:#dce5f2;--muted:#61728d;--accent:#155eef;--green:#168469}\n*{box-sizing:border-box}body{margin:0;height:100dvh;min-height:450px;display:flex;flex-direction:column;overflow:hidden;background:#f4f7fd;color:#14284e}button,input,textarea,select{font:inherit}button{border:1px solid var(--line);border-radius:9px;background:#fff;color:#14284e;padding:8px 12px;font-size:12px;cursor:pointer}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,textarea:focus-visible,select:focus-visible,summary:focus-visible,pre:focus-visible{outline:2px solid var(--accent);outline-offset:3px}.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600}.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\n.workspace-header{display:flex;align-items:center;justify-content:space-between;gap:15px;height:74px;min-height:74px;padding:0 28px;border-bottom:1px solid var(--line);background:#f4f7fd;flex:none}.workspace-title{display:flex;align-items:center;gap:12px;min-width:0}.workspace-title svg{width:22px;height:22px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.workspace-title h1{font-size:15px;font-weight:650;letter-spacing:0;margin:0}.workspace-caption{font-size:9px;letter-spacing:1.3px;color:#7b8ca8}\n.layout{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:0;flex:1}.kc-rail{display:flex;flex-direction:column;gap:6px;min-width:0;min-height:0;padding:20px 14px;border-right:1px solid var(--line);background:#fff;overflow-y:auto}.kc-new{width:100%;text-align:left;font-weight:600;background:#f5f8fe;border-radius:10px;padding:9px 12px;margin-bottom:6px}.section-label,.project-files>summary{font-size:10px;font-weight:550;letter-spacing:1px;text-transform:uppercase;color:var(--muted);margin:10px 2px 2px;padding:4px 2px}.spaced{margin-top:14px}.kc-list{display:flex;flex-direction:column;gap:2px}.project{display:block;width:100%;text-align:left;border:1px solid transparent;background:transparent;padding:9px 10px;border-radius:8px;min-width:0}.project strong{display:block;font-size:12px;font-weight:550;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.project small{display:block;color:var(--muted);font-size:10px;margin-top:3px}.project.selected{background:#edf4ff;border-color:#d5e4fc;color:var(--accent)}.muted,.fine{color:var(--muted);font-size:11px;line-height:1.6}.muted{margin:5px 0}.project-files{min-width:0;margin-top:12px;border-top:1px solid var(--line);padding-top:3px}.project-files>summary{cursor:pointer;margin-bottom:10px}.crumb{display:flex;align-items:center;gap:7px;min-width:0;margin:0 0 8px}.crumb span{font-size:10px;color:var(--muted);overflow-wrap:anywhere}.crumb button{padding:3px 8px}.file{display:flex;align-items:center;gap:8px;width:100%;border:0;background:transparent;padding:7px 9px;text-align:left;font-size:11px;min-width:0;white-space:normal}.file span:last-child{overflow-wrap:anywhere}.file.selected{background:#edf4ff;color:var(--accent)}.file-icon{color:#7b8ca8}.kc-rail-foot{margin-top:auto;padding-top:18px}.quiet{background:none;border:0;padding:3px;color:var(--accent);font-size:11px;text-align:left}\n.kc-pane{display:flex;flex-direction:column;min-width:0;min-height:0;overflow:hidden;background:#f4f7fd}.workspace-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 24px;border-bottom:1px solid var(--line);flex:none}.workspace-head>div{min-width:0}h2{font-size:16px;font-weight:600;line-height:1.4;letter-spacing:-.2px;margin:0 0 9px}#filename{font-size:13px;margin:0;overflow-wrap:anywhere}.workspace-head p{margin:4px 0 0;font-size:10px}.workspace-body{min-height:0;flex:1;overflow:auto;padding:20px 24px}.kc-start{padding:28px 12px;max-width:820px;margin:0 auto;width:100%}.kc-start h2{font-size:29px;font-weight:600;letter-spacing:-.9px;margin:0 0 8px}.kc-start>p{font-size:12px;color:var(--muted);line-height:1.8;margin:0 0 24px;max-width:610px}.kc-choices{display:grid;grid-template-columns:minmax(0,1fr);gap:18px;max-width:420px}.kc-choice{display:flex;flex-direction:column;gap:6px;text-align:left;background:#fff;border:1px solid var(--line);border-radius:16px;padding:23px}.kc-choice svg{width:22px;height:22px;margin-bottom:6px;fill:none;stroke:var(--accent);stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}.kc-choice-title{font-size:13px;font-weight:600}.kc-choice-sub{font-size:11px;color:var(--muted)}.kc-start #file-hint{margin-top:20px}\n.file-preview{background:#fff;border:1px solid var(--line);border-radius:12px;overflow:hidden}.file-preview>summary{display:flex;justify-content:space-between;align-items:center;padding:12px 14px;font-size:12px;cursor:pointer;background:#f9fbff;gap:12px}.file-preview>summary:before{content:\"›\";color:var(--muted);font-size:17px;line-height:1}.file-preview[open]>summary:before{transform:rotate(90deg)}.file-preview>summary>span:first-child{margin-right:auto}#file-size{font-size:10px;color:var(--muted)}textarea,select{background:#f5f8fe;border:1px solid var(--line);border-radius:9px;color:#14284e;padding:10px;max-width:100%;font-size:12px}#editor{display:block;font:12px/1.65 ui-monospace,SFMono-Regular,Consolas,monospace;resize:vertical;width:100%;min-height:260px;height:34vh;border:0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);border-radius:0;margin:0;padding:14px 16px;background:#fff;tab-size:2;white-space:pre}.editor-actions{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 14px}.editor-actions span{font-size:10px}.editor-actions button{font-size:11px;flex:none}\n.assist{flex:none;padding:13px 24px 14px;border-top:1px solid var(--line);background:#fff}.kc-composer{display:flex;align-items:flex-end;gap:9px}#instruction{display:block;resize:vertical;flex:1;min-width:0;min-height:68px;max-height:160px;font-size:12px;line-height:1.6}.assist-bottom{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:8px}.assist-bottom label{font-size:10px;color:var(--muted)}.assist-bottom select{min-width:0;max-width:240px;padding:5px 8px;font-size:11px}.assist-bottom .fine{margin-left:auto;font-size:10px}\n.proposal,.history{margin-top:18px;padding:18px;border:1px solid var(--line);border-radius:14px;background:#fff}.proposal-heading,.row{display:flex;align-items:center;justify-content:space-between;gap:12px}.proposal-heading h2{font-size:13px;overflow-wrap:anywhere;margin:0}.badge{font-size:10px;line-height:1.4;border:1px solid #ead7a3;color:#8d621d;background:#fff8e9;border-radius:20px;padding:4px 9px;white-space:nowrap}#summary{font-size:12px;line-height:1.7;margin:12px 0;color:var(--muted)}.review-tabs{display:flex;gap:4px;margin:16px 0 0;border-bottom:1px solid var(--line)}.review-tabs button{border:0;border-bottom:2px solid transparent;border-radius:0;background:none;font-size:11px;padding:8px 12px}.review-tabs button.active{background:#edf4ff;color:var(--accent);border-bottom-color:var(--accent)}pre{padding:14px;margin:0;background:#f8faff;color:#14284e;border:1px solid var(--line);border-top:0;font:11px/1.7 ui-monospace,Consolas,monospace;overflow:auto;max-height:360px;white-space:pre;tab-size:2}.proposal-actions{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:14px}.proposal-actions span{flex:1;min-width:160px;font-size:10px}.turn{border-bottom:1px solid var(--line);padding:12px 0}.turn:last-child{border:0}.turn strong{font-size:10px;color:var(--accent);font-weight:600}.turn p{font-size:12px;line-height:1.75;white-space:pre-wrap;overflow-wrap:anywhere;margin:6px 0}.close-button{border:0;background:none;font-size:22px;line-height:1;padding:5px 8px;color:var(--muted)}\nfooter{background:#fff;border-top:1px solid var(--line);display:flex;align-items:center;gap:8px;padding:6px 18px;font-size:10px;color:var(--muted);flex:none;min-height:29px}.status-dot{width:5px;height:5px;flex:none;border-radius:50%;background:var(--green)}#notice{margin:12px 24px;padding:10px 12px;border:1px solid #c6d9f9;border-radius:9px;background:#eaf2ff;color:#184b9c;font-size:12px;overflow-wrap:anywhere;flex:none}#notice.error{border-color:#f0c4cc;background:#fff0f2;color:#a33040}.sr-only{position:absolute;clip:rect(0,0,0,0);width:1px;height:1px;overflow:hidden}[hidden]{display:none!important}\n@media(max-width:900px){.layout{grid-template-columns:200px minmax(0,1fr)}.workspace-header{padding-inline:22px}.kc-rail{padding:16px 12px}.workspace-head,.workspace-body{padding:16px 20px}.assist{padding:12px 20px}.kc-start{padding:20px 0}.editor-actions{align-items:flex-start;flex-wrap:wrap}.assist-bottom .fine{margin-left:0;width:100%}.proposal{padding:14px}.proposal-actions span{flex-basis:100%}}\n@media(max-width:620px){.layout{grid-template-columns:minmax(0,1fr);grid-template-rows:auto minmax(0,1fr)}.kc-rail{max-height:30vh;border-right:0;border-bottom:1px solid var(--line);display:block}.kc-rail .kc-new{margin-bottom:8px}.kc-rail-foot{padding-top:8px}.workspace-header{height:65px;min-height:65px;padding-inline:18px}.workspace-caption{display:none}.workspace-head,.workspace-body{padding:14px}.assist{padding:12px 14px}.kc-start h2{font-size:25px}.workspace-head{align-items:flex-start}.workspace-head button{font-size:10px;padding:6px 9px}.kc-composer{align-items:stretch;flex-wrap:wrap}#instruction{flex-basis:100%}.kc-composer #suggest{margin-left:auto}#notice{margin-inline:14px}}\n"},"publicKey":"MCowBQYDK2VwAyEAujPt2xYcqLkorZIdmrBEa0ZlLml+yEERDhP+YtI2t5o=","signature":"ol9HN3ZklIeanrl8djDtxnvLKbq1yTS6qBuAMIPjVRECeHvEBPbkdCJxz4MWn8u7FvqOl4x+7PoeBbfQzaVKBA=="}