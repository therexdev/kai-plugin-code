{"manifest":{"schema":2,"apiVersion":3,"id":"kai.code","version":"0.3.2","name":"Koinos Code","description":"The complete original coding workspace: projects and conversations, plan-first coding, reviewed file changes and commands, project tools, slash commands, and GitHub.","entry":"index.html","permissions":["native.execute","models.read","inference.local","storage.read","storage.write","services.call","services.provide","network.status","desktop.windows","secrets.use","desktop.preferences"],"runtime":"native","service":"service/index.js","provides":["kai.code"],"consumes":["kai.tools"]},"files":{"app.js":"/*\n * Koinos Code — the workspace view (task #74).\n *\n * REWRITTEN, and the reason matters: the previous version drove every action\n * through window.prompt(). **window.prompt() DOES NOT EXIST IN ELECTRON** — it\n * returns null without ever showing anything, so in the packaged app every one\n * of those buttons silently did nothing. The same trap is recorded in\n * ui/tools-view.js from an earlier field report. Inputs use inline forms, confirmations use Core’s styled dialogs, and\n * folder choice goes through the\n * NATIVE picker when the app shell offers one, with an in-app directory\n * browser everywhere else.\n *\n * Shape: a projects rail with \"New chat\", and a pane that is either the start\n * screen (pick a folder, or clone one) or a conversation. The permission model\n * is untouched — every write is a card with its diff, every command a card\n * with the exact line, and nothing happens until a button is pressed.\n */\n(() => {\n  \"use strict\";\n\n  const $ = (id) => document.getElementById(id);\n  // NOT named `state`: app.js declares a top-level `state` this file reads for\n  // the selected model alias, and shadowing it would silently break that.\n  const kc = {\n    projects: [],\n    projectId: null,\n    sessions: [],\n    sessionId: null,\n    runId: null,\n    runController: null,\n    gh: null,\n    browseFor: \"project\", // \"project\" | \"clone\"\n    browsePath: \"\",\n    browseSeq: 0,\n    allTools: [],\n    maxTools: 8,\n    toolsByProject: {}, // projectId -> [tool names] — opt-in, per project\n    commands: [],\n    commandsDir: \"\",\n    models: [], // local aliases that are actually on this machine\n  };\n\n  /** Does the app shell offer the OS folder window? Electron yes, browser no. */\n  const nativePicker = () => typeof window.koinosShell?.pickFolder === \"function\";\n\n  async function api(path, opts = {}) {\n    const r = await fetch(path, { headers: { \"content-type\": \"application/json\" }, ...opts });\n    const j = await r.json().catch(() => ({}));\n    if (!r.ok || j.ok === false) throw new Error(j.error || `request failed (${r.status})`);\n    return j;\n  }\n\n  const status = (t) => { $(\"kc-status\").textContent = t || \"\"; };\n  function startError(msg) {\n    const el = $(\"kc-start-error\");\n    el.textContent = msg || \"\";\n    el.hidden = !msg;\n  }\n\n  function currentProject() {\n    return kc.projects.find((p) => p.id === kc.projectId) || null;\n  }\n\n  // ------------------------------------------------------------ transcript\n\n  function trace(text) {\n    const div = document.createElement(\"div\");\n    div.className = \"pg-tool\";\n    div.textContent = text;\n    $(\"kc-trace\").appendChild(div);\n    div.scrollIntoView({ block: \"nearest\" });\n  }\n\n  function bubble(who, text) {\n    const div = document.createElement(\"div\");\n    div.className = \"pg-msg\";\n    const name = document.createElement(\"span\");\n    name.className = \"pg-name\";\n    name.textContent = who;\n    div.appendChild(name);\n    div.appendChild(document.createTextNode(text));\n    $(\"kc-trace\").appendChild(div);\n    div.scrollIntoView({ block: \"nearest\" });\n  }\n\n  function approvalCard(t) {\n    const card = document.createElement(\"div\");\n    card.className = \"kc-approval\";\n    const head = document.createElement(\"div\");\n    head.className = \"kc-approval-head\";\n    KaiI18n.setText(head, t.kind === \"edit\" ? `edit ${t.path}` : `run: ${t.cmd}`);\n    card.appendChild(head);\n    if (t.kind === \"edit\") {\n      const pre = document.createElement(\"pre\");\n      pre.className = \"kc-diff\";\n      for (const line of String(t.diff || \"\").split(\"\\n\")) {\n        const span = document.createElement(\"span\");\n        span.className = line.startsWith(\"+\") ? \"kc-add\" : line.startsWith(\"-\") ? \"kc-del\" : \"\";\n        KaiI18n.setText(span, KaiI18n.message`${line}\\n`);\n        pre.appendChild(span);\n      }\n      card.appendChild(pre);\n    }\n    const row = document.createElement(\"div\");\n    row.className = \"form-row\";\n    const yes = document.createElement(\"button\");\n    yes.className = \"primary small\";\n    KaiI18n.setText(yes, t.kind === \"edit\" ? \"Apply edit\" : \"Run command\");\n    const no = document.createElement(\"button\");\n    no.className = \"small\";\n    KaiI18n.setText(no, \"Deny\");\n    const answer = async (approved) => {\n      yes.disabled = no.disabled = true;\n      card.classList.add(\"answered\");\n      head.textContent += approved ? \" — approved\" : \" — denied\";\n      // The run can finish over SSE before this approval request returns.\n      // Mark it running first so a late acknowledgement cannot replace done.\n      status(\"running…\");\n      await fetch(\"/core/code/approve\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ approvalId: t.approvalId, approved }),\n      }).catch(() => {});\n    };\n    yes.addEventListener(\"click\", () => answer(true));\n    no.addEventListener(\"click\", () => answer(false));\n    row.appendChild(yes);\n    row.appendChild(no);\n    card.appendChild(row);\n    $(\"kc-trace\").appendChild(card);\n    card.scrollIntoView({ block: \"nearest\" });\n  }\n\n  /*\n   * A PLAN is a proposal, so it gets a card rather than becoming a turn: the\n   * agent has read the project and written what it would do, and nothing has\n   * happened yet. Approving re-runs the same task in acting mode with the plan\n   * as the thing to follow.\n   */\n  function planCard(planText, task) {\n    const card = document.createElement(\"div\");\n    card.className = \"kc-approval\";\n    const head = document.createElement(\"div\");\n    head.className = \"kc-approval-head\";\n    KaiI18n.setText(head, \"proposed plan — nothing has been changed yet\");\n    const body = document.createElement(\"div\");\n    body.className = \"pg-msg\";\n    body.textContent = planText;\n    const row = document.createElement(\"div\");\n    row.className = \"form-row\";\n    const go = document.createElement(\"button\");\n    go.className = \"primary small\";\n    KaiI18n.setText(go, \"Approve and run\");\n    const no = document.createElement(\"button\");\n    no.className = \"small\";\n    KaiI18n.setText(no, \"Discard\");\n    go.addEventListener(\"click\", () => {\n      go.disabled = no.disabled = true;\n      card.classList.add(\"answered\");\n      KaiI18n.setText(head, \"plan approved\");\n      run(task, { plan: planText });\n    });\n    no.addEventListener(\"click\", () => {\n      go.disabled = no.disabled = true;\n      card.classList.add(\"answered\");\n      KaiI18n.setText(head, \"plan discarded\");\n      status(\"\");\n    });\n    row.append(go, no);\n    card.append(head, body, row);\n    $(\"kc-trace\").appendChild(card);\n    card.scrollIntoView({ block: \"nearest\" });\n  }\n\n  // -------------------------------------------------------------- rendering\n\n  function renderProjects() {\n    const host = $(\"kc-projects\");\n    host.innerHTML = \"\";\n    for (const p of kc.projects) {\n      const b = document.createElement(\"button\");\n      b.className = `kc-item${p.id === kc.projectId ? \" on\" : \"\"}${p.missing ? \" missing\" : \"\"}`;\n      b.title = p.path;\n      const name = document.createElement(\"span\");\n      name.textContent = p.name;\n      const sub = document.createElement(\"span\");\n      sub.className = \"kc-sub\";\n      // A moved or deleted folder is SAID, not silently dropped.\n      KaiI18n.setText(sub, p.missing ? \"folder not found\" : p.path);\n      b.append(name, sub);\n      b.addEventListener(\"click\", () => selectProject(p.id));\n      host.appendChild(b);\n    }\n  }\n\n  function renderSessions() {\n    const host = $(\"kc-sessions\");\n    host.innerHTML = \"\";\n    $(\"kc-sessions-label\").hidden = !kc.projectId;\n    for (const s of kc.sessions) {\n      const b = document.createElement(\"button\");\n      b.className = `kc-item${s.id === kc.sessionId ? \" on\" : \"\"}`;\n      b.title = s.title;\n      const t = document.createElement(\"span\");\n      t.textContent = s.title;\n      const sub = document.createElement(\"span\");\n      sub.className = \"kc-sub\";\n      KaiI18n.setText(sub, KaiI18n.message`${s.turns} turn${s.turns === 1 ? \"\" : \"s\"}`);\n      b.append(t, sub);\n      b.addEventListener(\"click\", () => selectSession(s.id));\n      host.appendChild(b);\n    }\n  }\n\n  /** Start screen when nothing is chosen; conversation when something is. */\n  function showChat(on) {\n    $(\"kc-start\").hidden = on;\n    $(\"kc-chat\").hidden = !on;\n  }\n\n  async function loadProjects() {\n    const j = await api(\"/core/code/projects\");\n    kc.projects = j.projects || [];\n    if (kc.projectId && !kc.projects.some((p) => p.id === kc.projectId)) kc.projectId = null;\n    renderProjects();\n    if (kc.projectId) await loadSessions();\n    else {\n      kc.sessions = [];\n      renderSessions();\n      showChat(false);\n    }\n  }\n\n  async function refreshSessionList() {\n    const j = await api(`/core/code/projects/${encodeURIComponent(kc.projectId)}/sessions`);\n    kc.sessions = j.sessions || [];\n    if (kc.sessionId && !kc.sessions.some((s) => s.id === kc.sessionId)) kc.sessionId = null;\n    if (!kc.sessionId && kc.sessions.length) kc.sessionId = kc.sessions[0].id;\n    renderSessions();\n    const p = currentProject();\n    if (p) {\n      $(\"kc-title\").textContent = p.name;\n      $(\"kc-path\").textContent = p.path;\n    }\n  }\n\n  async function loadSessions() {\n    await refreshSessionList();\n    showChat(true);\n    if (kc.sessionId) await loadTranscript();\n    else $(\"kc-trace\").innerHTML = \"\";\n  }\n\n  /** Replay a session so switching back shows what happened, rather than an\n   *  empty pane implying nothing did. */\n  async function loadTranscript() {\n    $(\"kc-trace\").innerHTML = \"\";\n    try {\n      const j = await api(`/core/code/projects/${encodeURIComponent(kc.projectId)}/sessions/${encodeURIComponent(kc.sessionId)}`);\n      for (const t of j.session.turns || []) bubble(t.role === \"user\" ? \"You\" : \"Koinos Code\", t.content);\n    } catch {\n      /* a session that vanished shows empty */\n    }\n  }\n\n  async function selectProject(id) {\n    if (kc.runController) return status(\"Stop the current task before changing conversations.\");\n    kc.projectId = id;\n    kc.sessionId = null;\n    kc.sessions = [];\n    renderProjects();\n    status(\"\");\n    startError(\"\");\n    try {\n      await loadSessions();\n      await renderGit();\n      renderToolsSummary();\n      renderModelPick();\n      await loadCommands();\n      $(\"kc-tools-panel\").hidden = true;\n      $(\"kc-cmd-hints\").hidden = true;\n    } catch (e) {\n      status(e.message);\n    }\n  }\n\n  async function selectSession(id) {\n    if (kc.runController) return status(\"Stop the current task before changing conversations.\");\n    kc.sessionId = id;\n    renderSessions();\n    await loadTranscript();\n    status(\"\");\n  }\n\n  // ----------------------------------------------------------- new / pick\n\n  $(\"btn-kc-new\").addEventListener(\"click\", () => {\n    // \"New chat\" from inside a project starts a fresh session there; from\n    // nowhere it goes back to the start screen so a folder can be chosen.\n    if (kc.projectId) {\n      newSession();\n    } else {\n      kc.projectId = null;\n      renderProjects();\n      showChat(false);\n      closePanels();\n    }\n  });\n\n  async function newSession() {\n    if (kc.runController) return status(\"Stop the current task before changing conversations.\");\n    try {\n      const j = await api(`/core/code/projects/${encodeURIComponent(kc.projectId)}/sessions`, { method: \"POST\", body: \"{}\" });\n      kc.sessionId = j.session.id;\n      await refreshSessionList();\n      $(\"kc-trace\").innerHTML = \"\";\n      showChat(true);\n      status(\"\");\n      $(\"kc-task\").focus();\n    } catch (e) {\n      status(e.message);\n    }\n  }\n\n  function closePanels() {\n    $(\"kc-browse\").hidden = true;\n    $(\"kc-clone\").hidden = true;\n    startError(\"\");\n  }\n\n  /** Add a folder as a project and go straight into it — choosing a folder\n   *  IS the intent to work in it, so it should not need a second click. */\n  async function useFolder(dir, name = \"\") {\n    try {\n      const j = await api(\"/core/code/projects\", { method: \"POST\", body: JSON.stringify({ dir, name }) });\n      kc.projectId = j.project.id;\n      kc.sessionId = null;\n      closePanels();\n      await loadProjects();\n      await renderGit();\n      $(\"kc-task\").focus();\n    } catch (e) {\n      startError(e.message);\n    }\n  }\n\n  $(\"btn-kc-pick\").addEventListener(\"click\", async () => {\n    startError(\"\");\n    // The app shell's NATIVE picker is the right experience and returns a real\n    // on-disk path. The served UI has no such dialog, so it browses in-app.\n    if (nativePicker()) {\n      const dir = await window.koinosShell.pickFolder(\"Choose a project folder\");\n      if (dir) return useFolder(dir);\n      return;\n    }\n    kc.browseFor = \"project\";\n    $(\"kc-clone\").hidden = true;\n    $(\"kc-browse\").hidden = false;\n    await browse(\"\");\n  });\n\n  // ------------------------------------------------------------- browsing\n\n  async function browse(dir) {\n    const seq = ++kc.browseSeq;\n    try {\n      const j = await api(\"/core/code/browse\", { method: \"POST\", body: JSON.stringify({ dir }) });\n      // A person can paste a path while the initial directory request is\n      // still in flight. Never let that older response replace the newer\n      // selection when the requests complete out of order.\n      if (seq !== kc.browseSeq) return;\n      kc.browsePath = j.path || \"\";\n      $(\"kc-browse-path\").value = kc.browsePath;\n      KaiI18n.setText($(\"kc-browse-here\"), kc.browsePath ? `Selected: ${kc.browsePath}` : \"Pick a starting point\");\n      $(\"btn-kc-browse-use\").disabled = !kc.browsePath;\n      const host = $(\"kc-browse-list\");\n      host.innerHTML = \"\";\n      if (j.parent) {\n        const up = document.createElement(\"button\");\n        up.className = \"kc-browse-item up\";\n        KaiI18n.setText(up, \"⬆ up a level\");\n        up.addEventListener(\"click\", () => browse(j.parent));\n        host.appendChild(up);\n      }\n      for (const e of j.entries || []) {\n        const b = document.createElement(\"button\");\n        b.className = \"kc-browse-item\";\n        b.textContent = j.start ? e.name : `📁 ${e.name}`;\n        b.title = e.path;\n        b.addEventListener(\"click\", () => browse(e.path));\n        host.appendChild(b);\n      }\n      if (!j.start && !(j.entries || []).length) {\n        const empty = document.createElement(\"div\");\n        empty.className = \"kc-browse-item up\";\n        KaiI18n.setText(empty, \"(no folders in here — you can still use it)\");\n        host.appendChild(empty);\n      }\n      startError(\"\");\n    } catch (e) {\n      if (seq === kc.browseSeq) startError(e.message);\n    }\n  }\n\n  $(\"btn-kc-browse-go\").addEventListener(\"click\", () => browse($(\"kc-browse-path\").value.trim()));\n  $(\"kc-browse-path\").addEventListener(\"input\", () => { kc.browseSeq += 1; });\n  $(\"kc-browse-path\").addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\") browse($(\"kc-browse-path\").value.trim());\n  });\n  $(\"btn-kc-browse-close\").addEventListener(\"click\", closePanels);\n  $(\"btn-kc-browse-use\").addEventListener(\"click\", () => {\n    if (!kc.browsePath) return;\n    if (kc.browseFor === \"clone\") {\n      setCloneParent(kc.browsePath);\n      $(\"kc-browse\").hidden = true;\n      $(\"kc-clone\").hidden = false;\n      return;\n    }\n    useFolder(kc.browsePath);\n  });\n\n  // --------------------------------------------------------------- cloning\n\n  $(\"btn-kc-clone\").addEventListener(\"click\", async () => {\n    startError(\"\");\n    $(\"kc-browse\").hidden = true;\n    $(\"kc-clone\").hidden = false;\n    $(\"kc-clone-status\").textContent = \"\";\n    $(\"kc-clone-parent-row\").hidden = nativePicker();\n    setCloneParent($(\"kc-clone-parent\").value.trim());\n    // If an account is connected, offer what it can actually see rather than\n    // making someone remember exact repository names.\n    try {\n      const g = kc.gh || (await api(\"/core/code/github\"));\n      if (g.connected) {\n        const j = await api(\"/core/code/github/repos\");\n        const host = $(\"kc-repo-list\");\n        host.innerHTML = \"\";\n        for (const r of j.repos || []) {\n          const b = document.createElement(\"button\");\n          b.className = \"kc-browse-item\";\n          KaiI18n.setText(b, KaiI18n.message`${r.private ? \"🔒\" : \"📦\"} ${r.full}`);\n          b.title = r.description || r.full;\n          b.addEventListener(\"click\", () => {\n            $(\"kc-clone-repo\").value = r.full;\n          });\n          host.appendChild(b);\n        }\n        host.hidden = !(j.repos || []).length;\n      }\n    } catch {\n      /* listing is a convenience; typing a name always works */\n    }\n  });\n\n  $(\"btn-kc-clone-close\").addEventListener(\"click\", closePanels);\n\n  /** The destination, wherever it came from — typed, browsed, or picked. */\n  function setCloneParent(dir) {\n    $(\"kc-clone-parent\").value = dir || \"\";\n    $(\"kc-clone-parent-label\").textContent = dir || \"no folder chosen yet\";\n  }\n\n  // Field request: \"for the github repo copy I want the folder selection to be\n  // a window selection as well like the first one.\" So the button opens the\n  // SAME native window as \"Select a folder\", and where that window exists the\n  // typed-path row is not shown at all — one way to answer, not two.\n  $(\"btn-kc-clone-pick\").addEventListener(\"click\", async () => {\n    if (nativePicker()) {\n      const dir = await window.koinosShell.pickFolder(\"Where should the repository go?\");\n      if (dir) setCloneParent(dir);\n      return;\n    }\n    kc.browseFor = \"clone\";\n    $(\"kc-clone\").hidden = true;\n    $(\"kc-browse\").hidden = false;\n    await browse(\"\");\n  });\n  $(\"kc-clone-parent\").addEventListener(\"input\", () => setCloneParent($(\"kc-clone-parent\").value.trim()));\n\n  $(\"btn-kc-clone-go\").addEventListener(\"click\", async () => {\n    const repo = $(\"kc-clone-repo\").value.trim();\n    const parentDir = $(\"kc-clone-parent\").value.trim();\n    if (!repo) return startError(\"Name the repository — owner/name, or its GitHub URL.\");\n    if (!parentDir) return startError(\"Choose a folder to clone into.\");\n    $(\"btn-kc-clone-go\").disabled = true;\n    KaiI18n.setText($(\"kc-clone-status\"), \"cloning…\");\n    startError(\"\");\n    try {\n      // Core clones AND registers the project; going straight into it is the\n      // whole point of the flow.\n      const j = await api(\"/core/code/github/clone\", { method: \"POST\", body: JSON.stringify({ repo, parentDir }) });\n      kc.projectId = j.project.id;\n      kc.sessionId = null;\n      closePanels();\n      await loadProjects();\n      await renderGit();\n      status(`cloned ${j.repo}`);\n      $(\"kc-task\").focus();\n    } catch (e) {\n      startError(e.message);\n      $(\"kc-clone-status\").textContent = \"\";\n    } finally {\n      $(\"btn-kc-clone-go\").disabled = false;\n    }\n  });\n\n  // ---------------------------------------------------------------- GitHub\n\n  async function renderGitHub() {\n    try {\n      const g = await api(\"/core/code/github\");\n      kc.gh = g;\n      const el = $(\"kc-gh-status\");\n      if (!g.git?.ok) {\n        // Far more use than a clone that fails for an unexplained reason.\n        el.textContent = g.git?.error || \"git is not available on this machine\";\n        $(\"btn-kc-gh\").hidden = true;\n        return;\n      }\n      $(\"btn-kc-gh\").hidden = false;\n      KaiI18n.setText($(\"btn-kc-gh\"), g.connected ? \"Disconnect GitHub\" : \"Connect GitHub\");\n      KaiI18n.setText(el, g.connected ? `${g.login} (${g.tokenTail})` : \"Not connected\");\n    } catch (e) {\n      $(\"kc-gh-status\").textContent = e.message;\n    }\n  }\n\n  $(\"btn-kc-gh\").addEventListener(\"click\", async () => {\n    if (kc.gh?.connected) {\n      try {\n        await api(\"/core/code/github/disconnect\", { method: \"POST\", body: \"{}\" });\n        await renderGitHub();\n      } catch (e) {\n        startError(e.message);\n      }\n      return;\n    }\n    // Inline, because prompt() is dead in Electron. The token is typed into a\n    // password field, sent once, and never rendered back.\n    showChat(false);\n    closePanels();\n    const panel = $(\"kc-clone\");\n    panel.hidden = false;\n    $(\"kc-clone-status\").textContent = \"\";\n    $(\"kc-repo-list\").hidden = true;\n    if (!$(\"kc-token-row\")) {\n      const row = document.createElement(\"div\");\n      row.id = \"kc-token-row\";\n      row.className = \"form-row\";\n      const input = document.createElement(\"input\");\n      input.type = \"password\";\n      input.id = \"kc-token\";\n      input.placeholder = \"GitHub personal access token\";\n      input.autocomplete = \"off\";\n      const save = document.createElement(\"button\");\n      save.className = \"primary small\";\n      KaiI18n.setText(save, \"Connect\");\n      const connect = async () => {\n        const token = input.value.trim();\n        if (!token) return;\n        save.disabled = true;\n        try {\n          await api(\"/core/code/github/connect\", { method: \"POST\", body: JSON.stringify({ token }) });\n          input.value = \"\";\n          row.remove();\n          closePanels();\n          await renderGitHub();\n        } catch (e) {\n          startError(e.message);\n        } finally {\n          save.disabled = false;\n        }\n      };\n      save.addEventListener(\"click\", connect);\n      input.addEventListener(\"keydown\", (e) => {\n        if (e.key === \"Enter\") connect();\n      });\n      row.append(input, save);\n      panel.insertBefore(row, panel.querySelector(\".form-row\"));\n      const note = document.createElement(\"div\");\n      note.className = \"kc-choice-sub\";\n      KaiI18n.setText(note, \"Stored on this machine only, never shown again, and sent nowhere but github.com.\");\n      panel.insertBefore(note, row.nextSibling);\n    }\n    $(\"kc-token\")?.focus();\n  });\n\n  // ------------------------------------------------------------------ git\n\n  async function renderGit() {\n    const p = currentProject();\n    if (!p || p.missing) {\n      $(\"btn-kc-git\").hidden = true;\n      $(\"kc-branch\").hidden = true;\n      $(\"kc-git-bar\").hidden = true;\n      return;\n    }\n    try {\n      const j = await api(\"/core/code/github/status\", { method: \"POST\", body: JSON.stringify({ projectId: p.id }) });\n      const st = j.status;\n      if (!st.repo) {\n        $(\"btn-kc-git\").hidden = true;\n        $(\"kc-branch\").hidden = true;\n        return;\n      }\n      $(\"btn-kc-git\").hidden = false;\n      const bits = [st.branch];\n      if (st.dirty) bits.push(`${st.files.length} changed`);\n      if (st.ahead) bits.push(`${st.ahead}↑`);\n      if (st.behind) bits.push(`${st.behind}↓`);\n      $(\"kc-branch\").textContent = bits.join(\" · \");\n      $(\"kc-branch\").hidden = false;\n    } catch {\n      $(\"btn-kc-git\").hidden = true;\n      $(\"kc-branch\").hidden = true;\n    }\n  }\n\n  $(\"btn-kc-git\").addEventListener(\"click\", () => {\n    $(\"kc-git-bar\").hidden = !$(\"kc-git-bar\").hidden;\n    if (!$(\"kc-git-bar\").hidden) $(\"kc-git-input\").focus();\n  });\n\n  async function gitAction(pathname, body, working) {\n    const p = currentProject();\n    if (!p) return null;\n    $(\"kc-git-status\").textContent = working;\n    try {\n      const j = await api(pathname, { method: \"POST\", body: JSON.stringify({ projectId: p.id, ...body }) });\n      await renderGit();\n      return j;\n    } catch (e) {\n      $(\"kc-git-status\").textContent = e.message;\n      return null;\n    }\n  }\n\n  const gitInput = () => $(\"kc-git-input\").value.trim();\n  const clearGitInput = () => { $(\"kc-git-input\").value = \"\"; };\n\n  $(\"btn-kc-branch\").addEventListener(\"click\", async () => {\n    const name = gitInput();\n    if (!name) return (KaiI18n.setText($(\"kc-git-status\"), \"Type a branch name first.\"));\n    if (await gitAction(\"/core/code/github/branch\", { name }, \"switching branch…\")) {\n      KaiI18n.setText($(\"kc-git-status\"), KaiI18n.message`on ${name}`);\n      clearGitInput();\n    }\n  });\n\n  $(\"btn-kc-commit\").addEventListener(\"click\", async () => {\n    const message = gitInput();\n    if (!message) return (KaiI18n.setText($(\"kc-git-status\"), \"Type a commit message first.\"));\n    if (await gitAction(\"/core/code/github/commit\", { message }, \"committing…\")) {\n      KaiI18n.setText($(\"kc-git-status\"), \"committed\");\n      clearGitInput();\n    }\n  });\n\n  $(\"btn-kc-push\").addEventListener(\"click\", async () => {\n    const j = await gitAction(\"/core/code/github/push\", {}, \"pushing…\");\n    if (j) KaiI18n.setText($(\"kc-git-status\"), KaiI18n.message`pushed ${j.branch}`);\n  });\n\n  $(\"btn-kc-pr\").addEventListener(\"click\", async () => {\n    const title = gitInput();\n    if (!title) return (KaiI18n.setText($(\"kc-git-status\"), \"Type a pull request title first.\"));\n    const j = await gitAction(\"/core/code/github/pr\", { title }, \"opening pull request…\");\n    if (j) {\n      KaiI18n.setText($(\"kc-git-status\"), KaiI18n.message`opened #${j.pr.number}`);\n      clearGitInput();\n      const a = document.createElement(\"a\");\n      a.href = j.pr.url;\n      a.target = \"_blank\";\n      a.rel = \"noreferrer\";\n      KaiI18n.setText(a, KaiI18n.message`Pull request #${j.pr.number}`);\n      const div = document.createElement(\"div\");\n      div.className = \"pg-tool\";\n      div.appendChild(a);\n      $(\"kc-trace\").appendChild(div);\n      div.scrollIntoView({ block: \"nearest\" });\n    }\n  });\n\n  // -------------------------------------------------------- rename / forget\n\n  $(\"btn-kc-rename\").addEventListener(\"click\", () => {\n    const p = currentProject();\n    if (!p) return;\n    $(\"kc-rename-bar\").hidden = false;\n    $(\"kc-rename-input\").value = p.name;\n    $(\"kc-rename-input\").focus();\n  });\n  $(\"btn-kc-rename-cancel\").addEventListener(\"click\", () => { $(\"kc-rename-bar\").hidden = true; });\n  $(\"btn-kc-rename-save\").addEventListener(\"click\", async () => {\n    const p = currentProject();\n    const name = $(\"kc-rename-input\").value.trim();\n    if (!p || !name) return;\n    try {\n      await api(`/core/code/projects/${encodeURIComponent(p.id)}`, { method: \"PATCH\", body: JSON.stringify({ name }) });\n      $(\"kc-rename-bar\").hidden = true;\n      await loadProjects();\n    } catch (e) {\n      status(e.message);\n    }\n  });\n  $(\"kc-rename-input\").addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\") $(\"btn-kc-rename-save\").click();\n    if (e.key === \"Escape\") $(\"btn-kc-rename-cancel\").click();\n  });\n\n  $(\"btn-kc-forget\").addEventListener(\"click\", async () => {\n    const p = currentProject();\n    if (!p) return;\n    // Await Core’s styled confirmation before changing the project list.\n    if (!await window.kai.dialogs.confirm(`Remove \"${p.name}\" from this list?\\n\\nThe folder and its files are left exactly as they are.`)) return;\n    try {\n      await api(`/core/code/projects/${encodeURIComponent(p.id)}`, { method: \"DELETE\" });\n      kc.projectId = null;\n      kc.sessionId = null;\n      await loadProjects();\n    } catch (e) {\n      status(e.message);\n    }\n  });\n\n  // ------------------------------------------------------------------ runs\n\n  async function readSse(resp, onEvent) {\n    const reader = resp.body.getReader();\n    const decoder = new TextDecoder();\n    let buf = \"\";\n    for (;;) {\n      const { done, value } = await reader.read();\n      if (done) break;\n      buf += decoder.decode(value, { stream: true });\n      const parts = buf.split(\"\\n\\n\");\n      buf = parts.pop() || \"\";\n      for (const part of parts) {\n        const line = part.split(\"\\n\").find((l) => l.startsWith(\"data: \"));\n        if (!line) continue;\n        try {\n          onEvent(JSON.parse(line.slice(6)));\n        } catch {\n          /* a malformed frame is skipped, never fatal */\n        }\n      }\n    }\n  }\n\n  function send() {\n    if (kc.runController) return;\n    const p = currentProject();\n    if (!p) return status(\"Choose a folder first.\");\n    if (p.missing) return status(\"That folder no longer exists — forget the project, or put the folder back.\");\n    const task = $(\"kc-task\").value.trim();\n    if (!task) return;\n    bubble(\"You\", task);\n    $(\"kc-task\").value = \"\";\n    $(\"kc-task\").style.height = \"\";\n    $(\"kc-cmd-hints\").hidden = true;\n    // \"Plan first\" makes the FIRST pass read-only: it looks, proposes, and\n    // waits. Approving the plan runs the same task for real.\n    return run(task, { mode: $(\"kc-plan\").checked ? \"plan\" : \"act\" });\n  }\n\n  async function run(task, { mode = \"act\", plan = \"\" } = {}) {\n    const p = currentProject();\n    if (!p || kc.runController) return;\n    const controller = new AbortController();\n    kc.runController = controller;\n    $(\"btn-kc-run\").disabled = true;\n    $(\"btn-kc-stop\").hidden = false;\n    status(\"Opening the project…\");\n    try {\n      const resp = await fetch(\"/core/code/run\", {\n        signal: controller.signal,\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({\n          projectId: p.id,\n          sessionId: kc.sessionId || \"\",\n          task,\n          model: chosenModel(),\n          mode,\n          plan,\n          tools: allowedTools(),\n        }),\n      });\n      if (!resp.ok || !resp.body) {\n        const j = await resp.json().catch(() => ({}));\n        throw new Error(j.error || `Koinos Code answered ${resp.status}`);\n      }\n      let done = null;\n      await readSse(resp, (ev) => {\n        if (ev.session) kc.sessionId = ev.session.sessionId;\n        const t = ev.trace;\n        if (t?.type === \"start\") kc.runId = t.runId;\n        if (t?.type === \"phase\") status(t.text);\n        if (t?.type === \"tool\") { status(`Using ${t.name}…`); trace(`» ${t.name} ${t.args}`); }\n        if (t?.type === \"obs\") trace(`  ${t.text}`);\n        if (t?.type === \"note\") trace(t.text);\n        if (t?.type === \"approval-request\") {\n          approvalCard(t);\n          status(\"waiting for your approval…\");\n        }\n        if (ev.done) done = ev;\n      });\n      if (!done) throw new Error(\"the run ended without a result\");\n      if (done.error) throw new Error(done.error);\n      if (done.reason === \"planned\") {\n        // A plan is a proposal, not a turn: it is not written to the session\n        // and nothing has happened on disk.\n        if (done.answer) planCard(done.answer, task);\n        status(\"plan ready — approve it to make the changes\");\n        return;\n      }\n      if (done.answer) bubble(\"Koinos Code\", done.answer);\n      status(\n        done.reason === \"budget\"\n          ? \"step budget exhausted — the task may be incomplete\"\n          : done.reason === \"stopped\"\n            ? \"stopped\"\n            : `done — ${done.steps} tool step${done.steps === 1 ? \"\" : \"s\"}`\n      );\n      await refreshSessionList();\n      await renderGit();\n    } catch (e) {\n      status(controller.signal.aborted ? \"Stopped. No further actions will run.\" : e.message);\n    } finally {\n      kc.runController = null;\n      $(\"btn-kc-run\").disabled = false;\n      $(\"btn-kc-stop\").hidden = true;\n      kc.runId = null;\n    }\n  }\n\n  $(\"btn-kc-run\").addEventListener(\"click\", send);\n  $(\"btn-kc-stop\").addEventListener(\"click\", async () => {\n    kc.runController?.abort();\n    if (!kc.runId) return;\n    await fetch(\"/core/code/stop\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ runId: kc.runId }),\n    }).catch(() => {});\n  });\n\n  // Enter sends, Shift+Enter is a newline — the composer convention people\n  // already have in their fingers. The box grows with the text.\n  $(\"kc-task\").addEventListener(\"keydown\", (e) => {\n    if (e.key === \"Enter\" && !e.shiftKey) {\n      e.preventDefault();\n      send();\n    }\n  });\n  $(\"kc-task\").addEventListener(\"input\", (e) => {\n    const el = e.target;\n    el.style.height = \"auto\";\n    el.style.height = `${Math.min(el.scrollHeight, 180)}px`;\n    renderCommandHints();\n  });\n\n  // ------------------------------------------------------------- commands\n\n  /*\n   * A project's own slash commands, listed when someone types \"/\". They are\n   * prompt templates living in .koinos/commands/*.md — expanded by Core, so\n   * the API behaves identically.\n   */\n  async function loadCommands() {\n    if (!kc.projectId) return;\n    try {\n      const j = await api(\"/core/code/commands\", { method: \"POST\", body: JSON.stringify({ projectId: kc.projectId }) });\n      kc.commands = j.commands || [];\n      kc.commandsDir = j.dir || \".koinos/commands\";\n    } catch {\n      kc.commands = [];\n    }\n  }\n\n  function renderCommandHints() {\n    const host = $(\"kc-cmd-hints\");\n    const text = $(\"kc-task\").value;\n    // Only while typing the command itself — it must not sit in the way once\n    // there are arguments.\n    const m = text.match(/^\\/([A-Za-z0-9_-]*)$/);\n    if (!m) {\n      host.hidden = true;\n      return;\n    }\n    const q = m[1].toLowerCase();\n    const hits = (kc.commands || []).filter((c) => c.name.startsWith(q));\n    host.innerHTML = \"\";\n    if (!hits.length) {\n      const none = document.createElement(\"div\");\n      none.className = \"kc-browse-item up\";\n      KaiI18n.setText(none, (kc.commands || []).length\n        ? \"no command matches\"\n        : `no commands yet — add one as ${kc.commandsDir || \".koinos/commands\"}/name.md`);\n      host.appendChild(none);\n      host.hidden = false;\n      return;\n    }\n    for (const c of hits) {\n      const b = document.createElement(\"button\");\n      b.className = \"kc-browse-item\";\n      KaiI18n.setText(b, KaiI18n.message`/${c.name}${c.description ? ` — ${c.description}` : \"\"}`);\n      b.addEventListener(\"click\", () => {\n        $(\"kc-task\").value = `/${c.name} `;\n        host.hidden = true;\n        $(\"kc-task\").focus();\n      });\n      host.appendChild(b);\n    }\n    host.hidden = false;\n  }\n\n  // ---------------------------------------------------------------- tools\n\n  function allowedTools() {\n    return kc.toolsByProject[kc.projectId] || [];\n  }\n\n  function renderToolsSummary() {\n    const n = allowedTools().length;\n    $(\"kc-tools-summary\").textContent = n ? `${n} tool${n === 1 ? \"\" : \"s\"} lent` : \"\";\n  }\n\n  async function loadTools() {\n    try {\n      const j = await api(\"/core/code/tools\");\n      kc.allTools = j.tools || [];\n      kc.maxTools = j.max || 8;\n    } catch {\n      kc.allTools = [];\n    }\n  }\n\n  function renderToolsPanel() {\n    const host = $(\"kc-tools-list\");\n    host.innerHTML = \"\";\n    const chosen = new Set(allowedTools());\n    KaiI18n.setText($(\"kc-tools-note\"), kc.allTools.length\n      ? `Off by default. Pick up to ${kc.maxTools} — a small local model cannot hold many tool descriptions and still have room for the task. Anything marked \"asks first\" still shows you a card before it runs.`\n      : \"No tools are available right now. Add an MCP server under Tools, or switch off Local-Only if the tools you want reach the internet.\");\n    for (const t of kc.allTools) {\n      const row = document.createElement(\"label\");\n      row.className = \"kc-tool-row\";\n      const cb = document.createElement(\"input\");\n      cb.type = \"checkbox\";\n      cb.checked = chosen.has(t.name);\n      cb.addEventListener(\"change\", () => {\n        const now = new Set(allowedTools());\n        if (cb.checked) {\n          if (now.size >= kc.maxTools) {\n            cb.checked = false;\n            KaiI18n.setText($(\"kc-tools-note\"), KaiI18n.message`That is the limit (${kc.maxTools}). Uncheck something first.`);\n            return;\n          }\n          now.add(t.name);\n        } else {\n          now.delete(t.name);\n        }\n        kc.toolsByProject[kc.projectId] = [...now];\n        try {\n          localStorage.setItem(\"kai-code-tools\", JSON.stringify(kc.toolsByProject));\n        } catch {\n          /* storage off — the choice just does not outlive the session */\n        }\n        renderToolsSummary();\n      });\n      const text = document.createElement(\"span\");\n      const name = document.createElement(\"b\");\n      name.textContent = t.name;\n      const sub = document.createElement(\"span\");\n      sub.className = \"kc-sub\";\n      KaiI18n.setText(sub, KaiI18n.message`${t.description || \"\"}${t.sensitive ? \" — asks first\" : \"\"}${t.egress ? \" · leaves this machine\" : \"\"}`);\n      text.append(name, sub);\n      row.append(cb, text);\n      host.appendChild(row);\n    }\n  }\n\n  $(\"btn-kc-tools\").addEventListener(\"click\", async () => {\n    const panel = $(\"kc-tools-panel\");\n    if (!panel.hidden) {\n      panel.hidden = true;\n      return;\n    }\n    await loadTools();\n    renderToolsPanel();\n    panel.hidden = false;\n  });\n  $(\"btn-kc-tools-close\").addEventListener(\"click\", () => { $(\"kc-tools-panel\").hidden = true; });\n\n  // ------------------------------------------------------------ the model\n\n  /*\n   * Which model does the work.\n   *\n   * Field question: \"what model does this use? There should probably be a\n   * model selector just like the chat.\" It was using the Chat model silently —\n   * right answer, invisible. Now it is a box, and the choice is remembered per\n   * project because a big repository and a scratch folder do not want the same\n   * model.\n   *\n   * LOCAL MODELS ONLY, deliberately, and unlike Chat: the coding agent reads\n   * your project's files into every prompt it sends. Routing that to volunteer\n   * machines on the Koinos Network would put private source on other people's\n   * computers as a side effect of picking a faster box — a decision nobody\n   * would expect from a model dropdown. Chat offers the network because the\n   * person types what goes into it; here the agent decides, so it stays home.\n   */\n  async function loadModels() {\n    try {\n      const r = await fetch(\"/core/models\", { headers: { \"content-type\": \"application/json\" } });\n      const j = await r.json();\n      kc.models = (j.aliases || [])\n        .filter((a) => a.status === \"ready\")\n        .map((a) => ({ v: a.alias, label: String(a.label || a.alias).split(\" (\")[0] }));\n    } catch {\n      kc.models = []; // Core unreachable: fall through to \"app default\"\n    }\n    renderModelPick();\n  }\n\n  function renderModelPick() {\n    const pick = $(\"kc-model\");\n    const chosen = currentProject()?.model || \"\";\n    const appDefault = kc.models.find((m) => m.v === (typeof state === \"object\" ? state.alias : null));\n    const options = [\n      { v: \"\", label: appDefault ? `App default — ${appDefault.label}` : \"App default\" },\n      ...kc.models,\n    ];\n    const sig = options.map((o) => o.v).join(\",\");\n    if (pick.dataset.sig !== sig) {\n      pick.innerHTML = \"\";\n      for (const o of options) {\n        const el = document.createElement(\"option\");\n        el.value = o.v;\n        el.textContent = o.label;\n        pick.appendChild(el);\n      }\n      pick.dataset.sig = sig;\n    }\n    // A pinned model that is no longer on the machine must not silently\n    // vanish into \"App default\" — name it, so the mismatch is visible.\n    if (chosen && !options.some((o) => o.v === chosen)) {\n      const el = document.createElement(\"option\");\n      el.value = chosen;\n      KaiI18n.setText(el, KaiI18n.message`${chosen} — not installed`);\n      pick.appendChild(el);\n      pick.dataset.sig = \"\";\n    }\n    pick.value = chosen;\n  }\n\n  $(\"kc-model\").addEventListener(\"change\", async () => {\n    const p = currentProject();\n    if (!p) return;\n    const model = $(\"kc-model\").value;\n    try {\n      const j = await api(`/core/code/projects/${encodeURIComponent(p.id)}`, {\n        method: \"PATCH\",\n        body: JSON.stringify({ model }),\n      });\n      p.model = j.project.model || \"\";\n      status(model ? `using ${$(\"kc-model\").selectedOptions[0]?.textContent || model}` : \"using the app's model\");\n    } catch (e) {\n      status(e.message);\n      renderModelPick(); // put the box back to what is actually stored\n    }\n  });\n\n  /** What this run should ask for: the project's pin, else the app's model. */\n  function chosenModel() {\n    return $(\"kc-model\").value || (typeof state === \"object\" && state.alias) || \"\";\n  }\n\n  async function render() {\n    try {\n      try {\n        kc.toolsByProject = JSON.parse(localStorage.getItem(\"kai-code-tools\") || \"{}\") || {};\n      } catch {\n        kc.toolsByProject = {};\n      }\n      await loadProjects();\n      await loadModels();\n      await renderGitHub();\n      renderToolsSummary();\n      if (kc.projectId) await renderGit();\n    } catch (e) {\n      startError(e.message);\n    }\n  }\n\n  window.KaiCode = { render };\n})();\n","boot.js":"\"use strict\";\n(async () => {\n  const keys = [\"kai-code-tools\", \"kai-code-dir\", \"kai-interface-language\"], originalSet = Storage.prototype.setItem;\n  let saved = await call(\"storage.get\", {key:\"workspace-preferences\"});\n  if (!saved || typeof saved !== \"object\" || Array.isArray(saved)) saved = await call(\"desktop.preferencesRead\", {keys});\n  const preferences = Object.fromEntries(keys.filter(key => typeof saved?.[key] === \"string\").map(key => [key,saved[key]]));\n  for (const [key,value] of Object.entries(preferences)) originalSet.call(localStorage,key,value);\n  let pending = Promise.resolve();\n  Storage.prototype.setItem = function(key,value) {\n    originalSet.call(this,key,value);\n    if (this === localStorage && keys.includes(key)) { preferences[key]=String(value);const snapshot={...preferences};pending=pending.catch(()=>{}).then(()=>call(\"storage.set\",{key:\"workspace-preferences\",value:snapshot})).catch(error=>{const el=document.getElementById(\"kc-status\");if(el)el.textContent=\"Could not save workspace preference: \"+error.message;}); }\n  };\n  if (preferences[\"kai-interface-language\"]) KaiI18n.setLanguage(preferences[\"kai-interface-language\"]);\n  await call(\"storage.set\", {key:\"workspace-preferences\",value:preferences});\n  await window.KaiCode.render();\n})().catch(error => {const el=document.getElementById(\"kc-start-error\");el.textContent=error.message;el.hidden=false;});\n","brand-mark.svg":"<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 48 48\"><defs><linearGradient id=\"blue\" x2=\".8\" y2=\"1\"><stop stop-color=\"#03cefa\"/><stop offset=\"1\" stop-color=\"#0856f9\"/></linearGradient></defs><g fill=\"none\" stroke=\"url(#blue)\" stroke-width=\"11\" stroke-linecap=\"round\"><path d=\"M11 10v7M11 38V28L35 9M26 29l12 10\"/></g></svg>\n","bridge.js":"\"use strict\";\n// A transport adapter for the unchanged original workspace. Every operation\n// crosses its named, publisher-pinned broker; no renderer network access exists.\nconst $ = id => document.getElementById(id);\nconst state = { alias: \"\" };\nlet pickable = [];\nconst esc2 = value => String(value ?? \"\").replace(/[&<>\"']/g, c => ({\"&\":\"&amp;\",\"<\":\"&lt;\",\">\":\"&gt;\",'\"':\"&quot;\",\"'\":\"&#39;\"}[c]));\nconst call = (method, input) => window.kai.call(method, input);\nasync function pluginResponse(feature, result, signal) {\n  if (signal?.aborted) { if(result.streamId) await call(feature + \".cancel\", {streamId: result.streamId}).catch(()=>{}); throw new DOMException(\"Stopped\", \"AbortError\"); }\n  if (!result.streamId) return new Response(typeof result.body === \"string\" ? result.body : JSON.stringify(result.body ?? {}), {status: result.status || 200, headers: result.headers || {\"content-type\":\"application/json\"}});\n  let stopped = false, controller;\n  const cancel = async () => { if (stopped) return; stopped = true; signal?.removeEventListener(\"abort\", abort); await call(feature + \".cancel\", {streamId:result.streamId}).catch(()=>{}); };\n  const abort = () => { void cancel(); try { controller?.error(new DOMException(\"Stopped\", \"AbortError\")); } catch {} };\n  const body = new ReadableStream({\n    start(c) { controller = c; signal?.addEventListener(\"abort\", abort, {once:true}); if(signal?.aborted) abort(); },\n    async pull(c) {\n      try {\n        // Keep satisfying this read across empty native polls. Returning with\n        // no chunk can leave ReadableStream waiting forever for another pull.\n        while (!stopped) {\n          const next=await call(feature+\".poll\",{streamId:result.streamId});\n          if(stopped)return;\n          for(const text of next.chunks||[])c.enqueue(new TextEncoder().encode(text));\n          if(next.error)throw Error(next.error);\n          if(next.done){stopped=true;signal?.removeEventListener(\"abort\",abort);c.close();return;}\n          if(next.chunks?.length)return;\n          await new Promise(resolve=>setTimeout(resolve,150));\n        }\n      } catch(error){if(!stopped){await cancel();c.error(error);}}\n    },\n    cancel\n  });\n  return new Response(body,{status:result.status||200,headers:result.headers||{\"content-type\":\"text/event-stream\"}});\n}\nasync function* sseDeltas(body) {\n  const decoder=new TextDecoder();let buffer=\"\";\n  for await(const chunk of body){buffer+=decoder.decode(chunk,{stream:true});let end;\n    while((end=buffer.indexOf(\"\\n\\n\"))>=0){const frame=buffer.slice(0,end);buffer=buffer.slice(end+2);\n      for(const line of frame.split(\"\\n\")){if(!line.startsWith(\"data: \"))continue;const value=line.slice(6).trim();if(value===\"[DONE]\")return;\n        try{const event=JSON.parse(value);if(event.error)throw Error(event.error.message||event.error);yield{content:event.choices?.[0]?.delta?.content||\"\",model:event.model||null};}catch(error){if(error.name!==\"SyntaxError\")throw error;}\n      }\n    }\n  }\n}\n\nwindow.fetch = async (path, options = {}) => {\n  if(typeof path!==\"string\"||!path.startsWith(\"/core/\"))throw Error(\"Only Koinos Code workspace requests are supported\");\n  options.signal?.throwIfAborted();\n  const body=options.body?JSON.parse(options.body):undefined;\n  const result=await call(\"code.request\",{path,method:options.method||\"GET\",body,stream:path===\"/core/code/run\"});\n  if (path === \"/core/models\" && result.body && typeof result.body === \"object\") {\n    const ready=(result.body.aliases||[]).filter(model=>model.status===\"ready\"), active=result.body.runtime?.activeAlias;\n    state.alias=ready.some(model=>model.alias===active)?active:ready.some(model=>model.alias===state.alias)?state.alias:ready[0]?.alias||\"\";\n  }\n  return pluginResponse(\"code\",result,options.signal);\n};\nwindow.koinosShell = { pickFolder: title => call(\"code.chooseFolder\", {title}) };\n","i18n.js":"/* Offline interface localization. Source text and user values stay separate. */\n(function (root, factory) {\n  const api = factory(root);\n  if (typeof module === 'object' && module.exports) module.exports = api;\n  else root.KaiI18n = api;\n})(typeof window === 'object' ? window : globalThis, function (root) {\n  'use strict';\n  const languages = [\n    { code: 'en', name: 'English' }, { code: 'es', name: 'Español' },\n    { code: 'pt-BR', name: 'Português (Brasil)' }, { code: 'fr', name: 'Français' },\n    { code: 'de', name: 'Deutsch' },\n  ];\n  const supported = new Set(languages.map(l => l.code));\n  const storageKey = 'kai-interface-language';\n  const normalize = value => {\n    if (typeof value !== 'string') return null;\n    const tag = value.trim().replace(/_/g, '-').toLowerCase();\n    if (/^pt(?:-|$)/.test(tag)) return 'pt-BR';\n    const base = tag.split('-')[0];\n    return supported.has(base) ? base : null;\n  };\n  const detect = preferences => {\n    for (const tag of Array.isArray(preferences) ? preferences : [preferences]) {\n      const locale = normalize(tag); if (locale) return locale;\n    }\n    return 'en';\n  };\n  let preference = null;\n  try { preference = normalize(root.localStorage?.getItem(storageKey)); } catch { /* restricted storage */ }\n  let locale = preference || detect(root.navigator?.languages || [root.navigator?.language]);\n  const descriptors = new Map();\n  const normalizeText = text => String(text).replace(/\\s+/g, ' ').trim();\n  const interpolate = (text, values = []) => text.replace(/\\{(\\d+)\\}/g, (match, n) => n < values.length ? String(values[n]) : match);\n  const translate = (source, values = [], lang = locale) => {\n    const key = normalizeText(source);\n    const table = root.KaiLocaleCatalogs?.[lang];\n    const translated = table && Object.hasOwn(table, key) ? table[key] : key;\n    return interpolate(translated, values);\n  };\n  const preserveSpace = (source, translated) => source.match(/^\\s*/)[0] + translated + source.match(/\\s*$/)[0];\n  const remember = (node, source, attr = null, values = []) => {\n    if (!normalizeText(source)) return;\n    let map = descriptors.get(node); if (!map) descriptors.set(node, map = new Map());\n    const entry = { source, values };\n    map.set(attr, entry);\n    apply(node, attr, entry);\n  };\n  const currentText = (node, attr) => attr ? node.getAttribute(attr) : node.nodeType === 3 ? node.data : node.textContent;\n  function apply(node, attr, entry) {\n    const text = preserveSpace(entry.source, translate(entry.source, entry.values));\n    if (attr) { if (node.getAttribute(attr) !== text) node.setAttribute(attr, text); }\n    else if (node.nodeType === 3) { if (node.data !== text) node.data = text; }\n    else if (node.textContent !== text) node.textContent = text;\n    entry.rendered = text;\n  }\n  function setText(node, source) {\n    if (!node) return;\n    // Only callers at interface-text sinks use this API. No DOM-wide matching\n    // of user messages, files, model output, names, keys or addresses.\n    if (source == null || source === '') { descriptors.get(node)?.delete(null); node.textContent = ''; return; }\n    if (source && typeof source === 'object' && Array.isArray(source.values)) remember(node, source.source, null, source.values);\n    else remember(node, String(source ?? ''));\n  }\n  function message(strings, ...values) {\n    return { source: strings.reduce((text, part, i) => text + part + (i < values.length ? `{${i}}` : ''), ''), values };\n  }\n  function setLanguage(value, { persist = false } = {}) {\n    const next = normalize(value);\n    if (!next) throw new Error('Unsupported interface language');\n    locale = next;\n    if (persist) {\n      preference = next;\n      try { root.localStorage?.setItem(storageKey, next); } catch { /* desktop IPC remains authoritative */ }\n    }\n    if (root.document) {\n      root.document.documentElement.lang = next;\n      root.document.documentElement.dir = 'ltr';\n      for (const [node, entries] of descriptors) {\n        if (!node.isConnected) { descriptors.delete(node); continue; }\n        for (const [attr, item] of entries) {\n          // A controller may have replaced a status since it was registered.\n          // Never resurrect stale status/error text when switching languages.\n          if (currentText(node, attr) !== item.rendered) { entries.delete(attr); continue; }\n          apply(node, attr, item);\n        }\n      }\n      root.document.dispatchEvent(new CustomEvent('kai:language-changed', { detail: { language: next } }));\n    }\n    return next;\n  }\n  const ignored = 'script,style,code,pre,textarea,svg,[translate=\"no\"],[data-i18n-ignore]';\n  function registerStatic(container) {\n    if (!root.document) return;\n    const walker = root.document.createTreeWalker(container, 4);\n    for (let node; (node = walker.nextNode());) {\n      if (!node.parentElement?.closest(ignored) && /[A-Za-z]/.test(node.data)) remember(node, node.data);\n    }\n    for (const el of container.querySelectorAll('[title],[placeholder],[aria-label],[data-chat-prompt]')) {\n      if (el.closest('[translate=\"no\"],[data-i18n-ignore]')) continue;\n      for (const attr of ['title', 'placeholder', 'aria-label', 'data-chat-prompt']) {\n        if (el.hasAttribute(attr)) remember(el, el.getAttribute(attr), attr);\n      }\n    }\n    for (const template of container.querySelectorAll('template')) {\n      // Templates are translated only after cloning, from explicit markers.\n      template.innerHTML = html(template.innerHTML);\n    }\n  }\n  function registerMarkers(container) {\n    if (!container || !root.document) return;\n    const nodes = container.nodeType === 1 ? [container, ...container.querySelectorAll('[data-i18n],[data-i18n-attrs]')] : [];\n    for (const el of nodes) {\n      if (el.hasAttribute('data-i18n')) remember(el, el.getAttribute('data-i18n'));\n      if (el.hasAttribute('data-i18n-attrs')) {\n        try { for (const [attr, source] of Object.entries(JSON.parse(el.getAttribute('data-i18n-attrs')))) remember(el, source, attr); } catch { /* malformed markup */ }\n      }\n    }\n    const walker = root.document.createTreeWalker(container, 128);\n    for (let node; (node = walker.nextNode());) {\n      if (!node.data.startsWith('kai-i18n:') || node.nextSibling?.nodeType !== 3) continue;\n      try { const { source, values } = JSON.parse(decodeURIComponent(node.data.slice(9))); remember(node.nextSibling, source, null, values); } catch { /* not a localization marker */ }\n    }\n  }\n  const escapeHTML = text => String(text).replace(/[&<>\"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' })[c]);\n  function html(strings, ...values) {\n    if (typeof strings === 'string') strings = [strings];\n    const source = strings.reduce((text, part, i) => text + part + (i < values.length ? `KAI_I18N_SLOT_${i}_END` : ''), '');\n    const replaceSlots = text => text.replace(/KAI_I18N_SLOT_(\\d+)_END/g, (_, i) => String(values[i] ?? ''));\n    if (!root.document) return replaceSlots(source);\n    const decode = text => { const t = root.document.createElement('template'); t.innerHTML = text; return t.content.textContent; };\n    const stack = [];\n    const result = source.replace(/<!--[\\s\\S]*?-->|<(?:[^>\"']|\"[^\"]*\"|'[^']*')*>|[^<]+|</g, token => {\n      if (token.startsWith('<!--')) return token;\n      if (token.startsWith('<')) {\n        const match = /^<(\\/?)([a-z][\\w-]*)/i.exec(token);\n        if (!match) return token;\n        const tag = match[2].toLowerCase();\n        if (match[1]) { const index = stack.lastIndexOf(tag); if (index >= 0) stack.splice(index); return token; }\n        if (!['input','br','hr','img','meta','link','source','wbr','area','embed','col'].includes(tag) && !token.endsWith('/>')) stack.push(tag);\n        const attrs = {};\n        token = token.replace(/\\b(title|placeholder|aria-label)=(\"[^\"]*\"|'[^']*')/g, (attribute, name, quoted) => {\n          const value = quoted.slice(1, -1);\n          if (/KAI_I18N_SLOT_\\d+_END/.test(value)) return attribute;\n          attrs[name] = decode(value); return name + '=\"' + escapeHTML(translate(attrs[name])) + '\"';\n        });\n        if (Object.keys(attrs).length) token = token.replace(/(\\/?>)$/, ' data-i18n-attrs=\"' + escapeHTML(JSON.stringify(attrs)) + '\"$1');\n        return token;\n      }\n      if (stack.some(tag => ['script','style','textarea','pre','code','svg'].includes(tag))) return token;\n      if (!/[A-Za-z]{2}/.test(token.replace(/KAI_I18N_SLOT_\\d+_END/g, ''))) return token;\n      // Do not reinterpret an interpolated child component as prose.\n      const slots = [...token.matchAll(/KAI_I18N_SLOT_(\\d+)_END/g)];\n      if (slots.some(([, i]) => /<[a-z!\\/]/i.test(String(values[i] ?? '')))) return token;\n      const params = [];\n      const key = decode(token).replace(/KAI_I18N_SLOT_(\\d+)_END/g, (_, i) => { params.push(decode(String(values[i] ?? ''))); return `{${params.length - 1}}`; });\n      const marker = '<!--kai-i18n:' + encodeURIComponent(JSON.stringify({ source: key, values: params })) + '-->';\n      return marker + escapeHTML(preserveSpace(key, translate(key, params)));\n    });\n    // One non-recursive substitution preserves user data and attribute syntax.\n    return replaceSlots(result);\n  }\n  function start() {\n    registerStatic(root.document.body);\n    root.document.documentElement.lang = locale;\n    const observer = new MutationObserver(records => {\n      if (records.some(record => record.removedNodes.length)) for (const node of descriptors.keys()) if (!node.isConnected) descriptors.delete(node);\n      for (const record of records) for (const node of record.addedNodes) {\n        if (node.nodeType === 1 || node.nodeType === 11) registerMarkers(node);\n        // innerHTML can add adjacent comment and text nodes directly.\n        else if (node.nodeType === 8 && node.data.startsWith('kai-i18n:')) registerMarkers(node.parentNode);\n      }\n    });\n    observer.observe(root.document.body, { childList: true, subtree: true });\n    root.addEventListener('storage', event => { if (event.key === storageKey && normalize(event.newValue)) setLanguage(event.newValue); });\n  }\n  if (root.document?.body) start();\n  return { languages, normalize, detect, t: translate, html, message, setText, setLanguage, registerStatic, registerMarkers,\n    get language() { return locale; }, get preference() { return preference; }, storageKey };\n});\n","index.html":"<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><title>Koinos Code</title><link rel=\"stylesheet\" href=\"styles.css\"><link rel=\"stylesheet\" href=\"product-experience.css\"><link rel=\"stylesheet\" href=\"plugin-shell.css\"></head>\n<body class=\"product-v2\"><main id=\"plugin-workspace\">\n      <section id=\"view-code\" class=\"view\">\n        <div class=\"kc-shell\">\n          <!-- Projects rail -->\n          <aside class=\"kc-rail\">\n            <button id=\"btn-kc-new\" class=\"kc-new\">+ New chat</button>\n            <div class=\"kc-rail-label\">Projects</div>\n            <div id=\"kc-projects\" class=\"kc-list\"></div>\n            <div class=\"kc-rail-label kc-rail-sessions\" id=\"kc-sessions-label\" hidden>Chats</div>\n            <div id=\"kc-sessions\" class=\"kc-list\"></div>\n            <div class=\"kc-rail-foot\">\n              <div id=\"kc-gh-status\" class=\"kc-gh\"></div>\n              <button id=\"btn-kc-gh\" class=\"kc-link\">Connect GitHub</button>\n            </div>\n          </aside>\n\n          <!-- Working pane -->\n          <main class=\"kc-pane\">\n            <!-- START SCREEN: no project chosen -->\n            <div id=\"kc-start\" class=\"kc-start\">\n              <h1 class=\"kc-start-title\">Koinos Code</h1>\n              <p class=\"kc-start-sub\">Point it at a folder and tell it what to do. It shows you every change before anything happens.</p>\n\n              <div class=\"kc-choices\">\n                <button id=\"btn-kc-pick\" class=\"kc-choice\">\n                  <span class=\"kc-choice-title\">Select a folder</span>\n                  <span class=\"kc-choice-sub\">Work on something already on this machine</span>\n                </button>\n                <button id=\"btn-kc-clone\" class=\"kc-choice\">\n                  <span class=\"kc-choice-title\">Clone from GitHub</span>\n                  <span class=\"kc-choice-sub\">Copy a repository down and start on it</span>\n                </button>\n              </div>\n\n              <!-- Inline folder browser (no window.prompt: it does not exist in Electron) -->\n              <div id=\"kc-browse\" class=\"kc-panel\" hidden>\n                <div class=\"kc-panel-head\">\n                  <b>Choose a folder</b>\n                  <button id=\"btn-kc-browse-close\" class=\"kc-x\" aria-label=\"Close\">✕</button>\n                </div>\n                <div class=\"form-row\">\n                  <input id=\"kc-browse-path\" placeholder=\"Type or paste a full path\" />\n                  <button id=\"btn-kc-browse-go\" class=\"small\">Go</button>\n                </div>\n                <div id=\"kc-browse-list\" class=\"kc-browse-list\"></div>\n                <div class=\"form-row\">\n                  <button id=\"btn-kc-browse-use\" class=\"primary small\">Use this folder</button>\n                  <span id=\"kc-browse-here\" class=\"meta\"></span>\n                </div>\n              </div>\n\n              <!-- Inline clone form -->\n              <div id=\"kc-clone\" class=\"kc-panel\" hidden>\n                <div class=\"kc-panel-head\">\n                  <b>Clone a repository</b>\n                  <button id=\"btn-kc-clone-close\" class=\"kc-x\" aria-label=\"Close\">✕</button>\n                </div>\n                <div class=\"form-row\">\n                  <input id=\"kc-clone-repo\" placeholder=\"owner/name — or the full GitHub URL\" />\n                </div>\n                <!-- Destination. The BUTTON is the affordance, same native\n                     window as \"Select a folder\" on the start screen; the typed\n                     path is the fallback for the served UI, which has no\n                     dialog to open. -->\n                <div class=\"form-row\">\n                  <button id=\"btn-kc-clone-pick\" class=\"small\">Select a folder…</button>\n                  <span id=\"kc-clone-parent-label\" class=\"meta\">no folder chosen yet</span>\n                </div>\n                <div class=\"form-row\" id=\"kc-clone-parent-row\">\n                  <input id=\"kc-clone-parent\" placeholder=\"Folder to clone into — full path\" />\n                </div>\n                <div class=\"form-row\">\n                  <button id=\"btn-kc-clone-go\" class=\"primary small\">Clone and start</button>\n                  <span id=\"kc-clone-status\" class=\"meta\"></span>\n                </div>\n                <div id=\"kc-repo-list\" class=\"kc-browse-list\" hidden></div>\n              </div>\n\n              <div id=\"kc-start-error\" class=\"kc-error\" hidden></div>\n            </div>\n\n            <!-- CHAT: a project is chosen -->\n            <div id=\"kc-chat\" class=\"kc-chat\" hidden>\n              <header class=\"kc-head\">\n                <div class=\"kc-head-main\">\n                  <span id=\"kc-title\" class=\"kc-head-title\"></span>\n                  <span id=\"kc-path\" class=\"kc-head-path\"></span>\n                </div>\n                <div class=\"kc-head-actions\">\n                  <span id=\"kc-branch\" class=\"kc-branch\" hidden></span>\n                  <button id=\"btn-kc-git\" class=\"small\" hidden>Git</button>\n                  <button id=\"btn-kc-rename\" class=\"small\">Rename</button>\n                  <button id=\"btn-kc-forget\" class=\"small\">Forget</button>\n                </div>\n              </header>\n\n              <!-- Git actions, revealed by the Git button -->\n              <div id=\"kc-git-bar\" class=\"kc-panel\" hidden>\n                <div class=\"form-row\">\n                  <input id=\"kc-git-input\" placeholder=\"Branch name / commit message / PR title\" />\n                  <button id=\"btn-kc-branch\" class=\"small\">Branch</button>\n                  <button id=\"btn-kc-commit\" class=\"small\">Commit</button>\n                  <button id=\"btn-kc-push\" class=\"small\">Push</button>\n                  <button id=\"btn-kc-pr\" class=\"small\">Pull request</button>\n                </div>\n                <div class=\"form-row\"><span id=\"kc-git-status\" class=\"meta\"></span></div>\n              </div>\n\n              <!-- Rename, inline -->\n              <div id=\"kc-rename-bar\" class=\"kc-panel\" hidden>\n                <div class=\"form-row\">\n                  <input id=\"kc-rename-input\" placeholder=\"Project name\" />\n                  <button id=\"btn-kc-rename-save\" class=\"primary small\">Save</button>\n                  <button id=\"btn-kc-rename-cancel\" class=\"small\">Cancel</button>\n                </div>\n              </div>\n\n              <div id=\"kc-trace\" class=\"kc-transcript\"></div>\n\n              <div id=\"kc-cmd-hints\" class=\"kc-browse-list kc-cmd-hints\" hidden></div>\n              <div class=\"kc-composer\">\n                <textarea id=\"kc-task\" rows=\"1\" placeholder=\"What should it do? (Enter to send, Shift+Enter for a new line)\"></textarea>\n                <button id=\"btn-kc-run\" class=\"primary small\">Send</button>\n                <button id=\"btn-kc-stop\" class=\"small\" hidden>Stop</button>\n              </div>\n              <div class=\"kc-composer-opts\">\n                <label class=\"check kc-opt\"><input type=\"checkbox\" id=\"kc-plan\" /> Plan first</label>\n                <label class=\"kc-opt\" for=\"kc-model\">Model</label>\n                <select id=\"kc-model\" title=\"Which model does the work. Koinos Code runs on this machine only — the agent reads your project's files into the prompt, and those do not leave the computer.\"></select>\n                <button id=\"btn-kc-tools\" class=\"kc-link\">Tools…</button>\n                <span id=\"kc-tools-summary\" class=\"meta\"></span>\n              </div>\n              <div id=\"kc-tools-panel\" class=\"kc-panel\" hidden>\n                <div class=\"kc-panel-head\">\n                  <b>Tools this project may use</b>\n                  <button id=\"btn-kc-tools-close\" class=\"kc-x\" aria-label=\"Close\">✕</button>\n                </div>\n                <p class=\"kc-choice-sub\" id=\"kc-tools-note\"></p>\n                <div id=\"kc-tools-list\" class=\"kc-browse-list\"></div>\n              </div>\n              <div class=\"kc-statusline\"><span id=\"kc-status\" class=\"meta\"></span></div>\n            </div>\n          </main>\n        </div>\n      </section>\n</main>\n<script src=\"locales/catalogs.js\"></script>\n<script src=\"i18n.js\"></script>\n<script src=\"bridge.js\"></script>\n<script src=\"app.js\"></script>\n<script src=\"boot.js\"></script>\n</body></html>\n","kai-notices.js":"\"use strict\";\n(function (root) {\n  const attached = new WeakMap();\n  function attach(container, { focusTarget } = {}) {\n    if (attached.has(container)) return attached.get(container);\n    const document = container.ownerDocument, initial = container.textContent;\n    const message = document.createElement(\"span\"), close = document.createElement(\"button\"), symbol = document.createElement(\"span\");\n    message.className = \"kai-notice-text\"; message.setAttribute(\"role\", \"status\"); message.setAttribute(\"aria-atomic\", \"true\");\n    close.className = \"kai-notice-close\"; close.type = \"button\"; close.title = \"Dismiss message\"; close.setAttribute(\"aria-label\", \"Dismiss message\");\n    symbol.textContent = \"×\"; symbol.setAttribute(\"aria-hidden\", \"true\"); close.append(symbol);\n    container.classList.add(\"kai-notice\"); container.removeAttribute(\"role\"); container.removeAttribute(\"aria-live\"); container.replaceChildren(message, close);\n    let current = \"\", dismissed = null;\n    function show(value, { error = false, dismissible = true, force = false } = {}) {\n      const content = String(value ?? \"\"), key = JSON.stringify([content, error, dismissible]);\n      if (force || key !== current) dismissed = null;\n      current = key;\n      if (message.textContent !== content) message.textContent = content;\n      container.classList.toggle(\"error\", error); close.hidden = !dismissible;\n      container.hidden = !content || current === dismissed;\n    }\n    function dismiss() {\n      if (container.hidden || close.hidden) return;\n      const hadFocus = document.activeElement === close;\n      dismissed = current; container.hidden = true;\n      if (hadFocus) {\n        const target = focusTarget?.();\n        if (target && !target.disabled && target.getClientRects().length) target.focus({ preventScroll: true });\n      }\n    }\n    close.onclick = dismiss;\n    const api = { show, dismiss, clear() { show(\"\"); } };\n    attached.set(container, api); show(initial);\n    return api;\n  }\n  root.KaiPluginNotice = { attach };\n})(window);\n","kai-theme.css":"/* KAI workspace primitives, shared by the first-party plugin windows. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#fff;--bg-input:#f5f8fe;--panel:#fff;--surface:#fff;--border:#dce5f2;--line:#dce5f2;--text:#14284e;--text-dim:#61728d;--muted:#61728d;--accent:#155eef;--violet:#155eef;--sky:#096bdc;--emerald:#168469;--mint:#168469;--danger:#c93d4c;--radius:14px;font:14px/1.6 Inter,\"Segoe UI\",Arial,sans-serif;color:var(--text);background:var(--bg)}\n*{box-sizing:border-box;scrollbar-width:thin;scrollbar-color:#bdcde2 #f4f7fd}\n*::-webkit-scrollbar{width:9px;height:9px}*::-webkit-scrollbar-track,*::-webkit-scrollbar-corner{background:#f4f7fd}*::-webkit-scrollbar-thumb{background:#bdcde2;border:2px solid #f4f7fd;border-radius:8px}*::-webkit-scrollbar-thumb:hover{background:#9eb4d1}\nbody{margin:0;background:var(--bg);color:var(--text)}button,input,select,textarea{font:inherit}button{border:1px solid var(--border);border-radius:9px;background:#fff;color:var(--text);padding:9px 14px;font-size:12px;font-weight:550;cursor:pointer;transition:background .15s,border-color .15s}button:hover:not(:disabled){background:#edf4ff;border-color:#b7cff6}button:disabled{opacity:.5;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:2px solid var(--accent);outline-offset:3px}button.primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:650}button.primary:hover:not(:disabled){background:#0c4ed3;border-color:#0c4ed3}\ninput,select,textarea{background:var(--bg-input);border:1px solid var(--border);border-radius:9px;padding:10px 12px;color:var(--text);max-width:100%;font-size:12px}input::placeholder,textarea::placeholder{color:#8795aa}textarea{resize:vertical}label{font-size:12px;color:var(--text-dim)}a{color:var(--accent)}p{font-size:12px;line-height:1.7}h1,h2,h3{line-height:1.4;font-weight:600}h1{font-size:24px;letter-spacing:-.5px}h2{font-size:16px;letter-spacing:-.2px}h3{font-size:13px}.muted,.hint,.small{color:var(--text-dim);font-size:11px;line-height:1.6}\n:where(.workspace-header,.kai-workspace-header){display:flex;align-items:center;gap:12px;min-height:74px;height:74px;flex:none;border-bottom:1px solid var(--border);padding:0 28px;background:var(--bg)}:where(.workspace-header,.kai-workspace-header) h1{font-size:15px;letter-spacing:0;margin:0;font-weight:650}:where(.workspace-header,.kai-workspace-header) svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}\n.kai-notice{display:flex;align-items:flex-start;gap:12px;min-width:0;padding:10px 13px;border:1px solid #c6d9f9;border-radius:10px;background:#eaf2ff;color:#184b9c;font-size:12px;line-height:1.6;overflow-wrap:anywhere}.kai-notice.error{background:#fff0f2;border-color:#f0c4cc;color:#a33040}.kai-notice-text{flex:1;min-width:0;align-self:center;max-height:30vh;overflow:auto;white-space:pre-wrap}.kai-notice .kai-notice-close{display:flex;align-items:center;justify-content:center;flex:0 0 30px;width:30px;height:30px;padding:0;border:0;border-radius:6px;background:transparent;color:inherit;font-size:22px;line-height:1}.kai-notice .kai-notice-close:hover{background:#14284e12}\n[hidden]{display:none!important}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}\n@media(max-width:700px){:where(.workspace-header,.kai-workspace-header){padding-inline:18px;min-height:65px;height:65px}}\n@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}\n","locales/catalogs.js":"/* Generated by scripts/build-locales.js from the JSON catalogs. */\n(function(root) { root.KaiLocaleCatalogs = {\"es\":{\"Minimize\":\"Minimizar\",\"Maximize\":\"Maximizar\",\"Close\":\"Cerrar\",\"THINK · BUILD · GROW\":\"PIENSA · CREA · CRECE\",\"Main navigation\":\"Navegación principal\",\"Workspace\":\"Espacio de trabajo\",\"Chat with KAI\":\"Chatear con KAI\",\"Brain\":\"Cerebro\",\"Workflows\":\"Flujos de trabajo\",\"Connections\":\"Conexiones\",\"Agents\":\"Agentes\",\"Documents\":\"Documentos\",\"Compare models\":\"Comparar modelos\",\"Your toolkit\":\"Tus herramientas\",\"Model library\":\"Biblioteca de modelos\",\"Tools\":\"Herramientas\",\"Tasks\":\"Tareas\",\"Local API\":\"API local\",\"Developer tools\":\"Herramientas de desarrollo\",\"Contribute\":\"Contribuir\",\"Earn KAI\":\"Ganar KAI\",\"Launch KAI\":\"Abrir KAI\",\"A little help, always close\":\"Un poco de ayuda, siempre cerca\",\"Connecting…\":\"Conectando…\",\"Settings\":\"Configuración\",\"Network\":\"Red\",\"Send feedback\":\"Enviar comentarios\",\"Your workspace. Your choice of AI.\":\"Tu espacio. Tú eliges la IA.\",\"YOUR AI WORKSPACE\":\"TU ESPACIO DE IA\",\"A little curiosity goes a long way.\":\"Un poco de curiosidad abre muchas puertas.\",\"Welcome to Koinos AI\":\"Bienvenido a Koinos AI\",\"Let’s find your first local model. You can also connect OpenAI or Anthropic in desktop Settings, or explore the network.\":\"Busquemos tu primer modelo local. También puedes conectar OpenAI o Anthropic en la Configuración de la app, o explorar la red.\",\"Download & start\":\"Descargar e iniciar\",\"Starting…\":\"Iniciando…\",\"Start a new chat\":\"Iniciar un chat nuevo\",\"+ New chat\":\"+ Nuevo chat\",\"Search chats…\":\"Buscar chats…\",\"Chats\":\"Chats\",\"Conversations\":\"Conversaciones\",\"Make room for your next idea.\":\"Haz espacio para tu próxima idea.\",\"YOUR EVERYDAY SIDEKICK\":\"TU COMPAÑERO DE CADA DÍA\",\"Hi, I’m KAI\":\"Hola, soy KAI\",\"Let’s do something amazing.\":\"Hagamos algo increíble.\",\"Ask a question, explore an idea, or get a hand with your next project.\":\"Haz una pregunta, explora una idea o recibe ayuda con tu próximo proyecto.\",\"Help me understand something new. Ask me what I’m curious about.\":\"Ayúdame a entender algo nuevo. Pregúntame qué me da curiosidad.\",\"Answer a question\":\"Responder una pregunta\",\"Make the complicated click.\":\"Entiende lo complicado.\",\"Help me turn an idea into a project. Ask me what I want to build.\":\"Ayúdame a convertir una idea en un proyecto. Pregúntame qué quiero crear.\",\"Help me build\":\"Ayúdame a crear\",\"Big ideas start small.\":\"Las grandes ideas empiezan en pequeño.\",\"Let’s brainstorm some fresh ideas. Ask me what I’m working on.\":\"Busquemos ideas nuevas. Pregúntame en qué estoy trabajando.\",\"Find a fresh idea\":\"Encontrar una idea nueva\",\"A different way to think.\":\"Otra forma de pensar.\",\"Choose your AI below. Local, network, or your own desktop connection.\":\"Elige tu IA abajo: local, de la red o tu propia conexión de escritorio.\",\"How to answer: plain chat, multi-step web research, an agent that uses tools, or a whole AI team\":\"Cómo responder: chat, investigación web, un agente con herramientas o un equipo de IA\",\"Chat\":\"Chat\",\"Research\":\"Investigación\",\"Agent\":\"Agente\",\"Research team\":\"Equipo de investigación\",\"Analyst team (code)\":\"Equipo de análisis (código)\",\"Write & review team\":\"Equipo de redacción y revisión\",\"Choose this machine, Koinos Network, or a private desktop provider\":\"Elige este equipo, Koinos Network o un proveedor privado de escritorio\",\"Which model answers\":\"Qué modelo responde\",\"How the AI should answer\":\"Cómo debe responder la IA\",\"Default style\":\"Estilo predeterminado\",\"Concise\":\"Conciso\",\"Explain simply\":\"Explicar de forma sencilla\",\"Code helper\":\"Ayuda con código\",\"Custom…\":\"Personalizado…\",\"Your message to KAI\":\"Tu mensaje para KAI\",\"Ask KAI anything, or dream something up…\":\"Pregúntale algo a KAI o imagina algo nuevo…\",\"Attach a text file as context\":\"Adjuntar un archivo de texto como contexto\",\"Web search: the AI looks things up live (your search query leaves this machine)\":\"Búsqueda web: la IA consulta información en línea (tu consulta sale de este equipo)\",\"Voice input: speak, and it's typed for you — transcribed on this machine, audio never leaves it\":\"Entrada de voz: habla y se transcribe en este equipo; el audio nunca sale de él\",\"Send\":\"Enviar\",\"Stop\":\"Detener\",\"Remove attachment\":\"Quitar adjunto\",\"Describe how the AI should behave, e.g. “You are a pirate. Answer everything in character.”\":\"Describe cómo debe comportarse la IA, p. ej.: «Eres un pirata. Responde siempre como tal».\",\"+ New\":\"+ Nuevo\",\"Title\":\"Título\",\"Write here. Select some text (or nothing, for the whole document) and use the AI bar below — suggestions preview first, and only Apply changes your words.\":\"Escribe aquí. Selecciona texto (o nada para usar todo el documento) y utiliza la barra de IA. Primero verás una vista previa; solo Aplicar modifica tu texto.\",\"Model for suggestions\":\"Modelo para sugerencias\",\"Improve\":\"Mejorar\",\"Fix grammar\":\"Corregir gramática\",\"Shorten\":\"Acortar\",\"Expand\":\"Ampliar\",\"Continue\":\"Continuar\",\"…or tell it what to do (e.g. “make this friendlier”)\":\"…o indica qué hacer (p. ej., «hazlo más amable»)\",\"Go\":\"Ir\",\"Suggestion\":\"Sugerencia\",\"Apply\":\"Aplicar\",\"Discard\":\"Descartar\",\"One prompt, two models, blind. Answers stream one at a time (they share the machine), then you reveal which was which. Pick winners to learn which model earns its size.\":\"Una pregunta, dos modelos sin identificar. Las respuestas llegan una a la vez porque comparten este equipo; después se revelan los modelos. Elige ganadores para comparar su calidad.\",\"Ask both models the same thing…\":\"Haz la misma pregunta a ambos modelos…\",\"Run both\":\"Ejecutar ambos\",\"Answer 1\":\"Respuesta 1\",\"Answer 2\":\"Respuesta 2\",\"Reveal models\":\"Revelar modelos\",\"Which answer was better?\":\"¿Qué respuesta fue mejor?\",\"Tie\":\"Empate\",\"Scheduled tasks\":\"Tareas programadas\",\"A prompt that runs itself — hourly, daily, or weekly — and drops its answer into your chats. Tasks run while Koinos AI is open, on whichever model you choose, with the same privacy rules as typed chat.\":\"Una instrucción se ejecuta cada hora, día o semana y deja su respuesta en tus chats. Las tareas se ejecutan mientras Koinos AI está abierto, con el modelo elegido y las mismas reglas de privacidad que el chat.\",\"Name (e.g. Morning writing prompt)\":\"Nombre (p. ej., Ejercicio de escritura matutino)\",\"The prompt to run, e.g. “Give me one unusual writing prompt and a first line.”\":\"Instrucción, p. ej.: «Dame una idea de escritura original y una primera frase».\",\"Every hour\":\"Cada hora\",\"Every 6 hours\":\"Cada 6 horas\",\"Daily\":\"Diariamente\",\"Weekly\":\"Semanalmente\",\"Mon\":\"Lun\",\"Tue\":\"Mar\",\"Wed\":\"Mié\",\"Thu\":\"Jue\",\"Fri\":\"Vie\",\"Sat\":\"Sáb\",\"Sun\":\"Dom\",\"Add task\":\"Añadir tarea\",\"Network status\":\"Estado de la red\",\"A live look at the Koinos network — the computers online right now and the models they serve. Refreshes every 15 seconds while open.\":\"Los equipos conectados a la red Koinos y los modelos que ofrecen, en tiempo real. Se actualiza cada 15 segundos mientras esta pantalla está abierta.\",\"Computers online\":\"Equipos conectados\",\"Model classes live\":\"Clases de modelos activas\",\"Jobs waiting\":\"Trabajos en espera\",\"Models on the network\":\"Modelos en la red\",\"Computers\":\"Equipos\",\"Tools & accounts\":\"Herramientas y cuentas\",\"Give your AI abilities: tool servers (MCP), a memory that lasts across chats, and your email & calendar. Everything asks before acting until you say otherwise.\":\"Añade servidores de herramientas (MCP), memoria entre chats, correo y calendario. Se pedirá permiso antes de actuar hasta que indiques lo contrario.\",\"Privacy mode is\":\"El modo de privacidad es\",\"Local-Only\":\"Solo local\",\": tools that talk to the internet (including email & calendar) are switched off. Change it in Local API → Privacy.\":\": las herramientas de internet (incluidos correo y calendario) están desactivadas. Cámbialo en API local → Privacidad.\",\"Tool servers\":\"Servidores de herramientas\",\"Add\":\"Añadir\",\"Add your own (URL or command)\":\"Añadir uno propio (URL o comando)\",\"Name, e.g. My tools\":\"Nombre, p. ej. Mis herramientas\",\"https://… (an MCP server URL)\":\"https://… (URL de un servidor MCP)\",\"or a local command, e.g. npx -y @modelcontextprotocol/server-fetch\":\"o un comando local, p. ej. npx -y @modelcontextprotocol/server-fetch\",\"Add server\":\"Añadir servidor\",\"Manage everything KAI remembers in Brain → Memories.\":\"Gestiona todo lo que KAI recuerda en Cerebro → Recuerdos.\",\"Email\":\"Correo electrónico\",\"Calendar\":\"Calendario\",\"Models\":\"Modelos\",\"Trusted models, verified by checksum before first use. Chat picks any model that's on this machine; bigger models answer better and download once.\":\"Modelos fiables, verificados mediante suma de comprobación antes del primer uso. El chat puede usar cualquier modelo de este equipo; los más grandes suelen responder mejor y se descargan una vez.\",\"Import your own model\":\"Importar tu propio modelo\",\"Any GGUF file on this machine. It's verified (hashed) once and used in place — nothing is copied or uploaded.\":\"Cualquier archivo GGUF de este equipo. Se verifica una vez y se usa donde está: no se copia ni se sube nada.\",\"Full path to a .gguf file\":\"Ruta completa al archivo .gguf\",\"Import\":\"Importar\",\"Choose file…\":\"Elegir archivo…\",\"Earn with your hardware\":\"Gana con tu hardware\",\"Run approved AI jobs for the network and earn KAI. Alpha runs on the Koinos testnet — rewards are test tokens while the network hardens.\":\"Procesa trabajos de IA aprobados para la red y gana KAI. La versión alfa usa la red de pruebas de Koinos: las recompensas son tokens de prueba mientras se fortalece la red.\",\"Create your earning account\":\"Crear tu cuenta de ganancias\",\"A wallet is created on this machine. Its key never leaves your computer and is never shared with apps or the network.\":\"Se crea una billetera en este equipo. Su clave nunca sale del equipo ni se comparte con apps o con la red.\",\"Choose a password (min 8 chars)\":\"Elige una contraseña (mín. 8 caracteres)\",\"show\":\"mostrar\",\"Confirm password\":\"Confirmar contraseña\",\"Create\":\"Crear\",\"Backup key — shown only once. Write it down, then continue:\":\"Clave de respaldo: se muestra una sola vez. Anótala antes de continuar:\",\"I saved it\":\"Ya la guardé\",\"Unlock your earning account\":\"Desbloquear tu cuenta de ganancias\",\"Wallet password\":\"Contraseña de la billetera\",\"Unlock\":\"Desbloquear\",\"Forgot your password? Restore with your backup code\":\"¿Olvidaste la contraseña? Restaura con tu código de respaldo\",\"Restore from backup code\":\"Restaurar con código de respaldo\",\"Enter the backup code you wrote down when the account was created, and choose a new password. Your address and balance stay the same.\":\"Introduce el código de respaldo que anotaste al crear la cuenta y elige una contraseña nueva. Tu dirección y saldo no cambian.\",\"Backup code\":\"Código de respaldo\",\"New password (min 8 chars)\":\"Nueva contraseña (mín. 8 caracteres)\",\"Confirm new password\":\"Confirmar nueva contraseña\",\"Restore\":\"Restaurar\",\"Offline\":\"Sin conexión\",\"Scheduler URL (from the project)\":\"URL del coordinador (del proyecto)\",\"Start Earning\":\"Empezar a ganar\",\"Stopping is immediate — no job runs after you press Stop.\":\"La detención es inmediata: no se ejecuta ningún trabajo después de pulsar Detener.\",\"Network usage & balance\":\"Uso de la red y saldo\",\"Network AI is billed like any modern AI API — by input and output tokens, per model — and settles in KAI underneath. Add funds by converting KAI at the current reference price, or keep earning: serving the network covers your own usage.\":\"La IA de la red se cobra por tokens de entrada y salida según el modelo, y se liquida en KAI. Añade fondos convirtiendo KAI al precio de referencia actual, o sigue ganando: atender a la red cubre tu propio uso.\",\"KAI to convert\":\"KAI para convertir\",\"Add funds\":\"Añadir fondos\",\"Your wallet stays unlocked on this computer.\":\"Tu billetera permanece desbloqueada en este equipo.\",\"Lock wallet\":\"Bloquear billetera\",\"Show backup code\":\"Mostrar código de respaldo\",\"Wallet password (required to reveal)\":\"Contraseña de la billetera (obligatoria para mostrar)\",\"Reveal\":\"Mostrar\",\"Wallet — send & receive on Koinos mainnet\":\"Billetera: enviar y recibir en la red principal de Koinos\",\"Your Koinos AI wallet is a real Koinos address: share it to receive KOIN or VHP, and send either with your wallet password. This is real mainnet value — check the recipient address character by character. Works on every machine, node or not.\":\"Tu billetera Koinos AI es una dirección real de Koinos. Compártela para recibir KOIN o VHP y usa tu contraseña para enviarlos. Se trata de valor real en la red principal: comprueba cada carácter de la dirección de destino. Funciona con o sin nodo.\",\"Your Koinos address\":\"Tu dirección Koinos\",\"Copy address\":\"Copiar dirección\",\"Show balances\":\"Mostrar saldos\",\"Token to send\":\"Token a enviar\",\"Recipient address (1…)\":\"Dirección del destinatario (1…)\",\"Amount\":\"Cantidad\",\"Wallet password (required to send)\":\"Contraseña de la billetera (obligatoria para enviar)\",\"Dashboard\":\"Panel\",\"Wallet\":\"Billetera\",\"Fund node\":\"Financiar nodo\",\"Burn KOIN → VHP\":\"Quemar KOIN → VHP\",\"Node\":\"Nodo\",\"Reward returns\":\"Retorno de recompensas\",\"Node settings\":\"Configuración del nodo\",\"App settings\":\"Configuración de la app\",\"Your account, and the parts of the app that are off until you turn them on.\":\"Tu cuenta y las funciones que permanecen desactivadas hasta que las actives.\",\"Desktop AI connections\":\"Conexiones de IA de escritorio\",\"Use your own OpenAI or Anthropic API account in chat and desktop KAI. Chats, attachments and relevant app tool results go directly to your chosen provider. API usage is billed by that provider. Keys are encrypted on this computer and are never offered to the Koinos Network.\":\"Usa tu cuenta de API de OpenAI o Anthropic en el chat y en KAI de escritorio. Los chats, adjuntos y resultados relevantes de herramientas se envían directamente al proveedor elegido. El proveedor cobra el uso de la API. Las claves se cifran en este equipo y nunca se ofrecen a Koinos Network.\",\"Not connected\":\"Sin conectar\",\"API key\":\"Clave de API\",\"Paste your API key\":\"Pega tu clave de API\",\"Model ID\":\"ID del modelo\",\"(optional — or refresh models after saving)\":\"(opcional; también puedes actualizar los modelos después de guardar)\",\"A model ID from your provider account\":\"Un ID de modelo de tu cuenta del proveedor\",\"Save connection\":\"Guardar conexión\",\"Test & refresh models\":\"Probar y actualizar modelos\",\"Use in chat\":\"Usar en el chat\",\"Remove\":\"Quitar\",\"Get an API key ↗\":\"Obtener una clave de API ↗\",\"Available in desktop chat, Research, Agent and KAI. Teams, scheduled tasks, the local API and network earning continue using their existing models. Stop cancels an active provider reply.\":\"Disponible en el chat de escritorio, Investigación, Agente y KAI. Los equipos, tareas programadas, API local y ganancias de red siguen usando sus modelos actuales. Detener cancela la respuesta activa del proveedor.\",\"Checking…\":\"Comprobando…\",\"Check for updates\":\"Buscar actualizaciones\",\"Koinos AI account\":\"Cuenta Koinos AI\",\"One account across your devices: sign in once, link this wallet, and your balance and claims follow you. Sign-in happens at koinosai.com with a passkey, email code, or Google — the app never asks for a password, it just shows a short code.\":\"Una cuenta para todos tus dispositivos: inicia sesión y vincula esta billetera para acceder a tu saldo y reclamaciones. El inicio de sesión se realiza en koinosai.com con passkey, código por correo o Google. La app muestra un código corto y nunca pide tu contraseña de acceso.\",\"Sign in / create account\":\"Iniciar sesión / crear cuenta\",\"On any device, open\":\"En cualquier dispositivo, abre\",\", sign in, and type this code:\":\", inicia sesión e introduce este código:\",\"Waiting for approval…\":\"Esperando aprobación…\",\"Link this wallet\":\"Vincular esta billetera\",\"Sign out on this device\":\"Cerrar sesión en este dispositivo\",\"Use Koinos AI on the web\":\"Usar Koinos AI en la web\",\"Chat and Docs in a browser, signed in to this same account — useful on a machine that cannot run models. The website has no key of its own, so it can only spend what you authorise here: a cap, and a date it stops. This app signs that once, with this wallet, and you can end it from either side at any time. A grant is permission, not funds — this wallet still needs KAI on the network to draw against, same as the app.\":\"Usa Chat y Documentos en un navegador con esta misma cuenta, incluso sin modelos locales. El sitio solo puede gastar lo autorizado aquí: un límite y una fecha de vencimiento. Esta app firma el permiso con tu billetera; puedes revocarlo desde cualquiera de los dos lados. El permiso no aporta fondos: la billetera debe tener KAI en la red.\",\"How it works\":\"Cómo funciona\",\"Spend up to\":\"Gastar hasta\",\"for 7 days\":\"durante 7 días\",\"for 30 days\":\"durante 30 días\",\"for 90 days\":\"durante 90 días\",\"Authorise\":\"Autorizar\",\"In US dollars of model usage — the same rates the Network tab shows. Nothing is transferred now; the site draws against this as it is used.\":\"En dólares estadounidenses de uso de modelos, con las mismas tarifas de la pestaña Red. Ahora no se transfiere nada; el sitio usa el permiso según su consumo.\",\"Open the web app\":\"Abrir la app web\",\"End web access\":\"Finalizar acceso web\",\"Closing the window\":\"Al cerrar la ventana\",\"Keep running in the notification area\":\"Seguir ejecutando en el área de notificación\",\"Closing the window tucks Koinos AI down by the clock instead of shutting it down, so your node stays connected and keeps earning. Click that icon to bring the window back, or right-click it and choose Quit to stop the app completely. Switch this off and the X closes the app outright, the way it used to.\":\"Al cerrar la ventana, Koinos AI queda junto al reloj para que tu nodo siga conectado y ganando. Haz clic en su icono para volver, o clic derecho y Salir para cerrar la app por completo. Desactiva esta opción para que la X cierre la app.\",\"Optional sections\":\"Secciones opcionales\",\"Each of these adds its own entry to the sidebar. All of them are off until you switch them on, and switching one off only hides it — nothing you made is deleted.\":\"Cada función añade una entrada a la barra lateral y permanece desactivada hasta que la actives. Desactivarla solo la oculta: no se elimina nada de lo que creaste.\",\"Run Koinos Node\":\"Ejecutar Koinos Node\",\"Runs a real Koinos node on this machine, with a wallet, funding, swaps and block-production rewards. Uses your existing Koinos AI wallet. Node networking is independent of AI Privacy; Local-Only can stay on.\":\"Ejecuta un nodo real de Koinos en este equipo, con billetera, financiación, intercambios y recompensas por producir bloques. Usa tu billetera Koinos AI existente. La red del nodo es independiente de la privacidad de IA; Solo local puede seguir activado.\",\"Run Koinos node\":\"Ejecutar nodo Koinos\",\"Koinos Node is on — it is in the sidebar now.\":\"Koinos Node está activado; ya aparece en la barra lateral.\",\"Adds a\":\"Añade una sección de\",\"Developer Tools\":\"Herramientas de desarrollo\",\"section to the sidebar: build your own multi-agent systems, watch them run in a live playground, define custom pipelines, and benchmark your model. Everything there obeys the same privacy and permission rules as the rest of the app.\":\"a la barra lateral: crea sistemas multiagente, observa su ejecución en vivo, define procesos y evalúa tu modelo. Se respetan las mismas reglas de privacidad y permisos que en el resto de la app.\",\"Adds\":\"Añade\",\"to the sidebar: the coding agent, working on folders you choose. Worth knowing exactly what it can do — inside a project you add, it can write files and run commands as you. It never does either without showing you the change or the exact command first and waiting for your yes, and it never touches anything outside that folder.\":\"a la barra lateral: un agente de programación que trabaja en las carpetas que elijas. Puede escribir archivos y ejecutar comandos como tú dentro de los proyectos añadidos. Primero muestra el cambio o comando exacto y espera tu aprobación. Nunca modifica nada fuera de esa carpeta.\",\"Your local OpenAI-compatible API\":\"Tu API local compatible con OpenAI\",\"Point any OpenAI SDK or tool at this machine. No cloud, no per-token bill.\":\"Conecta cualquier SDK de OpenAI o herramienta a este equipo. Sin nube ni factura por token.\",\"Network & privacy\":\"Red y privacidad\",\"Local-Only is the default: AI requests stay on this machine. Koinos Node and explicit wallet actions use the blockchain independently. Local-First and Network unlock the “Koinos Network” model — requests overflow to network providers through the scheduler.\":\"Solo local es el valor predeterminado: las solicitudes de IA permanecen en este equipo. Koinos Node y las acciones explícitas de la billetera usan la cadena de forma independiente. Local primero y Red habilitan el modelo Koinos Network y el envío de solicitudes a proveedores de la red mediante el coordinador.\",\"Network requests run on other people's computers: the provider serving your request can read what it contains\":\"Las solicitudes de red se procesan en equipos ajenos: el proveedor puede leer su contenido\",\"— nothing is stored by the serving path, but treat anything sent off this machine as visible to that provider.\":\": el procesamiento no guarda nada, pero considera visible para el proveedor cualquier información enviada fuera de este equipo.\",\"Local-Only (AI requests stay on this machine)\":\"Solo local (las solicitudes de IA permanecen en este equipo)\",\"Local-First (local when possible, network when needed — first 25k tokens/epoch free)\":\"Local primero (local si es posible, red si hace falta; primeros 25 mil tokens por época gratis)\",\"API keys\":\"Claves de API\",\"Create key\":\"Crear clave\",\"Without keys, apps on this computer connect freely. Creating the first key requires every API call to present one — the built-in chat keeps working either way.\":\"Sin claves, las apps de este equipo se conectan libremente. Al crear la primera clave, cada llamada a la API debe presentar una. El chat integrado sigue funcionando en ambos casos.\",\"Copy it now — it is shown only once:\":\"Cópiala ahora: se muestra una sola vez:\",\"Remote access\":\"Acceso remoto\",\"Use your API from anywhere — a phone, a server, another computer. The app keeps an outbound connection to koinosai.com (nothing to install, no router setup) and your API key works at the address below. Requests are answered by\":\"Usa tu API desde un teléfono, servidor u otro equipo. La app mantiene una conexión saliente a koinosai.com, sin instalaciones ni ajustes del router. Tu clave de API funciona en la dirección siguiente. Las solicitudes las responde\",\"this computer\":\"este equipo\",\", so it works while the app is running. An API key is required — without one the switch refuses, so your API is never open to the internet. Heads up: remote traffic passes through koinosai.com on its way here.\":\", por lo que la app debe estar abierta. Se necesita una clave de API; sin ella no se permite activar el acceso. Tu API nunca queda abierta a internet. El tráfico remoto pasa por koinosai.com.\",\"Projects\":\"Proyectos\",\"Connect GitHub\":\"Conectar GitHub\",\"Point it at a folder and tell it what to do. It shows you every change before anything happens.\":\"Elige una carpeta e indica qué hacer. Verás cada cambio antes de que se realice.\",\"Select a folder\":\"Seleccionar carpeta\",\"Work on something already on this machine\":\"Trabajar en algo que ya está en este equipo\",\"Clone from GitHub\":\"Clonar desde GitHub\",\"Copy a repository down and start on it\":\"Descargar un repositorio y empezar a trabajar\",\"Choose a folder\":\"Elegir carpeta\",\"Type or paste a full path\":\"Escribe o pega una ruta completa\",\"Use this folder\":\"Usar esta carpeta\",\"Clone a repository\":\"Clonar un repositorio\",\"owner/name — or the full GitHub URL\":\"propietario/nombre o URL completa de GitHub\",\"Select a folder…\":\"Seleccionar carpeta…\",\"no folder chosen yet\":\"aún no se ha elegido una carpeta\",\"Folder to clone into — full path\":\"Carpeta de destino: ruta completa\",\"Clone and start\":\"Clonar e iniciar\",\"Rename\":\"Renombrar\",\"Forget\":\"Olvidar\",\"Branch name / commit message / PR title\":\"Nombre de rama / mensaje de commit / título de PR\",\"Branch\":\"Rama\",\"Project name\":\"Nombre del proyecto\",\"Save\":\"Guardar\",\"Cancel\":\"Cancelar\",\"What should it do? (Enter to send, Shift+Enter for a new line)\":\"¿Qué debe hacer? (Enter envía, Mayús+Enter añade una línea)\",\"Plan first\":\"Planificar primero\",\"Model\":\"Modelo\",\"Which model does the work. Koinos Code runs on this machine only — the agent reads your project's files into the prompt, and those do not leave the computer.\":\"Qué modelo hace el trabajo. Koinos Code solo se ejecuta en este equipo: los archivos de tu proyecto se leen en la instrucción y no salen del equipo.\",\"Tools…\":\"Herramientas…\",\"Tools this project may use\":\"Herramientas permitidas para este proyecto\",\"Build and run your own agent systems on this machine's API — from a one-line pipeline to a team of named agents that talk, use tools, and ask you questions.\":\"Crea y ejecuta sistemas de agentes en la API de este equipo, desde un proceso sencillo hasta equipos de agentes que conversan, usan herramientas y te hacen preguntas.\",\"Developer tools sections\":\"Secciones de herramientas de desarrollo\",\"Multi-agent\":\"Multiagente\",\"Playground\":\"Entorno de pruebas\",\"Pipelines\":\"Procesos\",\"Benchmark\":\"Evaluación\",\"Named agents share one conversation. Pick how the floor moves — round robin, a model moderator, or explicit handoffs — and how it ends. A\":\"Los agentes con nombre comparten una conversación. Elige el orden (por turnos, moderador de IA o traspasos explícitos) y cómo termina. Un agente\",\"human\":\"humano\",\"agent pauses the run and asks you. Hard ceilings always hold: 60 messages, 120 model calls, 6 tool actions per turn. Apps can POST the same spec to\":\"pausa la ejecución y te pregunta. Los límites son 60 mensajes, 120 llamadas al modelo y 6 acciones de herramientas por turno. Las apps pueden enviar la misma especificación por POST a\",\"Team name\":\"Nombre del equipo\",\"e.g. Research duo\":\"p. ej. Dúo de investigación\",\"Turn order\":\"Orden de turnos\",\"Round robin — agents speak in order\":\"Por turnos: los agentes hablan en orden\",\"Selector — a model picks who speaks next\":\"Selector: un modelo elige quién habla después\",\"Handoff — the speaker passes the floor by name\":\"Traspaso: quien habla cede el turno por nombre\",\"+ Add agent\":\"+ Añadir agente\",\"Max messages\":\"Máx. mensajes\",\"Max model calls\":\"Máx. llamadas al modelo\",\"End phrase\":\"Frase de finalización\",\"Team JSON\":\"JSON del equipo\",\"Update JSON from builder\":\"Actualizar JSON desde el editor\",\"Update the JSON after changing the builder. Saving and running use this JSON.\":\"Actualiza el JSON después de modificar el editor. Guardar y ejecutar usan este JSON.\",\"Save team\":\"Guardar equipo\",\"Saved teams\":\"Equipos guardados\",\"Load\":\"Cargar\",\"Delete\":\"Eliminar\",\"Run a team and watch the conversation live. When a human agent's turn comes, the box below asks you — the run waits (up to its timeout) for your words.\":\"Ejecuta un equipo y observa la conversación en vivo. Cuando sea el turno de un agente humano, el campo de abajo te pedirá una respuesta; la ejecución espera hasta su tiempo límite.\",\"Team\":\"Equipo\",\"Task\":\"Tarea\",\"What should the team do?\":\"¿Qué debe hacer el equipo?\",\"Run\":\"Ejecutar\",\"Your message to the team\":\"Tu mensaje para el equipo\",\"It's your turn — type your message\":\"Es tu turno: escribe tu mensaje\",\"The simple track: one pipeline of typed stages (plan → work → write → critique → revise). Budgets cap at the built-in ceilings (4 sub-tasks, 4 actions per worker, 24 model calls) no matter what the spec asks. Also at\":\"Un proceso de etapas: planificar → trabajar → redactar → revisar → corregir. Los límites son 4 subtareas, 4 acciones por trabajador y 24 llamadas al modelo, independientemente de la especificación. También en\",\"Pipeline name\":\"Nombre del proceso\",\"e.g. Research pipeline\":\"p. ej. Proceso de investigación\",\"Stages\":\"Etapas\",\"plan\":\"planificar\",\"work\":\"trabajar\",\"write (always)\":\"redactar (siempre)\",\"critique\":\"revisar\",\"revise\":\"corregir\",\"loading tools…\":\"cargando herramientas…\",\"Sub-tasks\":\"Subtareas\",\"Actions per worker\":\"Acciones por trabajador\",\"Worker goal (optional)\":\"Objetivo del trabajador (opcional)\",\"What each worker should do\":\"Qué debe hacer cada trabajador\",\"Pipeline JSON\":\"JSON del proceso\",\"Update the JSON after changing the builder. Running uses this JSON.\":\"Actualiza el JSON después de modificar el editor. La ejecución usa este JSON.\",\"What should the pipeline do?\":\"¿Qué debe hacer el proceso?\",\"Run team\":\"Ejecutar equipo\",\"Scores the current model on a fixed suite of objective tasks — arithmetic, instruction following, JSON output, extraction, and a tool-using agent case. Same tasks every run, so scores compare across models and app versions. Also at\":\"Evalúa el modelo con tareas fijas: aritmética, seguimiento de instrucciones, salida JSON, extracción y uso de herramientas. Las tareas se repiten para comparar modelos y versiones. También en\",\"Run benchmark\":\"Ejecutar evaluación\",\"Goes straight to the Koinos AI team. Crashes, confusion, ideas — all welcome.\":\"Se envía directamente al equipo de Koinos AI. Errores, dudas e ideas: todo es bienvenido.\",\"What happened? What did you expect?\":\"¿Qué ocurrió? ¿Qué esperabas?\",\"Email (optional — for a reply)\":\"Correo electrónico (opcional, para responderte)\",\"Include the app's diagnostic log (recommended — no chat content, no keys)\":\"Incluir registro de diagnóstico (recomendado; sin chats ni claves)\",\"Language\":\"Idioma\",\"App language\":\"Idioma de la app\",\"Choose your language\":\"Elige tu idioma\",\"Welcome to Koinos AI. Select your language to get started.\":\"Bienvenido a Koinos AI. Elige tu idioma para empezar.\",\"You can change this later in Settings.\":\"Puedes cambiarlo después en Configuración.\",\"Choose the language used for menus, settings, and setup. You can change it at any time.\":\"Elige el idioma de los menús, la configuración y la instalación inicial. Puedes cambiarlo cuando quieras.\",\"Language saved.\":\"Idioma guardado.\",\"Could not save the language. Please try again.\":\"No se pudo guardar el idioma. Inténtalo de nuevo.\",\"Could not load the language setting. Choose a language and try again.\":\"No se pudo cargar el idioma. Elige uno e inténtalo de nuevo.\",\"Core unreachable\":\"No se puede conectar con Core\",\"Downloading model… {0}%\":\"Descargando modelo… {0}%\",\"Downloading engine… {0}%\":\"Descargando motor… {0}%\",\"Setting up engine… (one time — takes a few minutes, the app stays usable)\":\"Preparando el motor… (solo una vez; tarda unos minutos y puedes seguir usando la app)\",\"Loading model…\":\"Cargando modelo…\",\"Model loaded\":\"Modelo cargado\",\"Ready (model loads on first message)\":\"Listo (el modelo se carga con el primer mensaje)\",\"Setup needed\":\"Se necesita configuración\",\"No models in catalog\":\"No hay modelos en el catálogo\",\"Desktop provider ready\":\"Proveedor de escritorio listo\",\"Model load failed{0}\":\"Error al cargar el modelo{0}\",\"System\":\"Sistema\",\"Memory\":\"Memoria\",\"None detected — running on CPU\":\"No se detectó ninguna; se usa la CPU\",\"From a first thought to the final draft.\":\"De la primera idea al borrador final.\",\"One question. A few different perspectives.\":\"Una pregunta. Varias perspectivas.\",\"Find the right mind for the job.\":\"Encuentra el modelo adecuado para el trabajo.\",\"Build a service. Connect with other agents.\":\"Crea un servicio. Conecta con otros agentes.\",\"Your world, remembered.\":\"Tu mundo, recordado.\",\"Give your routines to KAI.\":\"Deja tus rutinas en manos de KAI.\",\"Your accounts, your control.\":\"Tus cuentas, tu control.\",\"Put your ideas in motion.\":\"Pon tus ideas en marcha.\",\"Give your AI a few more abilities.\":\"Dale más capacidades a tu IA.\",\"Your models, connected to your workflow.\":\"Tus modelos, conectados a tu trabajo.\",\"Let your compute contribute.\":\"Haz que tu equipo contribuya.\",\"Make this space your own.\":\"Haz tuyo este espacio.\",\"Connected on your terms.\":\"Conectado según tus reglas.\",\"Build something you want to exist.\":\"Crea algo que quieras ver existir.\",\"Everything you need to get hands-on.\":\"Todo lo que necesitas para empezar.\",\"Your wallet. Your node. Your contribution.\":\"Tu billetera. Tu nodo. Tu contribución.\",\"Let’s get you ready.\":\"Vamos a prepararlo todo.\",\"Copy\":\"Copiar\",\"Copy message\":\"Copiar mensaje\",\"Copied\":\"Copiado\",\"Edit\":\"Editar\",\"Refresh\":\"Actualizar\",\"Retry\":\"Reintentar\",\"Back\":\"Atrás\",\"← Back\":\"← Atrás\",\"Next\":\"Siguiente\",\"Done\":\"Hecho\",\"Ready\":\"Listo\",\"Loading…\":\"Cargando…\",\"Working…\":\"Trabajando…\",\"Saving…\":\"Guardando…\",\"Saved\":\"Guardado\",\"Failed\":\"Fallido\",\"Error\":\"Error\",\"Unknown error\":\"Error desconocido\",\"Running\":\"En ejecución\",\"Stopped\":\"Detenido\",\"stopped\":\"detenido\",\"running\":\"en ejecución\",\"Paused\":\"En pausa\",\"Pending\":\"Pendiente\",\"Enabled\":\"Activado\",\"Disabled\":\"Desactivado\",\"On\":\"Activado\",\"Off\":\"Desactivado\",\"Online\":\"En línea\",\"Connected\":\"Conectado\",\"Connect\":\"Conectar\",\"Disconnect\":\"Desconectar\",\"Start\":\"Iniciar\",\"Stop Earning\":\"Dejar de ganar\",\"Details\":\"Detalles\",\"Name\":\"Nombre\",\"Description\":\"Descripción\",\"Status\":\"Estado\",\"Type\":\"Tipo\",\"Action\":\"Acción\",\"Actions\":\"Acciones\",\"Address\":\"Dirección\",\"Balance\":\"Saldo\",\"Balances\":\"Saldos\",\"Password\":\"Contraseña\",\"Confirm\":\"Confirmar\",\"Confirm transaction\":\"Confirmar transacción\",\"Transaction\":\"Transacción\",\"Transactions\":\"Transacciones\",\"Receive\":\"Recibir\",\"Sent\":\"Enviado\",\"Received\":\"Recibido\",\"Recipient\":\"Destinatario\",\"Fee\":\"Comisión\",\"Amount to send\":\"Cantidad a enviar\",\"Available\":\"Disponible\",\"Not available\":\"No disponible\",\"Copy to clipboard\":\"Copiar al portapapeles\",\"Export\":\"Exportar\",\"Download\":\"Descargar\",\"Install\":\"Instalar\",\"Uninstall\":\"Desinstalar\",\"Update\":\"Actualizar\",\"Open\":\"Abrir\",\"Search\":\"Buscar\",\"Clear\":\"Limpiar\",\"New\":\"Nuevo\",\"Yes\":\"Sí\",\"No\":\"No\",\"None\":\"Ninguno\",\"Never\":\"Nunca\",\"Not yet\":\"Todavía no\",\"Optional\":\"Opcional\",\"Required\":\"Obligatorio\",\"Advanced\":\"Avanzado\",\"General\":\"General\",\"Security\":\"Seguridad\",\"Privacy\":\"Privacidad\",\"Overview\":\"Resumen\",\"Activity\":\"Actividad\",\"History\":\"Historial\",\"Today\":\"Hoy\",\"Yesterday\":\"Ayer\",\"Total\":\"Total\",\"Options\":\"Opciones\",\"Default\":\"Predeterminado\",\"Configure\":\"Configurar\",\"Manage\":\"Gestionar\",\"View\":\"Ver\",\"Reset\":\"Restablecer\",\"Restart\":\"Reiniciar\",\"Test builds\":\"Versiones de prueba\",\"What's new\":\"Novedades\",\"Couldn't check — Core is not answering.\":\"No se pudo comprobar: Core no responde.\",\"Memories\":\"Recuerdos\",\"Memory graph\":\"Mapa de recuerdos\",\"Goals & tasks\":\"Objetivos y tareas\",\"Sources\":\"Fuentes\",\"Sync & changes\":\"Sincronización y cambios\",\"Awareness\":\"Percepción\",\"Orchestration\":\"Coordinación\",\"My workflows\":\"Mis flujos\",\"Run history\":\"Historial de ejecuciones\",\"Templates\":\"Plantillas\",\"Discover workflows\":\"Descubrir flujos\",\"Explore apps\":\"Explorar apps\",\"Connection settings\":\"Configuración de conexiones\",\"Custom APIs\":\"API personalizadas\",\"Models & other tools\":\"Modelos y otras herramientas\",\"KAI Brain\":\"Cerebro de KAI\",\"A memory of your world, built from what you choose to share.\":\"Un recuerdo de tu mundo, creado con lo que eliges compartir.\",\"Teach KAI a routine. Review the steps, then run it whenever you need.\":\"Enséñale una rutina a KAI. Revisa los pasos y ejecútala cuando quieras.\",\"Connect the apps you use and choose what KAI can do with them.\":\"Conecta tus apps y elige qué puede hacer KAI con ellas.\",\"Open the installed KAI desktop app\":\"Abre la app KAI instalada\",\"Brain, private API connections, and durable workflows are available in Koinos AI Test.\":\"Cerebro, conexiones privadas de API y flujos persistentes están disponibles en Koinos AI Test.\",\"Your companion data is locked\":\"Los datos del compañero están bloqueados\",\"Unlock your original OS keychain and restart KAI. Your saved data will stay intact.\":\"Desbloquea el llavero original del sistema y reinicia KAI. Tus datos guardados se conservarán.\",\"Add memory\":\"Añadir recuerdo\",\"Edit memory\":\"Editar recuerdo\",\"Your notes\":\"Tus notas\",\"Source removed\":\"Fuente eliminada\",\"Read source text\":\"Leer texto de la fuente\",\"A little more understanding, every day.\":\"Un poco más de comprensión, cada día.\",\"Memories, sources and priorities connected in one private place.\":\"Recuerdos, fuentes y prioridades conectados en un espacio privado.\",\"Export Markdown\":\"Exportar Markdown\",\"Topics\":\"Temas\",\"To review\":\"Por revisar\",\"Observing\":\"Observando\",\"Assisting\":\"Ayudando\",\"Run a check\":\"Realizar comprobación\",\"Open activity\":\"Abrir actividad\",\"Your daily briefing\":\"Tu resumen diario\",\"Build briefing\":\"Crear resumen\",\"Worth a look\":\"Vale la pena revisar\",\"You're all caught up\":\"Estás al día\",\"Your memory activity\":\"Actividad de tus recuerdos\",\"Use relevant Brain memories in private replies\":\"Usar recuerdos relevantes en respuestas privadas\",\"Your memories\":\"Tus recuerdos\",\"See how your world connects\":\"Descubre cómo se conecta tu mundo\",\"Search exact source text and your saved knowledge.\":\"Busca en el texto original y tus conocimientos guardados.\",\"Import file\":\"Importar archivo\",\"Source\":\"Fuente\",\"Topic\":\"Tema\",\"All sources\":\"Todas las fuentes\",\"All topics\":\"Todos los temas\",\"Updated since\":\"Actualizado desde\",\"People, topics, projects…\":\"Personas, temas, proyectos…\",\"Add a goal\":\"Añadir objetivo\",\"Goal\":\"Objetivo\",\"Goals\":\"Objetivos\",\"Priority\":\"Prioridad\",\"Due date\":\"Fecha límite\",\"High\":\"Alta\",\"Medium\":\"Media\",\"Low\":\"Baja\",\"Completed\":\"Completado\",\"Complete\":\"Completar\",\"Add source\":\"Añadir fuente\",\"Sync now\":\"Sincronizar ahora\",\"Sync\":\"Sincronizar\",\"Auto-sync\":\"Sincronización automática\",\"Local model\":\"Modelo local\",\"Source excerpts\":\"Extractos de fuentes\",\"New workflow\":\"Nuevo flujo de trabajo\",\"Import workflow\":\"Importar flujo\",\"Scheduled prompts\":\"Instrucciones programadas\",\"Manual\":\"Manual\",\"Schedule on\":\"Programación activada\",\"Schedule off\":\"Programación desactivada\",\"Draft · review required\":\"Borrador · requiere revisión\",\"Review & resume\":\"Revisar y reanudar\",\"Cancel run\":\"Cancelar ejecución\",\"Your first run starts here\":\"Tu primera ejecución empieza aquí\",\"Run a saved workflow to see its progress and results.\":\"Ejecuta un flujo guardado para ver su progreso y resultados.\",\"Make room for the work you enjoy\":\"Haz espacio para el trabajo que disfrutas\",\"Start from a template\":\"Empezar con una plantilla\",\"Project briefing\":\"Resumen del proyecto\",\"Weekly goal review\":\"Revisión semanal de objetivos\",\"API digest\":\"Resumen de API\",\"AI models\":\"Modelos de IA\",\"Provider settings\":\"Configuración del proveedor\",\"Local model library\":\"Biblioteca de modelos locales\",\"MCP, email & calendars\":\"MCP, correo y calendarios\",\"Open Tools\":\"Abrir Herramientas\",\"Add connection\":\"Añadir conexión\",\"Manual use only\":\"Solo uso manual\",\"Background reads allowed\":\"Lecturas en segundo plano permitidas\",\"Background reads off\":\"Lecturas en segundo plano desactivadas\",\"Open & test\":\"Abrir y probar\",\"Connect a custom API\":\"Conectar una API personalizada\",\"Start with an API template\":\"Empezar con una plantilla de API\",\"Source content\":\"Contenido de la fuente\",\"Workflow builder\":\"Editor de flujos\",\"API connection\":\"Conexión de API\",\"Use connection\":\"Usar conexión\",\"Add a Brain source\":\"Añadir fuente al Cerebro\",\"Start workflow\":\"Iniciar flujo\",\"Run input (optional)\":\"Datos de entrada (opcional)\",\"Start run\":\"Iniciar ejecución\",\"Category\":\"Categoría\",\"Pinned\":\"Fijado\",\"Content\":\"Contenido\",\"Save memory\":\"Guardar recuerdo\",\"Save goal\":\"Guardar objetivo\",\"Save workflow\":\"Guardar flujo\",\"Add step\":\"Añadir paso\",\"New step\":\"Nuevo paso\",\"Step\":\"Paso\",\"Steps\":\"Pasos\",\"Schedule\":\"Programación\",\"Trigger\":\"Activador\",\"Result\":\"Resultado\",\"Results\":\"Resultados\",\"Input\":\"Entrada\",\"Output\":\"Salida\",\"Approval\":\"Aprobación\",\"Approve\":\"Aprobar\",\"Reject\":\"Rechazar\",\"Deny\":\"Denegar\",\"Allow once\":\"Permitir una vez\",\"Always allow\":\"Permitir siempre\",\"Permissions\":\"Permisos\",\"Run now\":\"Ejecutar ahora\",\"Test connection\":\"Probar conexión\",\"Test action\":\"Probar acción\",\"Use template\":\"Usar plantilla\",\"Search apps\":\"Buscar apps\",\"Search apps…\":\"Buscar apps…\",\"All apps\":\"Todas las apps\",\"Connected apps\":\"Apps conectadas\",\"Reconnect\":\"Volver a conectar\",\"Remove connection\":\"Quitar conexión\",\"View details\":\"Ver detalles\",\"Local-First\":\"Local primero\",\"🔊 Read\":\"🔊 Leer\",\"⏹ Stop\":\"⏹ Detener\",\"📌 Remember\":\"📌 Recordar\",\"📌 Remembered\":\"📌 Recordado\",\"Open result ↗\":\"Abrir resultado ↗\",\"Quick syncing\":\"Sincronización rápida\",\"Quick Sync\":\"Sincronización rápida\",\"Quick sync\":\"Sincronización rápida\",\"Node Details\":\"Detalles del nodo\",\"Node details\":\"Detalles del nodo\",\"Node Value\":\"Valor del nodo\",\"Profit & Return\":\"Beneficio y rendimiento\",\"Network Details\":\"Detalles de la red\",\"Koinos Network\":\"Red Koinos\",\"Node status\":\"Estado del nodo\",\"Start node\":\"Iniciar nodo\",\"Stop node\":\"Detener nodo\",\"Producer wallet custody\":\"Custodia de la billetera del productor\",\"External signing\":\"Firma externa\",\"Connect Koin Vault\":\"Conectar Koin Vault\",\"Connect KOIN Vault\":\"Conectar KOIN Vault\",\"Prepare transaction\":\"Preparar transacción\",\"Import signed transaction\":\"Importar transacción firmada\",\"Broadcast\":\"Transmitir\",\"Copy unsigned JSON\":\"Copiar JSON sin firmar\",\"Download unsigned JSON\":\"Descargar JSON sin firmar\",\"Paste signed JSON\":\"Pegar JSON firmado\",\"Registered\":\"Registrado\",\"Not registered\":\"No registrado\",\"Register\":\"Registrar\",\"Producer\":\"Productor\",\"Block height\":\"Altura de bloque\",\"Local height\":\"Altura local\",\"Network height\":\"Altura de la red\",\"Progress\":\"Progreso\",\"Syncing\":\"Sincronizando\",\"Synced\":\"Sincronizado\",\"Healthy\":\"En buen estado\",\"Unhealthy\":\"Con problemas\",\"Services\":\"Servicios\",\"No services running.\":\"No hay servicios en ejecución.\",\"Data folder\":\"Carpeta de datos\",\"Open data folder\":\"Abrir carpeta de datos\",\"Change data folder\":\"Cambiar carpeta de datos\",\"Logs\":\"Registros\",\"View logs\":\"Ver registros\",\"Copy logs\":\"Copiar registros\",\"Rewards\":\"Recompensas\",\"Reburn\":\"Volver a quemar\",\"Distribute\":\"Distribuir\",\"Distribution\":\"Distribución\",\"Reinvest\":\"Reinvertir\",\"Percentage\":\"Porcentaje\",\"Last 24 hours\":\"Últimas 24 horas\",\"Last 7 days\":\"Últimos 7 días\",\"Last 30 days\":\"Últimos 30 días\",\"Mainnet\":\"Red principal\",\"Testnet\":\"Red de pruebas\",\"Desktop\":\"Escritorio\",\"Open Koinos AI\":\"Abrir Koinos AI\",\"Launch KAI companion\":\"Abrir compañero KAI\",\"Hide KAI companion\":\"Ocultar compañero KAI\",\"Quit Koinos AI\":\"Salir de Koinos AI\",\"KAI · Your desktop companion\":\"KAI · Tu compañero de escritorio\",\"KAI desktop companion\":\"Compañero de escritorio KAI\",\"Talk with KAI\":\"Hablar con KAI\",\"DESKTOP COMPANION\":\"COMPAÑERO DE ESCRITORIO\",\"Connecting to your app…\":\"Conectando con tu app…\",\"New conversation\":\"Nueva conversación\",\"Keep KAI on the desktop\":\"Mantener KAI en el escritorio\",\"Collapse conversation\":\"Contraer conversación\",\"Choose KAI's model\":\"Elegir el modelo de KAI\",\"Enable local listening for Hey KAI\":\"Activar escucha local de Hey KAI\",\"Hey KAI off\":\"Hey KAI desactivado\",\"Voice & listening\":\"Voz y escucha\",\"Voice and listening settings\":\"Configuración de voz y escucha\",\"A little voice. A lot of personality.\":\"Una voz pequeña. Mucha personalidad.\",\"Close voice settings\":\"Cerrar configuración de voz\",\"KAI's voice\":\"La voz de KAI\",\"Computer voice\":\"Voz del equipo\",\"Pocket voices · English\":\"Voces Pocket · Inglés\",\"One download, about 201 MB. Speech stays on your computer.\":\"Una descarga de unos 201 MB. La voz se procesa en tu equipo.\",\"Download Pocket voices\":\"Descargar voces Pocket\",\"Try Azelma\":\"Probar Azelma\",\"Voice credits\":\"Créditos de las voces\",\"Use fast Cute KAI\":\"Usar Cute KAI rápido\",\"Refresh voices\":\"Actualizar voces\",\"Add Windows voices ↗\":\"Añadir voces de Windows ↗\",\"Install speech voices in Windows Settings, then refresh this list. Available voices depend on your Windows installation.\":\"Instala voces en la Configuración de Windows y actualiza esta lista. Las voces disponibles dependen de tu instalación de Windows.\",\"Voice character\":\"Personalidad de la voz\",\"Cute KAI · bright & squeaky\":\"Cute KAI · alegre y agudo\",\"Classic KAI · deeper, softly robotic\":\"Classic KAI · más grave, suavemente robótico\",\"Natural · original sound\":\"Natural · sonido original\",\"Squeak\":\"Agudo\",\"Playful\":\"Juguetón\",\"Voice squeak\":\"Tono agudo de la voz\",\"Gentle\":\"Suave\",\"Extra squeaky\":\"Muy agudo\",\"Reply timing\":\"Momento de respuesta\",\"Quick start · first sentence\":\"Inicio rápido · primera frase\",\"Head start · two sentences\":\"Con margen · dos frases\",\"Whole reply · continuous playback\":\"Respuesta completa · reproducción continua\",\"Hear a hello\":\"Escuchar un saludo\",\"Get natural voices\":\"Obtener voces naturales\",\"Try Cute KAI with Bella. Hear a hello instantly, then download the local voice once for conversations.\":\"Prueba Cute KAI con Bella. Escucha un saludo al instante y descarga la voz local una vez para conversar.\",\"Just say “Hey KAI”\":\"Solo di «Hey KAI»\",\"Tap the mic and talk, or turn on Hey KAI and say your question. KAI listens for a finished thought before sending. Keep talking after KAI answers—you have a minute for follow-ups.\":\"Toca el micrófono y habla, o activa Hey KAI y haz tu pregunta. KAI espera a que termines la idea antes de enviarla. Después de su respuesta tienes un minuto para seguir hablando.\",\"Conversation pauses\":\"Pausas en la conversación\",\"Quick · short pauses\":\"Rápido · pausas breves\",\"Natural · room to pause\":\"Natural · espacio para pausar\",\"Patient · more time to think\":\"Paciente · más tiempo para pensar\",\"KAI combines a quiet pause with local semantic turn detection, so a breath in the middle of a thought is less likely to cut you off. If it waits, keep talking or tap the mic to send now. Saying “KAI” during a reply still stops it as soon as the name is recognized.\":\"KAI combina las pausas con detección semántica local para no interrumpirte al respirar. Si está esperando, sigue hablando o toca el micrófono para enviar. Decir «KAI» durante una respuesta la detiene cuando reconoce el nombre.\",\"Microphone sensitivity\":\"Sensibilidad del micrófono\",\"TV nearby · less sensitive\":\"TV cerca · menos sensible\",\"Everyday room · balanced\":\"Habitación normal · equilibrado\",\"Quiet room · more sensitive\":\"Habitación silenciosa · más sensible\",\"Microphone level\":\"Nivel del micrófono\",\"Microphone off\":\"Micrófono desactivado\",\"Local speech detection starts with the microphone.\":\"La detección local de voz empieza con el micrófono.\",\"With the mic on, background sound should stay below the listening level and your voice should rise above it. Move closer or choose a more sensitive setting if KAI misses you.\":\"Con el micrófono activado, el ruido de fondo debe quedar por debajo del nivel de escucha y tu voz por encima. Acércate o aumenta la sensibilidad si KAI no te detecta.\",\"Say “KAI” to interrupt\":\"Di «KAI» para interrumpir\",\"While KAI is answering, say “KAI” on its own or “KAI” followed by your new question. It stops when it recognizes the name. After the reply, just keep talking—follow-ups need no name.\":\"Mientras KAI responde, di «KAI» solo o seguido de tu nueva pregunta. Se detiene al reconocer el nombre. Después de la respuesta, sigue hablando sin decir el nombre.\",\"KAI does not identify your voice yet. Loud background dialogue can still sound like a question. The mic button always lets you stop a reply and ask directly.\":\"KAI todavía no identifica tu voz. Las conversaciones fuertes de fondo pueden parecerle preguntas. El botón del micrófono permite detener la respuesta y preguntar directamente.\",\"The chat can stay closed. Say “That’s all” to end the conversation, or “Stop listening” to turn the mic off. Audio stays on this computer; accepted questions go to your selected chat model. Hiding KAI turns the mic off.\":\"El chat puede permanecer cerrado. Di «That’s all» para terminar o «Stop listening» para apagar el micrófono. El audio queda en este equipo; las preguntas aceptadas se envían al modelo elegido. Ocultar KAI apaga el micrófono.\",\"KAI Eyes settings\":\"Configuración de KAI Eyes\",\"Let KAI see what you mean.\":\"Deja que KAI vea lo que quieres decir.\",\"Close KAI Eyes settings\":\"Cerrar configuración de KAI Eyes\",\"Screen and camera vision are session-only. KAI keeps six small frames in memory, attaches only the freshest view to a turn, and discards everything when you turn it off or hide KAI.\":\"La visión de pantalla y cámara solo dura esta sesión. KAI conserva seis imágenes pequeñas en memoria, adjunta solo la más reciente al mensaje y las descarta al desactivar la función u ocultar KAI.\",\"Screen\":\"Pantalla\",\"See the display KAI is sitting on\":\"Ver la pantalla donde está KAI\",\"Camera\":\"Cámara\",\"See what you choose to show KAI\":\"Ver lo que elijas mostrarle a KAI\",\"Choose a vision-capable brain, then turn on a source.\":\"Elige un modelo con visión y activa una fuente.\",\"A visible indicator stays on for the entire capture session. Frames never enter chat history or the Koinos Network. Local-Only still blocks private online models. Desktop clicks and typing remain a separate, per-task permission.\":\"Un indicador permanece visible durante toda la captura. Las imágenes nunca entran en el historial ni en Koinos Network. Solo local sigue bloqueando modelos privados en línea. Los clics y la escritura requieren un permiso independiente por tarea.\",\"Conversation\":\"Conversación\",\"A LITTLE ROBOT. A LOT OF HELP.\":\"UN PEQUEÑO ROBOT. UNA GRAN AYUDA.\",\"Hey, I'm KAI\":\"Hola, soy KAI\",\"Your app, a question away. Ask about your wallet, models, node, or the world outside.\":\"Tu app, a una pregunta de distancia. Pregunta por tu billetera, modelos, nodo o el mundo exterior.\",\"Check my KAI earnings\":\"Consultar mis ganancias de KAI\",\"Explore my models\":\"Explorar mis modelos\",\"Open my Pictures folder\":\"Abrir mi carpeta Imágenes\",\"Ask KAI anything…\":\"Pregúntale cualquier cosa a KAI…\",\"Talk to KAI\":\"Hablar con KAI\",\"Start voice input\":\"Iniciar entrada de voz\",\"Enter to send\":\"Enter para enviar\",\"Stop response\":\"Detener respuesta\",\"Send message\":\"Enviar mensaje\",\"Read KAI's replies aloud\":\"Leer en voz alta las respuestas de KAI\",\"Voice replies off\":\"Respuestas de voz desactivadas\",\"Open full app\":\"Abrir app completa\",\"Set up KAI's Pocket voice\":\"Configurar la voz Pocket de KAI\",\"Add KAI’s Pocket voice\":\"Añadir la voz Pocket de KAI\",\"Later\":\"Más tarde\",\"Set up KAI's natural voice\":\"Configurar la voz natural de KAI\",\"Meet KAI’s natural voice\":\"Conoce la voz natural de KAI\",\"Get natural voice\":\"Obtener voz natural\",\"Let KAI hear you\":\"Deja que KAI te escuche\",\"Set up listening\":\"Configurar escucha\",\"Dismiss message\":\"Descartar mensaje\",\"KAI Eyes capture active\":\"Captura de KAI Eyes activa\",\"KAI Eyes is active · click to review\":\"KAI Eyes está activo · clic para revisar\",\"Screen on\":\"Pantalla activada\",\"Here when you need me\":\"Aquí cuando me necesites\",\"KAI. Click to chat, or drag to move.\":\"KAI. Haz clic para chatear o arrastra para mover.\",\"Click to chat · Drag to move\":\"Clic para chatear · Arrastrar para mover\",\"Open chat\":\"Abrir chat\",\"Open or minimize chat\":\"Abrir o minimizar chat\",\"Hey KAI listening off\":\"Escucha Hey KAI desactivada\",\"Toggle Hey KAI listening\":\"Activar o desactivar escucha Hey KAI\",\"KAI options\":\"Opciones de KAI\",\"Say hello 👋\":\"Saludar 👋\",\"Desktop control\":\"Control del escritorio\",\"Animation on\":\"Animación activada\",\"Open full app ↗\":\"Abrir app completa ↗\",\"Hide KAI to tray\":\"Ocultar KAI en la bandeja\",\"Transaction ID copied (no explorer for this network)\":\"ID de transacción copiado (sin explorador para esta red)\",\"Producer data unavailable\":\"Datos de productores no disponibles\",\"💵 Profit & projected return\":\"💵 Beneficio y rendimiento previsto\",\"Koinos network\":\"Red Koinos\",\"View block producers ↗\":\"Ver productores de bloques ↗\",\"📡 Activity feed\":\"📡 Actividad\",\"Can't reach the app\":\"No se puede conectar con la app\",\"Active producers · ~24h\":\"Productores activos · ~24 h\",\"Produced within the last 28,800 blocks\":\"Produjeron en los últimos 28.800 bloques\",\"Recent producers · 2h\":\"Productores recientes · 2 h\",\"Produced within 2 hours · green status\":\"Produjeron en 2 horas · estado verde\",\"Tracked producer accounts\":\"Cuentas de productores registradas\",\"Recent producers plus VHP holders\":\"Productores recientes y titulares de VHP\",\"Last known data · refresh unavailable\":\"Últimos datos conocidos · actualización no disponible\",\"Mainnet only\":\"Solo red principal\",\"Counts unavailable · retrying…\":\"Recuentos no disponibles · reintentando…\",\"Loading counts…\":\"Cargando recuentos…\",\"Stopping node\":\"Deteniendo nodo\",\"Node stopped\":\"Nodo detenido\",\"Quick sync in progress\":\"Sincronización rápida en curso\",\"Needs attention\":\"Requiere atención\",\"Docker not ready — finish setup on the Node tab\":\"Docker no está listo; termina la configuración en la pestaña Nodo\",\"Set up node\":\"Configurar nodo\",\"{0}{1} blocks\":\"{0}{1} bloques\",\"in sync\":\"sincronizado\",\"syncing\":\"sincronizando\",\"producing stake\":\"participación para producción\",\"recharges over time\":\"se recarga con el tiempo\",\"Net worth\":\"Valor neto\",\"Blocks produced\":\"Bloques producidos\",\"Total rewards\":\"Recompensas totales\",\"VHP consumed\":\"VHP consumido\",\"spent producing\":\"gastado en producción\",\"Profit\":\"Beneficio\",\"rewards − VHP spent\":\"recompensas menos VHP gastado\",\"Total burned\":\"Total quemado\",\"Deposits in\":\"Depósitos recibidos\",\"at current rate\":\"al ritmo actual\",\"enable reburn to compound\":\"activa la reinversión para capitalizar\",\"no reburn set\":\"reinversión desactivada\",\"Daily profit\":\"Beneficio diario\",\"Weekly profit\":\"Beneficio semanal\",\"Monthly profit\":\"Beneficio mensual\",\"Yearly return\":\"Rendimiento anual\",\"Yearly + reburn\":\"Anual con reinversión\",\"history syncing — longer windows still catching up\":\"historial sincronizando; los períodos largos aún se están completando\",\"Create a wallet (Wallet tab) to see activity.\":\"Crea una billetera en la pestaña Billetera para ver la actividad.\",\"Activity history isn't available on {0} — it needs a history RPC (works on mainnet).\":\"El historial no está disponible en {0}; necesita un RPC de historial (funciona en la red principal).\",\"No activity yet. When your node produces a block, it appears here.\":\"Aún no hay actividad. Los bloques producidos por tu nodo aparecerán aquí.\",\"totals still syncing…\":\"totales sincronizando…\",\"Block\":\"Bloque\",\"Deposit\":\"Depósito\",\"Burned → VHP\":\"Quemado → VHP\",\"Sent out\":\"Enviado\",\"Node starting…\":\"Iniciando nodo…\",\"Stopping…\":\"Deteniendo…\",\"Stopping node…\":\"Deteniendo nodo…\",\"Welcome 👋\":\"Bienvenido 👋\",\"Set up a Koinos wallet to get started. It takes a few seconds — your key is generated locally and encrypted with a password on this computer.\":\"Configura una billetera Koinos para empezar. Solo tarda unos segundos: la clave se genera localmente y se cifra con una contraseña en este equipo.\",\"🆕 Create a new wallet\":\"🆕 Crear una billetera nueva\",\"Password (min {0} characters)\":\"Contraseña (mín. {0} caracteres)\",\"Create wallet\":\"Crear billetera\",\"You'll be shown a private key backup right after — write it down and keep it safe.\":\"Después se mostrará una copia de la clave privada: anótala y guárdala en un lugar seguro.\",\"📥 Import an existing wallet\":\"📥 Importar billetera existente\",\"Private key (WIF)\":\"Clave privada (WIF)\",\"New password for this device\":\"Nueva contraseña para este dispositivo\",\"Import wallet\":\"Importar billetera\",\"The key is encrypted with your password and stored only on this machine.\":\"La clave se cifra con tu contraseña y solo se guarda en este equipo.\",\"Unlock your wallet\":\"Desbloquear tu billetera\",\"Unlocking is required to burn, send, register the producer key, and for automatic reward returns.\":\"Debes desbloquear para quemar, enviar, registrar la clave del productor y devolver recompensas automáticamente.\",\"Enter\":\"Entrar\",\"🔒 Lock\":\"🔒 Bloquear\",\"Your address — share it to receive {0} or VHP.\":\"Tu dirección: compártela para recibir {0} o VHP.\",\"{0} (liquid)\":\"{0} (líquido)\",\"spendable + fuels mana\":\"disponible para gastar y generar maná\",\"virtual hash power for block production\":\"poder de hash virtual para producir bloques\",\"recharges over time, spent by transactions\":\"se recarga con el tiempo y se gasta en transacciones\",\"⟠ Ethereum & USDT\":\"⟠ Ethereum y USDT\",\"funding wallet\":\"billetera de financiación\",\"Your Ethereum funding address, derived from this same wallet key. Receive ETH or USDT here to fund the node, or send them back out.\":\"Tu dirección de financiación de Ethereum se deriva de la misma clave. Recibe ETH o USDT para financiar el nodo, o envíalos a otra dirección.\",\"Send only\":\"Envía únicamente\",\"ETH or USDT on Ethereum Mainnet\":\"ETH o USDT en la red principal de Ethereum\",\"to this address. Other networks/tokens may be lost.\":\"a esta dirección. Otros tokens o redes pueden causar pérdidas.\",\"Send ETH\":\"Enviar ETH\",\"Send USDT\":\"Enviar USDT\",\"Bridge→KOIN\":\"Puente → KOIN\",\"Explorer ↗\":\"Explorador ↗\",\"Wallet locked\":\"Billetera bloqueada\",\"Address copied\":\"Dirección copiada\",\"ETH address copied\":\"Dirección ETH copiada\",\"Recipient Ethereum address\":\"Dirección Ethereum del destinatario\",\"Amount (ETH)\":\"Cantidad (ETH)\",\"Max\":\"Máx.\",\"Enter a recipient and amount\":\"Introduce un destinatario y una cantidad\",\"Sending…\":\"Enviando…\",\"Getting quote…\":\"Obteniendo cotización…\",\"Not enough ETH for amount + gas (balance {0})\":\"ETH insuficiente para cantidad y gas (saldo {0})\",\"Not enough ETH (after gas)\":\"ETH insuficiente tras el gas\",\"Amount (USDT)\":\"Cantidad (USDT)\",\"Gas is paid in ETH — keep a little ETH in this address.\":\"El gas se paga en ETH; conserva algo de ETH en esta dirección.\",\"Not enough USDT.\":\"USDT insuficiente.\",\"Not enough ETH for gas.\":\"ETH insuficiente para el gas.\",\"No USDT balance\":\"Sin saldo de USDT\",\"Send vKOIN\":\"Enviar vKOIN\",\"Amount (vKOIN)\":\"Cantidad (vKOIN)\",\"Not enough vKOIN.\":\"vKOIN insuficiente.\",\"No vKOIN balance\":\"Sin saldo de vKOIN\",\"Bridge vKOIN → KOIN\":\"Puente vKOIN → KOIN\",\"native KOIN\":\"KOIN nativo\",\"Bridge to KOIN\":\"Usar puente a KOIN\",\"Enter a vKOIN amount\":\"Introduce una cantidad de vKOIN\",\"Passwords don't match\":\"Las contraseñas no coinciden\",\"Creating…\":\"Creando…\",\"🔑 Back up your private key now\":\"🔑 Guarda tu clave privada ahora\",\"This is the only time it will be shown automatically. Anyone with this key controls the wallet — write it down and store it offline.\":\"Esta es la única vez que se muestra automáticamente. Quien tenga esta clave controla la billetera: anótala y guárdala sin conexión.\",\"Address:\":\"Dirección:\",\"Copy key\":\"Copiar clave\",\"I saved my key\":\"Guardé mi clave\",\"Importing…\":\"Importando…\",\"Unlocking…\":\"Desbloqueando…\",\"Wallet unlocked\":\"Billetera desbloqueada\",\"Send tokens\":\"Enviar tokens\",\"Token\":\"Token\",\"Recipient address\":\"Dirección del destinatario\",\"Transfer\":\"Transferir\",\"External producer mode: prepare and sign burns through Node → External signing. KAI will not use the earning wallet.\":\"Productor externo: prepara y firma quemas en Nodo → Firma externa. KAI no usará la billetera de ganancias.\",\"Burn {0} → VHP\":\"Quemar {0} → VHP\",\"Burning converts liquid {0} into Virtual Hash Power (VHP) — the stake that lets your node produce blocks and earn rewards.\":\"Quemar convierte {0} líquido en poder de hash virtual (VHP), la participación que permite a tu nodo producir bloques y ganar recompensas.\",\"Create a wallet first (Wallet tab).\":\"Primero crea una billetera en la pestaña Billetera.\",\"Unlock your wallet to burn (Wallet tab).\":\"Desbloquea tu billetera en la pestaña Billetera para quemar.\",\"Burning converts liquid {0} into VHP 1:1. VHP is consumed slowly while producing blocks, and you earn {1} rewards in return.\":\"Quemar convierte {0} líquido en VHP 1:1. El VHP se consume gradualmente al producir bloques, a cambio de recompensas en {1}.\",\"🔥 Burn\":\"🔥 Quemar\",\"Balance:\":\"Saldo:\",\"Amount to burn ({0})\":\"Cantidad a quemar ({0})\",\"You will receive: —\":\"Recibirás: —\",\"Burn {0}\":\"Quemar {0}\",\"ℹ️ How it works\":\"ℹ️ Cómo funciona\",\"Amount exceeds your balance.\":\"La cantidad supera tu saldo.\",\"Not enough mana to burn this much right now (about {0} {1} available). Burning spends mana, which recharges over ~5 days — burn less or wait.\":\"Maná insuficiente para quemar esta cantidad (aprox. {0} {1} disponible). El maná se recarga en unos 5 días; quema menos o espera.\",\"This leaves less than {0} {1} liquid. You need liquid {2} for mana to keep transacting.\":\"Quedarían menos de {0} {1} líquidos. Necesitas {2} líquido para generar maná y seguir operando.\",\"Enter an amount to burn\":\"Introduce una cantidad a quemar\",\"Confirm burn\":\"Confirmar quema\",\"You are about to\":\"Estás a punto de\",\"permanently burn\":\"quemar permanentemente\",\"and receive\":\"y recibir\",\"VHP is only useful for producing blocks with a node. It converts back to {0} gradually through block rewards.\":\"VHP solo sirve para producir bloques con un nodo. Se convierte gradualmente en {0} mediante recompensas de bloques.\",\"Burn\":\"Quemar\",\"Burning…\":\"Quemando…\",\"Waiting for your approval in Koin Vault…\":\"Esperando tu aprobación en Koin Vault…\",\"Sending request to Koin Vault…\":\"Enviando solicitud a Koin Vault…\",\"Wallet is submitting your transaction…\":\"La billetera está enviando tu transacción…\",\"You rejected the request. Nothing was submitted by this request.\":\"Rechazaste la solicitud. Esta solicitud no envió nada.\",\"Transaction verified on-chain. For registration, click Verify registration before starting the node.\":\"Transacción verificada en la cadena. Para el registro, pulsa Verificar registro antes de iniciar el nodo.\",\"Connected. Use this producer wallet, generate a hot key, then sign its registration below.\":\"Conectado. Usa esta billetera de productor, genera una clave activa y firma su registro abajo.\",\"Scan with Koin Vault → Connect App. This connection expires in 30 minutes.\":\"Escanea con Koin Vault → Connect App. Esta conexión vence en 30 minutos.\",\"Mainnet · No wallet connected.\":\"Red principal · Sin billetera conectada.\",\"Koinos node\":\"Nodo Koinos\",\"📁 Data folder\":\"📁 Carpeta de datos\",\"⚡ Quick sync\":\"⚡ Sincronización rápida\",\"Runs the official Koinos microservices with Docker. First start downloads images and syncs the chain — this can take a while.\":\"Ejecuta los microservicios oficiales de Koinos con Docker. El primer inicio descarga imágenes y sincroniza la cadena; puede tardar bastante.\",\"Your KAI earning wallet stays separate from an external producer. Stop the node before changing custody or rotating its hot key.\":\"Tu billetera de ganancias KAI está separada del productor externo. Detén el nodo antes de cambiar la custodia o renovar su clave activa.\",\"Wallet mode\":\"Modo de billetera\",\"Local earning wallet (hot wallet)\":\"Billetera local de ganancias (activa)\",\"External/cold producer wallet\":\"Billetera de productor externa/fría\",\"Watch-only producer address\":\"Dirección de productor de solo lectura\",\"Public Koinos address only — never a private key\":\"Solo dirección pública Koinos; nunca una clave privada\",\"Save custody mode\":\"Guardar modo de custodia\",\"Generate hot key\":\"Generar clave activa\",\"Rotate hot key…\":\"Renovar clave activa…\",\"Verify registration\":\"Verificar registro\",\"Hot block-production public key\":\"Clave pública activa de producción de bloques\",\"Block-production public key\":\"Clave pública de producción de bloques\",\"Generate a hot key to view its public key\":\"Genera una clave activa para ver su clave pública\",\"Copy public key\":\"Copiar clave pública\",\"Connect your phone, use its wallet as your producer, then approve registration, burns and transfers with your fingerprint or device passkey. Your node keeps running after the phone disconnects.\":\"Conecta tu teléfono, usa su billetera como productor y aprueba registros, quemas y transferencias con tu huella o passkey. El nodo sigue funcionando después de desconectar el teléfono.\",\"Use this producer wallet\":\"Usar esta billetera de productor\",\"Disconnect / cancel approval\":\"Desconectar / cancelar aprobación\",\"Scan with Koin Vault Connect App\":\"Escanear con Koin Vault Connect App\",\"Open Koin Vault → Connect App → scan this QR and approve. Keep the wallet open for transaction requests.\":\"Abre Koin Vault → Connect App, escanea este QR y aprueba. Mantén la billetera abierta para recibir solicitudes.\",\"Open Koin Vault\":\"Abrir Koin Vault\",\"Copy connection link\":\"Copiar enlace de conexión\",\"Operation\":\"Operación\",\"Register hot public key\":\"Registrar clave pública activa\",\"Allow VHP for block production\":\"Permitir VHP para producir bloques\",\"Burn KOIN to this producer's VHP\":\"Quemar KOIN para el VHP de este productor\",\"Transfer tokens\":\"Transferir tokens\",\"Use full VHP balance\":\"Usar todo el saldo de VHP\",\"Also allow my full VHP balance for production\":\"También permitir todo mi VHP para producción\",\"Includes the new VHP. Both changes use one phone approval.\":\"Incluye el nuevo VHP. Ambos cambios usan una aprobación del teléfono.\",\"Koinos address\":\"Dirección Koinos\",\"For Koin Vault production, approve a VHP allowance after registering the hot key. Choose a limited amount up to your VHP balance, or 0 to revoke.\":\"Para producir con Koin Vault, aprueba un límite de VHP después de registrar la clave activa. Elige hasta tu saldo de VHP, o 0 para revocar.\",\"Review and sign with Koin Vault\":\"Revisar y firmar con Koin Vault\",\"External signing: registration, burns and transfers\":\"Firma externa: registros, quemas y transferencias\",\"Open Kondor signer\":\"Abrir firmante Kondor\",\"Copy signer link\":\"Copiar enlace del firmante\",\"Signing and backup guide\":\"Guía de firma y respaldo\",\"Prepare and download the unsigned JSON here. On your secure computer, open https://koinosai.com/producer-signer/ in the browser with Kondor, load the file, review and sign. Bring the signed JSON back and import it below. Your private key stays in Kondor. The offline helper remains available in the guide. Drafts last 15 minutes by default. For dual boot, select the 24-hour window before preparing; after restarting KAI, use Resume saved draft.\":\"Prepara y descarga aquí el JSON sin firmar. En tu equipo seguro, abre https://koinosai.com/producer-signer/ con Kondor, carga el archivo, revísalo y fírmalo. Trae el JSON firmado e impórtalo abajo. La clave privada permanece en Kondor. La guía incluye el asistente sin conexión. Los borradores duran 15 minutos. Para arranque dual, elige 24 horas antes de preparar; tras reiniciar KAI, usa Reanudar borrador guardado.\",\"Amount (burn/transfer)\":\"Cantidad (quema/transferencia)\",\"Token (transfer)\":\"Token (transferencia)\",\"Recipient (transfer)\":\"Destinatario (transferencia)\",\"Dual-boot / offline signing — keep this draft for 24 hours\":\"Arranque dual / firma sin conexión: conservar borrador 24 horas\",\"Resume saved draft\":\"Reanudar borrador guardado\",\"Prepare unsigned transaction\":\"Preparar transacción sin firmar\",\"Unsigned transaction — take this file to the secure computer\":\"Transacción sin firmar: lleva este archivo al equipo seguro\",\"Import signed JSON\":\"Importar JSON firmado\",\"Signed transaction JSON returned by your external signer\":\"JSON de transacción firmada devuelto por el firmante externo\",\"Paste signed transaction JSON only\":\"Pega solo JSON de transacción firmada\",\"I reviewed the actual operations, recipient, amount and network on my signing machine.\":\"Revisé las operaciones reales, el destinatario, la cantidad y la red en mi equipo de firma.\",\"Broadcast signed transaction\":\"Transmitir transacción firmada\",\"Previous chain backups\":\"Copias anteriores de la cadena\",\"Manage backups\":\"Gestionar copias de seguridad\",\"Quick Sync keeps the previous chain data. After the restored node is working, remove old backups here to reclaim space.\":\"La sincronización rápida conserva los datos anteriores. Cuando el nodo restaurado funcione, elimina aquí las copias antiguas para liberar espacio.\",\"📡 Status\":\"📡 Estado\",\"Recover after an unexpected stop\":\"Recuperar tras una detención inesperada\",\"— manual stops and quick sync keep the node stopped.\":\": las detenciones manuales y la sincronización rápida mantienen el nodo detenido.\",\"⛏️ Block production setup\":\"⛏️ Configurar producción de bloques\",\"Register signing key\":\"Registrar clave de firma\",\"📜 Logs\":\"📜 Registros\",\"all services\":\"todos los servicios\",\"Checking the signed transaction and submitting to the network…\":\"Verificando la transacción firmada y enviándola a la red…\",\"Custody saved. Automatic returns are off. Verify registration before starting production.\":\"Custodia guardada. Las devoluciones automáticas están desactivadas. Verifica el registro antes de producir.\",\"Hot key ready. Back up private.key and public.key securely from:\":\"Clave activa lista. Guarda private.key y public.key de forma segura desde:\",\"Rotate hot production key?\":\"¿Renovar la clave activa de producción?\",\"Stop the node first. KAI will preserve a local backup of the old hot key. Register the new public key with your external wallet before restarting production.\":\"Detén el nodo primero. KAI conservará una copia local de la clave anterior. Registra la nueva clave pública con tu billetera externa antes de reiniciar la producción.\",\"Rotate key\":\"Renovar clave\",\"Registration does not match yet. Sign and confirm the registration, then check again.\":\"El registro aún no coincide. Firma y confirma el registro y vuelve a comprobar.\",\"Koin Vault producer saved. Generate a hot key, then register it with Koin Vault below.\":\"Productor Koin Vault guardado. Genera una clave activa y regístrala con Koin Vault abajo.\",\"Create a connection QR first.\":\"Primero crea un QR de conexión.\",\"Click \\\"Use this producer wallet\\\" above first (stop the node if it is running), then generate a hot key before registering it.\":\"Primero pulsa «Usar esta billetera de productor» (detén el nodo si está activo) y genera una clave activa antes de registrarla.\",\"Preparing review…\":\"Preparando revisión…\",\"Review the request in KAI, then click Request wallet approval to send it to your phone.\":\"Revisa la solicitud en KAI y pulsa Solicitar aprobación para enviarla a tu teléfono.\",\"Set the official Proof-of-Burn contract's spending allowance to\":\"Establecer el límite de gasto del contrato oficial Proof-of-Burn en\",\"This replaces the remaining allowance. Block production consumes it as VHP converts to KOIN rewards. Renew it when exhausted; set 0 to revoke it. No tokens move now. Your hot key gains no transfer permission.\":\"Esto reemplaza el permiso restante. La producción lo consume al convertir VHP en KOIN. Renuévalo al agotarse o usa 0 para revocarlo. Ahora no se mueven tokens. Tu clave activa no obtiene permiso para transferir.\",\"Register this node's hot public key:\":\"Registrar la clave pública activa de este nodo:\",\"Permanently burn\":\"Quemar permanentemente\",\"for the same amount of VHP in your producer wallet.\":\"por la misma cantidad de VHP en tu billetera de productor.\",\"Also set the official PoB production allowance to\":\"También establecer el límite oficial de producción PoB en\",\": current VHP plus this burn. Both changes succeed together. This replaces the remaining allowance; later deposits need a new approval.\":\": VHP actual más esta quema. Ambos cambios se completan juntos. Reemplaza el permiso restante; depósitos posteriores requieren otra aprobación.\",\"to:\":\"a:\",\"Review Koin Vault request\":\"Revisar solicitud de Koin Vault\",\"Mainnet · Producer:\":\"Red principal · Productor:\",\"Next, review the same details in Koin Vault and approve with your fingerprint or device passkey. Wallet approval submits the transaction.\":\"Revisa los mismos datos en Koin Vault y aprueba con tu huella o passkey. Al aprobar en la billetera se envía la transacción.\",\"Request wallet approval\":\"Solicitar aprobación de la billetera\",\"Prepared only — nothing signed or broadcast. Review decoded operations on your separate signing machine.\":\"Solo preparada: no se ha firmado ni transmitido nada. Revisa las operaciones decodificadas en tu equipo de firma separado.\",\"Prepare a transaction first.\":\"Primero prepara una transacción.\",\"Invalid mana\":\"Maná no válido\",\"Choose or paste a valid signed transaction JSON file.\":\"Elige o pega un archivo JSON válido de transacción firmada.\",\"Choose a signed JSON file smaller than 100 KB.\":\"Elige un archivo JSON firmado de menos de 100 KB.\",\"External transaction\":\"Transacción externa\",\"The app will keep your node running automatically.\":\"La app mantendrá tu nodo en ejecución automáticamente.\",\"Automatic restart is off — you'll restart the node yourself.\":\"El reinicio automático está desactivado; debes reiniciar el nodo manualmente.\",\"Measuring backups…\":\"Midiendo copias de seguridad…\",\"Delete backup\":\"Eliminar copia de seguridad\",\"Size unavailable\":\"Tamaño no disponible\",\"No previous chain backups.\":\"No hay copias anteriores de la cadena.\",\"Delete previous chain backup?\":\"¿Eliminar la copia anterior de la cadena?\",\"This permanently deletes {0}. Confirm the restored node is working before removing your rollback copy. Active chain data, wallets and keys are kept.\":\"Esto elimina {0} de forma permanente. Comprueba que el nodo restaurado funciona antes de borrar la copia de recuperación. Los datos activos, billeteras y claves se conservan.\",\"⚡ Quick sync from official backup\":\"⚡ Sincronización rápida desde copia oficial\",\"Downloads the Koinos Foundation chain snapshot and installs it, so the node catches up in hours instead of syncing for days. Your wallet, node config, and peer identity are not touched; current chain data is set aside for rollback.\":\"Descarga e instala la instantánea de Koinos Foundation para ponerse al día en horas en lugar de días. No modifica la billetera, configuración ni identidad del nodo. Los datos anteriores se guardan para poder volver atrás.\",\"Snapshot size\":\"Tamaño de instantánea\",\"{0} (compressed)\":\"{0} (comprimido)\",\"Snapshot date\":\"Fecha de instantánea\",\"Free disk space\":\"Espacio libre en disco\",\"{0} (needs ~{1} during restore)\":\"{0} (necesita ~{1} durante la restauración)\",\"The download is verified against the published SHA-256 and the archive layout is checked before anything is installed. You can cancel at any time and resume later.\":\"La descarga se verifica con el SHA-256 publicado y se revisa el archivo antes de instalar. Puedes cancelar en cualquier momento y continuar después.\",\"Resumable\":\"Se puede reanudar\",\"{0} already downloaded\":\"{0} ya descargado\",\"Free space looks below the recommended headroom — the restore may fail mid-way. Free up disk first if possible.\":\"Parece haber menos espacio libre del recomendado; la restauración puede fallar. Libera espacio antes si puedes.\",\"The node is running — it will be stopped before the restore and can be started again right after.\":\"El nodo está activo. Se detendrá antes de restaurar y podrás iniciarlo después.\",\"Start quick sync\":\"Iniciar sincronización rápida\",\"Quick sync started — progress shows on this page\":\"Sincronización rápida iniciada; el progreso aparece aquí\",\"Start Koinos node\":\"Iniciar nodo Koinos\",\"Enable block production (uses producer address\":\"Activar producción de bloques (usa la dirección\",\"as producer)\":\"como productor)\",\"The node runs in Docker in the background and keeps running even if you close this app. First sync downloads the whole chain.\":\"El nodo se ejecuta en Docker en segundo plano y sigue activo aunque cierres la app. La primera sincronización descarga toda la cadena.\",\"not configured\":\"no configurado\",\"Node starting — pulling images and launching services…\":\"Iniciando nodo: descargando imágenes y servicios…\",\"Registering…\":\"Registrando…\",\"Producer key registration\":\"Registro de clave del productor\",\"(no output)\":\"(sin salida)\",\"Docker isn't available.\":\"Docker no está disponible.\",\"Docker install guide ↗\":\"Guía de instalación de Docker ↗\",\"Downloading Docker Desktop{0}\":\"Descargando Docker Desktop{0}\",\"🧰 Set up requirements\":\"🧰 Instalar requisitos\",\"one time · {0}\":\"una vez · {0}\",\"Re-check\":\"Volver a comprobar\",\"Download cancelled\":\"Descarga cancelada\",\"Restart Windows?\":\"¿Reiniciar Windows?\",\"Windows needs to restart to finish enabling WSL 2. This will restart your computer in 60 seconds — save any open work first. You can cancel during the countdown.\":\"Windows debe reiniciarse para terminar de activar WSL 2. El equipo se reiniciará en 60 segundos; guarda tu trabajo. Puedes cancelar durante la cuenta atrás.\",\"Not now\":\"Ahora no\",\"Restart in 60s\":\"Reiniciar en 60 s\",\"Windows will restart in 60 seconds.\":\"Windows se reiniciará en 60 segundos.\",\"Restart cancelled\":\"Reinicio cancelado\",\"Preparing snapshot restore\":\"Preparando restauración\",\"Downloading snapshot\":\"Descargando instantánea\",\"Verifying checksum\":\"Verificando suma de comprobación\",\"Inspecting archive\":\"Inspeccionando archivo\",\"Extracting chain data\":\"Extrayendo datos de la cadena\",\"Installing chain data\":\"Instalando datos de la cadena\",\"Cleaning up\":\"Limpiando\",\"Restore complete\":\"Restauración completa\",\"Restoring chain data\":\"Restaurando datos de la cadena\",\"Quick sync:\":\"Sincronización rápida:\",\"Cancelling quick sync — the download can be resumed later\":\"Cancelando sincronización rápida; podrás reanudar la descarga\",\"in progress…\":\"en curso…\",\"{0} failed:\":\"{0} falló:\",\"stopping for quick sync\":\"deteniendo para sincronización rápida\",\"stopped · quick syncing\":\"detenido · sincronización rápida\",\"needs attention\":\"requiere atención\",\"(recovered {0}× recently)\":\"(recuperado {0} veces recientemente)\",\"{0} Automatic recovery will not restart it during quick sync. Start the node after the restore finishes.\":\"{0} La recuperación automática no lo reiniciará durante la sincronización rápida. Inicia el nodo al terminar.\",\"The node is stopping for a snapshot restore.\":\"El nodo se está deteniendo para restaurar una instantánea.\",\"The node is stopped while quick sync restores the chain data. Block production is paused.\":\"El nodo está detenido mientras se restauran los datos. La producción de bloques está en pausa.\",\"Chain validation failed — block production is not healthy.\":\"Falló la validación de la cadena; la producción no funciona correctamente.\",\"🔧 Repair node data\":\"🔧 Reparar datos del nodo\",\"Block submissions rejected: could not burn VHP.\":\"Bloques rechazados: no se pudo quemar VHP.\",\"Last observed block submission was rejected.\":\"El último bloque observado fue rechazado.\",\"Open block_producer logs for the failure details. Running services and a registered key do not guarantee accepted blocks.\":\"Abre los registros de block_producer para ver los detalles. Servicios activos y una clave registrada no garantizan bloques aceptados.\",\"Getting your node back up — this takes a minute. You don't need to do anything.\":\"Recuperando tu nodo; tarda un minuto. No necesitas hacer nada.\",\"The node is not confirmed healthy ({0}). Block production may be interrupted. Check the chain logs{1}.\":\"El nodo no está confirmado en buen estado ({0}). La producción puede estar interrumpida. Revisa los registros{1}.\",\"status unavailable\":\"estado no disponible\",\"; automatic recovery is enabled\":\"; recuperación automática activada\",\"; automatic recovery is off\":\"; recuperación automática desactivada\",\"✓ Your node is running and healthy.{0}\":\"✓ Tu nodo está activo y en buen estado.{0}\",\"Start the node to sync the chain.\":\"Inicia el nodo para sincronizar la cadena.\",\"Waiting for local RPC… (services may still be starting)\":\"Esperando al RPC local… (los servicios pueden estar iniciándose)\",\"Head block time: {0}\":\"Hora del bloque más reciente: {0}\",\"Producer address configured\":\"Dirección del productor configurada\",\"Choose a local or external producer address above.\":\"Elige una dirección de productor local o externo arriba.\",\"VHP staked at your address\":\"VHP asignado en tu dirección\",\"Checking your VHP… no need to unlock — it's read from your public address.\":\"Comprobando tu VHP; no hace falta desbloquear, se lee de tu dirección pública.\",\"Node stopping for quick sync\":\"Nodo deteniéndose para sincronización rápida\",\"Node stopped for quick sync\":\"Nodo detenido para sincronización rápida\",\"Node running\":\"Nodo en ejecución\",\"Wait for the restore to finish, then start the node.\":\"Espera a que termine la restauración e inicia el nodo.\",\"Start the node above.\":\"Inicia el nodo arriba.\",\"Signing key generated\":\"Clave de firma generada\",\"Generated automatically by the node on first start.\":\"El nodo la genera automáticamente en su primer inicio.\",\"Signing key registered on chain\":\"Clave de firma registrada en la cadena\",\"Register it with the button below (needs unlocked wallet + mana).\":\"Regístrala con el botón de abajo (requiere billetera desbloqueada y maná).\",\"Last observed block submission failed\":\"El último intento observado de bloque falló\",\"VHP burn rejected. Approve a production allowance in Koin Vault; registration alone does not confirm successful production.\":\"Quema de VHP rechazada. Aprueba un límite de producción en Koin Vault; el registro por sí solo no confirma que estés produciendo.\",\"Check block_producer logs for the rejection reason.\":\"Revisa los registros de block_producer para ver el motivo del rechazo.\",\"External producer registration verified. The node holds only its hot production key.\":\"Registro del productor externo verificado. El nodo solo conserva su clave activa de producción.\",\"Use External signing above to register this hot key with your separate wallet.\":\"Usa Firma externa arriba para registrar esta clave con tu billetera separada.\",\"Signing key registered on chain.\":\"Clave de firma registrada en la cadena.\",\"⚠️ A different key is registered on chain for this address. Register the current node key to replace it.\":\"⚠️ Hay otra clave registrada para esta dirección. Registra la clave actual del nodo para reemplazarla.\",\"The signing key appears after the node's first start.\":\"La clave de firma aparece tras el primer inicio del nodo.\",\"Unlock your wallet to register.\":\"Desbloquea tu billetera para registrar.\",\"Block production is paused for quick sync.\":\"La producción está en pausa por la sincronización rápida.\",\"The node is stopped; no blocks are being produced here.\":\"El nodo está detenido; aquí no se producen bloques.\",\"Production also requires an in-sync node with block production enabled.\":\"Para producir, el nodo debe estar sincronizado y tener activada la producción.\",\"Resume\":\"Reanudar\",\"Continue?\":\"¿Continuar?\",\"Enter a recipient address\":\"Introduce una dirección de destinatario\",\"Enter an amount to send\":\"Introduce una cantidad a enviar\",\"Send real ETH?\":\"¿Enviar ETH real?\",\"on Ethereum Mainnet. This is irreversible. Continue?\":\"en la red principal de Ethereum. Es irreversible. ¿Continuar?\",\"Send it\":\"Enviar\",\"Sent ✓\":\"Enviado ✓\",\"Preparing…\":\"Preparando…\",\"Endpoint saved\":\"Punto de acceso guardado\",\"Automatic burns and transfers are disabled for your external producer. Use Node → External signing for each funds operation.\":\"Las quemas y transferencias automáticas están desactivadas para el productor externo. Usa Nodo → Firma externa para cada operación de fondos.\",\"⚙️ Configuration\":\"⚙️ Configuración\",\"Enable automatic returns\":\"Activar devoluciones automáticas\",\"Return percentage:\":\"Porcentaje de devolución:\",\"of new rewards\":\"de las nuevas recompensas\",\"What to do with returned {0}\":\"Qué hacer con {0} devuelto\",\"♻️ Compound — burn back into VHP (keeps node producing)\":\"♻️ Reinvertir: quemar de nuevo en VHP para seguir produciendo\",\"📤 Send to another address\":\"📤 Enviar a otra dirección\",\"Send returns to\":\"Enviar devoluciones a\",\"Only required when the destination changes\":\"Solo necesario al cambiar el destino\",\"Minimum return ({0})\":\"Devolución mínima ({0})\",\"Max per return ({0})\":\"Máximo por devolución ({0})\",\"0 = no limit\":\"0 = sin límite\",\"Check every (minutes)\":\"Comprobar cada (minutos)\",\"Check now\":\"Comprobar ahora\",\"Max per return\":\"Máximo por devolución\",\"📊 Status\":\"📊 Estado\",\"🧾 Return history\":\"🧾 Historial de devoluciones\",\"When\":\"Cuándo\",\"Returned\":\"Devuelto\",\"Mode\":\"Modo\",\"Return settings saved\":\"Configuración de devolución guardada\",\"no wallet\":\"sin billetera\",\"wallet locked\":\"billetera bloqueada\",\"RPC error\":\"error de RPC\",\"no history RPC\":\"sin RPC de historial\",\"reading history…\":\"leyendo historial…\",\"tracking started\":\"seguimiento iniciado\",\"low liquid KOIN\":\"poco KOIN líquido\",\"waiting for mana\":\"esperando maná\",\"tx failed\":\"transacción fallida\",\"config error\":\"error de configuración\",\"no checks yet\":\"aún sin comprobaciones\",\"Engine\":\"Motor\",\"Last check\":\"Última comprobación\",\"Next automatic check\":\"Próxima comprobación automática\",\"Lifetime rewards\":\"Recompensas acumuladas\",\"(Dashboard)\":\"(Panel)\",\"Rewards since enabled\":\"Recompensas desde la activación\",\"Pending return\":\"Devolución pendiente\",\"No returns yet.\":\"Aún no hay devoluciones.\",\"Network, RPC and wallet management.\":\"Gestión de red, RPC y billetera.\",\"🌐 Network\":\"🌐 Red\",\"🔌 Custom RPC (optional)\":\"🔌 RPC personalizado (opcional)\",\"Save settings\":\"Guardar configuración\",\"🔐 Wallet security\":\"🔐 Seguridad de la billetera\",\"Reveal private key\":\"Mostrar clave privada\",\"Remove wallet from this device\":\"Eliminar billetera de este dispositivo\",\"Files live in\":\"Los archivos están en\",\"open ↗\":\"abrir ↗\",\"local node RPC\":\"RPC del nodo local\",\"{0} RPC URL\":\"URL del RPC de {0}\",\"Settings saved\":\"Configuración guardada\",\"No wallet on this device\":\"No hay billetera en este dispositivo\",\"Enter your password. Never share this key or enter it on websites.\":\"Introduce tu contraseña. Nunca compartas esta clave ni la introduzcas en sitios web.\",\"⚠️ Remove wallet\":\"⚠️ Eliminar billetera\",\"This deletes the encrypted key file from this device.\":\"Esto elimina el archivo de clave cifrada de este dispositivo.\",\"Without a backup of the private key, the funds are lost forever.\":\"Sin una copia de la clave privada, los fondos se pierden para siempre.\",\"to confirm\":\"para confirmar\",\"Remove wallet\":\"Eliminar billetera\",\"Wallet removed from this device\":\"Billetera eliminada de este dispositivo\",\"Failed to start UI: {0}\":\"No se pudo iniciar la interfaz: {0}\",\"This machine\":\"Este equipo\",\"{0} — the desktop updater isn't available in this copy.\":\"{0} — el actualizador no está disponible en esta copia.\",\"{0} — couldn't contact the desktop updater. Restart the app and try again.\":\"{0} — no se pudo contactar con el actualizador. Reinicia la aplicación e inténtalo de nuevo.\",\"{0} — up to date. Checked just now.\":\"{0} — actualizado. Se acaba de comprobar.\",\"Koinos AI {0} is available — downloading it now. You'll be asked before restarting.\":\"Koinos AI {0} está disponible; se está descargando. Se te preguntará antes de reiniciar.\",\"Koinos AI {0} is ready and will install when you close the app.\":\"Koinos AI {0} está listo y se instalará cuando cierres la aplicación.\",\"Koinos AI {0} is available and ready to download.\":\"Koinos AI {0} está disponible para descargar.\",\"{0} — updates install themselves.\":\"{0} — las actualizaciones se instalan automáticamente.\",\"{0} — up to date ({1}), installed from source.\":\"{0} — actualizado ({1}), instalado desde el código fuente.\",\"{0} — installed from source, {1}. {2}\":\"{0} — instalado desde el código fuente, {1}. {2}\",\"Open wallet\":\"Abrir cartera\",\"Set up wallet\":\"Configurar cartera\",\"Wallet balance unavailable\":\"Saldo de la cartera no disponible\",\"Testnet balance has no USD value\":\"El saldo de la red de pruebas no tiene valor en USD\",\"KOIN price is out of date\":\"El precio de KOIN está desactualizado\",\"KOIN price unavailable\":\"Precio de KOIN no disponible\",\"Estimated wallet value in USD\":\"Valor estimado de la cartera en USD\",\"KOIN\":\"KOIN\",\"KOIN · Earnings & wallet\":\"KOIN · Ganancias y cartera\",\"Contribute AI capacity, track network rewards and manage your KOIN wallet.\":\"Aporta capacidad de IA, consulta las recompensas de la red y gestiona tu cartera KOIN.\",\"KOIN rewards are in preparation\":\"Las recompensas KOIN están en preparación\",\"This Test build measures availability without paying KOIN rewards. Purchases and claims will open after contract verification. Your existing mainnet wallet remains available below.\":\"Esta versión Test mide la disponibilidad sin pagar recompensas KOIN. Las compras y los retiros de recompensas se habilitarán tras verificar los contratos. Tu cartera de la red principal sigue disponible abajo.\",\"Launch policy: up to 5% of the free reward pool per day; 70% for verified availability and 30% for paid work. Unused rewards remain in the pool.\":\"Política de lanzamiento: hasta el 5% del fondo de recompensas libre al día; 70% por disponibilidad verificada y 30% por trabajo pagado. Las recompensas no utilizadas permanecen en el fondo.\",\"AI usage credits\":\"Créditos de uso de IA\",\"Credits will be prepaid with KOIN. Unused funds stay reserved; only consumed usage is split: 60% to rewards, 25% to mining and 15% to operations.\":\"Los créditos se pagarán por adelantado con KOIN. Los fondos sin utilizar quedan reservados; solo el uso consumido se reparte: 60% a recompensas, 25% a minería y 15% a operaciones.\",\"Purchases not active\":\"Compras no activas\",\"Claims not active\":\"Retiros de recompensas no activos\",\"Legacy test KAI\":\"KAI de pruebas anterior\",\"Historical test balances are separate from KOIN. No conversion or distribution has been applied.\":\"Los saldos de pruebas anteriores están separados de KOIN. No se ha aplicado ninguna conversión ni distribución.\",\"Available to claim\":\"Disponible para retirar\",\"Usage credits\":\"Créditos de uso\",\"Not active\":\"No activo\",\"Availability estimate (simulation)\":\"Estimación de disponibilidad (simulación)\",\"Paid-work estimate (simulation)\":\"Estimación de trabajo pagado (simulación)\",\"Awaiting verified data\":\"Esperando datos verificados\",\"Capacity status\":\"Estado de capacidad\",\"Verified for shadow scoring\":\"Verificado para puntuación simulada\",\"Awaiting capacity verification\":\"Esperando verificación de capacidad\",\"Local-Only mode\":\"Modo solo local\",\"No capacity report\":\"Sin informe de capacidad\",\"Awaiting master integration\":\"Esperando integración del nodo maestro\",\"Legacy test KAI balance\":\"Saldo anterior de KAI de pruebas\",\"Legacy prepaid balance\":\"Saldo prepagado anterior\",\"Legacy epoch\":\"Época anterior\",\"Online — serving{0}\":\"En línea — prestando servicio{0}\",\"Preview a spending review\":\"Vista previa de una revisión de gasto\",\"See the model, maximum request cost and session limits before reviewing an example. Prices are illustrative; paid requests are not active.\":\"Consulta el modelo, el coste máximo de la solicitud y los límites de sesión antes de revisar un ejemplo. Los precios son ilustrativos; las solicitudes de pago no están activas.\",\"Preview review\":\"Ver ejemplo de revisión\",\"Review the example in the desktop dialog.\":\"Revisa el ejemplo en el diálogo de la aplicación.\",\"Example reviewed. No request was signed or sent.\":\"Ejemplo revisado. No se firmó ni envió ninguna solicitud.\",\"Preview cancelled. No KOIN was spent.\":\"Vista previa cancelada. No se gastó KOIN.\",\"Preview unavailable. Please try again.\":\"Vista previa no disponible. Inténtalo de nuevo.\",\"Example prices only. No KOIN will be spent.\":\"Solo precios de ejemplo. No se gastará KOIN.\",\"Simulation only. No KOIN will be spent.\":\"Solo simulación. No se gastará KOIN.\",\"Tariff version\":\"Versión de tarifa\",\"Input tokens\":\"Tokens de entrada\",\"Maximum output tokens\":\"Máximo de tokens de salida\",\"Maximum request cost\":\"Coste máximo de la solicitud\",\"Per-request limit\":\"Límite por solicitud\",\"Session available\":\"Disponible en la sesión\",\"Session total limit\":\"Límite total de sesión\",\"Requests remaining\":\"Solicitudes restantes\",\"Review expires (UTC)\":\"La revisión caduca (UTC)\",\"Session\":\"Sesión\",\"Quote\":\"Cotización\",\"Reviewing does not sign or submit a request.\":\"La revisión no firma ni envía ninguna solicitud.\",\"KOIN · Review preview\":\"KOIN · Vista previa de revisión\",\"Review one simulated request\":\"Revisa una solicitud simulada\",\"Mark example reviewed\":\"Marcar ejemplo como revisado\",\"KOIN session rehearsal\":\"Ensayo de sesión KOIN\",\"Approve a bounded session once. This developer rehearsal does not enable paid chat or move KOIN.\":\"Aprueba una sesión con límites una sola vez. Este ensayo para desarrolladores no activa el chat de pago ni mueve KOIN.\",\"Review session limits\":\"Revisar límites de sesión\",\"Retry saved approval\":\"Reintentar aprobación guardada\",\"Refresh session\":\"Actualizar sesión\",\"Revoke session approval\":\"Revocar aprobación de sesión\",\"Stop new requests for this session?\":\"¿Detener las nuevas solicitudes de esta sesión?\",\"Dispatched work stays reserved. This does not refund on-chain credits.\":\"El trabajo asignado mantiene su reserva. Esto no reembolsa créditos en la cadena.\",\"Approve one bounded rehearsal session\":\"Aprobar una sesión de ensayo con límites\",\"This signs a session approval for accounting tests. No KOIN will be spent.\":\"Esto firma una aprobación de sesión para pruebas contables. No se gastará KOIN.\",\"Maximum requests\":\"Máximo de solicitudes\",\"Session expires (UTC)\":\"La sesión caduca (UTC)\",\"Spending grant\":\"Autorización de gasto\",\"Credits contract\":\"Contrato de créditos\",\"Contract bytecode\":\"Bytecode del contrato\",\"Tariff policy\":\"Política de tarifas\",\"Requests within these limits reuse this approval. Revoking it stops new requests.\":\"Las solicitudes dentro de estos límites reutilizan esta aprobación. Revocarla detiene las nuevas solicitudes.\",\"Live payments require a separate authorization and are not enabled by this signature.\":\"Los pagos reales requieren otra autorización y esta firma no los activa.\",\"Approve session rehearsal\":\"Aprobar ensayo de sesión\",\"No session approval saved. Review the limits to begin.\":\"No hay una aprobación de sesión guardada. Revisa los límites para empezar.\",\"Session approved for accounting rehearsal. Paid chat remains disabled.\":\"Sesión aprobada para ensayo contable. El chat de pago sigue desactivado.\",\"Session approval revoked. Dispatched work stays reserved.\":\"Aprobación de sesión revocada. El trabajo asignado mantiene su reserva.\",\"Session approval expired.\":\"La aprobación de sesión ha caducado.\",\"Session action cancelled.\":\"Acción de sesión cancelada.\",\"The session result is uncertain. Refresh or retry the saved approval.\":\"El resultado de la sesión es incierto. Actualiza o reintenta la aprobación guardada.\",\"The account grant is unavailable. New requests are blocked.\":\"La autorización de la cuenta no está disponible. Se bloquean las nuevas solicitudes.\",\"Session accounting needs reconciliation. New requests are blocked.\":\"La contabilidad de la sesión requiere conciliación. Se bloquean las nuevas solicitudes.\",\"Session rehearsal unavailable. Retry the saved approval if a response was lost.\":\"Ensayo de sesión no disponible. Reintenta la aprobación guardada si se perdió una respuesta.\",\"Input price per 1M tokens\":\"Precio de entrada por 1 M de tokens\",\"Output price per 1M tokens\":\"Precio de salida por 1 M de tokens\"},\"pt-BR\":{\"Minimize\":\"Minimizar\",\"Maximize\":\"Maximizar\",\"Close\":\"Fechar\",\"THINK · BUILD · GROW\":\"PENSE · CRIE · CRESÇA\",\"Main navigation\":\"Navegação principal\",\"Workspace\":\"Área de trabalho\",\"Chat with KAI\":\"Conversar com KAI\",\"Brain\":\"Cérebro\",\"Workflows\":\"Fluxos de trabalho\",\"Connections\":\"Conexões\",\"Agents\":\"Agentes\",\"Documents\":\"Documentos\",\"Compare models\":\"Comparar modelos\",\"Your toolkit\":\"Suas ferramentas\",\"Model library\":\"Biblioteca de modelos\",\"Tools\":\"Ferramentas\",\"Tasks\":\"Tarefas\",\"Local API\":\"API local\",\"Developer tools\":\"Ferramentas de desenvolvimento\",\"Contribute\":\"Contribuir\",\"Earn KAI\":\"Ganhar KAI\",\"Launch KAI\":\"Abrir KAI\",\"A little help, always close\":\"Uma ajuda sempre por perto\",\"Connecting…\":\"Conectando…\",\"Settings\":\"Configurações\",\"Network\":\"Rede\",\"Send feedback\":\"Enviar comentários\",\"Your workspace. Your choice of AI.\":\"Seu espaço. Você escolhe a IA.\",\"YOUR AI WORKSPACE\":\"SUA ÁREA DE IA\",\"A little curiosity goes a long way.\":\"Um pouco de curiosidade vai longe.\",\"Welcome to Koinos AI\":\"Boas-vindas ao Koinos AI\",\"Let’s find your first local model. You can also connect OpenAI or Anthropic in desktop Settings, or explore the network.\":\"Vamos encontrar seu primeiro modelo local. Você também pode conectar OpenAI ou Anthropic nas Configurações do aplicativo, ou explorar a rede.\",\"Download & start\":\"Baixar e iniciar\",\"Starting…\":\"Iniciando…\",\"Start a new chat\":\"Iniciar uma nova conversa\",\"+ New chat\":\"+ Nova conversa\",\"Search chats…\":\"Buscar conversas…\",\"Chats\":\"Conversas\",\"Conversations\":\"Conversas\",\"Make room for your next idea.\":\"Abra espaço para sua próxima ideia.\",\"YOUR EVERYDAY SIDEKICK\":\"SEU COMPANHEIRO DO DIA A DIA\",\"Hi, I’m KAI\":\"Olá, sou o KAI\",\"Let’s do something amazing.\":\"Vamos fazer algo incrível.\",\"Ask a question, explore an idea, or get a hand with your next project.\":\"Faça uma pergunta, explore uma ideia ou receba ajuda com seu próximo projeto.\",\"Help me understand something new. Ask me what I’m curious about.\":\"Ajude-me a entender algo novo. Pergunte o que desperta minha curiosidade.\",\"Answer a question\":\"Responder uma pergunta\",\"Make the complicated click.\":\"Entenda o que parece complicado.\",\"Help me turn an idea into a project. Ask me what I want to build.\":\"Ajude-me a transformar uma ideia em um projeto. Pergunte o que quero criar.\",\"Help me build\":\"Ajude-me a criar\",\"Big ideas start small.\":\"Grandes ideias começam pequenas.\",\"Let’s brainstorm some fresh ideas. Ask me what I’m working on.\":\"Vamos pensar em novas ideias. Pergunte no que estou trabalhando.\",\"Find a fresh idea\":\"Encontrar uma nova ideia\",\"A different way to think.\":\"Uma nova forma de pensar.\",\"Choose your AI below. Local, network, or your own desktop connection.\":\"Escolha sua IA abaixo: local, da rede ou sua própria conexão no aplicativo.\",\"How to answer: plain chat, multi-step web research, an agent that uses tools, or a whole AI team\":\"Como responder: conversa, pesquisa na web, agente com ferramentas ou equipe de IA\",\"Chat\":\"Conversa\",\"Research\":\"Pesquisa\",\"Agent\":\"Agente\",\"Research team\":\"Equipe de pesquisa\",\"Analyst team (code)\":\"Equipe de análise (código)\",\"Write & review team\":\"Equipe de redação e revisão\",\"Choose this machine, Koinos Network, or a private desktop provider\":\"Escolha este computador, Koinos Network ou um provedor privado no aplicativo\",\"Which model answers\":\"Qual modelo responde\",\"How the AI should answer\":\"Como a IA deve responder\",\"Default style\":\"Estilo padrão\",\"Concise\":\"Conciso\",\"Explain simply\":\"Explicar de forma simples\",\"Code helper\":\"Ajuda com código\",\"Custom…\":\"Personalizado…\",\"Your message to KAI\":\"Sua mensagem para KAI\",\"Ask KAI anything, or dream something up…\":\"Pergunte algo ao KAI ou imagine algo novo…\",\"Attach a text file as context\":\"Anexar arquivo de texto como contexto\",\"Web search: the AI looks things up live (your search query leaves this machine)\":\"Busca na web: a IA pesquisa informações atuais (sua consulta sai deste computador)\",\"Voice input: speak, and it's typed for you — transcribed on this machine, audio never leaves it\":\"Entrada de voz: fale e o texto será transcrito neste computador; o áudio nunca sai dele\",\"Send\":\"Enviar\",\"Stop\":\"Parar\",\"Remove attachment\":\"Remover anexo\",\"Describe how the AI should behave, e.g. “You are a pirate. Answer everything in character.”\":\"Descreva como a IA deve se comportar, por exemplo: “Você é um pirata. Responda sempre no personagem.”\",\"+ New\":\"+ Novo\",\"Title\":\"Título\",\"Write here. Select some text (or nothing, for the whole document) and use the AI bar below — suggestions preview first, and only Apply changes your words.\":\"Escreva aqui. Selecione um texto (ou nada para usar o documento inteiro) e use a barra de IA. As sugestões aparecem primeiro; só Aplicar altera seu texto.\",\"Model for suggestions\":\"Modelo para sugestões\",\"Improve\":\"Melhorar\",\"Fix grammar\":\"Corrigir gramática\",\"Shorten\":\"Encurtar\",\"Expand\":\"Expandir\",\"Continue\":\"Continuar\",\"…or tell it what to do (e.g. “make this friendlier”)\":\"…ou diga o que fazer (por exemplo, “deixe mais amigável”)\",\"Go\":\"Ir\",\"Suggestion\":\"Sugestão\",\"Apply\":\"Aplicar\",\"Discard\":\"Descartar\",\"One prompt, two models, blind. Answers stream one at a time (they share the machine), then you reveal which was which. Pick winners to learn which model earns its size.\":\"Uma pergunta, dois modelos sem identificação. As respostas chegam uma por vez porque compartilham este computador; depois os modelos são revelados. Escolha os vencedores para comparar a qualidade.\",\"Ask both models the same thing…\":\"Faça a mesma pergunta aos dois modelos…\",\"Run both\":\"Executar ambos\",\"Answer 1\":\"Resposta 1\",\"Answer 2\":\"Resposta 2\",\"Reveal models\":\"Revelar modelos\",\"Which answer was better?\":\"Qual resposta foi melhor?\",\"Tie\":\"Empate\",\"Scheduled tasks\":\"Tarefas agendadas\",\"A prompt that runs itself — hourly, daily, or weekly — and drops its answer into your chats. Tasks run while Koinos AI is open, on whichever model you choose, with the same privacy rules as typed chat.\":\"Uma instrução é executada a cada hora, dia ou semana e deixa a resposta nas conversas. As tarefas são executadas enquanto o Koinos AI está aberto, com o modelo escolhido e as mesmas regras de privacidade da conversa.\",\"Name (e.g. Morning writing prompt)\":\"Nome (por exemplo, Exercício de escrita matinal)\",\"The prompt to run, e.g. “Give me one unusual writing prompt and a first line.”\":\"Instrução, por exemplo: “Dê uma ideia de escrita original e uma primeira frase.”\",\"Every hour\":\"A cada hora\",\"Every 6 hours\":\"A cada 6 horas\",\"Daily\":\"Diariamente\",\"Weekly\":\"Semanalmente\",\"Mon\":\"Seg\",\"Tue\":\"Ter\",\"Wed\":\"Qua\",\"Thu\":\"Qui\",\"Fri\":\"Sex\",\"Sat\":\"Sáb\",\"Sun\":\"Dom\",\"Add task\":\"Adicionar tarefa\",\"Network status\":\"Status da rede\",\"A live look at the Koinos network — the computers online right now and the models they serve. Refreshes every 15 seconds while open.\":\"Os computadores conectados à rede Koinos e os modelos que oferecem, em tempo real. Atualiza a cada 15 segundos enquanto esta tela está aberta.\",\"Computers online\":\"Computadores online\",\"Model classes live\":\"Classes de modelos ativas\",\"Jobs waiting\":\"Trabalhos na fila\",\"Models on the network\":\"Modelos na rede\",\"Computers\":\"Computadores\",\"Tools & accounts\":\"Ferramentas e contas\",\"Give your AI abilities: tool servers (MCP), a memory that lasts across chats, and your email & calendar. Everything asks before acting until you say otherwise.\":\"Adicione servidores de ferramentas (MCP), memória entre conversas, e-mail e calendário. Ações pedem permissão até você indicar o contrário.\",\"Privacy mode is\":\"O modo de privacidade é\",\"Local-Only\":\"Somente local\",\": tools that talk to the internet (including email & calendar) are switched off. Change it in Local API → Privacy.\":\": ferramentas da internet (incluindo e-mail e calendário) estão desativadas. Altere em API local → Privacidade.\",\"Tool servers\":\"Servidores de ferramentas\",\"Add\":\"Adicionar\",\"Add your own (URL or command)\":\"Adicionar o seu (URL ou comando)\",\"Name, e.g. My tools\":\"Nome, por exemplo, Minhas ferramentas\",\"https://… (an MCP server URL)\":\"https://… (URL de um servidor MCP)\",\"or a local command, e.g. npx -y @modelcontextprotocol/server-fetch\":\"ou um comando local, por exemplo, npx -y @modelcontextprotocol/server-fetch\",\"Add server\":\"Adicionar servidor\",\"Manage everything KAI remembers in Brain → Memories.\":\"Gerencie tudo que KAI lembra em Cérebro → Memórias.\",\"Email\":\"E-mail\",\"Calendar\":\"Calendário\",\"Models\":\"Modelos\",\"Trusted models, verified by checksum before first use. Chat picks any model that's on this machine; bigger models answer better and download once.\":\"Modelos confiáveis, verificados por soma de verificação antes do primeiro uso. A conversa pode usar qualquer modelo deste computador; modelos maiores costumam responder melhor e são baixados uma vez.\",\"Import your own model\":\"Importar seu próprio modelo\",\"Any GGUF file on this machine. It's verified (hashed) once and used in place — nothing is copied or uploaded.\":\"Qualquer arquivo GGUF deste computador. É verificado uma vez e usado no local: nada é copiado ou enviado.\",\"Full path to a .gguf file\":\"Caminho completo do arquivo .gguf\",\"Import\":\"Importar\",\"Choose file…\":\"Escolher arquivo…\",\"Earn with your hardware\":\"Ganhe com seu hardware\",\"Run approved AI jobs for the network and earn KAI. Alpha runs on the Koinos testnet — rewards are test tokens while the network hardens.\":\"Processe trabalhos de IA aprovados para a rede e ganhe KAI. A versão alfa usa a rede de testes Koinos: as recompensas são tokens de teste enquanto a rede é aprimorada.\",\"Create your earning account\":\"Criar sua conta de ganhos\",\"A wallet is created on this machine. Its key never leaves your computer and is never shared with apps or the network.\":\"Uma carteira é criada neste computador. Sua chave nunca sai dele e nunca é compartilhada com aplicativos ou com a rede.\",\"Choose a password (min 8 chars)\":\"Escolha uma senha (mín. 8 caracteres)\",\"show\":\"mostrar\",\"Confirm password\":\"Confirmar senha\",\"Create\":\"Criar\",\"Backup key — shown only once. Write it down, then continue:\":\"Chave de backup: exibida uma única vez. Anote antes de continuar:\",\"I saved it\":\"Já salvei\",\"Unlock your earning account\":\"Desbloquear sua conta de ganhos\",\"Wallet password\":\"Senha da carteira\",\"Unlock\":\"Desbloquear\",\"Forgot your password? Restore with your backup code\":\"Esqueceu a senha? Restaure com seu código de backup\",\"Restore from backup code\":\"Restaurar com código de backup\",\"Enter the backup code you wrote down when the account was created, and choose a new password. Your address and balance stay the same.\":\"Digite o código de backup anotado ao criar a conta e escolha uma nova senha. Seu endereço e saldo não mudam.\",\"Backup code\":\"Código de backup\",\"New password (min 8 chars)\":\"Nova senha (mín. 8 caracteres)\",\"Confirm new password\":\"Confirmar nova senha\",\"Restore\":\"Restaurar\",\"Offline\":\"Offline\",\"Scheduler URL (from the project)\":\"URL do coordenador (do projeto)\",\"Start Earning\":\"Começar a ganhar\",\"Stopping is immediate — no job runs after you press Stop.\":\"A parada é imediata: nenhum trabalho é executado após clicar em Parar.\",\"Network usage & balance\":\"Uso da rede e saldo\",\"Network AI is billed like any modern AI API — by input and output tokens, per model — and settles in KAI underneath. Add funds by converting KAI at the current reference price, or keep earning: serving the network covers your own usage.\":\"A IA da rede é cobrada por tokens de entrada e saída de cada modelo, com liquidação em KAI. Adicione saldo convertendo KAI ao preço de referência atual ou continue ganhando: atender à rede cobre seu próprio uso.\",\"KAI to convert\":\"KAI para converter\",\"Add funds\":\"Adicionar saldo\",\"Your wallet stays unlocked on this computer.\":\"Sua carteira permanece desbloqueada neste computador.\",\"Lock wallet\":\"Bloquear carteira\",\"Show backup code\":\"Mostrar código de backup\",\"Wallet password (required to reveal)\":\"Senha da carteira (necessária para exibir)\",\"Reveal\":\"Exibir\",\"Wallet — send & receive on Koinos mainnet\":\"Carteira: enviar e receber na rede principal Koinos\",\"Your Koinos AI wallet is a real Koinos address: share it to receive KOIN or VHP, and send either with your wallet password. This is real mainnet value — check the recipient address character by character. Works on every machine, node or not.\":\"Sua carteira Koinos AI é um endereço real Koinos. Compartilhe-o para receber KOIN ou VHP e use sua senha para enviá-los. São valores reais na rede principal: confira cada caractere do endereço do destinatário. Funciona com ou sem nó.\",\"Your Koinos address\":\"Seu endereço Koinos\",\"Copy address\":\"Copiar endereço\",\"Show balances\":\"Mostrar saldos\",\"Token to send\":\"Token a enviar\",\"Recipient address (1…)\":\"Endereço do destinatário (1…)\",\"Amount\":\"Quantidade\",\"Wallet password (required to send)\":\"Senha da carteira (necessária para enviar)\",\"Dashboard\":\"Painel\",\"Wallet\":\"Carteira\",\"Fund node\":\"Financiar nó\",\"Burn KOIN → VHP\":\"Queimar KOIN → VHP\",\"Node\":\"Nó\",\"Reward returns\":\"Retorno de recompensas\",\"Node settings\":\"Configurações do nó\",\"App settings\":\"Configurações do aplicativo\",\"Your account, and the parts of the app that are off until you turn them on.\":\"Sua conta e as funções que ficam desativadas até você ativá-las.\",\"Desktop AI connections\":\"Conexões de IA no aplicativo\",\"Use your own OpenAI or Anthropic API account in chat and desktop KAI. Chats, attachments and relevant app tool results go directly to your chosen provider. API usage is billed by that provider. Keys are encrypted on this computer and are never offered to the Koinos Network.\":\"Use sua conta de API OpenAI ou Anthropic na conversa e no KAI do desktop. Conversas, anexos e resultados relevantes de ferramentas vão diretamente ao provedor escolhido. O provedor cobra o uso da API. As chaves são criptografadas neste computador e nunca oferecidas à Koinos Network.\",\"Not connected\":\"Não conectado\",\"API key\":\"Chave de API\",\"Paste your API key\":\"Cole sua chave de API\",\"Model ID\":\"ID do modelo\",\"(optional — or refresh models after saving)\":\"(opcional; você também pode atualizar os modelos após salvar)\",\"A model ID from your provider account\":\"Um ID de modelo da sua conta do provedor\",\"Save connection\":\"Salvar conexão\",\"Test & refresh models\":\"Testar e atualizar modelos\",\"Use in chat\":\"Usar na conversa\",\"Remove\":\"Remover\",\"Get an API key ↗\":\"Obter uma chave de API ↗\",\"Available in desktop chat, Research, Agent and KAI. Teams, scheduled tasks, the local API and network earning continue using their existing models. Stop cancels an active provider reply.\":\"Disponível na conversa do aplicativo, Pesquisa, Agente e KAI. Equipes, tarefas agendadas, API local e ganhos da rede continuam usando os modelos atuais. Parar cancela a resposta ativa do provedor.\",\"Checking…\":\"Verificando…\",\"Check for updates\":\"Verificar atualizações\",\"Koinos AI account\":\"Conta Koinos AI\",\"One account across your devices: sign in once, link this wallet, and your balance and claims follow you. Sign-in happens at koinosai.com with a passkey, email code, or Google — the app never asks for a password, it just shows a short code.\":\"Uma conta para todos os dispositivos: entre e vincule esta carteira para acessar seu saldo e resgates. O login ocorre em koinosai.com com passkey, código por e-mail ou Google. O aplicativo mostra um código curto e nunca pede sua senha de acesso.\",\"Sign in / create account\":\"Entrar / criar conta\",\"On any device, open\":\"Em qualquer dispositivo, abra\",\", sign in, and type this code:\":\", entre e digite este código:\",\"Waiting for approval…\":\"Aguardando aprovação…\",\"Link this wallet\":\"Vincular esta carteira\",\"Sign out on this device\":\"Sair neste dispositivo\",\"Use Koinos AI on the web\":\"Usar Koinos AI na web\",\"Chat and Docs in a browser, signed in to this same account — useful on a machine that cannot run models. The website has no key of its own, so it can only spend what you authorise here: a cap, and a date it stops. This app signs that once, with this wallet, and you can end it from either side at any time. A grant is permission, not funds — this wallet still needs KAI on the network to draw against, same as the app.\":\"Use Conversa e Documentos no navegador com esta mesma conta, mesmo sem modelos locais. O site só pode gastar o autorizado aqui: um limite e uma data de vencimento. Este aplicativo assina a permissão com sua carteira; você pode revogá-la em qualquer lado. A permissão não fornece fundos: a carteira precisa ter KAI na rede.\",\"How it works\":\"Como funciona\",\"Spend up to\":\"Gastar até\",\"for 7 days\":\"por 7 dias\",\"for 30 days\":\"por 30 dias\",\"for 90 days\":\"por 90 dias\",\"Authorise\":\"Autorizar\",\"In US dollars of model usage — the same rates the Network tab shows. Nothing is transferred now; the site draws against this as it is used.\":\"Em dólares americanos de uso de modelos, com as mesmas tarifas da aba Rede. Nada é transferido agora; o site usa a permissão conforme o consumo.\",\"Open the web app\":\"Abrir o aplicativo web\",\"End web access\":\"Encerrar acesso web\",\"Closing the window\":\"Ao fechar a janela\",\"Keep running in the notification area\":\"Continuar na área de notificação\",\"Closing the window tucks Koinos AI down by the clock instead of shutting it down, so your node stays connected and keeps earning. Click that icon to bring the window back, or right-click it and choose Quit to stop the app completely. Switch this off and the X closes the app outright, the way it used to.\":\"Ao fechar a janela, Koinos AI fica perto do relógio para o nó continuar conectado e ganhando. Clique no ícone para voltar, ou clique com o botão direito e escolha Sair para encerrar. Desative esta opção para a X fechar o aplicativo.\",\"Optional sections\":\"Seções opcionais\",\"Each of these adds its own entry to the sidebar. All of them are off until you switch them on, and switching one off only hides it — nothing you made is deleted.\":\"Cada função adiciona uma entrada à barra lateral e fica desativada até você ativá-la. Desativar apenas a oculta: nada do que você criou é excluído.\",\"Run Koinos Node\":\"Executar Koinos Node\",\"Runs a real Koinos node on this machine, with a wallet, funding, swaps and block-production rewards. Uses your existing Koinos AI wallet. Node networking is independent of AI Privacy; Local-Only can stay on.\":\"Executa um nó real Koinos neste computador, com carteira, financiamento, trocas e recompensas por produção de blocos. Usa sua carteira Koinos AI existente. A rede do nó é independente da privacidade da IA; Somente local pode continuar ativo.\",\"Run Koinos node\":\"Executar nó Koinos\",\"Koinos Node is on — it is in the sidebar now.\":\"Koinos Node está ativo; já aparece na barra lateral.\",\"Adds a\":\"Adiciona uma seção de\",\"Developer Tools\":\"Ferramentas de desenvolvimento\",\"section to the sidebar: build your own multi-agent systems, watch them run in a live playground, define custom pipelines, and benchmark your model. Everything there obeys the same privacy and permission rules as the rest of the app.\":\"à barra lateral: crie sistemas multiagente, acompanhe a execução ao vivo, defina processos e avalie seu modelo. São respeitadas as mesmas regras de privacidade e permissões do aplicativo.\",\"Adds\":\"Adiciona\",\"to the sidebar: the coding agent, working on folders you choose. Worth knowing exactly what it can do — inside a project you add, it can write files and run commands as you. It never does either without showing you the change or the exact command first and waiting for your yes, and it never touches anything outside that folder.\":\"à barra lateral: um agente de programação que trabalha nas pastas escolhidas. Pode gravar arquivos e executar comandos como você nos projetos adicionados. Primeiro mostra a alteração ou o comando exato e aguarda sua aprovação. Nunca altera nada fora da pasta.\",\"Your local OpenAI-compatible API\":\"Sua API local compatível com OpenAI\",\"Point any OpenAI SDK or tool at this machine. No cloud, no per-token bill.\":\"Conecte qualquer SDK OpenAI ou ferramenta a este computador. Sem nuvem nem cobrança por token.\",\"Network & privacy\":\"Rede e privacidade\",\"Local-Only is the default: AI requests stay on this machine. Koinos Node and explicit wallet actions use the blockchain independently. Local-First and Network unlock the “Koinos Network” model — requests overflow to network providers through the scheduler.\":\"Somente local é o padrão: as solicitações de IA ficam neste computador. Koinos Node e ações explícitas da carteira usam a blockchain de forma independente. Local primeiro e Rede habilitam o modelo Koinos Network e o envio de solicitações aos provedores da rede pelo coordenador.\",\"Network requests run on other people's computers: the provider serving your request can read what it contains\":\"Solicitações da rede são processadas em computadores de outras pessoas: o provedor pode ler seu conteúdo\",\"— nothing is stored by the serving path, but treat anything sent off this machine as visible to that provider.\":\": o processamento não armazena nada, mas considere visível ao provedor qualquer informação enviada para fora deste computador.\",\"Local-Only (AI requests stay on this machine)\":\"Somente local (as solicitações de IA ficam neste computador)\",\"Local-First (local when possible, network when needed — first 25k tokens/epoch free)\":\"Local primeiro (local quando possível, rede quando necessário; primeiros 25 mil tokens por época grátis)\",\"API keys\":\"Chaves de API\",\"Create key\":\"Criar chave\",\"Without keys, apps on this computer connect freely. Creating the first key requires every API call to present one — the built-in chat keeps working either way.\":\"Sem chaves, os aplicativos deste computador se conectam livremente. Ao criar a primeira chave, cada chamada à API deve apresentar uma. A conversa integrada continua funcionando em ambos os casos.\",\"Copy it now — it is shown only once:\":\"Copie agora: é exibida uma única vez:\",\"Remote access\":\"Acesso remoto\",\"Use your API from anywhere — a phone, a server, another computer. The app keeps an outbound connection to koinosai.com (nothing to install, no router setup) and your API key works at the address below. Requests are answered by\":\"Use sua API de um celular, servidor ou outro computador. O aplicativo mantém uma conexão de saída com koinosai.com, sem instalações nem ajustes no roteador. Sua chave funciona no endereço abaixo. As solicitações são respondidas por\",\"this computer\":\"este computador\",\", so it works while the app is running. An API key is required — without one the switch refuses, so your API is never open to the internet. Heads up: remote traffic passes through koinosai.com on its way here.\":\", por isso o aplicativo deve estar aberto. É necessária uma chave de API; sem ela o acesso não pode ser ativado. Sua API nunca fica aberta na internet. O tráfego remoto passa por koinosai.com.\",\"Projects\":\"Projetos\",\"Connect GitHub\":\"Conectar GitHub\",\"Point it at a folder and tell it what to do. It shows you every change before anything happens.\":\"Escolha uma pasta e diga o que fazer. Cada alteração é mostrada antes de acontecer.\",\"Select a folder\":\"Selecionar pasta\",\"Work on something already on this machine\":\"Trabalhar em algo já neste computador\",\"Clone from GitHub\":\"Clonar do GitHub\",\"Copy a repository down and start on it\":\"Baixar um repositório e começar a trabalhar\",\"Choose a folder\":\"Escolher pasta\",\"Type or paste a full path\":\"Digite ou cole um caminho completo\",\"Use this folder\":\"Usar esta pasta\",\"Clone a repository\":\"Clonar um repositório\",\"owner/name — or the full GitHub URL\":\"proprietário/nome ou URL completa do GitHub\",\"Select a folder…\":\"Selecionar pasta…\",\"no folder chosen yet\":\"nenhuma pasta escolhida ainda\",\"Folder to clone into — full path\":\"Pasta de destino: caminho completo\",\"Clone and start\":\"Clonar e iniciar\",\"Rename\":\"Renomear\",\"Forget\":\"Esquecer\",\"Branch name / commit message / PR title\":\"Nome da branch / mensagem do commit / título do PR\",\"Branch\":\"Branch\",\"Project name\":\"Nome do projeto\",\"Save\":\"Salvar\",\"Cancel\":\"Cancelar\",\"What should it do? (Enter to send, Shift+Enter for a new line)\":\"O que deve fazer? (Enter envia, Shift+Enter adiciona uma linha)\",\"Plan first\":\"Planejar primeiro\",\"Model\":\"Modelo\",\"Which model does the work. Koinos Code runs on this machine only — the agent reads your project's files into the prompt, and those do not leave the computer.\":\"Qual modelo faz o trabalho. Koinos Code só é executado neste computador: os arquivos do projeto são lidos na instrução e não saem do computador.\",\"Tools…\":\"Ferramentas…\",\"Tools this project may use\":\"Ferramentas permitidas para este projeto\",\"Build and run your own agent systems on this machine's API — from a one-line pipeline to a team of named agents that talk, use tools, and ask you questions.\":\"Crie e execute sistemas de agentes na API deste computador, desde um processo simples até equipes que conversam, usam ferramentas e fazem perguntas.\",\"Developer tools sections\":\"Seções de ferramentas de desenvolvimento\",\"Multi-agent\":\"Multiagente\",\"Playground\":\"Área de testes\",\"Pipelines\":\"Pipelines\",\"Benchmark\":\"Avaliação\",\"Named agents share one conversation. Pick how the floor moves — round robin, a model moderator, or explicit handoffs — and how it ends. A\":\"Agentes nomeados compartilham uma conversa. Escolha a ordem (por turnos, moderador de IA ou transferências explícitas) e como termina. Um agente\",\"human\":\"humano\",\"agent pauses the run and asks you. Hard ceilings always hold: 60 messages, 120 model calls, 6 tool actions per turn. Apps can POST the same spec to\":\"pausa a execução e pergunta a você. Os limites são 60 mensagens, 120 chamadas ao modelo e 6 ações de ferramentas por turno. Aplicativos podem enviar a mesma especificação por POST para\",\"Team name\":\"Nome da equipe\",\"e.g. Research duo\":\"por exemplo, Dupla de pesquisa\",\"Turn order\":\"Ordem dos turnos\",\"Round robin — agents speak in order\":\"Por turnos: os agentes falam em ordem\",\"Selector — a model picks who speaks next\":\"Seletor: um modelo escolhe quem fala depois\",\"Handoff — the speaker passes the floor by name\":\"Transferência: quem fala passa a vez pelo nome\",\"+ Add agent\":\"+ Adicionar agente\",\"Max messages\":\"Máx. mensagens\",\"Max model calls\":\"Máx. chamadas ao modelo\",\"End phrase\":\"Frase de encerramento\",\"Team JSON\":\"JSON da equipe\",\"Update JSON from builder\":\"Atualizar JSON pelo editor\",\"Update the JSON after changing the builder. Saving and running use this JSON.\":\"Atualize o JSON após alterar o editor. Salvar e executar usam este JSON.\",\"Save team\":\"Salvar equipe\",\"Saved teams\":\"Equipes salvas\",\"Load\":\"Carregar\",\"Delete\":\"Excluir\",\"Run a team and watch the conversation live. When a human agent's turn comes, the box below asks you — the run waits (up to its timeout) for your words.\":\"Execute uma equipe e acompanhe a conversa ao vivo. Na vez de um agente humano, o campo abaixo pede uma resposta; a execução aguarda até o tempo limite.\",\"Team\":\"Equipe\",\"Task\":\"Tarefa\",\"What should the team do?\":\"O que a equipe deve fazer?\",\"Run\":\"Executar\",\"Your message to the team\":\"Sua mensagem para a equipe\",\"It's your turn — type your message\":\"É sua vez: digite sua mensagem\",\"The simple track: one pipeline of typed stages (plan → work → write → critique → revise). Budgets cap at the built-in ceilings (4 sub-tasks, 4 actions per worker, 24 model calls) no matter what the spec asks. Also at\":\"Um processo por etapas: planejar → trabalhar → escrever → avaliar → revisar. Os limites são 4 subtarefas, 4 ações por trabalhador e 24 chamadas ao modelo, independentemente da especificação. Também em\",\"Pipeline name\":\"Nome do pipeline\",\"e.g. Research pipeline\":\"por exemplo, Pipeline de pesquisa\",\"Stages\":\"Etapas\",\"plan\":\"planejar\",\"work\":\"trabalhar\",\"write (always)\":\"escrever (sempre)\",\"critique\":\"avaliar\",\"revise\":\"revisar\",\"loading tools…\":\"carregando ferramentas…\",\"Sub-tasks\":\"Subtarefas\",\"Actions per worker\":\"Ações por trabalhador\",\"Worker goal (optional)\":\"Objetivo do trabalhador (opcional)\",\"What each worker should do\":\"O que cada trabalhador deve fazer\",\"Pipeline JSON\":\"JSON do pipeline\",\"Update the JSON after changing the builder. Running uses this JSON.\":\"Atualize o JSON após alterar o editor. A execução usa este JSON.\",\"What should the pipeline do?\":\"O que o pipeline deve fazer?\",\"Run team\":\"Executar equipe\",\"Scores the current model on a fixed suite of objective tasks — arithmetic, instruction following, JSON output, extraction, and a tool-using agent case. Same tasks every run, so scores compare across models and app versions. Also at\":\"Avalia o modelo com tarefas fixas: aritmética, instruções, saída JSON, extração e uso de ferramentas. As tarefas se repetem para comparar modelos e versões. Também em\",\"Run benchmark\":\"Executar avaliação\",\"Goes straight to the Koinos AI team. Crashes, confusion, ideas — all welcome.\":\"Vai direto para a equipe Koinos AI. Erros, dúvidas e ideias são bem-vindos.\",\"What happened? What did you expect?\":\"O que aconteceu? O que você esperava?\",\"Email (optional — for a reply)\":\"E-mail (opcional, para resposta)\",\"Include the app's diagnostic log (recommended — no chat content, no keys)\":\"Incluir registro de diagnóstico (recomendado; sem conversas nem chaves)\",\"Language\":\"Idioma\",\"App language\":\"Idioma do aplicativo\",\"Choose your language\":\"Escolha seu idioma\",\"Welcome to Koinos AI. Select your language to get started.\":\"Boas-vindas ao Koinos AI. Escolha seu idioma para começar.\",\"You can change this later in Settings.\":\"Você pode alterar isso depois nas Configurações.\",\"Choose the language used for menus, settings, and setup. You can change it at any time.\":\"Escolha o idioma dos menus, configurações e configuração inicial. Você pode alterar a qualquer momento.\",\"Language saved.\":\"Idioma salvo.\",\"Could not save the language. Please try again.\":\"Não foi possível salvar o idioma. Tente novamente.\",\"Could not load the language setting. Choose a language and try again.\":\"Não foi possível carregar o idioma. Escolha um e tente novamente.\",\"Core unreachable\":\"Não foi possível conectar ao Core\",\"Downloading model… {0}%\":\"Baixando modelo… {0}%\",\"Downloading engine… {0}%\":\"Baixando mecanismo… {0}%\",\"Setting up engine… (one time — takes a few minutes, the app stays usable)\":\"Preparando o mecanismo… (uma única vez; leva alguns minutos e você pode continuar usando o aplicativo)\",\"Loading model…\":\"Carregando modelo…\",\"Model loaded\":\"Modelo carregado\",\"Ready (model loads on first message)\":\"Pronto (o modelo carrega na primeira mensagem)\",\"Setup needed\":\"Configuração necessária\",\"No models in catalog\":\"Nenhum modelo no catálogo\",\"Desktop provider ready\":\"Provedor do aplicativo pronto\",\"Model load failed{0}\":\"Falha ao carregar o modelo{0}\",\"System\":\"Sistema\",\"Memory\":\"Memória\",\"None detected — running on CPU\":\"Nenhuma detectada; usando a CPU\",\"From a first thought to the final draft.\":\"Da primeira ideia ao rascunho final.\",\"One question. A few different perspectives.\":\"Uma pergunta. Diferentes perspectivas.\",\"Find the right mind for the job.\":\"Encontre o modelo certo para o trabalho.\",\"Build a service. Connect with other agents.\":\"Crie um serviço. Conecte-se a outros agentes.\",\"Your world, remembered.\":\"Seu mundo, lembrado.\",\"Give your routines to KAI.\":\"Deixe suas rotinas com KAI.\",\"Your accounts, your control.\":\"Suas contas, seu controle.\",\"Put your ideas in motion.\":\"Coloque suas ideias em ação.\",\"Give your AI a few more abilities.\":\"Dê mais capacidades à sua IA.\",\"Your models, connected to your workflow.\":\"Seus modelos, conectados ao seu trabalho.\",\"Let your compute contribute.\":\"Deixe seu computador contribuir.\",\"Make this space your own.\":\"Deixe este espaço com a sua cara.\",\"Connected on your terms.\":\"Conectado nos seus termos.\",\"Build something you want to exist.\":\"Crie algo que você quer ver existir.\",\"Everything you need to get hands-on.\":\"Tudo que você precisa para começar.\",\"Your wallet. Your node. Your contribution.\":\"Sua carteira. Seu nó. Sua contribuição.\",\"Let’s get you ready.\":\"Vamos preparar tudo.\",\"Copy\":\"Copiar\",\"Copy message\":\"Copiar mensagem\",\"Copied\":\"Copiado\",\"Edit\":\"Editar\",\"Refresh\":\"Atualizar\",\"Retry\":\"Tentar novamente\",\"Back\":\"Voltar\",\"← Back\":\"← Voltar\",\"Next\":\"Próximo\",\"Done\":\"Concluído\",\"Ready\":\"Pronto\",\"Loading…\":\"Carregando…\",\"Working…\":\"Processando…\",\"Saving…\":\"Salvando…\",\"Saved\":\"Salvo\",\"Failed\":\"Falhou\",\"Error\":\"Erro\",\"Unknown error\":\"Erro desconhecido\",\"Running\":\"Em execução\",\"Stopped\":\"Parado\",\"stopped\":\"parado\",\"running\":\"em execução\",\"Paused\":\"Pausado\",\"Pending\":\"Pendente\",\"Enabled\":\"Ativado\",\"Disabled\":\"Desativado\",\"On\":\"Ativado\",\"Off\":\"Desativado\",\"Online\":\"Online\",\"Connected\":\"Conectado\",\"Connect\":\"Conectar\",\"Disconnect\":\"Desconectar\",\"Start\":\"Iniciar\",\"Stop Earning\":\"Parar de ganhar\",\"Details\":\"Detalhes\",\"Name\":\"Nome\",\"Description\":\"Descrição\",\"Status\":\"Status\",\"Type\":\"Tipo\",\"Action\":\"Ação\",\"Actions\":\"Ações\",\"Address\":\"Endereço\",\"Balance\":\"Saldo\",\"Balances\":\"Saldos\",\"Password\":\"Senha\",\"Confirm\":\"Confirmar\",\"Confirm transaction\":\"Confirmar transação\",\"Transaction\":\"Transação\",\"Transactions\":\"Transações\",\"Receive\":\"Receber\",\"Sent\":\"Enviado\",\"Received\":\"Recebido\",\"Recipient\":\"Destinatário\",\"Fee\":\"Taxa\",\"Amount to send\":\"Quantidade a enviar\",\"Available\":\"Disponível\",\"Not available\":\"Indisponível\",\"Copy to clipboard\":\"Copiar para a área de transferência\",\"Export\":\"Exportar\",\"Download\":\"Baixar\",\"Install\":\"Instalar\",\"Uninstall\":\"Desinstalar\",\"Update\":\"Atualizar\",\"Open\":\"Abrir\",\"Search\":\"Buscar\",\"Clear\":\"Limpar\",\"New\":\"Novo\",\"Yes\":\"Sim\",\"No\":\"Não\",\"None\":\"Nenhum\",\"Never\":\"Nunca\",\"Not yet\":\"Ainda não\",\"Optional\":\"Opcional\",\"Required\":\"Obrigatório\",\"Advanced\":\"Avançado\",\"General\":\"Geral\",\"Security\":\"Segurança\",\"Privacy\":\"Privacidade\",\"Overview\":\"Visão geral\",\"Activity\":\"Atividade\",\"History\":\"Histórico\",\"Today\":\"Hoje\",\"Yesterday\":\"Ontem\",\"Total\":\"Total\",\"Options\":\"Opções\",\"Default\":\"Padrão\",\"Configure\":\"Configurar\",\"Manage\":\"Gerenciar\",\"View\":\"Ver\",\"Reset\":\"Redefinir\",\"Restart\":\"Reiniciar\",\"Test builds\":\"Versões de teste\",\"What's new\":\"Novidades\",\"Couldn't check — Core is not answering.\":\"Não foi possível verificar: Core não responde.\",\"Memories\":\"Memórias\",\"Memory graph\":\"Mapa de memórias\",\"Goals & tasks\":\"Metas e tarefas\",\"Sources\":\"Fontes\",\"Sync & changes\":\"Sincronização e alterações\",\"Awareness\":\"Percepção\",\"Orchestration\":\"Orquestração\",\"My workflows\":\"Meus fluxos\",\"Run history\":\"Histórico de execuções\",\"Templates\":\"Modelos de fluxo\",\"Discover workflows\":\"Descobrir fluxos\",\"Explore apps\":\"Explorar aplicativos\",\"Connection settings\":\"Configurações de conexões\",\"Custom APIs\":\"APIs personalizadas\",\"Models & other tools\":\"Modelos e outras ferramentas\",\"KAI Brain\":\"Cérebro do KAI\",\"A memory of your world, built from what you choose to share.\":\"Uma memória do seu mundo, criada com o que você escolhe compartilhar.\",\"Teach KAI a routine. Review the steps, then run it whenever you need.\":\"Ensine uma rotina ao KAI. Revise os passos e execute quando precisar.\",\"Connect the apps you use and choose what KAI can do with them.\":\"Conecte seus aplicativos e escolha o que KAI pode fazer com eles.\",\"Open the installed KAI desktop app\":\"Abra o aplicativo KAI instalado\",\"Brain, private API connections, and durable workflows are available in Koinos AI Test.\":\"Cérebro, conexões privadas de API e fluxos persistentes estão disponíveis no Koinos AI Test.\",\"Your companion data is locked\":\"Os dados do companheiro estão bloqueados\",\"Unlock your original OS keychain and restart KAI. Your saved data will stay intact.\":\"Desbloqueie o chaveiro original do sistema e reinicie KAI. Seus dados salvos serão preservados.\",\"Add memory\":\"Adicionar memória\",\"Edit memory\":\"Editar memória\",\"Your notes\":\"Suas notas\",\"Source removed\":\"Fonte removida\",\"Read source text\":\"Ler texto da fonte\",\"A little more understanding, every day.\":\"Um pouco mais de compreensão a cada dia.\",\"Memories, sources and priorities connected in one private place.\":\"Memórias, fontes e prioridades conectadas em um espaço privado.\",\"Export Markdown\":\"Exportar Markdown\",\"Topics\":\"Tópicos\",\"To review\":\"Para revisar\",\"Observing\":\"Observando\",\"Assisting\":\"Ajudando\",\"Run a check\":\"Executar verificação\",\"Open activity\":\"Abrir atividade\",\"Your daily briefing\":\"Seu resumo diário\",\"Build briefing\":\"Criar resumo\",\"Worth a look\":\"Vale a pena conferir\",\"You're all caught up\":\"Está tudo em dia\",\"Your memory activity\":\"Atividade das suas memórias\",\"Use relevant Brain memories in private replies\":\"Usar memórias relevantes em respostas privadas\",\"Your memories\":\"Suas memórias\",\"See how your world connects\":\"Veja como seu mundo se conecta\",\"Search exact source text and your saved knowledge.\":\"Busque no texto original e no conhecimento salvo.\",\"Import file\":\"Importar arquivo\",\"Source\":\"Fonte\",\"Topic\":\"Tópico\",\"All sources\":\"Todas as fontes\",\"All topics\":\"Todos os tópicos\",\"Updated since\":\"Atualizado desde\",\"People, topics, projects…\":\"Pessoas, tópicos, projetos…\",\"Add a goal\":\"Adicionar meta\",\"Goal\":\"Meta\",\"Goals\":\"Metas\",\"Priority\":\"Prioridade\",\"Due date\":\"Prazo\",\"High\":\"Alta\",\"Medium\":\"Média\",\"Low\":\"Baixa\",\"Completed\":\"Concluído\",\"Complete\":\"Concluir\",\"Add source\":\"Adicionar fonte\",\"Sync now\":\"Sincronizar agora\",\"Sync\":\"Sincronizar\",\"Auto-sync\":\"Sincronização automática\",\"Local model\":\"Modelo local\",\"Source excerpts\":\"Trechos das fontes\",\"New workflow\":\"Novo fluxo de trabalho\",\"Import workflow\":\"Importar fluxo\",\"Scheduled prompts\":\"Instruções agendadas\",\"Manual\":\"Manual\",\"Schedule on\":\"Agendamento ativado\",\"Schedule off\":\"Agendamento desativado\",\"Draft · review required\":\"Rascunho · revisão necessária\",\"Review & resume\":\"Revisar e retomar\",\"Cancel run\":\"Cancelar execução\",\"Your first run starts here\":\"Sua primeira execução começa aqui\",\"Run a saved workflow to see its progress and results.\":\"Execute um fluxo salvo para ver o progresso e os resultados.\",\"Make room for the work you enjoy\":\"Abra espaço para o trabalho de que gosta\",\"Start from a template\":\"Começar com um modelo\",\"Project briefing\":\"Resumo do projeto\",\"Weekly goal review\":\"Revisão semanal de metas\",\"API digest\":\"Resumo de API\",\"AI models\":\"Modelos de IA\",\"Provider settings\":\"Configurações do provedor\",\"Local model library\":\"Biblioteca de modelos locais\",\"MCP, email & calendars\":\"MCP, e-mail e calendários\",\"Open Tools\":\"Abrir Ferramentas\",\"Add connection\":\"Adicionar conexão\",\"Manual use only\":\"Somente uso manual\",\"Background reads allowed\":\"Leituras em segundo plano permitidas\",\"Background reads off\":\"Leituras em segundo plano desativadas\",\"Open & test\":\"Abrir e testar\",\"Connect a custom API\":\"Conectar uma API personalizada\",\"Start with an API template\":\"Começar com um modelo de API\",\"Source content\":\"Conteúdo da fonte\",\"Workflow builder\":\"Editor de fluxos\",\"API connection\":\"Conexão de API\",\"Use connection\":\"Usar conexão\",\"Add a Brain source\":\"Adicionar fonte ao Cérebro\",\"Start workflow\":\"Iniciar fluxo\",\"Run input (optional)\":\"Dados de entrada (opcional)\",\"Start run\":\"Iniciar execução\",\"Category\":\"Categoria\",\"Pinned\":\"Fixado\",\"Content\":\"Conteúdo\",\"Save memory\":\"Salvar memória\",\"Save goal\":\"Salvar meta\",\"Save workflow\":\"Salvar fluxo\",\"Add step\":\"Adicionar etapa\",\"New step\":\"Nova etapa\",\"Step\":\"Etapa\",\"Steps\":\"Etapas\",\"Schedule\":\"Agendamento\",\"Trigger\":\"Gatilho\",\"Result\":\"Resultado\",\"Results\":\"Resultados\",\"Input\":\"Entrada\",\"Output\":\"Saída\",\"Approval\":\"Aprovação\",\"Approve\":\"Aprovar\",\"Reject\":\"Rejeitar\",\"Deny\":\"Negar\",\"Allow once\":\"Permitir uma vez\",\"Always allow\":\"Sempre permitir\",\"Permissions\":\"Permissões\",\"Run now\":\"Executar agora\",\"Test connection\":\"Testar conexão\",\"Test action\":\"Testar ação\",\"Use template\":\"Usar modelo\",\"Search apps\":\"Buscar aplicativos\",\"Search apps…\":\"Buscar aplicativos…\",\"All apps\":\"Todos os aplicativos\",\"Connected apps\":\"Aplicativos conectados\",\"Reconnect\":\"Reconectar\",\"Remove connection\":\"Remover conexão\",\"View details\":\"Ver detalhes\",\"Local-First\":\"Local primeiro\",\"🔊 Read\":\"🔊 Ler\",\"⏹ Stop\":\"⏹ Parar\",\"📌 Remember\":\"📌 Lembrar\",\"📌 Remembered\":\"📌 Memorizado\",\"Open result ↗\":\"Abrir resultado ↗\",\"Quick syncing\":\"Sincronização rápida\",\"Quick Sync\":\"Sincronização rápida\",\"Quick sync\":\"Sincronização rápida\",\"Node Details\":\"Detalhes do nó\",\"Node details\":\"Detalhes do nó\",\"Node Value\":\"Valor do nó\",\"Profit & Return\":\"Lucro e retorno\",\"Network Details\":\"Detalhes da rede\",\"Koinos Network\":\"Rede Koinos\",\"Node status\":\"Status do nó\",\"Start node\":\"Iniciar nó\",\"Stop node\":\"Parar nó\",\"Producer wallet custody\":\"Custódia da carteira do produtor\",\"External signing\":\"Assinatura externa\",\"Connect Koin Vault\":\"Conectar Koin Vault\",\"Connect KOIN Vault\":\"Conectar KOIN Vault\",\"Prepare transaction\":\"Preparar transação\",\"Import signed transaction\":\"Importar transação assinada\",\"Broadcast\":\"Transmitir\",\"Copy unsigned JSON\":\"Copiar JSON não assinado\",\"Download unsigned JSON\":\"Baixar JSON não assinado\",\"Paste signed JSON\":\"Colar JSON assinado\",\"Registered\":\"Registrado\",\"Not registered\":\"Não registrado\",\"Register\":\"Registrar\",\"Producer\":\"Produtor\",\"Block height\":\"Altura do bloco\",\"Local height\":\"Altura local\",\"Network height\":\"Altura da rede\",\"Progress\":\"Progresso\",\"Syncing\":\"Sincronizando\",\"Synced\":\"Sincronizado\",\"Healthy\":\"Saudável\",\"Unhealthy\":\"Com problemas\",\"Services\":\"Serviços\",\"No services running.\":\"Nenhum serviço em execução.\",\"Data folder\":\"Pasta de dados\",\"Open data folder\":\"Abrir pasta de dados\",\"Change data folder\":\"Alterar pasta de dados\",\"Logs\":\"Registros\",\"View logs\":\"Ver registros\",\"Copy logs\":\"Copiar registros\",\"Rewards\":\"Recompensas\",\"Reburn\":\"Queimar novamente\",\"Distribute\":\"Distribuir\",\"Distribution\":\"Distribuição\",\"Reinvest\":\"Reinvestir\",\"Percentage\":\"Porcentagem\",\"Last 24 hours\":\"Últimas 24 horas\",\"Last 7 days\":\"Últimos 7 dias\",\"Last 30 days\":\"Últimos 30 dias\",\"Mainnet\":\"Rede principal\",\"Testnet\":\"Rede de testes\",\"Desktop\":\"Desktop\",\"Open Koinos AI\":\"Abrir Koinos AI\",\"Launch KAI companion\":\"Abrir companheiro KAI\",\"Hide KAI companion\":\"Ocultar companheiro KAI\",\"Quit Koinos AI\":\"Sair do Koinos AI\",\"KAI · Your desktop companion\":\"KAI · Seu companheiro de desktop\",\"KAI desktop companion\":\"Companheiro de desktop KAI\",\"Talk with KAI\":\"Conversar com KAI\",\"DESKTOP COMPANION\":\"COMPANHEIRO DE DESKTOP\",\"Connecting to your app…\":\"Conectando ao seu aplicativo…\",\"New conversation\":\"Nova conversa\",\"Keep KAI on the desktop\":\"Manter KAI no desktop\",\"Collapse conversation\":\"Recolher conversa\",\"Choose KAI's model\":\"Escolher o modelo do KAI\",\"Enable local listening for Hey KAI\":\"Ativar escuta local de Hey KAI\",\"Hey KAI off\":\"Hey KAI desativado\",\"Voice & listening\":\"Voz e escuta\",\"Voice and listening settings\":\"Configurações de voz e escuta\",\"A little voice. A lot of personality.\":\"Uma voz pequena. Muita personalidade.\",\"Close voice settings\":\"Fechar configurações de voz\",\"KAI's voice\":\"A voz do KAI\",\"Computer voice\":\"Voz do computador\",\"Pocket voices · English\":\"Vozes Pocket · Inglês\",\"One download, about 201 MB. Speech stays on your computer.\":\"Um download de cerca de 201 MB. A fala fica no seu computador.\",\"Download Pocket voices\":\"Baixar vozes Pocket\",\"Try Azelma\":\"Testar Azelma\",\"Voice credits\":\"Créditos das vozes\",\"Use fast Cute KAI\":\"Usar Cute KAI rápido\",\"Refresh voices\":\"Atualizar vozes\",\"Add Windows voices ↗\":\"Adicionar vozes do Windows ↗\",\"Install speech voices in Windows Settings, then refresh this list. Available voices depend on your Windows installation.\":\"Instale vozes nas Configurações do Windows e atualize esta lista. As vozes disponíveis dependem da sua instalação do Windows.\",\"Voice character\":\"Personalidade da voz\",\"Cute KAI · bright & squeaky\":\"Cute KAI · alegre e agudo\",\"Classic KAI · deeper, softly robotic\":\"Classic KAI · mais grave, levemente robótico\",\"Natural · original sound\":\"Natural · som original\",\"Squeak\":\"Agudo\",\"Playful\":\"Brincalhão\",\"Voice squeak\":\"Tom agudo da voz\",\"Gentle\":\"Suave\",\"Extra squeaky\":\"Muito agudo\",\"Reply timing\":\"Momento da resposta\",\"Quick start · first sentence\":\"Início rápido · primeira frase\",\"Head start · two sentences\":\"Com margem · duas frases\",\"Whole reply · continuous playback\":\"Resposta completa · reprodução contínua\",\"Hear a hello\":\"Ouvir uma saudação\",\"Get natural voices\":\"Obter vozes naturais\",\"Try Cute KAI with Bella. Hear a hello instantly, then download the local voice once for conversations.\":\"Experimente Cute KAI com Bella. Ouça uma saudação na hora e baixe a voz local uma vez para conversar.\",\"Just say “Hey KAI”\":\"Basta dizer “Hey KAI”\",\"Tap the mic and talk, or turn on Hey KAI and say your question. KAI listens for a finished thought before sending. Keep talking after KAI answers—you have a minute for follow-ups.\":\"Toque no microfone e fale, ou ative Hey KAI e faça sua pergunta. KAI espera você concluir a ideia antes de enviar. Após a resposta, você tem um minuto para continuar falando.\",\"Conversation pauses\":\"Pausas na conversa\",\"Quick · short pauses\":\"Rápido · pausas curtas\",\"Natural · room to pause\":\"Natural · espaço para pausar\",\"Patient · more time to think\":\"Paciente · mais tempo para pensar\",\"KAI combines a quiet pause with local semantic turn detection, so a breath in the middle of a thought is less likely to cut you off. If it waits, keep talking or tap the mic to send now. Saying “KAI” during a reply still stops it as soon as the name is recognized.\":\"KAI combina pausas com detecção semântica local para não interromper você ao respirar. Se estiver aguardando, continue falando ou toque no microfone para enviar. Dizer “KAI” durante uma resposta a interrompe quando o nome é reconhecido.\",\"Microphone sensitivity\":\"Sensibilidade do microfone\",\"TV nearby · less sensitive\":\"TV próxima · menos sensível\",\"Everyday room · balanced\":\"Ambiente comum · equilibrado\",\"Quiet room · more sensitive\":\"Ambiente silencioso · mais sensível\",\"Microphone level\":\"Nível do microfone\",\"Microphone off\":\"Microfone desativado\",\"Local speech detection starts with the microphone.\":\"A detecção local de fala começa com o microfone.\",\"With the mic on, background sound should stay below the listening level and your voice should rise above it. Move closer or choose a more sensitive setting if KAI misses you.\":\"Com o microfone ativo, o ruído de fundo deve ficar abaixo do nível de escuta e sua voz acima. Aproxime-se ou aumente a sensibilidade se KAI não detectar você.\",\"Say “KAI” to interrupt\":\"Diga “KAI” para interromper\",\"While KAI is answering, say “KAI” on its own or “KAI” followed by your new question. It stops when it recognizes the name. After the reply, just keep talking—follow-ups need no name.\":\"Enquanto KAI responde, diga “KAI” sozinho ou seguido da nova pergunta. Ele para ao reconhecer o nome. Após a resposta, continue falando sem dizer o nome.\",\"KAI does not identify your voice yet. Loud background dialogue can still sound like a question. The mic button always lets you stop a reply and ask directly.\":\"KAI ainda não identifica sua voz. Conversas altas ao fundo podem parecer perguntas. O botão do microfone permite parar a resposta e perguntar diretamente.\",\"The chat can stay closed. Say “That’s all” to end the conversation, or “Stop listening” to turn the mic off. Audio stays on this computer; accepted questions go to your selected chat model. Hiding KAI turns the mic off.\":\"A conversa pode ficar fechada. Diga “That’s all” para encerrar ou “Stop listening” para desligar o microfone. O áudio fica neste computador; perguntas aceitas vão ao modelo escolhido. Ocultar KAI desliga o microfone.\",\"KAI Eyes settings\":\"Configurações do KAI Eyes\",\"Let KAI see what you mean.\":\"Deixe KAI ver o que você quer dizer.\",\"Close KAI Eyes settings\":\"Fechar configurações do KAI Eyes\",\"Screen and camera vision are session-only. KAI keeps six small frames in memory, attaches only the freshest view to a turn, and discards everything when you turn it off or hide KAI.\":\"A visão de tela e câmera dura apenas esta sessão. KAI mantém seis imagens pequenas na memória, anexa apenas a mais recente à mensagem e descarta tudo ao desativar a função ou ocultar KAI.\",\"Screen\":\"Tela\",\"See the display KAI is sitting on\":\"Ver a tela onde KAI está\",\"Camera\":\"Câmera\",\"See what you choose to show KAI\":\"Ver o que você escolher mostrar ao KAI\",\"Choose a vision-capable brain, then turn on a source.\":\"Escolha um modelo com visão e ative uma fonte.\",\"A visible indicator stays on for the entire capture session. Frames never enter chat history or the Koinos Network. Local-Only still blocks private online models. Desktop clicks and typing remain a separate, per-task permission.\":\"Um indicador permanece visível durante toda a captura. As imagens nunca entram no histórico nem na Koinos Network. Somente local continua bloqueando modelos privados online. Cliques e digitação exigem uma permissão separada por tarefa.\",\"Conversation\":\"Conversa\",\"A LITTLE ROBOT. A LOT OF HELP.\":\"UM PEQUENO ROBÔ. UMA GRANDE AJUDA.\",\"Hey, I'm KAI\":\"Olá, sou o KAI\",\"Your app, a question away. Ask about your wallet, models, node, or the world outside.\":\"Seu aplicativo, a uma pergunta de distância. Pergunte sobre sua carteira, modelos, nó ou o mundo lá fora.\",\"Check my KAI earnings\":\"Consultar meus ganhos de KAI\",\"Explore my models\":\"Explorar meus modelos\",\"Open my Pictures folder\":\"Abrir minha pasta Imagens\",\"Ask KAI anything…\":\"Pergunte qualquer coisa ao KAI…\",\"Talk to KAI\":\"Falar com KAI\",\"Start voice input\":\"Iniciar entrada de voz\",\"Enter to send\":\"Enter para enviar\",\"Stop response\":\"Parar resposta\",\"Send message\":\"Enviar mensagem\",\"Read KAI's replies aloud\":\"Ler as respostas do KAI em voz alta\",\"Voice replies off\":\"Respostas de voz desativadas\",\"Open full app\":\"Abrir aplicativo completo\",\"Set up KAI's Pocket voice\":\"Configurar a voz Pocket do KAI\",\"Add KAI’s Pocket voice\":\"Adicionar a voz Pocket do KAI\",\"Later\":\"Mais tarde\",\"Set up KAI's natural voice\":\"Configurar a voz natural do KAI\",\"Meet KAI’s natural voice\":\"Conheça a voz natural do KAI\",\"Get natural voice\":\"Obter voz natural\",\"Let KAI hear you\":\"Deixe KAI ouvir você\",\"Set up listening\":\"Configurar escuta\",\"Dismiss message\":\"Dispensar mensagem\",\"KAI Eyes capture active\":\"Captura do KAI Eyes ativa\",\"KAI Eyes is active · click to review\":\"KAI Eyes está ativo · clique para revisar\",\"Screen on\":\"Tela ativada\",\"Here when you need me\":\"Aqui quando precisar\",\"KAI. Click to chat, or drag to move.\":\"KAI. Clique para conversar ou arraste para mover.\",\"Click to chat · Drag to move\":\"Clique para conversar · Arraste para mover\",\"Open chat\":\"Abrir conversa\",\"Open or minimize chat\":\"Abrir ou minimizar conversa\",\"Hey KAI listening off\":\"Escuta Hey KAI desativada\",\"Toggle Hey KAI listening\":\"Ativar ou desativar escuta Hey KAI\",\"KAI options\":\"Opções do KAI\",\"Say hello 👋\":\"Dizer olá 👋\",\"Desktop control\":\"Controle do desktop\",\"Animation on\":\"Animação ativada\",\"Open full app ↗\":\"Abrir aplicativo completo ↗\",\"Hide KAI to tray\":\"Ocultar KAI na bandeja\",\"Transaction ID copied (no explorer for this network)\":\"ID da transação copiado (sem explorador para esta rede)\",\"Producer data unavailable\":\"Dados de produtores indisponíveis\",\"💵 Profit & projected return\":\"💵 Lucro e retorno previsto\",\"Koinos network\":\"Rede Koinos\",\"View block producers ↗\":\"Ver produtores de blocos ↗\",\"📡 Activity feed\":\"📡 Atividade\",\"Can't reach the app\":\"Não foi possível conectar ao aplicativo\",\"Active producers · ~24h\":\"Produtores ativos · ~24 h\",\"Produced within the last 28,800 blocks\":\"Produziram nos últimos 28.800 blocos\",\"Recent producers · 2h\":\"Produtores recentes · 2 h\",\"Produced within 2 hours · green status\":\"Produziram em 2 horas · status verde\",\"Tracked producer accounts\":\"Contas de produtores acompanhadas\",\"Recent producers plus VHP holders\":\"Produtores recentes e titulares de VHP\",\"Last known data · refresh unavailable\":\"Últimos dados conhecidos · atualização indisponível\",\"Mainnet only\":\"Somente rede principal\",\"Counts unavailable · retrying…\":\"Contagens indisponíveis · tentando novamente…\",\"Loading counts…\":\"Carregando contagens…\",\"Stopping node\":\"Parando nó\",\"Node stopped\":\"Nó parado\",\"Quick sync in progress\":\"Sincronização rápida em andamento\",\"Needs attention\":\"Precisa de atenção\",\"Docker not ready — finish setup on the Node tab\":\"Docker não está pronto; conclua a configuração na aba Nó\",\"Set up node\":\"Configurar nó\",\"{0}{1} blocks\":\"{0}{1} blocos\",\"in sync\":\"sincronizado\",\"syncing\":\"sincronizando\",\"producing stake\":\"participação para produção\",\"recharges over time\":\"recarrega com o tempo\",\"Net worth\":\"Valor líquido\",\"Blocks produced\":\"Blocos produzidos\",\"Total rewards\":\"Recompensas totais\",\"VHP consumed\":\"VHP consumido\",\"spent producing\":\"gasto na produção\",\"Profit\":\"Lucro\",\"rewards − VHP spent\":\"recompensas menos VHP gasto\",\"Total burned\":\"Total queimado\",\"Deposits in\":\"Depósitos recebidos\",\"at current rate\":\"no ritmo atual\",\"enable reburn to compound\":\"ative a queima novamente para capitalizar\",\"no reburn set\":\"queima novamente desativada\",\"Daily profit\":\"Lucro diário\",\"Weekly profit\":\"Lucro semanal\",\"Monthly profit\":\"Lucro mensal\",\"Yearly return\":\"Retorno anual\",\"Yearly + reburn\":\"Anual com reinvestimento\",\"history syncing — longer windows still catching up\":\"histórico sincronizando; períodos maiores ainda estão carregando\",\"Create a wallet (Wallet tab) to see activity.\":\"Crie uma carteira na aba Carteira para ver a atividade.\",\"Activity history isn't available on {0} — it needs a history RPC (works on mainnet).\":\"O histórico não está disponível em {0}; precisa de um RPC de histórico (funciona na rede principal).\",\"No activity yet. When your node produces a block, it appears here.\":\"Ainda não há atividade. Os blocos produzidos pelo seu nó aparecerão aqui.\",\"totals still syncing…\":\"totais sincronizando…\",\"Block\":\"Bloco\",\"Deposit\":\"Depósito\",\"Burned → VHP\":\"Queimado → VHP\",\"Sent out\":\"Enviado\",\"Node starting…\":\"Iniciando nó…\",\"Stopping…\":\"Parando…\",\"Stopping node…\":\"Parando nó…\",\"Welcome 👋\":\"Boas-vindas 👋\",\"Set up a Koinos wallet to get started. It takes a few seconds — your key is generated locally and encrypted with a password on this computer.\":\"Configure uma carteira Koinos para começar. Leva poucos segundos: a chave é gerada localmente e criptografada com uma senha neste computador.\",\"🆕 Create a new wallet\":\"🆕 Criar uma nova carteira\",\"Password (min {0} characters)\":\"Senha (mín. {0} caracteres)\",\"Create wallet\":\"Criar carteira\",\"You'll be shown a private key backup right after — write it down and keep it safe.\":\"Depois será exibida uma cópia da chave privada: anote e guarde em um lugar seguro.\",\"📥 Import an existing wallet\":\"📥 Importar carteira existente\",\"Private key (WIF)\":\"Chave privada (WIF)\",\"New password for this device\":\"Nova senha para este dispositivo\",\"Import wallet\":\"Importar carteira\",\"The key is encrypted with your password and stored only on this machine.\":\"A chave é criptografada com sua senha e salva apenas neste computador.\",\"Unlock your wallet\":\"Desbloquear sua carteira\",\"Unlocking is required to burn, send, register the producer key, and for automatic reward returns.\":\"Desbloqueie para queimar, enviar, registrar a chave do produtor e retornar recompensas automaticamente.\",\"Enter\":\"Entrar\",\"🔒 Lock\":\"🔒 Bloquear\",\"Your address — share it to receive {0} or VHP.\":\"Seu endereço: compartilhe para receber {0} ou VHP.\",\"{0} (liquid)\":\"{0} (líquido)\",\"spendable + fuels mana\":\"disponível para gastar e gerar mana\",\"virtual hash power for block production\":\"poder de hash virtual para produzir blocos\",\"recharges over time, spent by transactions\":\"recarrega com o tempo e é gasto em transações\",\"⟠ Ethereum & USDT\":\"⟠ Ethereum e USDT\",\"funding wallet\":\"carteira de financiamento\",\"Your Ethereum funding address, derived from this same wallet key. Receive ETH or USDT here to fund the node, or send them back out.\":\"Seu endereço de financiamento Ethereum deriva da mesma chave. Receba ETH ou USDT para financiar o nó ou envie para outro endereço.\",\"Send only\":\"Envie somente\",\"ETH or USDT on Ethereum Mainnet\":\"ETH ou USDT na rede principal Ethereum\",\"to this address. Other networks/tokens may be lost.\":\"para este endereço. Outros tokens ou redes podem causar perdas.\",\"Send ETH\":\"Enviar ETH\",\"Send USDT\":\"Enviar USDT\",\"Bridge→KOIN\":\"Ponte → KOIN\",\"Explorer ↗\":\"Explorador ↗\",\"Wallet locked\":\"Carteira bloqueada\",\"Address copied\":\"Endereço copiado\",\"ETH address copied\":\"Endereço ETH copiado\",\"Recipient Ethereum address\":\"Endereço Ethereum do destinatário\",\"Amount (ETH)\":\"Quantidade (ETH)\",\"Max\":\"Máx.\",\"Enter a recipient and amount\":\"Digite um destinatário e uma quantidade\",\"Sending…\":\"Enviando…\",\"Getting quote…\":\"Obtendo cotação…\",\"Not enough ETH for amount + gas (balance {0})\":\"ETH insuficiente para quantidade e gas (saldo {0})\",\"Not enough ETH (after gas)\":\"ETH insuficiente após o gas\",\"Amount (USDT)\":\"Quantidade (USDT)\",\"Gas is paid in ETH — keep a little ETH in this address.\":\"O gas é pago em ETH; mantenha um pouco de ETH neste endereço.\",\"Not enough USDT.\":\"USDT insuficiente.\",\"Not enough ETH for gas.\":\"ETH insuficiente para o gas.\",\"No USDT balance\":\"Sem saldo de USDT\",\"Send vKOIN\":\"Enviar vKOIN\",\"Amount (vKOIN)\":\"Quantidade (vKOIN)\",\"Not enough vKOIN.\":\"vKOIN insuficiente.\",\"No vKOIN balance\":\"Sem saldo de vKOIN\",\"Bridge vKOIN → KOIN\":\"Ponte vKOIN → KOIN\",\"native KOIN\":\"KOIN nativo\",\"Bridge to KOIN\":\"Usar ponte para KOIN\",\"Enter a vKOIN amount\":\"Digite uma quantidade de vKOIN\",\"Passwords don't match\":\"As senhas não coincidem\",\"Creating…\":\"Criando…\",\"🔑 Back up your private key now\":\"🔑 Salve sua chave privada agora\",\"This is the only time it will be shown automatically. Anyone with this key controls the wallet — write it down and store it offline.\":\"Esta é a única vez que será exibida automaticamente. Quem tem esta chave controla a carteira: anote e guarde offline.\",\"Address:\":\"Endereço:\",\"Copy key\":\"Copiar chave\",\"I saved my key\":\"Salvei minha chave\",\"Importing…\":\"Importando…\",\"Unlocking…\":\"Desbloqueando…\",\"Wallet unlocked\":\"Carteira desbloqueada\",\"Send tokens\":\"Enviar tokens\",\"Token\":\"Token\",\"Recipient address\":\"Endereço do destinatário\",\"Transfer\":\"Transferir\",\"External producer mode: prepare and sign burns through Node → External signing. KAI will not use the earning wallet.\":\"Produtor externo: prepare e assine queimas em Nó → Assinatura externa. KAI não usará a carteira de ganhos.\",\"Burn {0} → VHP\":\"Queimar {0} → VHP\",\"Burning converts liquid {0} into Virtual Hash Power (VHP) — the stake that lets your node produce blocks and earn rewards.\":\"Queimar converte {0} líquido em poder de hash virtual (VHP), a participação que permite ao nó produzir blocos e ganhar recompensas.\",\"Create a wallet first (Wallet tab).\":\"Primeiro crie uma carteira na aba Carteira.\",\"Unlock your wallet to burn (Wallet tab).\":\"Desbloqueie a carteira na aba Carteira para queimar.\",\"Burning converts liquid {0} into VHP 1:1. VHP is consumed slowly while producing blocks, and you earn {1} rewards in return.\":\"Queimar converte {0} líquido em VHP 1:1. O VHP é consumido gradualmente na produção de blocos, em troca de recompensas em {1}.\",\"🔥 Burn\":\"🔥 Queimar\",\"Balance:\":\"Saldo:\",\"Amount to burn ({0})\":\"Quantidade a queimar ({0})\",\"You will receive: —\":\"Você receberá: —\",\"Burn {0}\":\"Queimar {0}\",\"ℹ️ How it works\":\"ℹ️ Como funciona\",\"Amount exceeds your balance.\":\"A quantidade supera seu saldo.\",\"Not enough mana to burn this much right now (about {0} {1} available). Burning spends mana, which recharges over ~5 days — burn less or wait.\":\"Mana insuficiente para queimar essa quantidade (cerca de {0} {1} disponível). A mana recarrega em cerca de 5 dias; queime menos ou aguarde.\",\"This leaves less than {0} {1} liquid. You need liquid {2} for mana to keep transacting.\":\"Restariam menos de {0} {1} líquidos. Você precisa de {2} líquido para gerar mana e continuar transacionando.\",\"Enter an amount to burn\":\"Digite uma quantidade a queimar\",\"Confirm burn\":\"Confirmar queima\",\"You are about to\":\"Você está prestes a\",\"permanently burn\":\"queimar permanentemente\",\"and receive\":\"e receber\",\"VHP is only useful for producing blocks with a node. It converts back to {0} gradually through block rewards.\":\"VHP só serve para produzir blocos com um nó. Converte-se gradualmente em {0} pelas recompensas de blocos.\",\"Burn\":\"Queimar\",\"Burning…\":\"Queimando…\",\"Waiting for your approval in Koin Vault…\":\"Aguardando sua aprovação no Koin Vault…\",\"Sending request to Koin Vault…\":\"Enviando solicitação ao Koin Vault…\",\"Wallet is submitting your transaction…\":\"A carteira está enviando sua transação…\",\"You rejected the request. Nothing was submitted by this request.\":\"Você rejeitou a solicitação. Nada foi enviado por ela.\",\"Transaction verified on-chain. For registration, click Verify registration before starting the node.\":\"Transação verificada na blockchain. Para o registro, clique em Verificar registro antes de iniciar o nó.\",\"Connected. Use this producer wallet, generate a hot key, then sign its registration below.\":\"Conectado. Use esta carteira de produtor, gere uma chave ativa e assine seu registro abaixo.\",\"Scan with Koin Vault → Connect App. This connection expires in 30 minutes.\":\"Escaneie com Koin Vault → Connect App. A conexão expira em 30 minutos.\",\"Mainnet · No wallet connected.\":\"Rede principal · Nenhuma carteira conectada.\",\"Koinos node\":\"Nó Koinos\",\"📁 Data folder\":\"📁 Pasta de dados\",\"⚡ Quick sync\":\"⚡ Sincronização rápida\",\"Runs the official Koinos microservices with Docker. First start downloads images and syncs the chain — this can take a while.\":\"Executa os microsserviços oficiais Koinos com Docker. A primeira inicialização baixa imagens e sincroniza a blockchain; pode demorar.\",\"Your KAI earning wallet stays separate from an external producer. Stop the node before changing custody or rotating its hot key.\":\"Sua carteira de ganhos KAI fica separada do produtor externo. Pare o nó antes de alterar a custódia ou renovar a chave ativa.\",\"Wallet mode\":\"Modo da carteira\",\"Local earning wallet (hot wallet)\":\"Carteira local de ganhos (ativa)\",\"External/cold producer wallet\":\"Carteira de produtor externa/fria\",\"Watch-only producer address\":\"Endereço de produtor somente leitura\",\"Public Koinos address only — never a private key\":\"Somente endereço público Koinos; nunca uma chave privada\",\"Save custody mode\":\"Salvar modo de custódia\",\"Generate hot key\":\"Gerar chave ativa\",\"Rotate hot key…\":\"Renovar chave ativa…\",\"Verify registration\":\"Verificar registro\",\"Hot block-production public key\":\"Chave pública ativa de produção de blocos\",\"Block-production public key\":\"Chave pública de produção de blocos\",\"Generate a hot key to view its public key\":\"Gere uma chave ativa para ver sua chave pública\",\"Copy public key\":\"Copiar chave pública\",\"Connect your phone, use its wallet as your producer, then approve registration, burns and transfers with your fingerprint or device passkey. Your node keeps running after the phone disconnects.\":\"Conecte seu celular, use a carteira como produtor e aprove registros, queimas e transferências com impressão digital ou passkey. O nó continua funcionando após desconectar o celular.\",\"Use this producer wallet\":\"Usar esta carteira de produtor\",\"Disconnect / cancel approval\":\"Desconectar / cancelar aprovação\",\"Scan with Koin Vault Connect App\":\"Escanear com Koin Vault Connect App\",\"Open Koin Vault → Connect App → scan this QR and approve. Keep the wallet open for transaction requests.\":\"Abra Koin Vault → Connect App, escaneie este QR e aprove. Mantenha a carteira aberta para receber solicitações.\",\"Open Koin Vault\":\"Abrir Koin Vault\",\"Copy connection link\":\"Copiar link de conexão\",\"Operation\":\"Operação\",\"Register hot public key\":\"Registrar chave pública ativa\",\"Allow VHP for block production\":\"Permitir VHP para produzir blocos\",\"Burn KOIN to this producer's VHP\":\"Queimar KOIN para o VHP deste produtor\",\"Transfer tokens\":\"Transferir tokens\",\"Use full VHP balance\":\"Usar todo o saldo de VHP\",\"Also allow my full VHP balance for production\":\"Também permitir todo meu VHP para produção\",\"Includes the new VHP. Both changes use one phone approval.\":\"Inclui o novo VHP. Ambas as alterações usam uma aprovação do celular.\",\"Koinos address\":\"Endereço Koinos\",\"For Koin Vault production, approve a VHP allowance after registering the hot key. Choose a limited amount up to your VHP balance, or 0 to revoke.\":\"Para produzir com Koin Vault, aprove um limite de VHP após registrar a chave ativa. Escolha até seu saldo de VHP ou 0 para revogar.\",\"Review and sign with Koin Vault\":\"Revisar e assinar com Koin Vault\",\"External signing: registration, burns and transfers\":\"Assinatura externa: registros, queimas e transferências\",\"Open Kondor signer\":\"Abrir assinador Kondor\",\"Copy signer link\":\"Copiar link do assinador\",\"Signing and backup guide\":\"Guia de assinatura e backup\",\"Prepare and download the unsigned JSON here. On your secure computer, open https://koinosai.com/producer-signer/ in the browser with Kondor, load the file, review and sign. Bring the signed JSON back and import it below. Your private key stays in Kondor. The offline helper remains available in the guide. Drafts last 15 minutes by default. For dual boot, select the 24-hour window before preparing; after restarting KAI, use Resume saved draft.\":\"Prepare e baixe aqui o JSON não assinado. No computador seguro, abra https://koinosai.com/producer-signer/ com Kondor, carregue, revise e assine o arquivo. Traga o JSON assinado e importe abaixo. A chave privada permanece no Kondor. O guia inclui o assistente offline. Rascunhos duram 15 minutos. Para dual boot, escolha 24 horas antes de preparar; após reiniciar KAI, use Retomar rascunho salvo.\",\"Amount (burn/transfer)\":\"Quantidade (queima/transferência)\",\"Token (transfer)\":\"Token (transferência)\",\"Recipient (transfer)\":\"Destinatário (transferência)\",\"Dual-boot / offline signing — keep this draft for 24 hours\":\"Dual boot / assinatura offline: manter rascunho por 24 horas\",\"Resume saved draft\":\"Retomar rascunho salvo\",\"Prepare unsigned transaction\":\"Preparar transação não assinada\",\"Unsigned transaction — take this file to the secure computer\":\"Transação não assinada: leve este arquivo ao computador seguro\",\"Import signed JSON\":\"Importar JSON assinado\",\"Signed transaction JSON returned by your external signer\":\"JSON da transação assinada devolvido pelo assinador externo\",\"Paste signed transaction JSON only\":\"Cole somente JSON de transação assinada\",\"I reviewed the actual operations, recipient, amount and network on my signing machine.\":\"Revisei as operações reais, o destinatário, a quantidade e a rede no computador de assinatura.\",\"Broadcast signed transaction\":\"Transmitir transação assinada\",\"Previous chain backups\":\"Backups anteriores da blockchain\",\"Manage backups\":\"Gerenciar backups\",\"Quick Sync keeps the previous chain data. After the restored node is working, remove old backups here to reclaim space.\":\"A sincronização rápida preserva os dados anteriores. Quando o nó restaurado funcionar, exclua os backups antigos aqui para liberar espaço.\",\"📡 Status\":\"📡 Status\",\"Recover after an unexpected stop\":\"Recuperar após uma parada inesperada\",\"— manual stops and quick sync keep the node stopped.\":\": paradas manuais e sincronização rápida mantêm o nó parado.\",\"⛏️ Block production setup\":\"⛏️ Configurar produção de blocos\",\"Register signing key\":\"Registrar chave de assinatura\",\"📜 Logs\":\"📜 Registros\",\"all services\":\"todos os serviços\",\"Checking the signed transaction and submitting to the network…\":\"Verificando a transação assinada e enviando à rede…\",\"Custody saved. Automatic returns are off. Verify registration before starting production.\":\"Custódia salva. Os retornos automáticos estão desativados. Verifique o registro antes de produzir.\",\"Hot key ready. Back up private.key and public.key securely from:\":\"Chave ativa pronta. Salve private.key e public.key com segurança de:\",\"Rotate hot production key?\":\"Renovar a chave ativa de produção?\",\"Stop the node first. KAI will preserve a local backup of the old hot key. Register the new public key with your external wallet before restarting production.\":\"Pare o nó primeiro. KAI preservará um backup local da chave anterior. Registre a nova chave pública com sua carteira externa antes de reiniciar a produção.\",\"Rotate key\":\"Renovar chave\",\"Registration does not match yet. Sign and confirm the registration, then check again.\":\"O registro ainda não corresponde. Assine e confirme o registro e verifique novamente.\",\"Koin Vault producer saved. Generate a hot key, then register it with Koin Vault below.\":\"Produtor Koin Vault salvo. Gere uma chave ativa e registre com Koin Vault abaixo.\",\"Create a connection QR first.\":\"Primeiro crie um QR de conexão.\",\"Click \\\"Use this producer wallet\\\" above first (stop the node if it is running), then generate a hot key before registering it.\":\"Primeiro clique em “Usar esta carteira de produtor” (pare o nó se estiver ativo) e gere uma chave ativa antes de registrar.\",\"Preparing review…\":\"Preparando revisão…\",\"Review the request in KAI, then click Request wallet approval to send it to your phone.\":\"Revise a solicitação no KAI e clique em Solicitar aprovação para enviar ao celular.\",\"Set the official Proof-of-Burn contract's spending allowance to\":\"Definir o limite de gasto do contrato oficial Proof-of-Burn como\",\"This replaces the remaining allowance. Block production consumes it as VHP converts to KOIN rewards. Renew it when exhausted; set 0 to revoke it. No tokens move now. Your hot key gains no transfer permission.\":\"Isso substitui a permissão restante. A produção consome o limite ao converter VHP em KOIN. Renove quando acabar ou use 0 para revogar. Nenhum token é movido agora. A chave ativa não ganha permissão de transferência.\",\"Register this node's hot public key:\":\"Registrar a chave pública ativa deste nó:\",\"Permanently burn\":\"Queimar permanentemente\",\"for the same amount of VHP in your producer wallet.\":\"pela mesma quantidade de VHP na carteira do produtor.\",\"Also set the official PoB production allowance to\":\"Também definir o limite oficial de produção PoB como\",\": current VHP plus this burn. Both changes succeed together. This replaces the remaining allowance; later deposits need a new approval.\":\": VHP atual mais esta queima. As duas alterações são concluídas juntas. Substitui a permissão restante; depósitos posteriores exigem nova aprovação.\",\"to:\":\"para:\",\"Review Koin Vault request\":\"Revisar solicitação do Koin Vault\",\"Mainnet · Producer:\":\"Rede principal · Produtor:\",\"Next, review the same details in Koin Vault and approve with your fingerprint or device passkey. Wallet approval submits the transaction.\":\"Revise os mesmos dados no Koin Vault e aprove com impressão digital ou passkey. A aprovação na carteira envia a transação.\",\"Request wallet approval\":\"Solicitar aprovação da carteira\",\"Prepared only — nothing signed or broadcast. Review decoded operations on your separate signing machine.\":\"Apenas preparada: nada foi assinado ou transmitido. Revise as operações decodificadas no computador de assinatura separado.\",\"Prepare a transaction first.\":\"Primeiro prepare uma transação.\",\"Invalid mana\":\"Mana inválida\",\"Choose or paste a valid signed transaction JSON file.\":\"Escolha ou cole um arquivo JSON válido de transação assinada.\",\"Choose a signed JSON file smaller than 100 KB.\":\"Escolha um arquivo JSON assinado menor que 100 KB.\",\"External transaction\":\"Transação externa\",\"The app will keep your node running automatically.\":\"O aplicativo manterá seu nó em execução automaticamente.\",\"Automatic restart is off — you'll restart the node yourself.\":\"O reinício automático está desativado; você deve reiniciar o nó manualmente.\",\"Measuring backups…\":\"Medindo backups…\",\"Delete backup\":\"Excluir backup\",\"Size unavailable\":\"Tamanho indisponível\",\"No previous chain backups.\":\"Nenhum backup anterior da blockchain.\",\"Delete previous chain backup?\":\"Excluir o backup anterior da blockchain?\",\"This permanently deletes {0}. Confirm the restored node is working before removing your rollback copy. Active chain data, wallets and keys are kept.\":\"Isso exclui {0} permanentemente. Confirme que o nó restaurado funciona antes de remover o backup de recuperação. Dados ativos, carteiras e chaves são preservados.\",\"⚡ Quick sync from official backup\":\"⚡ Sincronização rápida com backup oficial\",\"Downloads the Koinos Foundation chain snapshot and installs it, so the node catches up in hours instead of syncing for days. Your wallet, node config, and peer identity are not touched; current chain data is set aside for rollback.\":\"Baixa e instala o snapshot da Koinos Foundation para atualizar em horas em vez de dias. Não altera carteira, configurações nem identidade do nó. Os dados anteriores são guardados para recuperação.\",\"Snapshot size\":\"Tamanho do snapshot\",\"{0} (compressed)\":\"{0} (compactado)\",\"Snapshot date\":\"Data do snapshot\",\"Free disk space\":\"Espaço livre em disco\",\"{0} (needs ~{1} during restore)\":\"{0} (precisa de ~{1} na restauração)\",\"The download is verified against the published SHA-256 and the archive layout is checked before anything is installed. You can cancel at any time and resume later.\":\"O download é verificado pelo SHA-256 publicado e o arquivo é inspecionado antes da instalação. Você pode cancelar a qualquer momento e retomar depois.\",\"Resumable\":\"Pode ser retomado\",\"{0} already downloaded\":\"{0} já baixado\",\"Free space looks below the recommended headroom — the restore may fail mid-way. Free up disk first if possible.\":\"Parece haver menos espaço livre que o recomendado; a restauração pode falhar. Libere espaço antes, se possível.\",\"The node is running — it will be stopped before the restore and can be started again right after.\":\"O nó está ativo. Será parado antes de restaurar e poderá ser iniciado depois.\",\"Start quick sync\":\"Iniciar sincronização rápida\",\"Quick sync started — progress shows on this page\":\"Sincronização rápida iniciada; o progresso aparece aqui\",\"Start Koinos node\":\"Iniciar nó Koinos\",\"Enable block production (uses producer address\":\"Ativar produção de blocos (usa o endereço\",\"as producer)\":\"como produtor)\",\"The node runs in Docker in the background and keeps running even if you close this app. First sync downloads the whole chain.\":\"O nó roda no Docker em segundo plano e continua ativo ao fechar o aplicativo. A primeira sincronização baixa toda a blockchain.\",\"not configured\":\"não configurado\",\"Node starting — pulling images and launching services…\":\"Iniciando nó: baixando imagens e serviços…\",\"Registering…\":\"Registrando…\",\"Producer key registration\":\"Registro da chave do produtor\",\"(no output)\":\"(sem saída)\",\"Docker isn't available.\":\"Docker não está disponível.\",\"Docker install guide ↗\":\"Guia de instalação do Docker ↗\",\"Downloading Docker Desktop{0}\":\"Baixando Docker Desktop{0}\",\"🧰 Set up requirements\":\"🧰 Instalar requisitos\",\"one time · {0}\":\"uma vez · {0}\",\"Re-check\":\"Verificar novamente\",\"Download cancelled\":\"Download cancelado\",\"Restart Windows?\":\"Reiniciar Windows?\",\"Windows needs to restart to finish enabling WSL 2. This will restart your computer in 60 seconds — save any open work first. You can cancel during the countdown.\":\"O Windows precisa reiniciar para concluir a ativação do WSL 2. O computador reiniciará em 60 segundos; salve seu trabalho. Você pode cancelar durante a contagem.\",\"Not now\":\"Agora não\",\"Restart in 60s\":\"Reiniciar em 60 s\",\"Windows will restart in 60 seconds.\":\"O Windows reiniciará em 60 segundos.\",\"Restart cancelled\":\"Reinício cancelado\",\"Preparing snapshot restore\":\"Preparando restauração\",\"Downloading snapshot\":\"Baixando snapshot\",\"Verifying checksum\":\"Verificando soma de verificação\",\"Inspecting archive\":\"Inspecionando arquivo\",\"Extracting chain data\":\"Extraindo dados da blockchain\",\"Installing chain data\":\"Instalando dados da blockchain\",\"Cleaning up\":\"Limpando\",\"Restore complete\":\"Restauração concluída\",\"Restoring chain data\":\"Restaurando dados da blockchain\",\"Quick sync:\":\"Sincronização rápida:\",\"Cancelling quick sync — the download can be resumed later\":\"Cancelando sincronização rápida; você poderá retomar o download\",\"in progress…\":\"em andamento…\",\"{0} failed:\":\"{0} falhou:\",\"stopping for quick sync\":\"parando para sincronização rápida\",\"stopped · quick syncing\":\"parado · sincronização rápida\",\"needs attention\":\"precisa de atenção\",\"(recovered {0}× recently)\":\"(recuperado {0} vezes recentemente)\",\"{0} Automatic recovery will not restart it during quick sync. Start the node after the restore finishes.\":\"{0} A recuperação automática não reiniciará durante a sincronização rápida. Inicie o nó ao terminar.\",\"The node is stopping for a snapshot restore.\":\"O nó está parando para restaurar um snapshot.\",\"The node is stopped while quick sync restores the chain data. Block production is paused.\":\"O nó está parado enquanto os dados são restaurados. A produção de blocos está pausada.\",\"Chain validation failed — block production is not healthy.\":\"A validação da blockchain falhou; a produção não está saudável.\",\"🔧 Repair node data\":\"🔧 Reparar dados do nó\",\"Block submissions rejected: could not burn VHP.\":\"Blocos rejeitados: não foi possível queimar VHP.\",\"Last observed block submission was rejected.\":\"O último bloco observado foi rejeitado.\",\"Open block_producer logs for the failure details. Running services and a registered key do not guarantee accepted blocks.\":\"Abra os registros de block_producer para ver os detalhes. Serviços ativos e chave registrada não garantem blocos aceitos.\",\"Getting your node back up — this takes a minute. You don't need to do anything.\":\"Recuperando seu nó; leva um minuto. Você não precisa fazer nada.\",\"The node is not confirmed healthy ({0}). Block production may be interrupted. Check the chain logs{1}.\":\"O nó não está confirmado como saudável ({0}). A produção pode estar interrompida. Confira os registros{1}.\",\"status unavailable\":\"status indisponível\",\"; automatic recovery is enabled\":\"; recuperação automática ativada\",\"; automatic recovery is off\":\"; recuperação automática desativada\",\"✓ Your node is running and healthy.{0}\":\"✓ Seu nó está ativo e saudável.{0}\",\"Start the node to sync the chain.\":\"Inicie o nó para sincronizar a blockchain.\",\"Waiting for local RPC… (services may still be starting)\":\"Aguardando RPC local… (os serviços podem estar iniciando)\",\"Head block time: {0}\":\"Hora do bloco mais recente: {0}\",\"Producer address configured\":\"Endereço do produtor configurado\",\"Choose a local or external producer address above.\":\"Escolha acima um endereço de produtor local ou externo.\",\"VHP staked at your address\":\"VHP alocado no seu endereço\",\"Checking your VHP… no need to unlock — it's read from your public address.\":\"Verificando seu VHP; não precisa desbloquear, é lido do endereço público.\",\"Node stopping for quick sync\":\"Nó parando para sincronização rápida\",\"Node stopped for quick sync\":\"Nó parado para sincronização rápida\",\"Node running\":\"Nó em execução\",\"Wait for the restore to finish, then start the node.\":\"Aguarde a restauração terminar e inicie o nó.\",\"Start the node above.\":\"Inicie o nó acima.\",\"Signing key generated\":\"Chave de assinatura gerada\",\"Generated automatically by the node on first start.\":\"O nó gera automaticamente na primeira inicialização.\",\"Signing key registered on chain\":\"Chave de assinatura registrada na blockchain\",\"Register it with the button below (needs unlocked wallet + mana).\":\"Registre com o botão abaixo (requer carteira desbloqueada e mana).\",\"Last observed block submission failed\":\"A última tentativa observada de bloco falhou\",\"VHP burn rejected. Approve a production allowance in Koin Vault; registration alone does not confirm successful production.\":\"Queima de VHP rejeitada. Aprove um limite de produção no Koin Vault; só o registro não confirma a produção.\",\"Check block_producer logs for the rejection reason.\":\"Confira os registros de block_producer para ver o motivo da rejeição.\",\"External producer registration verified. The node holds only its hot production key.\":\"Registro do produtor externo verificado. O nó mantém apenas sua chave ativa de produção.\",\"Use External signing above to register this hot key with your separate wallet.\":\"Use Assinatura externa acima para registrar esta chave com sua carteira separada.\",\"Signing key registered on chain.\":\"Chave de assinatura registrada na blockchain.\",\"⚠️ A different key is registered on chain for this address. Register the current node key to replace it.\":\"⚠️ Há outra chave registrada para este endereço. Registre a chave atual do nó para substituí-la.\",\"The signing key appears after the node's first start.\":\"A chave de assinatura aparece após iniciar o nó pela primeira vez.\",\"Unlock your wallet to register.\":\"Desbloqueie sua carteira para registrar.\",\"Block production is paused for quick sync.\":\"A produção está pausada pela sincronização rápida.\",\"The node is stopped; no blocks are being produced here.\":\"O nó está parado; nenhum bloco está sendo produzido aqui.\",\"Production also requires an in-sync node with block production enabled.\":\"Para produzir, o nó precisa estar sincronizado e com produção ativada.\",\"Resume\":\"Retomar\",\"Continue?\":\"Continuar?\",\"Enter a recipient address\":\"Digite um endereço de destinatário\",\"Enter an amount to send\":\"Digite uma quantidade a enviar\",\"Send real ETH?\":\"Enviar ETH real?\",\"on Ethereum Mainnet. This is irreversible. Continue?\":\"na rede principal Ethereum. É irreversível. Continuar?\",\"Send it\":\"Enviar\",\"Sent ✓\":\"Enviado ✓\",\"Preparing…\":\"Preparando…\",\"Endpoint saved\":\"Endpoint salvo\",\"Automatic burns and transfers are disabled for your external producer. Use Node → External signing for each funds operation.\":\"Queimas e transferências automáticas estão desativadas para o produtor externo. Use Nó → Assinatura externa para cada operação de fundos.\",\"⚙️ Configuration\":\"⚙️ Configuração\",\"Enable automatic returns\":\"Ativar retornos automáticos\",\"Return percentage:\":\"Porcentagem de retorno:\",\"of new rewards\":\"das novas recompensas\",\"What to do with returned {0}\":\"O que fazer com {0} retornado\",\"♻️ Compound — burn back into VHP (keeps node producing)\":\"♻️ Reinvestir: queimar novamente em VHP para continuar produzindo\",\"📤 Send to another address\":\"📤 Enviar para outro endereço\",\"Send returns to\":\"Enviar retornos para\",\"Only required when the destination changes\":\"Necessário apenas ao alterar o destino\",\"Minimum return ({0})\":\"Retorno mínimo ({0})\",\"Max per return ({0})\":\"Máximo por retorno ({0})\",\"0 = no limit\":\"0 = sem limite\",\"Check every (minutes)\":\"Verificar a cada (minutos)\",\"Check now\":\"Verificar agora\",\"Max per return\":\"Máximo por retorno\",\"📊 Status\":\"📊 Status\",\"🧾 Return history\":\"🧾 Histórico de retornos\",\"When\":\"Quando\",\"Returned\":\"Retornado\",\"Mode\":\"Modo\",\"Return settings saved\":\"Configurações de retorno salvas\",\"no wallet\":\"sem carteira\",\"wallet locked\":\"carteira bloqueada\",\"RPC error\":\"erro de RPC\",\"no history RPC\":\"sem RPC de histórico\",\"reading history…\":\"lendo histórico…\",\"tracking started\":\"acompanhamento iniciado\",\"low liquid KOIN\":\"pouco KOIN líquido\",\"waiting for mana\":\"aguardando mana\",\"tx failed\":\"transação falhou\",\"config error\":\"erro de configuração\",\"no checks yet\":\"ainda sem verificações\",\"Engine\":\"Mecanismo\",\"Last check\":\"Última verificação\",\"Next automatic check\":\"Próxima verificação automática\",\"Lifetime rewards\":\"Recompensas acumuladas\",\"(Dashboard)\":\"(Painel)\",\"Rewards since enabled\":\"Recompensas desde a ativação\",\"Pending return\":\"Retorno pendente\",\"No returns yet.\":\"Ainda não há retornos.\",\"Network, RPC and wallet management.\":\"Gerenciamento de rede, RPC e carteira.\",\"🌐 Network\":\"🌐 Rede\",\"🔌 Custom RPC (optional)\":\"🔌 RPC personalizado (opcional)\",\"Save settings\":\"Salvar configurações\",\"🔐 Wallet security\":\"🔐 Segurança da carteira\",\"Reveal private key\":\"Exibir chave privada\",\"Remove wallet from this device\":\"Remover carteira deste dispositivo\",\"Files live in\":\"Os arquivos estão em\",\"open ↗\":\"abrir ↗\",\"local node RPC\":\"RPC do nó local\",\"{0} RPC URL\":\"URL do RPC de {0}\",\"Settings saved\":\"Configurações salvas\",\"No wallet on this device\":\"Nenhuma carteira neste dispositivo\",\"Enter your password. Never share this key or enter it on websites.\":\"Digite sua senha. Nunca compartilhe esta chave nem a insira em sites.\",\"⚠️ Remove wallet\":\"⚠️ Remover carteira\",\"This deletes the encrypted key file from this device.\":\"Isso exclui o arquivo de chave criptografada deste dispositivo.\",\"Without a backup of the private key, the funds are lost forever.\":\"Sem backup da chave privada, os fundos serão perdidos para sempre.\",\"to confirm\":\"para confirmar\",\"Remove wallet\":\"Remover carteira\",\"Wallet removed from this device\":\"Carteira removida deste dispositivo\",\"Failed to start UI: {0}\":\"Falha ao iniciar a interface: {0}\",\"This machine\":\"Este computador\",\"{0} — the desktop updater isn't available in this copy.\":\"{0} — o atualizador não está disponível nesta cópia.\",\"{0} — couldn't contact the desktop updater. Restart the app and try again.\":\"{0} — não foi possível contatar o atualizador. Reinicie o aplicativo e tente novamente.\",\"{0} — up to date. Checked just now.\":\"{0} — atualizado. Verificado agora.\",\"Koinos AI {0} is available — downloading it now. You'll be asked before restarting.\":\"Koinos AI {0} está disponível; baixando agora. Você será consultado antes de reiniciar.\",\"Koinos AI {0} is ready and will install when you close the app.\":\"Koinos AI {0} está pronto e será instalado quando você fechar o aplicativo.\",\"Koinos AI {0} is available and ready to download.\":\"Koinos AI {0} está disponível para baixar.\",\"{0} — updates install themselves.\":\"{0} — as atualizações são instaladas automaticamente.\",\"{0} — up to date ({1}), installed from source.\":\"{0} — atualizado ({1}), instalado a partir do código-fonte.\",\"{0} — installed from source, {1}. {2}\":\"{0} — instalado a partir do código-fonte, {1}. {2}\",\"Open wallet\":\"Abrir carteira\",\"Set up wallet\":\"Configurar carteira\",\"Wallet balance unavailable\":\"Saldo da carteira indisponível\",\"Testnet balance has no USD value\":\"O saldo da rede de testes não tem valor em USD\",\"KOIN price is out of date\":\"O preço do KOIN está desatualizado\",\"KOIN price unavailable\":\"Preço do KOIN indisponível\",\"Estimated wallet value in USD\":\"Valor estimado da carteira em USD\",\"KOIN\":\"KOIN\",\"KOIN · Earnings & wallet\":\"KOIN · Ganhos e carteira\",\"Contribute AI capacity, track network rewards and manage your KOIN wallet.\":\"Contribua com capacidade de IA, acompanhe as recompensas da rede e gerencie sua carteira KOIN.\",\"KOIN rewards are in preparation\":\"As recompensas KOIN estão em preparação\",\"This Test build measures availability without paying KOIN rewards. Purchases and claims will open after contract verification. Your existing mainnet wallet remains available below.\":\"Esta versão Test mede a disponibilidade sem pagar recompensas KOIN. Compras e resgates serão liberados após a verificação dos contratos. Sua carteira da rede principal continua disponível abaixo.\",\"Launch policy: up to 5% of the free reward pool per day; 70% for verified availability and 30% for paid work. Unused rewards remain in the pool.\":\"Política de lançamento: até 5% do saldo livre do fundo por dia; 70% para disponibilidade verificada e 30% para trabalho pago. Recompensas não utilizadas permanecem no fundo.\",\"AI usage credits\":\"Créditos de uso de IA\",\"Credits will be prepaid with KOIN. Unused funds stay reserved; only consumed usage is split: 60% to rewards, 25% to mining and 15% to operations.\":\"Os créditos serão pré-pagos com KOIN. O saldo não utilizado fica reservado; apenas o uso consumido é dividido: 60% para recompensas, 25% para mineração e 15% para operações.\",\"Purchases not active\":\"Compras não ativas\",\"Claims not active\":\"Resgates não ativos\",\"Legacy test KAI\":\"KAI de teste anterior\",\"Historical test balances are separate from KOIN. No conversion or distribution has been applied.\":\"Os saldos de teste anteriores são separados de KOIN. Nenhuma conversão ou distribuição foi aplicada.\",\"Available to claim\":\"Disponível para resgatar\",\"Usage credits\":\"Créditos de uso\",\"Not active\":\"Não ativo\",\"Availability estimate (simulation)\":\"Estimativa de disponibilidade (simulação)\",\"Paid-work estimate (simulation)\":\"Estimativa de trabalho pago (simulação)\",\"Awaiting verified data\":\"Aguardando dados verificados\",\"Capacity status\":\"Status da capacidade\",\"Verified for shadow scoring\":\"Verificado para pontuação simulada\",\"Awaiting capacity verification\":\"Aguardando verificação de capacidade\",\"Local-Only mode\":\"Modo somente local\",\"No capacity report\":\"Sem relatório de capacidade\",\"Awaiting master integration\":\"Aguardando integração do nó mestre\",\"Legacy test KAI balance\":\"Saldo anterior de KAI de teste\",\"Legacy prepaid balance\":\"Saldo pré-pago anterior\",\"Legacy epoch\":\"Época anterior\",\"Online — serving{0}\":\"Online — prestando serviço{0}\",\"Preview a spending review\":\"Prévia da revisão de gastos\",\"See the model, maximum request cost and session limits before reviewing an example. Prices are illustrative; paid requests are not active.\":\"Veja o modelo, o custo máximo da solicitação e os limites da sessão antes de revisar um exemplo. Os preços são ilustrativos; solicitações pagas não estão ativas.\",\"Preview review\":\"Ver exemplo de revisão\",\"Review the example in the desktop dialog.\":\"Revise o exemplo na janela do aplicativo.\",\"Example reviewed. No request was signed or sent.\":\"Exemplo revisado. Nenhuma solicitação foi assinada ou enviada.\",\"Preview cancelled. No KOIN was spent.\":\"Prévia cancelada. Nenhum KOIN foi gasto.\",\"Preview unavailable. Please try again.\":\"Prévia indisponível. Tente novamente.\",\"Example prices only. No KOIN will be spent.\":\"Preços de exemplo apenas. Nenhum KOIN será gasto.\",\"Simulation only. No KOIN will be spent.\":\"Apenas simulação. Nenhum KOIN será gasto.\",\"Tariff version\":\"Versão da tarifa\",\"Input tokens\":\"Tokens de entrada\",\"Maximum output tokens\":\"Máximo de tokens de saída\",\"Maximum request cost\":\"Custo máximo da solicitação\",\"Per-request limit\":\"Limite por solicitação\",\"Session available\":\"Disponível na sessão\",\"Session total limit\":\"Limite total da sessão\",\"Requests remaining\":\"Solicitações restantes\",\"Review expires (UTC)\":\"A revisão expira (UTC)\",\"Session\":\"Sessão\",\"Quote\":\"Cotação\",\"Reviewing does not sign or submit a request.\":\"A revisão não assina nem envia uma solicitação.\",\"KOIN · Review preview\":\"KOIN · Prévia da revisão\",\"Review one simulated request\":\"Revise uma solicitação simulada\",\"Mark example reviewed\":\"Marcar exemplo como revisado\",\"KOIN session rehearsal\":\"Ensaio de sessão KOIN\",\"Approve a bounded session once. This developer rehearsal does not enable paid chat or move KOIN.\":\"Aprove uma sessão com limites uma única vez. Este ensaio para desenvolvedores não ativa o chat pago nem movimenta KOIN.\",\"Review session limits\":\"Revisar limites da sessão\",\"Retry saved approval\":\"Tentar novamente a aprovação salva\",\"Refresh session\":\"Atualizar sessão\",\"Revoke session approval\":\"Revogar aprovação da sessão\",\"Stop new requests for this session?\":\"Interromper novas solicitações desta sessão?\",\"Dispatched work stays reserved. This does not refund on-chain credits.\":\"O trabalho enviado mantém sua reserva. Isso não reembolsa créditos na blockchain.\",\"Approve one bounded rehearsal session\":\"Aprovar uma sessão de ensaio com limites\",\"This signs a session approval for accounting tests. No KOIN will be spent.\":\"Isso assina uma aprovação de sessão para testes contábeis. Nenhum KOIN será gasto.\",\"Maximum requests\":\"Máximo de solicitações\",\"Session expires (UTC)\":\"A sessão expira (UTC)\",\"Spending grant\":\"Autorização de gastos\",\"Credits contract\":\"Contrato de créditos\",\"Contract bytecode\":\"Bytecode do contrato\",\"Tariff policy\":\"Política de tarifas\",\"Requests within these limits reuse this approval. Revoking it stops new requests.\":\"Solicitações dentro desses limites reutilizam esta aprovação. Revogá-la impede novas solicitações.\",\"Live payments require a separate authorization and are not enabled by this signature.\":\"Pagamentos reais exigem outra autorização e não são ativados por esta assinatura.\",\"Approve session rehearsal\":\"Aprovar ensaio de sessão\",\"No session approval saved. Review the limits to begin.\":\"Nenhuma aprovação de sessão salva. Revise os limites para começar.\",\"Session approved for accounting rehearsal. Paid chat remains disabled.\":\"Sessão aprovada para ensaio contábil. O chat pago continua desativado.\",\"Session approval revoked. Dispatched work stays reserved.\":\"Aprovação da sessão revogada. O trabalho enviado mantém sua reserva.\",\"Session approval expired.\":\"A aprovação da sessão expirou.\",\"Session action cancelled.\":\"Ação da sessão cancelada.\",\"The session result is uncertain. Refresh or retry the saved approval.\":\"O resultado da sessão é incerto. Atualize ou tente novamente a aprovação salva.\",\"The account grant is unavailable. New requests are blocked.\":\"A autorização da conta está indisponível. Novas solicitações estão bloqueadas.\",\"Session accounting needs reconciliation. New requests are blocked.\":\"A contabilidade da sessão precisa de conciliação. Novas solicitações estão bloqueadas.\",\"Session rehearsal unavailable. Retry the saved approval if a response was lost.\":\"Ensaio de sessão indisponível. Tente novamente a aprovação salva se uma resposta foi perdida.\",\"Input price per 1M tokens\":\"Preço de entrada por 1 milhão de tokens\",\"Output price per 1M tokens\":\"Preço de saída por 1 milhão de tokens\"},\"fr\":{\"Minimize\":\"Réduire\",\"Maximize\":\"Agrandir\",\"Close\":\"Fermer\",\"THINK · BUILD · GROW\":\"PENSEZ · CRÉEZ · GRANDISSEZ\",\"Main navigation\":\"Navigation principale\",\"Workspace\":\"Espace de travail\",\"Chat with KAI\":\"Discuter avec KAI\",\"Brain\":\"Cerveau\",\"Workflows\":\"Flux de travail\",\"Connections\":\"Connexions\",\"Agents\":\"Agents\",\"Documents\":\"Documents\",\"Compare models\":\"Comparer les modèles\",\"Your toolkit\":\"Vos outils\",\"Model library\":\"Bibliothèque de modèles\",\"Tools\":\"Outils\",\"Tasks\":\"Tâches\",\"Local API\":\"API locale\",\"Developer tools\":\"Outils de développement\",\"Contribute\":\"Contribuer\",\"Earn KAI\":\"Gagner des KAI\",\"Launch KAI\":\"Ouvrir KAI\",\"A little help, always close\":\"Un peu d’aide, toujours à portée\",\"Connecting…\":\"Connexion…\",\"Settings\":\"Paramètres\",\"Network\":\"Réseau\",\"Send feedback\":\"Envoyer un avis\",\"Your workspace. Your choice of AI.\":\"Votre espace. Votre choix d’IA.\",\"YOUR AI WORKSPACE\":\"VOTRE ESPACE IA\",\"A little curiosity goes a long way.\":\"Un peu de curiosité mène loin.\",\"Welcome to Koinos AI\":\"Bienvenue sur Koinos AI\",\"Let’s find your first local model. You can also connect OpenAI or Anthropic in desktop Settings, or explore the network.\":\"Trouvons votre premier modèle local. Vous pouvez aussi connecter OpenAI ou Anthropic dans les Paramètres de l’application, ou explorer le réseau.\",\"Download & start\":\"Télécharger et démarrer\",\"Starting…\":\"Démarrage…\",\"Start a new chat\":\"Nouvelle discussion\",\"+ New chat\":\"+ Nouvelle discussion\",\"Search chats…\":\"Rechercher des discussions…\",\"Chats\":\"Discussions\",\"Conversations\":\"Conversations\",\"Make room for your next idea.\":\"Faites place à votre prochaine idée.\",\"YOUR EVERYDAY SIDEKICK\":\"VOTRE COMPAGNON AU QUOTIDIEN\",\"Hi, I’m KAI\":\"Bonjour, je suis KAI\",\"Let’s do something amazing.\":\"Créons quelque chose d’extraordinaire.\",\"Ask a question, explore an idea, or get a hand with your next project.\":\"Posez une question, explorez une idée ou faites-vous aider pour votre prochain projet.\",\"Help me understand something new. Ask me what I’m curious about.\":\"Aide-moi à comprendre quelque chose de nouveau. Demande-moi ce qui m’intéresse.\",\"Answer a question\":\"Répondre à une question\",\"Make the complicated click.\":\"Comprenez ce qui semblait compliqué.\",\"Help me turn an idea into a project. Ask me what I want to build.\":\"Aide-moi à transformer une idée en projet. Demande-moi ce que je veux créer.\",\"Help me build\":\"Aidez-moi à créer\",\"Big ideas start small.\":\"Les grandes idées commencent modestement.\",\"Let’s brainstorm some fresh ideas. Ask me what I’m working on.\":\"Cherchons de nouvelles idées. Demande-moi sur quoi je travaille.\",\"Find a fresh idea\":\"Trouver une nouvelle idée\",\"A different way to think.\":\"Une autre façon de penser.\",\"Choose your AI below. Local, network, or your own desktop connection.\":\"Choisissez votre IA ci-dessous : locale, réseau ou votre propre connexion dans l’application.\",\"How to answer: plain chat, multi-step web research, an agent that uses tools, or a whole AI team\":\"Mode de réponse : discussion, recherche web, agent avec outils ou équipe d’IA\",\"Chat\":\"Discussion\",\"Research\":\"Recherche\",\"Agent\":\"Agent\",\"Research team\":\"Équipe de recherche\",\"Analyst team (code)\":\"Équipe d’analyse (code)\",\"Write & review team\":\"Équipe de rédaction et de relecture\",\"Choose this machine, Koinos Network, or a private desktop provider\":\"Choisissez cet ordinateur, Koinos Network ou un fournisseur privé dans l’application\",\"Which model answers\":\"Modèle qui répond\",\"How the AI should answer\":\"Comment l’IA doit répondre\",\"Default style\":\"Style par défaut\",\"Concise\":\"Concis\",\"Explain simply\":\"Expliquer simplement\",\"Code helper\":\"Aide au code\",\"Custom…\":\"Personnalisé…\",\"Your message to KAI\":\"Votre message à KAI\",\"Ask KAI anything, or dream something up…\":\"Posez une question à KAI ou imaginez quelque chose…\",\"Attach a text file as context\":\"Joindre un fichier texte comme contexte\",\"Web search: the AI looks things up live (your search query leaves this machine)\":\"Recherche web : l’IA consulte des informations en ligne (votre requête quitte cet ordinateur)\",\"Voice input: speak, and it's typed for you — transcribed on this machine, audio never leaves it\":\"Saisie vocale : parlez et le texte est transcrit sur cet ordinateur ; l’audio ne le quitte jamais\",\"Send\":\"Envoyer\",\"Stop\":\"Arrêter\",\"Remove attachment\":\"Retirer la pièce jointe\",\"Describe how the AI should behave, e.g. “You are a pirate. Answer everything in character.”\":\"Décrivez le comportement de l’IA, par exemple : « Tu es un pirate. Réponds toujours dans ce rôle. »\",\"+ New\":\"+ Nouveau\",\"Title\":\"Titre\",\"Write here. Select some text (or nothing, for the whole document) and use the AI bar below — suggestions preview first, and only Apply changes your words.\":\"Écrivez ici. Sélectionnez du texte (ou rien pour utiliser tout le document), puis utilisez la barre IA. Les suggestions sont prévisualisées ; seul Appliquer modifie votre texte.\",\"Model for suggestions\":\"Modèle pour les suggestions\",\"Improve\":\"Améliorer\",\"Fix grammar\":\"Corriger la grammaire\",\"Shorten\":\"Raccourcir\",\"Expand\":\"Développer\",\"Continue\":\"Continuer\",\"…or tell it what to do (e.g. “make this friendlier”)\":\"…ou indiquez quoi faire (par ex. « rends ce texte plus chaleureux »)\",\"Go\":\"Lancer\",\"Suggestion\":\"Suggestion\",\"Apply\":\"Appliquer\",\"Discard\":\"Ignorer\",\"One prompt, two models, blind. Answers stream one at a time (they share the machine), then you reveal which was which. Pick winners to learn which model earns its size.\":\"Une question, deux modèles anonymes. Les réponses arrivent l’une après l’autre car les modèles partagent cet ordinateur. Révélez ensuite leur identité et choisissez les gagnants pour comparer leur qualité.\",\"Ask both models the same thing…\":\"Posez la même question aux deux modèles…\",\"Run both\":\"Exécuter les deux\",\"Answer 1\":\"Réponse 1\",\"Answer 2\":\"Réponse 2\",\"Reveal models\":\"Révéler les modèles\",\"Which answer was better?\":\"Quelle réponse était la meilleure ?\",\"Tie\":\"Égalité\",\"Scheduled tasks\":\"Tâches planifiées\",\"A prompt that runs itself — hourly, daily, or weekly — and drops its answer into your chats. Tasks run while Koinos AI is open, on whichever model you choose, with the same privacy rules as typed chat.\":\"Une instruction s’exécute chaque heure, jour ou semaine et dépose sa réponse dans vos discussions. Les tâches s’exécutent lorsque Koinos AI est ouvert, avec le modèle choisi et les mêmes règles de confidentialité que les discussions.\",\"Name (e.g. Morning writing prompt)\":\"Nom (par ex. Exercice d’écriture matinal)\",\"The prompt to run, e.g. “Give me one unusual writing prompt and a first line.”\":\"Instruction, par ex. : « Propose un sujet d’écriture original et une première phrase. »\",\"Every hour\":\"Chaque heure\",\"Every 6 hours\":\"Toutes les 6 heures\",\"Daily\":\"Chaque jour\",\"Weekly\":\"Chaque semaine\",\"Mon\":\"Lun\",\"Tue\":\"Mar\",\"Wed\":\"Mer\",\"Thu\":\"Jeu\",\"Fri\":\"Ven\",\"Sat\":\"Sam\",\"Sun\":\"Dim\",\"Add task\":\"Ajouter une tâche\",\"Network status\":\"État du réseau\",\"A live look at the Koinos network — the computers online right now and the models they serve. Refreshes every 15 seconds while open.\":\"Les ordinateurs connectés au réseau Koinos et les modèles disponibles en temps réel. Actualisation toutes les 15 secondes lorsque cet écran est ouvert.\",\"Computers online\":\"Ordinateurs en ligne\",\"Model classes live\":\"Catégories de modèles actives\",\"Jobs waiting\":\"Tâches en attente\",\"Models on the network\":\"Modèles sur le réseau\",\"Computers\":\"Ordinateurs\",\"Tools & accounts\":\"Outils et comptes\",\"Give your AI abilities: tool servers (MCP), a memory that lasts across chats, and your email & calendar. Everything asks before acting until you say otherwise.\":\"Ajoutez des serveurs d’outils (MCP), une mémoire entre les discussions, vos e-mails et calendriers. Les actions demandent votre accord jusqu’à indication contraire.\",\"Privacy mode is\":\"Le mode de confidentialité est\",\"Local-Only\":\"Local uniquement\",\": tools that talk to the internet (including email & calendar) are switched off. Change it in Local API → Privacy.\":\": les outils utilisant Internet (e-mails et calendrier compris) sont désactivés. Modifiez ce réglage dans API locale → Confidentialité.\",\"Tool servers\":\"Serveurs d’outils\",\"Add\":\"Ajouter\",\"Add your own (URL or command)\":\"Ajouter le vôtre (URL ou commande)\",\"Name, e.g. My tools\":\"Nom, par ex. Mes outils\",\"https://… (an MCP server URL)\":\"https://… (URL d’un serveur MCP)\",\"or a local command, e.g. npx -y @modelcontextprotocol/server-fetch\":\"ou une commande locale, par ex. npx -y @modelcontextprotocol/server-fetch\",\"Add server\":\"Ajouter un serveur\",\"Manage everything KAI remembers in Brain → Memories.\":\"Gérez les souvenirs de KAI dans Cerveau → Souvenirs.\",\"Email\":\"E-mail\",\"Calendar\":\"Calendrier\",\"Models\":\"Modèles\",\"Trusted models, verified by checksum before first use. Chat picks any model that's on this machine; bigger models answer better and download once.\":\"Modèles fiables, vérifiés par somme de contrôle avant la première utilisation. La discussion peut utiliser tout modèle de cet ordinateur ; les plus grands répondent généralement mieux et se téléchargent une seule fois.\",\"Import your own model\":\"Importer votre propre modèle\",\"Any GGUF file on this machine. It's verified (hashed) once and used in place — nothing is copied or uploaded.\":\"Tout fichier GGUF de cet ordinateur. Il est vérifié une fois et utilisé sur place : rien n’est copié ni envoyé.\",\"Full path to a .gguf file\":\"Chemin complet du fichier .gguf\",\"Import\":\"Importer\",\"Choose file…\":\"Choisir un fichier…\",\"Earn with your hardware\":\"Gagnez avec votre matériel\",\"Run approved AI jobs for the network and earn KAI. Alpha runs on the Koinos testnet — rewards are test tokens while the network hardens.\":\"Exécutez des tâches d’IA approuvées pour le réseau et gagnez des KAI. L’alpha utilise le réseau de test Koinos : les récompenses sont des jetons de test pendant la consolidation du réseau.\",\"Create your earning account\":\"Créer votre compte de gains\",\"A wallet is created on this machine. Its key never leaves your computer and is never shared with apps or the network.\":\"Un portefeuille est créé sur cet ordinateur. Sa clé ne le quitte jamais et n’est partagée ni avec les applications ni avec le réseau.\",\"Choose a password (min 8 chars)\":\"Choisissez un mot de passe (8 caractères min.)\",\"show\":\"afficher\",\"Confirm password\":\"Confirmer le mot de passe\",\"Create\":\"Créer\",\"Backup key — shown only once. Write it down, then continue:\":\"Clé de sauvegarde : affichée une seule fois. Notez-la avant de continuer :\",\"I saved it\":\"Je l’ai sauvegardée\",\"Unlock your earning account\":\"Déverrouiller votre compte de gains\",\"Wallet password\":\"Mot de passe du portefeuille\",\"Unlock\":\"Déverrouiller\",\"Forgot your password? Restore with your backup code\":\"Mot de passe oublié ? Restaurez avec votre code de sauvegarde\",\"Restore from backup code\":\"Restaurer avec le code de sauvegarde\",\"Enter the backup code you wrote down when the account was created, and choose a new password. Your address and balance stay the same.\":\"Saisissez le code de sauvegarde noté à la création du compte et choisissez un nouveau mot de passe. Votre adresse et votre solde restent identiques.\",\"Backup code\":\"Code de sauvegarde\",\"New password (min 8 chars)\":\"Nouveau mot de passe (8 caractères min.)\",\"Confirm new password\":\"Confirmer le nouveau mot de passe\",\"Restore\":\"Restaurer\",\"Offline\":\"Hors ligne\",\"Scheduler URL (from the project)\":\"URL du coordinateur (du projet)\",\"Start Earning\":\"Commencer à gagner\",\"Stopping is immediate — no job runs after you press Stop.\":\"L’arrêt est immédiat : aucune tâche ne s’exécute après avoir cliqué sur Arrêter.\",\"Network usage & balance\":\"Utilisation du réseau et solde\",\"Network AI is billed like any modern AI API — by input and output tokens, per model — and settles in KAI underneath. Add funds by converting KAI at the current reference price, or keep earning: serving the network covers your own usage.\":\"L’IA du réseau est facturée selon les jetons d’entrée et de sortie de chaque modèle, avec règlement en KAI. Ajoutez des fonds en convertissant des KAI au prix de référence actuel, ou continuez à gagner : servir le réseau couvre votre propre utilisation.\",\"KAI to convert\":\"KAI à convertir\",\"Add funds\":\"Ajouter des fonds\",\"Your wallet stays unlocked on this computer.\":\"Votre portefeuille reste déverrouillé sur cet ordinateur.\",\"Lock wallet\":\"Verrouiller le portefeuille\",\"Show backup code\":\"Afficher le code de sauvegarde\",\"Wallet password (required to reveal)\":\"Mot de passe du portefeuille (requis pour afficher)\",\"Reveal\":\"Afficher\",\"Wallet — send & receive on Koinos mainnet\":\"Portefeuille : envoyer et recevoir sur le réseau principal Koinos\",\"Your Koinos AI wallet is a real Koinos address: share it to receive KOIN or VHP, and send either with your wallet password. This is real mainnet value — check the recipient address character by character. Works on every machine, node or not.\":\"Votre portefeuille Koinos AI est une véritable adresse Koinos. Partagez-la pour recevoir des KOIN ou VHP et utilisez votre mot de passe pour en envoyer. Il s’agit de valeur réelle sur le réseau principal : vérifiez chaque caractère de l’adresse du destinataire. Fonctionne avec ou sans nœud.\",\"Your Koinos address\":\"Votre adresse Koinos\",\"Copy address\":\"Copier l’adresse\",\"Show balances\":\"Afficher les soldes\",\"Token to send\":\"Jeton à envoyer\",\"Recipient address (1…)\":\"Adresse du destinataire (1…)\",\"Amount\":\"Montant\",\"Wallet password (required to send)\":\"Mot de passe du portefeuille (requis pour envoyer)\",\"Dashboard\":\"Tableau de bord\",\"Wallet\":\"Portefeuille\",\"Fund node\":\"Financer le nœud\",\"Burn KOIN → VHP\":\"Brûler des KOIN → VHP\",\"Node\":\"Nœud\",\"Reward returns\":\"Retour des récompenses\",\"Node settings\":\"Paramètres du nœud\",\"App settings\":\"Paramètres de l’application\",\"Your account, and the parts of the app that are off until you turn them on.\":\"Votre compte et les fonctions désactivées jusqu’à leur activation.\",\"Desktop AI connections\":\"Connexions IA de l’application\",\"Use your own OpenAI or Anthropic API account in chat and desktop KAI. Chats, attachments and relevant app tool results go directly to your chosen provider. API usage is billed by that provider. Keys are encrypted on this computer and are never offered to the Koinos Network.\":\"Utilisez votre compte API OpenAI ou Anthropic dans les discussions et KAI sur le bureau. Discussions, pièces jointes et résultats pertinents des outils sont envoyés directement au fournisseur choisi. Celui-ci facture l’API. Les clés sont chiffrées sur cet ordinateur et jamais proposées à Koinos Network.\",\"Not connected\":\"Non connecté\",\"API key\":\"Clé API\",\"Paste your API key\":\"Collez votre clé API\",\"Model ID\":\"Identifiant du modèle\",\"(optional — or refresh models after saving)\":\"(facultatif ; vous pouvez aussi actualiser les modèles après l’enregistrement)\",\"A model ID from your provider account\":\"Un identifiant de modèle de votre compte fournisseur\",\"Save connection\":\"Enregistrer la connexion\",\"Test & refresh models\":\"Tester et actualiser les modèles\",\"Use in chat\":\"Utiliser dans la discussion\",\"Remove\":\"Retirer\",\"Get an API key ↗\":\"Obtenir une clé API ↗\",\"Available in desktop chat, Research, Agent and KAI. Teams, scheduled tasks, the local API and network earning continue using their existing models. Stop cancels an active provider reply.\":\"Disponible dans la discussion de l’application, Recherche, Agent et KAI. Les équipes, tâches planifiées, API locale et gains réseau conservent leurs modèles actuels. Arrêter annule la réponse active du fournisseur.\",\"Checking…\":\"Vérification…\",\"Check for updates\":\"Rechercher des mises à jour\",\"Koinos AI account\":\"Compte Koinos AI\",\"One account across your devices: sign in once, link this wallet, and your balance and claims follow you. Sign-in happens at koinosai.com with a passkey, email code, or Google — the app never asks for a password, it just shows a short code.\":\"Un compte pour tous vos appareils : connectez-vous et associez ce portefeuille pour retrouver votre solde et vos demandes. La connexion se fait sur koinosai.com par passkey, code e-mail ou Google. L’application affiche un code court et ne demande jamais votre mot de passe de connexion.\",\"Sign in / create account\":\"Se connecter / créer un compte\",\"On any device, open\":\"Sur n’importe quel appareil, ouvrez\",\", sign in, and type this code:\":\", connectez-vous et saisissez ce code :\",\"Waiting for approval…\":\"En attente d’approbation…\",\"Link this wallet\":\"Associer ce portefeuille\",\"Sign out on this device\":\"Se déconnecter sur cet appareil\",\"Use Koinos AI on the web\":\"Utiliser Koinos AI sur le web\",\"Chat and Docs in a browser, signed in to this same account — useful on a machine that cannot run models. The website has no key of its own, so it can only spend what you authorise here: a cap, and a date it stops. This app signs that once, with this wallet, and you can end it from either side at any time. A grant is permission, not funds — this wallet still needs KAI on the network to draw against, same as the app.\":\"Utilisez Discussion et Documents dans un navigateur avec ce même compte, même sans modèles locaux. Le site ne peut dépenser que ce qui est autorisé ici : un plafond et une date d’expiration. L’application signe l’autorisation avec votre portefeuille ; vous pouvez la révoquer des deux côtés. Cette autorisation n’ajoute pas de fonds : le portefeuille doit contenir des KAI sur le réseau.\",\"How it works\":\"Fonctionnement\",\"Spend up to\":\"Dépenser jusqu’à\",\"for 7 days\":\"pendant 7 jours\",\"for 30 days\":\"pendant 30 jours\",\"for 90 days\":\"pendant 90 jours\",\"Authorise\":\"Autoriser\",\"In US dollars of model usage — the same rates the Network tab shows. Nothing is transferred now; the site draws against this as it is used.\":\"En dollars américains d’utilisation des modèles, aux tarifs de l’onglet Réseau. Aucun transfert n’a lieu maintenant ; le site utilise l’autorisation selon la consommation.\",\"Open the web app\":\"Ouvrir l’application web\",\"End web access\":\"Mettre fin à l’accès web\",\"Closing the window\":\"À la fermeture de la fenêtre\",\"Keep running in the notification area\":\"Continuer dans la zone de notification\",\"Closing the window tucks Koinos AI down by the clock instead of shutting it down, so your node stays connected and keeps earning. Click that icon to bring the window back, or right-click it and choose Quit to stop the app completely. Switch this off and the X closes the app outright, the way it used to.\":\"Fermer la fenêtre laisse Koinos AI près de l’horloge pour que votre nœud reste connecté et continue à gagner. Cliquez sur l’icône pour revenir, ou faites un clic droit et choisissez Quitter pour tout arrêter. Désactivez cette option pour que la croix ferme l’application.\",\"Optional sections\":\"Sections facultatives\",\"Each of these adds its own entry to the sidebar. All of them are off until you switch them on, and switching one off only hides it — nothing you made is deleted.\":\"Chaque fonction ajoute une entrée à la barre latérale et reste inactive jusqu’à son activation. La désactiver ne fait que la masquer : aucune de vos créations n’est supprimée.\",\"Run Koinos Node\":\"Exécuter Koinos Node\",\"Runs a real Koinos node on this machine, with a wallet, funding, swaps and block-production rewards. Uses your existing Koinos AI wallet. Node networking is independent of AI Privacy; Local-Only can stay on.\":\"Exécute un véritable nœud Koinos sur cet ordinateur, avec portefeuille, financement, échanges et récompenses de production de blocs. Utilise votre portefeuille Koinos AI existant. Le réseau du nœud est indépendant de la confidentialité de l’IA ; Local uniquement peut rester activé.\",\"Run Koinos node\":\"Exécuter le nœud Koinos\",\"Koinos Node is on — it is in the sidebar now.\":\"Koinos Node est activé et apparaît dans la barre latérale.\",\"Adds a\":\"Ajoute une section\",\"Developer Tools\":\"Outils de développement\",\"section to the sidebar: build your own multi-agent systems, watch them run in a live playground, define custom pipelines, and benchmark your model. Everything there obeys the same privacy and permission rules as the rest of the app.\":\"dans la barre latérale : créez des systèmes multi-agents, observez leur exécution, définissez des pipelines et évaluez votre modèle. Les mêmes règles de confidentialité et d’autorisation s’appliquent.\",\"Adds\":\"Ajoute\",\"to the sidebar: the coding agent, working on folders you choose. Worth knowing exactly what it can do — inside a project you add, it can write files and run commands as you. It never does either without showing you the change or the exact command first and waiting for your yes, and it never touches anything outside that folder.\":\"dans la barre latérale : un agent de programmation travaillant dans les dossiers choisis. Il peut écrire des fichiers et exécuter des commandes sous votre identité dans les projets ajoutés. Il affiche d’abord la modification ou la commande exacte et attend votre accord. Il ne touche jamais aux éléments hors de ce dossier.\",\"Your local OpenAI-compatible API\":\"Votre API locale compatible OpenAI\",\"Point any OpenAI SDK or tool at this machine. No cloud, no per-token bill.\":\"Connectez tout SDK OpenAI ou outil à cet ordinateur. Sans cloud ni facture par jeton.\",\"Network & privacy\":\"Réseau et confidentialité\",\"Local-Only is the default: AI requests stay on this machine. Koinos Node and explicit wallet actions use the blockchain independently. Local-First and Network unlock the “Koinos Network” model — requests overflow to network providers through the scheduler.\":\"Local uniquement est le réglage par défaut : les requêtes IA restent sur cet ordinateur. Koinos Node et les actions explicites du portefeuille utilisent la blockchain indépendamment. Local en priorité et Réseau activent le modèle Koinos Network et l’envoi de requêtes aux fournisseurs via le coordinateur.\",\"Network requests run on other people's computers: the provider serving your request can read what it contains\":\"Les requêtes réseau s’exécutent sur les ordinateurs d’autres personnes : le fournisseur peut lire leur contenu\",\"— nothing is stored by the serving path, but treat anything sent off this machine as visible to that provider.\":\": le traitement ne stocke rien, mais considérez toute information envoyée hors de cet ordinateur comme visible par le fournisseur.\",\"Local-Only (AI requests stay on this machine)\":\"Local uniquement (les requêtes IA restent sur cet ordinateur)\",\"Local-First (local when possible, network when needed — first 25k tokens/epoch free)\":\"Local en priorité (local si possible, réseau si nécessaire ; 25 000 premiers jetons par époque gratuits)\",\"API keys\":\"Clés API\",\"Create key\":\"Créer une clé\",\"Without keys, apps on this computer connect freely. Creating the first key requires every API call to present one — the built-in chat keeps working either way.\":\"Sans clé, les applications de cet ordinateur se connectent librement. Créer la première clé impose une clé à chaque appel API. La discussion intégrée fonctionne dans les deux cas.\",\"Copy it now — it is shown only once:\":\"Copiez-la maintenant : elle n’est affichée qu’une fois :\",\"Remote access\":\"Accès à distance\",\"Use your API from anywhere — a phone, a server, another computer. The app keeps an outbound connection to koinosai.com (nothing to install, no router setup) and your API key works at the address below. Requests are answered by\":\"Utilisez votre API depuis un téléphone, serveur ou autre ordinateur. L’application maintient une connexion sortante vers koinosai.com, sans installation ni réglage du routeur. Votre clé fonctionne à l’adresse ci-dessous. Les requêtes sont traitées par\",\"this computer\":\"cet ordinateur\",\", so it works while the app is running. An API key is required — without one the switch refuses, so your API is never open to the internet. Heads up: remote traffic passes through koinosai.com on its way here.\":\", donc l’application doit rester ouverte. Une clé API est requise ; sans elle, l’accès ne peut pas être activé. Votre API n’est jamais ouverte à Internet. Le trafic distant passe par koinosai.com.\",\"Projects\":\"Projets\",\"Connect GitHub\":\"Connecter GitHub\",\"Point it at a folder and tell it what to do. It shows you every change before anything happens.\":\"Choisissez un dossier et indiquez quoi faire. Chaque modification est présentée avant son exécution.\",\"Select a folder\":\"Sélectionner un dossier\",\"Work on something already on this machine\":\"Travailler sur un projet déjà sur cet ordinateur\",\"Clone from GitHub\":\"Cloner depuis GitHub\",\"Copy a repository down and start on it\":\"Télécharger un dépôt et commencer à travailler\",\"Choose a folder\":\"Choisir un dossier\",\"Type or paste a full path\":\"Saisissez ou collez un chemin complet\",\"Use this folder\":\"Utiliser ce dossier\",\"Clone a repository\":\"Cloner un dépôt\",\"owner/name — or the full GitHub URL\":\"propriétaire/nom ou URL GitHub complète\",\"Select a folder…\":\"Sélectionner un dossier…\",\"no folder chosen yet\":\"aucun dossier choisi\",\"Folder to clone into — full path\":\"Dossier de destination : chemin complet\",\"Clone and start\":\"Cloner et démarrer\",\"Rename\":\"Renommer\",\"Forget\":\"Oublier\",\"Branch name / commit message / PR title\":\"Nom de branche / message de commit / titre de PR\",\"Branch\":\"Branche\",\"Project name\":\"Nom du projet\",\"Save\":\"Enregistrer\",\"Cancel\":\"Annuler\",\"What should it do? (Enter to send, Shift+Enter for a new line)\":\"Que doit-il faire ? (Entrée pour envoyer, Maj+Entrée pour une nouvelle ligne)\",\"Plan first\":\"Planifier d’abord\",\"Model\":\"Modèle\",\"Which model does the work. Koinos Code runs on this machine only — the agent reads your project's files into the prompt, and those do not leave the computer.\":\"Le modèle qui effectue le travail. Koinos Code s’exécute uniquement sur cet ordinateur : les fichiers du projet sont lus dans l’instruction et ne quittent pas l’ordinateur.\",\"Tools…\":\"Outils…\",\"Tools this project may use\":\"Outils autorisés pour ce projet\",\"Build and run your own agent systems on this machine's API — from a one-line pipeline to a team of named agents that talk, use tools, and ask you questions.\":\"Créez et exécutez des systèmes d’agents sur l’API de cet ordinateur, d’un simple pipeline à des équipes qui discutent, utilisent des outils et vous posent des questions.\",\"Developer tools sections\":\"Sections des outils de développement\",\"Multi-agent\":\"Multi-agents\",\"Playground\":\"Terrain d’essai\",\"Pipelines\":\"Pipelines\",\"Benchmark\":\"Évaluation\",\"Named agents share one conversation. Pick how the floor moves — round robin, a model moderator, or explicit handoffs — and how it ends. A\":\"Les agents nommés partagent une conversation. Choisissez l’ordre (à tour de rôle, modérateur IA ou passages explicites) et la fin. Un agent\",\"human\":\"humain\",\"agent pauses the run and asks you. Hard ceilings always hold: 60 messages, 120 model calls, 6 tool actions per turn. Apps can POST the same spec to\":\"met l’exécution en pause et vous interroge. Les plafonds sont de 60 messages, 120 appels au modèle et 6 actions d’outils par tour. Les applications peuvent envoyer la même spécification par POST à\",\"Team name\":\"Nom de l’équipe\",\"e.g. Research duo\":\"par ex. Duo de recherche\",\"Turn order\":\"Ordre des tours\",\"Round robin — agents speak in order\":\"À tour de rôle : les agents parlent dans l’ordre\",\"Selector — a model picks who speaks next\":\"Sélecteur : un modèle choisit qui parle ensuite\",\"Handoff — the speaker passes the floor by name\":\"Passage : l’orateur passe la parole par nom\",\"+ Add agent\":\"+ Ajouter un agent\",\"Max messages\":\"Messages max.\",\"Max model calls\":\"Appels au modèle max.\",\"End phrase\":\"Phrase de fin\",\"Team JSON\":\"JSON de l’équipe\",\"Update JSON from builder\":\"Actualiser le JSON depuis l’éditeur\",\"Update the JSON after changing the builder. Saving and running use this JSON.\":\"Actualisez le JSON après avoir modifié l’éditeur. L’enregistrement et l’exécution utilisent ce JSON.\",\"Save team\":\"Enregistrer l’équipe\",\"Saved teams\":\"Équipes enregistrées\",\"Load\":\"Charger\",\"Delete\":\"Supprimer\",\"Run a team and watch the conversation live. When a human agent's turn comes, the box below asks you — the run waits (up to its timeout) for your words.\":\"Exécutez une équipe et suivez la conversation en direct. Au tour d’un agent humain, le champ ci-dessous vous demande une réponse ; l’exécution attend jusqu’à son délai limite.\",\"Team\":\"Équipe\",\"Task\":\"Tâche\",\"What should the team do?\":\"Que doit faire l’équipe ?\",\"Run\":\"Exécuter\",\"Your message to the team\":\"Votre message à l’équipe\",\"It's your turn — type your message\":\"À votre tour : saisissez votre message\",\"The simple track: one pipeline of typed stages (plan → work → write → critique → revise). Budgets cap at the built-in ceilings (4 sub-tasks, 4 actions per worker, 24 model calls) no matter what the spec asks. Also at\":\"Un pipeline par étapes : planifier → travailler → écrire → évaluer → réviser. Les limites sont de 4 sous-tâches, 4 actions par exécutant et 24 appels au modèle, quelle que soit la spécification. Aussi disponible sur\",\"Pipeline name\":\"Nom du pipeline\",\"e.g. Research pipeline\":\"par ex. Pipeline de recherche\",\"Stages\":\"Étapes\",\"plan\":\"planifier\",\"work\":\"travailler\",\"write (always)\":\"écrire (toujours)\",\"critique\":\"évaluer\",\"revise\":\"réviser\",\"loading tools…\":\"chargement des outils…\",\"Sub-tasks\":\"Sous-tâches\",\"Actions per worker\":\"Actions par exécutant\",\"Worker goal (optional)\":\"Objectif de l’exécutant (facultatif)\",\"What each worker should do\":\"Ce que doit faire chaque exécutant\",\"Pipeline JSON\":\"JSON du pipeline\",\"Update the JSON after changing the builder. Running uses this JSON.\":\"Actualisez le JSON après avoir modifié l’éditeur. L’exécution utilise ce JSON.\",\"What should the pipeline do?\":\"Que doit faire le pipeline ?\",\"Run team\":\"Exécuter l’équipe\",\"Scores the current model on a fixed suite of objective tasks — arithmetic, instruction following, JSON output, extraction, and a tool-using agent case. Same tasks every run, so scores compare across models and app versions. Also at\":\"Évalue le modèle sur des tâches fixes : arithmétique, respect des instructions, sortie JSON, extraction et utilisation d’outils. Les mêmes tâches permettent de comparer modèles et versions. Aussi sur\",\"Run benchmark\":\"Lancer l’évaluation\",\"Goes straight to the Koinos AI team. Crashes, confusion, ideas — all welcome.\":\"Envoyé directement à l’équipe Koinos AI. Erreurs, questions et idées sont les bienvenues.\",\"What happened? What did you expect?\":\"Que s’est-il passé ? Qu’attendiez-vous ?\",\"Email (optional — for a reply)\":\"E-mail (facultatif, pour une réponse)\",\"Include the app's diagnostic log (recommended — no chat content, no keys)\":\"Inclure le journal de diagnostic (recommandé ; sans discussions ni clés)\",\"Language\":\"Langue\",\"App language\":\"Langue de l’application\",\"Choose your language\":\"Choisissez votre langue\",\"Welcome to Koinos AI. Select your language to get started.\":\"Bienvenue sur Koinos AI. Choisissez votre langue pour commencer.\",\"You can change this later in Settings.\":\"Vous pourrez modifier ce choix dans les Paramètres.\",\"Choose the language used for menus, settings, and setup. You can change it at any time.\":\"Choisissez la langue des menus, paramètres et de la configuration initiale. Vous pouvez la modifier à tout moment.\",\"Language saved.\":\"Langue enregistrée.\",\"Could not save the language. Please try again.\":\"Impossible d’enregistrer la langue. Réessayez.\",\"Could not load the language setting. Choose a language and try again.\":\"Impossible de charger la langue. Choisissez-en une et réessayez.\",\"Core unreachable\":\"Core inaccessible\",\"Downloading model… {0}%\":\"Téléchargement du modèle… {0}%\",\"Downloading engine… {0}%\":\"Téléchargement du moteur… {0}%\",\"Setting up engine… (one time — takes a few minutes, the app stays usable)\":\"Configuration du moteur… (une seule fois ; quelques minutes, l’application reste utilisable)\",\"Loading model…\":\"Chargement du modèle…\",\"Model loaded\":\"Modèle chargé\",\"Ready (model loads on first message)\":\"Prêt (le modèle se charge au premier message)\",\"Setup needed\":\"Configuration requise\",\"No models in catalog\":\"Aucun modèle dans le catalogue\",\"Desktop provider ready\":\"Fournisseur de l’application prêt\",\"Model load failed{0}\":\"Échec du chargement du modèle{0}\",\"System\":\"Système\",\"Memory\":\"Mémoire\",\"None detected — running on CPU\":\"Aucun détecté ; utilisation du processeur\",\"From a first thought to the final draft.\":\"De la première idée au brouillon final.\",\"One question. A few different perspectives.\":\"Une question. Plusieurs perspectives.\",\"Find the right mind for the job.\":\"Trouvez le bon modèle pour la tâche.\",\"Build a service. Connect with other agents.\":\"Créez un service. Connectez-vous à d’autres agents.\",\"Your world, remembered.\":\"Votre monde, en mémoire.\",\"Give your routines to KAI.\":\"Confiez vos routines à KAI.\",\"Your accounts, your control.\":\"Vos comptes, votre contrôle.\",\"Put your ideas in motion.\":\"Mettez vos idées en mouvement.\",\"Give your AI a few more abilities.\":\"Donnez plus de capacités à votre IA.\",\"Your models, connected to your workflow.\":\"Vos modèles, connectés à votre travail.\",\"Let your compute contribute.\":\"Faites contribuer votre puissance de calcul.\",\"Make this space your own.\":\"Personnalisez cet espace.\",\"Connected on your terms.\":\"Connecté selon vos conditions.\",\"Build something you want to exist.\":\"Créez ce que vous aimeriez voir exister.\",\"Everything you need to get hands-on.\":\"Tout ce qu’il faut pour passer à l’action.\",\"Your wallet. Your node. Your contribution.\":\"Votre portefeuille. Votre nœud. Votre contribution.\",\"Let’s get you ready.\":\"Préparons votre espace.\",\"Copy\":\"Copier\",\"Copy message\":\"Copier le message\",\"Copied\":\"Copié\",\"Edit\":\"Modifier\",\"Refresh\":\"Actualiser\",\"Retry\":\"Réessayer\",\"Back\":\"Retour\",\"← Back\":\"← Retour\",\"Next\":\"Suivant\",\"Done\":\"Terminé\",\"Ready\":\"Prêt\",\"Loading…\":\"Chargement…\",\"Working…\":\"Traitement…\",\"Saving…\":\"Enregistrement…\",\"Saved\":\"Enregistré\",\"Failed\":\"Échec\",\"Error\":\"Erreur\",\"Unknown error\":\"Erreur inconnue\",\"Running\":\"En cours\",\"Stopped\":\"Arrêté\",\"stopped\":\"arrêté\",\"running\":\"en cours\",\"Paused\":\"En pause\",\"Pending\":\"En attente\",\"Enabled\":\"Activé\",\"Disabled\":\"Désactivé\",\"On\":\"Activé\",\"Off\":\"Désactivé\",\"Online\":\"En ligne\",\"Connected\":\"Connecté\",\"Connect\":\"Connecter\",\"Disconnect\":\"Déconnecter\",\"Start\":\"Démarrer\",\"Stop Earning\":\"Arrêter les gains\",\"Details\":\"Détails\",\"Name\":\"Nom\",\"Description\":\"Description\",\"Status\":\"État\",\"Type\":\"Type\",\"Action\":\"Action\",\"Actions\":\"Actions\",\"Address\":\"Adresse\",\"Balance\":\"Solde\",\"Balances\":\"Soldes\",\"Password\":\"Mot de passe\",\"Confirm\":\"Confirmer\",\"Confirm transaction\":\"Confirmer la transaction\",\"Transaction\":\"Transaction\",\"Transactions\":\"Transactions\",\"Receive\":\"Recevoir\",\"Sent\":\"Envoyé\",\"Received\":\"Reçu\",\"Recipient\":\"Destinataire\",\"Fee\":\"Frais\",\"Amount to send\":\"Montant à envoyer\",\"Available\":\"Disponible\",\"Not available\":\"Indisponible\",\"Copy to clipboard\":\"Copier dans le presse-papiers\",\"Export\":\"Exporter\",\"Download\":\"Télécharger\",\"Install\":\"Installer\",\"Uninstall\":\"Désinstaller\",\"Update\":\"Mettre à jour\",\"Open\":\"Ouvrir\",\"Search\":\"Rechercher\",\"Clear\":\"Effacer\",\"New\":\"Nouveau\",\"Yes\":\"Oui\",\"No\":\"Non\",\"None\":\"Aucun\",\"Never\":\"Jamais\",\"Not yet\":\"Pas encore\",\"Optional\":\"Facultatif\",\"Required\":\"Obligatoire\",\"Advanced\":\"Avancé\",\"General\":\"Général\",\"Security\":\"Sécurité\",\"Privacy\":\"Confidentialité\",\"Overview\":\"Vue d’ensemble\",\"Activity\":\"Activité\",\"History\":\"Historique\",\"Today\":\"Aujourd’hui\",\"Yesterday\":\"Hier\",\"Total\":\"Total\",\"Options\":\"Options\",\"Default\":\"Par défaut\",\"Configure\":\"Configurer\",\"Manage\":\"Gérer\",\"View\":\"Afficher\",\"Reset\":\"Réinitialiser\",\"Restart\":\"Redémarrer\",\"Test builds\":\"Versions de test\",\"What's new\":\"Nouveautés\",\"Couldn't check — Core is not answering.\":\"Vérification impossible : Core ne répond pas.\",\"Memories\":\"Souvenirs\",\"Memory graph\":\"Carte des souvenirs\",\"Goals & tasks\":\"Objectifs et tâches\",\"Sources\":\"Sources\",\"Sync & changes\":\"Synchronisation et modifications\",\"Awareness\":\"Veille\",\"Orchestration\":\"Orchestration\",\"My workflows\":\"Mes flux de travail\",\"Run history\":\"Historique d’exécution\",\"Templates\":\"Modèles de flux\",\"Discover workflows\":\"Découvrir des flux\",\"Explore apps\":\"Explorer les applications\",\"Connection settings\":\"Paramètres de connexion\",\"Custom APIs\":\"API personnalisées\",\"Models & other tools\":\"Modèles et autres outils\",\"KAI Brain\":\"Cerveau de KAI\",\"A memory of your world, built from what you choose to share.\":\"Une mémoire de votre monde, construite à partir de ce que vous partagez.\",\"Teach KAI a routine. Review the steps, then run it whenever you need.\":\"Apprenez une routine à KAI. Vérifiez les étapes et lancez-la au besoin.\",\"Connect the apps you use and choose what KAI can do with them.\":\"Connectez vos applications et choisissez ce que KAI peut y faire.\",\"Open the installed KAI desktop app\":\"Ouvrez l’application KAI installée\",\"Brain, private API connections, and durable workflows are available in Koinos AI Test.\":\"Cerveau, connexions API privées et flux persistants sont disponibles dans Koinos AI Test.\",\"Your companion data is locked\":\"Les données du compagnon sont verrouillées\",\"Unlock your original OS keychain and restart KAI. Your saved data will stay intact.\":\"Déverrouillez le trousseau original du système et redémarrez KAI. Vos données seront préservées.\",\"Add memory\":\"Ajouter un souvenir\",\"Edit memory\":\"Modifier le souvenir\",\"Your notes\":\"Vos notes\",\"Source removed\":\"Source supprimée\",\"Read source text\":\"Lire le texte source\",\"A little more understanding, every day.\":\"Un peu plus de compréhension chaque jour.\",\"Memories, sources and priorities connected in one private place.\":\"Souvenirs, sources et priorités réunis dans un espace privé.\",\"Export Markdown\":\"Exporter en Markdown\",\"Topics\":\"Sujets\",\"To review\":\"À examiner\",\"Observing\":\"En observation\",\"Assisting\":\"En assistance\",\"Run a check\":\"Lancer une vérification\",\"Open activity\":\"Ouvrir l’activité\",\"Your daily briefing\":\"Votre résumé quotidien\",\"Build briefing\":\"Créer le résumé\",\"Worth a look\":\"À regarder\",\"You're all caught up\":\"Tout est à jour\",\"Your memory activity\":\"Activité de vos souvenirs\",\"Use relevant Brain memories in private replies\":\"Utiliser les souvenirs pertinents dans les réponses privées\",\"Your memories\":\"Vos souvenirs\",\"See how your world connects\":\"Découvrez les liens de votre monde\",\"Search exact source text and your saved knowledge.\":\"Recherchez dans les textes sources et vos connaissances.\",\"Import file\":\"Importer un fichier\",\"Source\":\"Source\",\"Topic\":\"Sujet\",\"All sources\":\"Toutes les sources\",\"All topics\":\"Tous les sujets\",\"Updated since\":\"Mis à jour depuis\",\"People, topics, projects…\":\"Personnes, sujets, projets…\",\"Add a goal\":\"Ajouter un objectif\",\"Goal\":\"Objectif\",\"Goals\":\"Objectifs\",\"Priority\":\"Priorité\",\"Due date\":\"Échéance\",\"High\":\"Haute\",\"Medium\":\"Moyenne\",\"Low\":\"Basse\",\"Completed\":\"Terminé\",\"Complete\":\"Terminer\",\"Add source\":\"Ajouter une source\",\"Sync now\":\"Synchroniser maintenant\",\"Sync\":\"Synchroniser\",\"Auto-sync\":\"Synchronisation automatique\",\"Local model\":\"Modèle local\",\"Source excerpts\":\"Extraits des sources\",\"New workflow\":\"Nouveau flux de travail\",\"Import workflow\":\"Importer un flux\",\"Scheduled prompts\":\"Instructions planifiées\",\"Manual\":\"Manuel\",\"Schedule on\":\"Planification activée\",\"Schedule off\":\"Planification désactivée\",\"Draft · review required\":\"Brouillon · à vérifier\",\"Review & resume\":\"Vérifier et reprendre\",\"Cancel run\":\"Annuler l’exécution\",\"Your first run starts here\":\"Votre première exécution commence ici\",\"Run a saved workflow to see its progress and results.\":\"Exécutez un flux enregistré pour suivre sa progression et ses résultats.\",\"Make room for the work you enjoy\":\"Faites place au travail que vous aimez\",\"Start from a template\":\"Partir d’un modèle\",\"Project briefing\":\"Résumé du projet\",\"Weekly goal review\":\"Bilan hebdomadaire des objectifs\",\"API digest\":\"Résumé API\",\"AI models\":\"Modèles d’IA\",\"Provider settings\":\"Paramètres du fournisseur\",\"Local model library\":\"Bibliothèque de modèles locaux\",\"MCP, email & calendars\":\"MCP, e-mail et calendriers\",\"Open Tools\":\"Ouvrir les outils\",\"Add connection\":\"Ajouter une connexion\",\"Manual use only\":\"Utilisation manuelle uniquement\",\"Background reads allowed\":\"Lectures en arrière-plan autorisées\",\"Background reads off\":\"Lectures en arrière-plan désactivées\",\"Open & test\":\"Ouvrir et tester\",\"Connect a custom API\":\"Connecter une API personnalisée\",\"Start with an API template\":\"Partir d’un modèle d’API\",\"Source content\":\"Contenu de la source\",\"Workflow builder\":\"Éditeur de flux\",\"API connection\":\"Connexion API\",\"Use connection\":\"Utiliser la connexion\",\"Add a Brain source\":\"Ajouter une source au Cerveau\",\"Start workflow\":\"Démarrer le flux\",\"Run input (optional)\":\"Entrée d’exécution (facultatif)\",\"Start run\":\"Démarrer l’exécution\",\"Category\":\"Catégorie\",\"Pinned\":\"Épinglé\",\"Content\":\"Contenu\",\"Save memory\":\"Enregistrer le souvenir\",\"Save goal\":\"Enregistrer l’objectif\",\"Save workflow\":\"Enregistrer le flux\",\"Add step\":\"Ajouter une étape\",\"New step\":\"Nouvelle étape\",\"Step\":\"Étape\",\"Steps\":\"Étapes\",\"Schedule\":\"Planification\",\"Trigger\":\"Déclencheur\",\"Result\":\"Résultat\",\"Results\":\"Résultats\",\"Input\":\"Entrée\",\"Output\":\"Sortie\",\"Approval\":\"Approbation\",\"Approve\":\"Approuver\",\"Reject\":\"Refuser\",\"Deny\":\"Refuser\",\"Allow once\":\"Autoriser une fois\",\"Always allow\":\"Toujours autoriser\",\"Permissions\":\"Autorisations\",\"Run now\":\"Exécuter maintenant\",\"Test connection\":\"Tester la connexion\",\"Test action\":\"Tester l’action\",\"Use template\":\"Utiliser le modèle\",\"Search apps\":\"Rechercher des applications\",\"Search apps…\":\"Rechercher des applications…\",\"All apps\":\"Toutes les applications\",\"Connected apps\":\"Applications connectées\",\"Reconnect\":\"Reconnecter\",\"Remove connection\":\"Retirer la connexion\",\"View details\":\"Voir les détails\",\"Local-First\":\"Local en priorité\",\"🔊 Read\":\"🔊 Lire\",\"⏹ Stop\":\"⏹ Arrêter\",\"📌 Remember\":\"📌 Mémoriser\",\"📌 Remembered\":\"📌 Mémorisé\",\"Open result ↗\":\"Ouvrir le résultat ↗\",\"Quick syncing\":\"Synchronisation rapide\",\"Quick Sync\":\"Synchronisation rapide\",\"Quick sync\":\"Synchronisation rapide\",\"Node Details\":\"Détails du nœud\",\"Node details\":\"Détails du nœud\",\"Node Value\":\"Valeur du nœud\",\"Profit & Return\":\"Bénéfice et rendement\",\"Network Details\":\"Détails du réseau\",\"Koinos Network\":\"Réseau Koinos\",\"Node status\":\"État du nœud\",\"Start node\":\"Démarrer le nœud\",\"Stop node\":\"Arrêter le nœud\",\"Producer wallet custody\":\"Garde du portefeuille du producteur\",\"External signing\":\"Signature externe\",\"Connect Koin Vault\":\"Connecter Koin Vault\",\"Connect KOIN Vault\":\"Connecter KOIN Vault\",\"Prepare transaction\":\"Préparer la transaction\",\"Import signed transaction\":\"Importer la transaction signée\",\"Broadcast\":\"Diffuser\",\"Copy unsigned JSON\":\"Copier le JSON non signé\",\"Download unsigned JSON\":\"Télécharger le JSON non signé\",\"Paste signed JSON\":\"Coller le JSON signé\",\"Registered\":\"Enregistré\",\"Not registered\":\"Non enregistré\",\"Register\":\"Enregistrer\",\"Producer\":\"Producteur\",\"Block height\":\"Hauteur de bloc\",\"Local height\":\"Hauteur locale\",\"Network height\":\"Hauteur réseau\",\"Progress\":\"Progression\",\"Syncing\":\"Synchronisation\",\"Synced\":\"Synchronisé\",\"Healthy\":\"Bon état\",\"Unhealthy\":\"Défaillant\",\"Services\":\"Services\",\"No services running.\":\"Aucun service en cours.\",\"Data folder\":\"Dossier de données\",\"Open data folder\":\"Ouvrir le dossier de données\",\"Change data folder\":\"Changer le dossier de données\",\"Logs\":\"Journaux\",\"View logs\":\"Voir les journaux\",\"Copy logs\":\"Copier les journaux\",\"Rewards\":\"Récompenses\",\"Reburn\":\"Brûler à nouveau\",\"Distribute\":\"Distribuer\",\"Distribution\":\"Distribution\",\"Reinvest\":\"Réinvestir\",\"Percentage\":\"Pourcentage\",\"Last 24 hours\":\"Dernières 24 heures\",\"Last 7 days\":\"7 derniers jours\",\"Last 30 days\":\"30 derniers jours\",\"Mainnet\":\"Réseau principal\",\"Testnet\":\"Réseau de test\",\"Desktop\":\"Bureau\",\"Open Koinos AI\":\"Ouvrir Koinos AI\",\"Launch KAI companion\":\"Ouvrir le compagnon KAI\",\"Hide KAI companion\":\"Masquer le compagnon KAI\",\"Quit Koinos AI\":\"Quitter Koinos AI\",\"KAI · Your desktop companion\":\"KAI · Votre compagnon de bureau\",\"KAI desktop companion\":\"Compagnon de bureau KAI\",\"Talk with KAI\":\"Parler avec KAI\",\"DESKTOP COMPANION\":\"COMPAGNON DE BUREAU\",\"Connecting to your app…\":\"Connexion à votre application…\",\"New conversation\":\"Nouvelle conversation\",\"Keep KAI on the desktop\":\"Garder KAI sur le bureau\",\"Collapse conversation\":\"Réduire la conversation\",\"Choose KAI's model\":\"Choisir le modèle de KAI\",\"Enable local listening for Hey KAI\":\"Activer l’écoute locale de Hey KAI\",\"Hey KAI off\":\"Hey KAI désactivé\",\"Voice & listening\":\"Voix et écoute\",\"Voice and listening settings\":\"Paramètres de voix et d’écoute\",\"A little voice. A lot of personality.\":\"Une petite voix. Une grande personnalité.\",\"Close voice settings\":\"Fermer les paramètres vocaux\",\"KAI's voice\":\"La voix de KAI\",\"Computer voice\":\"Voix de l’ordinateur\",\"Pocket voices · English\":\"Voix Pocket · Anglais\",\"One download, about 201 MB. Speech stays on your computer.\":\"Un téléchargement d’environ 201 Mo. La parole reste sur votre ordinateur.\",\"Download Pocket voices\":\"Télécharger les voix Pocket\",\"Try Azelma\":\"Essayer Azelma\",\"Voice credits\":\"Crédits des voix\",\"Use fast Cute KAI\":\"Utiliser Cute KAI rapide\",\"Refresh voices\":\"Actualiser les voix\",\"Add Windows voices ↗\":\"Ajouter des voix Windows ↗\",\"Install speech voices in Windows Settings, then refresh this list. Available voices depend on your Windows installation.\":\"Installez des voix dans les Paramètres Windows, puis actualisez cette liste. Les voix disponibles dépendent de votre installation Windows.\",\"Voice character\":\"Personnalité de la voix\",\"Cute KAI · bright & squeaky\":\"Cute KAI · vive et aiguë\",\"Classic KAI · deeper, softly robotic\":\"Classic KAI · plus grave, légèrement robotique\",\"Natural · original sound\":\"Naturelle · son original\",\"Squeak\":\"Aiguë\",\"Playful\":\"Enjouée\",\"Voice squeak\":\"Tonalité aiguë\",\"Gentle\":\"Douce\",\"Extra squeaky\":\"Très aiguë\",\"Reply timing\":\"Délai de réponse\",\"Quick start · first sentence\":\"Démarrage rapide · première phrase\",\"Head start · two sentences\":\"Avec avance · deux phrases\",\"Whole reply · continuous playback\":\"Réponse complète · lecture continue\",\"Hear a hello\":\"Écouter un bonjour\",\"Get natural voices\":\"Obtenir des voix naturelles\",\"Try Cute KAI with Bella. Hear a hello instantly, then download the local voice once for conversations.\":\"Essayez Cute KAI avec Bella. Écoutez un bonjour immédiatement, puis téléchargez une fois la voix locale pour discuter.\",\"Just say “Hey KAI”\":\"Dites simplement « Hey KAI »\",\"Tap the mic and talk, or turn on Hey KAI and say your question. KAI listens for a finished thought before sending. Keep talking after KAI answers—you have a minute for follow-ups.\":\"Touchez le micro et parlez, ou activez Hey KAI et posez votre question. KAI attend la fin de votre idée avant l’envoi. Après sa réponse, vous avez une minute pour poursuivre.\",\"Conversation pauses\":\"Pauses dans la conversation\",\"Quick · short pauses\":\"Rapide · pauses courtes\",\"Natural · room to pause\":\"Naturel · place aux pauses\",\"Patient · more time to think\":\"Patient · plus de temps pour réfléchir\",\"KAI combines a quiet pause with local semantic turn detection, so a breath in the middle of a thought is less likely to cut you off. If it waits, keep talking or tap the mic to send now. Saying “KAI” during a reply still stops it as soon as the name is recognized.\":\"KAI combine les pauses avec une détection sémantique locale pour éviter de vous couper quand vous respirez. S’il attend, continuez à parler ou touchez le micro pour envoyer. Dire « KAI » pendant une réponse l’arrête dès que le nom est reconnu.\",\"Microphone sensitivity\":\"Sensibilité du microphone\",\"TV nearby · less sensitive\":\"Télévision proche · moins sensible\",\"Everyday room · balanced\":\"Pièce normale · équilibrée\",\"Quiet room · more sensitive\":\"Pièce calme · plus sensible\",\"Microphone level\":\"Niveau du microphone\",\"Microphone off\":\"Microphone désactivé\",\"Local speech detection starts with the microphone.\":\"La détection vocale locale commence avec le microphone.\",\"With the mic on, background sound should stay below the listening level and your voice should rise above it. Move closer or choose a more sensitive setting if KAI misses you.\":\"Avec le micro activé, le bruit de fond doit rester sous le seuil d’écoute et votre voix au-dessus. Rapprochez-vous ou augmentez la sensibilité si KAI ne vous détecte pas.\",\"Say “KAI” to interrupt\":\"Dites « KAI » pour interrompre\",\"While KAI is answering, say “KAI” on its own or “KAI” followed by your new question. It stops when it recognizes the name. After the reply, just keep talking—follow-ups need no name.\":\"Pendant la réponse de KAI, dites « KAI » seul ou suivi de votre nouvelle question. Il s’arrête en reconnaissant le nom. Après la réponse, poursuivez sans prononcer le nom.\",\"KAI does not identify your voice yet. Loud background dialogue can still sound like a question. The mic button always lets you stop a reply and ask directly.\":\"KAI ne reconnaît pas encore votre voix. Des conversations fortes en arrière-plan peuvent ressembler à des questions. Le bouton du micro permet d’arrêter la réponse et de parler directement.\",\"The chat can stay closed. Say “That’s all” to end the conversation, or “Stop listening” to turn the mic off. Audio stays on this computer; accepted questions go to your selected chat model. Hiding KAI turns the mic off.\":\"La discussion peut rester fermée. Dites « That’s all » pour terminer ou « Stop listening » pour couper le micro. L’audio reste sur cet ordinateur ; les questions acceptées vont au modèle choisi. Masquer KAI coupe le micro.\",\"KAI Eyes settings\":\"Paramètres de KAI Eyes\",\"Let KAI see what you mean.\":\"Laissez KAI voir ce que vous voulez dire.\",\"Close KAI Eyes settings\":\"Fermer les paramètres de KAI Eyes\",\"Screen and camera vision are session-only. KAI keeps six small frames in memory, attaches only the freshest view to a turn, and discards everything when you turn it off or hide KAI.\":\"La vision de l’écran et de la caméra ne dure que cette session. KAI garde six petites images en mémoire, joint la plus récente au message et efface tout à la désactivation ou quand vous le masquez.\",\"Screen\":\"Écran\",\"See the display KAI is sitting on\":\"Voir l’écran où se trouve KAI\",\"Camera\":\"Caméra\",\"See what you choose to show KAI\":\"Voir ce que vous choisissez de montrer à KAI\",\"Choose a vision-capable brain, then turn on a source.\":\"Choisissez un modèle avec vision, puis activez une source.\",\"A visible indicator stays on for the entire capture session. Frames never enter chat history or the Koinos Network. Local-Only still blocks private online models. Desktop clicks and typing remain a separate, per-task permission.\":\"Un indicateur reste visible pendant toute la capture. Les images ne vont jamais dans l’historique ni sur Koinos Network. Local uniquement bloque toujours les modèles privés en ligne. Les clics et la saisie exigent une autorisation distincte par tâche.\",\"Conversation\":\"Conversation\",\"A LITTLE ROBOT. A LOT OF HELP.\":\"UN PETIT ROBOT. UNE GRANDE AIDE.\",\"Hey, I'm KAI\":\"Bonjour, je suis KAI\",\"Your app, a question away. Ask about your wallet, models, node, or the world outside.\":\"Votre application, à une question près. Interrogez KAI sur votre portefeuille, vos modèles, votre nœud ou le monde extérieur.\",\"Check my KAI earnings\":\"Consulter mes gains KAI\",\"Explore my models\":\"Explorer mes modèles\",\"Open my Pictures folder\":\"Ouvrir mon dossier Images\",\"Ask KAI anything…\":\"Demandez ce que vous voulez à KAI…\",\"Talk to KAI\":\"Parler à KAI\",\"Start voice input\":\"Démarrer la saisie vocale\",\"Enter to send\":\"Entrée pour envoyer\",\"Stop response\":\"Arrêter la réponse\",\"Send message\":\"Envoyer le message\",\"Read KAI's replies aloud\":\"Lire les réponses de KAI à voix haute\",\"Voice replies off\":\"Réponses vocales désactivées\",\"Open full app\":\"Ouvrir l’application complète\",\"Set up KAI's Pocket voice\":\"Configurer la voix Pocket de KAI\",\"Add KAI’s Pocket voice\":\"Ajouter la voix Pocket de KAI\",\"Later\":\"Plus tard\",\"Set up KAI's natural voice\":\"Configurer la voix naturelle de KAI\",\"Meet KAI’s natural voice\":\"Découvrez la voix naturelle de KAI\",\"Get natural voice\":\"Obtenir la voix naturelle\",\"Let KAI hear you\":\"Laissez KAI vous entendre\",\"Set up listening\":\"Configurer l’écoute\",\"Dismiss message\":\"Fermer le message\",\"KAI Eyes capture active\":\"Capture KAI Eyes active\",\"KAI Eyes is active · click to review\":\"KAI Eyes est actif · cliquez pour vérifier\",\"Screen on\":\"Écran activé\",\"Here when you need me\":\"Là quand vous en avez besoin\",\"KAI. Click to chat, or drag to move.\":\"KAI. Cliquez pour discuter ou faites glisser pour déplacer.\",\"Click to chat · Drag to move\":\"Cliquez pour discuter · Glissez pour déplacer\",\"Open chat\":\"Ouvrir la discussion\",\"Open or minimize chat\":\"Ouvrir ou réduire la discussion\",\"Hey KAI listening off\":\"Écoute Hey KAI désactivée\",\"Toggle Hey KAI listening\":\"Activer ou désactiver l’écoute Hey KAI\",\"KAI options\":\"Options KAI\",\"Say hello 👋\":\"Dire bonjour 👋\",\"Desktop control\":\"Contrôle du bureau\",\"Animation on\":\"Animation activée\",\"Open full app ↗\":\"Ouvrir l’application complète ↗\",\"Hide KAI to tray\":\"Masquer KAI dans la zone de notification\",\"Transaction ID copied (no explorer for this network)\":\"Identifiant copié (aucun explorateur pour ce réseau)\",\"Producer data unavailable\":\"Données des producteurs indisponibles\",\"💵 Profit & projected return\":\"💵 Bénéfice et rendement prévu\",\"Koinos network\":\"Réseau Koinos\",\"View block producers ↗\":\"Voir les producteurs de blocs ↗\",\"📡 Activity feed\":\"📡 Activité\",\"Can't reach the app\":\"Application inaccessible\",\"Active producers · ~24h\":\"Producteurs actifs · ~24 h\",\"Produced within the last 28,800 blocks\":\"Production dans les 28 800 derniers blocs\",\"Recent producers · 2h\":\"Producteurs récents · 2 h\",\"Produced within 2 hours · green status\":\"Production depuis 2 heures · état vert\",\"Tracked producer accounts\":\"Comptes de producteurs suivis\",\"Recent producers plus VHP holders\":\"Producteurs récents et détenteurs de VHP\",\"Last known data · refresh unavailable\":\"Dernières données connues · actualisation indisponible\",\"Mainnet only\":\"Réseau principal uniquement\",\"Counts unavailable · retrying…\":\"Comptages indisponibles · nouvel essai…\",\"Loading counts…\":\"Chargement des comptages…\",\"Stopping node\":\"Arrêt du nœud\",\"Node stopped\":\"Nœud arrêté\",\"Quick sync in progress\":\"Synchronisation rapide en cours\",\"Needs attention\":\"Attention requise\",\"Docker not ready — finish setup on the Node tab\":\"Docker n’est pas prêt ; terminez la configuration dans l’onglet Nœud\",\"Set up node\":\"Configurer le nœud\",\"{0}{1} blocks\":\"{0}{1} blocs\",\"in sync\":\"synchronisé\",\"syncing\":\"synchronisation\",\"producing stake\":\"participation de production\",\"recharges over time\":\"se recharge avec le temps\",\"Net worth\":\"Valeur nette\",\"Blocks produced\":\"Blocs produits\",\"Total rewards\":\"Récompenses totales\",\"VHP consumed\":\"VHP consommés\",\"spent producing\":\"dépensés en production\",\"Profit\":\"Bénéfice\",\"rewards − VHP spent\":\"récompenses moins VHP dépensés\",\"Total burned\":\"Total brûlé\",\"Deposits in\":\"Dépôts reçus\",\"at current rate\":\"au rythme actuel\",\"enable reburn to compound\":\"activez la combustion pour capitaliser\",\"no reburn set\":\"combustion automatique désactivée\",\"Daily profit\":\"Bénéfice quotidien\",\"Weekly profit\":\"Bénéfice hebdomadaire\",\"Monthly profit\":\"Bénéfice mensuel\",\"Yearly return\":\"Rendement annuel\",\"Yearly + reburn\":\"Annuel avec réinvestissement\",\"history syncing — longer windows still catching up\":\"historique en synchronisation ; périodes longues encore en cours\",\"Create a wallet (Wallet tab) to see activity.\":\"Créez un portefeuille dans l’onglet Portefeuille pour voir l’activité.\",\"Activity history isn't available on {0} — it needs a history RPC (works on mainnet).\":\"L’historique est indisponible sur {0} ; un RPC d’historique est requis (disponible sur le réseau principal).\",\"No activity yet. When your node produces a block, it appears here.\":\"Aucune activité. Les blocs produits par votre nœud apparaîtront ici.\",\"totals still syncing…\":\"totaux en synchronisation…\",\"Block\":\"Bloc\",\"Deposit\":\"Dépôt\",\"Burned → VHP\":\"Brûlé → VHP\",\"Sent out\":\"Envoyé\",\"Node starting…\":\"Démarrage du nœud…\",\"Stopping…\":\"Arrêt…\",\"Stopping node…\":\"Arrêt du nœud…\",\"Welcome 👋\":\"Bienvenue 👋\",\"Set up a Koinos wallet to get started. It takes a few seconds — your key is generated locally and encrypted with a password on this computer.\":\"Configurez un portefeuille Koinos pour commencer. Cela prend quelques secondes : la clé est générée localement et chiffrée par mot de passe sur cet ordinateur.\",\"🆕 Create a new wallet\":\"🆕 Créer un portefeuille\",\"Password (min {0} characters)\":\"Mot de passe ({0} caractères min.)\",\"Create wallet\":\"Créer le portefeuille\",\"You'll be shown a private key backup right after — write it down and keep it safe.\":\"Une copie de la clé privée sera ensuite affichée : notez-la et conservez-la en sécurité.\",\"📥 Import an existing wallet\":\"📥 Importer un portefeuille existant\",\"Private key (WIF)\":\"Clé privée (WIF)\",\"New password for this device\":\"Nouveau mot de passe pour cet appareil\",\"Import wallet\":\"Importer le portefeuille\",\"The key is encrypted with your password and stored only on this machine.\":\"La clé est chiffrée avec votre mot de passe et conservée uniquement sur cet ordinateur.\",\"Unlock your wallet\":\"Déverrouiller votre portefeuille\",\"Unlocking is required to burn, send, register the producer key, and for automatic reward returns.\":\"Le déverrouillage est requis pour brûler, envoyer, enregistrer la clé du producteur et retourner automatiquement les récompenses.\",\"Enter\":\"Entrer\",\"🔒 Lock\":\"🔒 Verrouiller\",\"Your address — share it to receive {0} or VHP.\":\"Votre adresse : partagez-la pour recevoir des {0} ou VHP.\",\"{0} (liquid)\":\"{0} (liquide)\",\"spendable + fuels mana\":\"disponible et génère du mana\",\"virtual hash power for block production\":\"puissance de hachage virtuelle pour produire des blocs\",\"recharges over time, spent by transactions\":\"se recharge et se dépense en transactions\",\"⟠ Ethereum & USDT\":\"⟠ Ethereum et USDT\",\"funding wallet\":\"portefeuille de financement\",\"Your Ethereum funding address, derived from this same wallet key. Receive ETH or USDT here to fund the node, or send them back out.\":\"Votre adresse de financement Ethereum est dérivée de la même clé. Recevez des ETH ou USDT pour financer le nœud, ou envoyez-les ailleurs.\",\"Send only\":\"Envoyez uniquement\",\"ETH or USDT on Ethereum Mainnet\":\"ETH ou USDT sur le réseau principal Ethereum\",\"to this address. Other networks/tokens may be lost.\":\"à cette adresse. Les autres jetons ou réseaux peuvent entraîner une perte.\",\"Send ETH\":\"Envoyer des ETH\",\"Send USDT\":\"Envoyer des USDT\",\"Bridge→KOIN\":\"Pont → KOIN\",\"Explorer ↗\":\"Explorateur ↗\",\"Wallet locked\":\"Portefeuille verrouillé\",\"Address copied\":\"Adresse copiée\",\"ETH address copied\":\"Adresse ETH copiée\",\"Recipient Ethereum address\":\"Adresse Ethereum du destinataire\",\"Amount (ETH)\":\"Montant (ETH)\",\"Max\":\"Max.\",\"Enter a recipient and amount\":\"Saisissez un destinataire et un montant\",\"Sending…\":\"Envoi…\",\"Getting quote…\":\"Obtention du devis…\",\"Not enough ETH for amount + gas (balance {0})\":\"ETH insuffisants pour le montant et le gas (solde {0})\",\"Not enough ETH (after gas)\":\"ETH insuffisants après le gas\",\"Amount (USDT)\":\"Montant (USDT)\",\"Gas is paid in ETH — keep a little ETH in this address.\":\"Le gas est payé en ETH ; gardez des ETH à cette adresse.\",\"Not enough USDT.\":\"USDT insuffisants.\",\"Not enough ETH for gas.\":\"ETH insuffisants pour le gas.\",\"No USDT balance\":\"Aucun solde USDT\",\"Send vKOIN\":\"Envoyer des vKOIN\",\"Amount (vKOIN)\":\"Montant (vKOIN)\",\"Not enough vKOIN.\":\"vKOIN insuffisants.\",\"No vKOIN balance\":\"Aucun solde vKOIN\",\"Bridge vKOIN → KOIN\":\"Pont vKOIN → KOIN\",\"native KOIN\":\"KOIN natifs\",\"Bridge to KOIN\":\"Transférer vers KOIN\",\"Enter a vKOIN amount\":\"Saisissez un montant de vKOIN\",\"Passwords don't match\":\"Les mots de passe ne correspondent pas\",\"Creating…\":\"Création…\",\"🔑 Back up your private key now\":\"🔑 Sauvegardez votre clé privée maintenant\",\"This is the only time it will be shown automatically. Anyone with this key controls the wallet — write it down and store it offline.\":\"Elle ne sera affichée automatiquement qu’une fois. Toute personne possédant cette clé contrôle le portefeuille : notez-la et conservez-la hors ligne.\",\"Address:\":\"Adresse :\",\"Copy key\":\"Copier la clé\",\"I saved my key\":\"J’ai sauvegardé ma clé\",\"Importing…\":\"Importation…\",\"Unlocking…\":\"Déverrouillage…\",\"Wallet unlocked\":\"Portefeuille déverrouillé\",\"Send tokens\":\"Envoyer des jetons\",\"Token\":\"Jeton\",\"Recipient address\":\"Adresse du destinataire\",\"Transfer\":\"Transférer\",\"External producer mode: prepare and sign burns through Node → External signing. KAI will not use the earning wallet.\":\"Producteur externe : préparez et signez les combustions dans Nœud → Signature externe. KAI n’utilisera pas le portefeuille de gains.\",\"Burn {0} → VHP\":\"Brûler {0} → VHP\",\"Burning converts liquid {0} into Virtual Hash Power (VHP) — the stake that lets your node produce blocks and earn rewards.\":\"La combustion convertit les {0} liquides en puissance de hachage virtuelle (VHP), la participation permettant au nœud de produire des blocs et gagner des récompenses.\",\"Create a wallet first (Wallet tab).\":\"Créez d’abord un portefeuille dans l’onglet Portefeuille.\",\"Unlock your wallet to burn (Wallet tab).\":\"Déverrouillez votre portefeuille dans l’onglet Portefeuille pour brûler.\",\"Burning converts liquid {0} into VHP 1:1. VHP is consumed slowly while producing blocks, and you earn {1} rewards in return.\":\"La combustion convertit les {0} liquides en VHP à 1:1. Les VHP sont consommés progressivement en produisant des blocs, contre des récompenses en {1}.\",\"🔥 Burn\":\"🔥 Brûler\",\"Balance:\":\"Solde :\",\"Amount to burn ({0})\":\"Montant à brûler ({0})\",\"You will receive: —\":\"Vous recevrez : —\",\"Burn {0}\":\"Brûler {0}\",\"ℹ️ How it works\":\"ℹ️ Fonctionnement\",\"Amount exceeds your balance.\":\"Le montant dépasse votre solde.\",\"Not enough mana to burn this much right now (about {0} {1} available). Burning spends mana, which recharges over ~5 days — burn less or wait.\":\"Mana insuffisant pour brûler ce montant (environ {0} {1} disponibles). Le mana se recharge en environ 5 jours ; brûlez moins ou attendez.\",\"This leaves less than {0} {1} liquid. You need liquid {2} for mana to keep transacting.\":\"Il resterait moins de {0} {1} liquides. Des {2} liquides sont nécessaires pour générer du mana et continuer à effectuer des transactions.\",\"Enter an amount to burn\":\"Saisissez un montant à brûler\",\"Confirm burn\":\"Confirmer la combustion\",\"You are about to\":\"Vous allez\",\"permanently burn\":\"brûler définitivement\",\"and receive\":\"et recevoir\",\"VHP is only useful for producing blocks with a node. It converts back to {0} gradually through block rewards.\":\"Les VHP servent uniquement à produire des blocs avec un nœud. Ils se reconvertissent progressivement en {0} via les récompenses de blocs.\",\"Burn\":\"Brûler\",\"Burning…\":\"Combustion…\",\"Waiting for your approval in Koin Vault…\":\"En attente de votre approbation dans Koin Vault…\",\"Sending request to Koin Vault…\":\"Envoi de la demande à Koin Vault…\",\"Wallet is submitting your transaction…\":\"Le portefeuille soumet votre transaction…\",\"You rejected the request. Nothing was submitted by this request.\":\"Vous avez refusé la demande. Rien n’a été soumis par celle-ci.\",\"Transaction verified on-chain. For registration, click Verify registration before starting the node.\":\"Transaction vérifiée sur la chaîne. Pour l’enregistrement, cliquez sur Vérifier l’enregistrement avant de démarrer le nœud.\",\"Connected. Use this producer wallet, generate a hot key, then sign its registration below.\":\"Connecté. Utilisez ce portefeuille producteur, générez une clé active et signez son enregistrement ci-dessous.\",\"Scan with Koin Vault → Connect App. This connection expires in 30 minutes.\":\"Scannez avec Koin Vault → Connect App. La connexion expire dans 30 minutes.\",\"Mainnet · No wallet connected.\":\"Réseau principal · Aucun portefeuille connecté.\",\"Koinos node\":\"Nœud Koinos\",\"📁 Data folder\":\"📁 Dossier de données\",\"⚡ Quick sync\":\"⚡ Synchronisation rapide\",\"Runs the official Koinos microservices with Docker. First start downloads images and syncs the chain — this can take a while.\":\"Exécute les microservices officiels Koinos avec Docker. Le premier démarrage télécharge les images et synchronise la chaîne ; cela peut prendre du temps.\",\"Your KAI earning wallet stays separate from an external producer. Stop the node before changing custody or rotating its hot key.\":\"Votre portefeuille de gains KAI reste séparé du producteur externe. Arrêtez le nœud avant de changer la garde ou de renouveler sa clé active.\",\"Wallet mode\":\"Mode de portefeuille\",\"Local earning wallet (hot wallet)\":\"Portefeuille de gains local (actif)\",\"External/cold producer wallet\":\"Portefeuille producteur externe/froid\",\"Watch-only producer address\":\"Adresse producteur en lecture seule\",\"Public Koinos address only — never a private key\":\"Adresse publique Koinos uniquement ; jamais de clé privée\",\"Save custody mode\":\"Enregistrer le mode de garde\",\"Generate hot key\":\"Générer une clé active\",\"Rotate hot key…\":\"Renouveler la clé active…\",\"Verify registration\":\"Vérifier l’enregistrement\",\"Hot block-production public key\":\"Clé publique active de production de blocs\",\"Block-production public key\":\"Clé publique de production de blocs\",\"Generate a hot key to view its public key\":\"Générez une clé active pour voir sa clé publique\",\"Copy public key\":\"Copier la clé publique\",\"Connect your phone, use its wallet as your producer, then approve registration, burns and transfers with your fingerprint or device passkey. Your node keeps running after the phone disconnects.\":\"Connectez votre téléphone, utilisez son portefeuille comme producteur et approuvez enregistrements, combustions et transferts par empreinte ou passkey. Le nœud continue après la déconnexion du téléphone.\",\"Use this producer wallet\":\"Utiliser ce portefeuille producteur\",\"Disconnect / cancel approval\":\"Déconnecter / annuler l’approbation\",\"Scan with Koin Vault Connect App\":\"Scanner avec Koin Vault Connect App\",\"Open Koin Vault → Connect App → scan this QR and approve. Keep the wallet open for transaction requests.\":\"Ouvrez Koin Vault → Connect App, scannez ce QR et approuvez. Gardez le portefeuille ouvert pour recevoir les demandes.\",\"Open Koin Vault\":\"Ouvrir Koin Vault\",\"Copy connection link\":\"Copier le lien de connexion\",\"Operation\":\"Opération\",\"Register hot public key\":\"Enregistrer la clé publique active\",\"Allow VHP for block production\":\"Autoriser les VHP pour produire des blocs\",\"Burn KOIN to this producer's VHP\":\"Brûler des KOIN pour les VHP de ce producteur\",\"Transfer tokens\":\"Transférer des jetons\",\"Use full VHP balance\":\"Utiliser tout le solde VHP\",\"Also allow my full VHP balance for production\":\"Autoriser aussi tout mon solde VHP pour la production\",\"Includes the new VHP. Both changes use one phone approval.\":\"Inclut les nouveaux VHP. Les deux changements utilisent une approbation sur le téléphone.\",\"Koinos address\":\"Adresse Koinos\",\"For Koin Vault production, approve a VHP allowance after registering the hot key. Choose a limited amount up to your VHP balance, or 0 to revoke.\":\"Pour produire avec Koin Vault, autorisez un quota VHP après avoir enregistré la clé active. Choisissez un montant jusqu’à votre solde VHP, ou 0 pour révoquer.\",\"Review and sign with Koin Vault\":\"Vérifier et signer avec Koin Vault\",\"External signing: registration, burns and transfers\":\"Signature externe : enregistrements, combustions et transferts\",\"Open Kondor signer\":\"Ouvrir le signataire Kondor\",\"Copy signer link\":\"Copier le lien du signataire\",\"Signing and backup guide\":\"Guide de signature et de sauvegarde\",\"Prepare and download the unsigned JSON here. On your secure computer, open https://koinosai.com/producer-signer/ in the browser with Kondor, load the file, review and sign. Bring the signed JSON back and import it below. Your private key stays in Kondor. The offline helper remains available in the guide. Drafts last 15 minutes by default. For dual boot, select the 24-hour window before preparing; after restarting KAI, use Resume saved draft.\":\"Préparez et téléchargez ici le JSON non signé. Sur votre ordinateur sécurisé, ouvrez https://koinosai.com/producer-signer/ avec Kondor, chargez le fichier, vérifiez et signez. Rapportez le JSON signé et importez-le ci-dessous. La clé privée reste dans Kondor. Le guide propose aussi l’assistant hors ligne. Les brouillons durent 15 minutes. Pour un double démarrage, choisissez 24 heures avant la préparation ; après redémarrage, utilisez Reprendre le brouillon enregistré.\",\"Amount (burn/transfer)\":\"Montant (combustion/transfert)\",\"Token (transfer)\":\"Jeton (transfert)\",\"Recipient (transfer)\":\"Destinataire (transfert)\",\"Dual-boot / offline signing — keep this draft for 24 hours\":\"Double démarrage / signature hors ligne : conserver le brouillon 24 heures\",\"Resume saved draft\":\"Reprendre le brouillon enregistré\",\"Prepare unsigned transaction\":\"Préparer la transaction non signée\",\"Unsigned transaction — take this file to the secure computer\":\"Transaction non signée : apportez ce fichier sur l’ordinateur sécurisé\",\"Import signed JSON\":\"Importer le JSON signé\",\"Signed transaction JSON returned by your external signer\":\"JSON de transaction signé par votre signataire externe\",\"Paste signed transaction JSON only\":\"Collez uniquement le JSON de transaction signé\",\"I reviewed the actual operations, recipient, amount and network on my signing machine.\":\"J’ai vérifié les opérations réelles, le destinataire, le montant et le réseau sur mon ordinateur de signature.\",\"Broadcast signed transaction\":\"Diffuser la transaction signée\",\"Previous chain backups\":\"Anciennes sauvegardes de la chaîne\",\"Manage backups\":\"Gérer les sauvegardes\",\"Quick Sync keeps the previous chain data. After the restored node is working, remove old backups here to reclaim space.\":\"La synchronisation rapide conserve les anciennes données. Une fois le nœud restauré opérationnel, supprimez ici les anciennes sauvegardes pour libérer de l’espace.\",\"📡 Status\":\"📡 État\",\"Recover after an unexpected stop\":\"Récupérer après un arrêt inattendu\",\"— manual stops and quick sync keep the node stopped.\":\": les arrêts manuels et la synchronisation rapide maintiennent le nœud arrêté.\",\"⛏️ Block production setup\":\"⛏️ Configurer la production de blocs\",\"Register signing key\":\"Enregistrer la clé de signature\",\"📜 Logs\":\"📜 Journaux\",\"all services\":\"tous les services\",\"Checking the signed transaction and submitting to the network…\":\"Vérification de la transaction signée et soumission au réseau…\",\"Custody saved. Automatic returns are off. Verify registration before starting production.\":\"Garde enregistrée. Les retours automatiques sont désactivés. Vérifiez l’enregistrement avant de produire.\",\"Hot key ready. Back up private.key and public.key securely from:\":\"Clé active prête. Sauvegardez private.key et public.key en sécurité depuis :\",\"Rotate hot production key?\":\"Renouveler la clé active de production ?\",\"Stop the node first. KAI will preserve a local backup of the old hot key. Register the new public key with your external wallet before restarting production.\":\"Arrêtez d’abord le nœud. KAI conservera une sauvegarde locale de l’ancienne clé. Enregistrez la nouvelle clé publique avec votre portefeuille externe avant de reprendre la production.\",\"Rotate key\":\"Renouveler la clé\",\"Registration does not match yet. Sign and confirm the registration, then check again.\":\"L’enregistrement ne correspond pas encore. Signez et confirmez, puis vérifiez à nouveau.\",\"Koin Vault producer saved. Generate a hot key, then register it with Koin Vault below.\":\"Producteur Koin Vault enregistré. Générez une clé active et enregistrez-la avec Koin Vault ci-dessous.\",\"Create a connection QR first.\":\"Créez d’abord un QR de connexion.\",\"Click \\\"Use this producer wallet\\\" above first (stop the node if it is running), then generate a hot key before registering it.\":\"Cliquez d’abord sur « Utiliser ce portefeuille producteur » (arrêtez le nœud s’il tourne), puis générez une clé active avant de l’enregistrer.\",\"Preparing review…\":\"Préparation de la vérification…\",\"Review the request in KAI, then click Request wallet approval to send it to your phone.\":\"Vérifiez la demande dans KAI, puis cliquez sur Demander l’approbation pour l’envoyer au téléphone.\",\"Set the official Proof-of-Burn contract's spending allowance to\":\"Définir l’autorisation de dépense du contrat officiel Proof-of-Burn à\",\"This replaces the remaining allowance. Block production consumes it as VHP converts to KOIN rewards. Renew it when exhausted; set 0 to revoke it. No tokens move now. Your hot key gains no transfer permission.\":\"Ceci remplace l’autorisation restante. La production la consomme en convertissant les VHP en KOIN. Renouvelez-la après épuisement ou utilisez 0 pour révoquer. Aucun jeton ne bouge maintenant. La clé active n’obtient aucun droit de transfert.\",\"Register this node's hot public key:\":\"Enregistrer la clé publique active de ce nœud :\",\"Permanently burn\":\"Brûler définitivement\",\"for the same amount of VHP in your producer wallet.\":\"contre le même montant de VHP dans votre portefeuille producteur.\",\"Also set the official PoB production allowance to\":\"Définir aussi l’autorisation officielle de production PoB à\",\": current VHP plus this burn. Both changes succeed together. This replaces the remaining allowance; later deposits need a new approval.\":\": VHP actuels plus cette combustion. Les deux changements réussissent ensemble. Remplace l’autorisation restante ; les dépôts ultérieurs nécessitent une nouvelle approbation.\",\"to:\":\"à :\",\"Review Koin Vault request\":\"Vérifier la demande Koin Vault\",\"Mainnet · Producer:\":\"Réseau principal · Producteur :\",\"Next, review the same details in Koin Vault and approve with your fingerprint or device passkey. Wallet approval submits the transaction.\":\"Vérifiez les mêmes détails dans Koin Vault et approuvez par empreinte ou passkey. L’approbation du portefeuille soumet la transaction.\",\"Request wallet approval\":\"Demander l’approbation du portefeuille\",\"Prepared only — nothing signed or broadcast. Review decoded operations on your separate signing machine.\":\"Préparée uniquement : rien n’est signé ni diffusé. Vérifiez les opérations décodées sur votre ordinateur de signature séparé.\",\"Prepare a transaction first.\":\"Préparez d’abord une transaction.\",\"Invalid mana\":\"Mana invalide\",\"Choose or paste a valid signed transaction JSON file.\":\"Choisissez ou collez un JSON valide de transaction signée.\",\"Choose a signed JSON file smaller than 100 KB.\":\"Choisissez un fichier JSON signé de moins de 100 Ko.\",\"External transaction\":\"Transaction externe\",\"The app will keep your node running automatically.\":\"L’application maintiendra automatiquement votre nœud en fonctionnement.\",\"Automatic restart is off — you'll restart the node yourself.\":\"Le redémarrage automatique est désactivé ; vous redémarrerez le nœud manuellement.\",\"Measuring backups…\":\"Mesure des sauvegardes…\",\"Delete backup\":\"Supprimer la sauvegarde\",\"Size unavailable\":\"Taille indisponible\",\"No previous chain backups.\":\"Aucune ancienne sauvegarde de la chaîne.\",\"Delete previous chain backup?\":\"Supprimer l’ancienne sauvegarde de la chaîne ?\",\"This permanently deletes {0}. Confirm the restored node is working before removing your rollback copy. Active chain data, wallets and keys are kept.\":\"Ceci supprime définitivement {0}. Vérifiez que le nœud restauré fonctionne avant de supprimer votre copie de restauration. Données actives, portefeuilles et clés sont conservés.\",\"⚡ Quick sync from official backup\":\"⚡ Synchronisation rapide depuis une sauvegarde officielle\",\"Downloads the Koinos Foundation chain snapshot and installs it, so the node catches up in hours instead of syncing for days. Your wallet, node config, and peer identity are not touched; current chain data is set aside for rollback.\":\"Télécharge et installe l’instantané de Koinos Foundation pour rattraper la chaîne en heures plutôt qu’en jours. Portefeuille, configuration et identité du nœud restent intacts. Les anciennes données sont mises de côté pour revenir en arrière.\",\"Snapshot size\":\"Taille de l’instantané\",\"{0} (compressed)\":\"{0} (compressé)\",\"Snapshot date\":\"Date de l’instantané\",\"Free disk space\":\"Espace disque disponible\",\"{0} (needs ~{1} during restore)\":\"{0} (nécessite ~{1} pendant la restauration)\",\"The download is verified against the published SHA-256 and the archive layout is checked before anything is installed. You can cancel at any time and resume later.\":\"Le téléchargement est vérifié avec le SHA-256 publié et l’archive est inspectée avant installation. Vous pouvez annuler à tout moment et reprendre plus tard.\",\"Resumable\":\"Reprise possible\",\"{0} already downloaded\":\"{0} déjà téléchargé\",\"Free space looks below the recommended headroom — the restore may fail mid-way. Free up disk first if possible.\":\"L’espace libre semble inférieur à la marge recommandée ; la restauration peut échouer. Libérez de l’espace avant si possible.\",\"The node is running — it will be stopped before the restore and can be started again right after.\":\"Le nœud fonctionne. Il sera arrêté avant la restauration et pourra être redémarré ensuite.\",\"Start quick sync\":\"Démarrer la synchronisation rapide\",\"Quick sync started — progress shows on this page\":\"Synchronisation rapide démarrée ; la progression apparaît ici\",\"Start Koinos node\":\"Démarrer le nœud Koinos\",\"Enable block production (uses producer address\":\"Activer la production de blocs (utilise l’adresse\",\"as producer)\":\"comme producteur)\",\"The node runs in Docker in the background and keeps running even if you close this app. First sync downloads the whole chain.\":\"Le nœud s’exécute dans Docker en arrière-plan et continue après fermeture de l’application. La première synchronisation télécharge toute la chaîne.\",\"not configured\":\"non configuré\",\"Node starting — pulling images and launching services…\":\"Démarrage : téléchargement des images et lancement des services…\",\"Registering…\":\"Enregistrement…\",\"Producer key registration\":\"Enregistrement de la clé producteur\",\"(no output)\":\"(aucune sortie)\",\"Docker isn't available.\":\"Docker n’est pas disponible.\",\"Docker install guide ↗\":\"Guide d’installation de Docker ↗\",\"Downloading Docker Desktop{0}\":\"Téléchargement de Docker Desktop{0}\",\"🧰 Set up requirements\":\"🧰 Installer les prérequis\",\"one time · {0}\":\"une fois · {0}\",\"Re-check\":\"Vérifier à nouveau\",\"Download cancelled\":\"Téléchargement annulé\",\"Restart Windows?\":\"Redémarrer Windows ?\",\"Windows needs to restart to finish enabling WSL 2. This will restart your computer in 60 seconds — save any open work first. You can cancel during the countdown.\":\"Windows doit redémarrer pour terminer l’activation de WSL 2. Le redémarrage aura lieu dans 60 secondes ; sauvegardez votre travail. Vous pouvez annuler pendant le compte à rebours.\",\"Not now\":\"Pas maintenant\",\"Restart in 60s\":\"Redémarrer dans 60 s\",\"Windows will restart in 60 seconds.\":\"Windows redémarrera dans 60 secondes.\",\"Restart cancelled\":\"Redémarrage annulé\",\"Preparing snapshot restore\":\"Préparation de la restauration\",\"Downloading snapshot\":\"Téléchargement de l’instantané\",\"Verifying checksum\":\"Vérification de la somme de contrôle\",\"Inspecting archive\":\"Inspection de l’archive\",\"Extracting chain data\":\"Extraction des données de la chaîne\",\"Installing chain data\":\"Installation des données de la chaîne\",\"Cleaning up\":\"Nettoyage\",\"Restore complete\":\"Restauration terminée\",\"Restoring chain data\":\"Restauration des données de la chaîne\",\"Quick sync:\":\"Synchronisation rapide :\",\"Cancelling quick sync — the download can be resumed later\":\"Annulation de la synchronisation rapide ; le téléchargement pourra reprendre\",\"in progress…\":\"en cours…\",\"{0} failed:\":\"Échec de {0} :\",\"stopping for quick sync\":\"arrêt pour synchronisation rapide\",\"stopped · quick syncing\":\"arrêté · synchronisation rapide\",\"needs attention\":\"attention requise\",\"(recovered {0}× recently)\":\"(récupéré {0} fois récemment)\",\"{0} Automatic recovery will not restart it during quick sync. Start the node after the restore finishes.\":\"{0} La récupération automatique ne le redémarrera pas pendant la synchronisation rapide. Démarrez-le une fois terminée.\",\"The node is stopping for a snapshot restore.\":\"Le nœud s’arrête pour restaurer un instantané.\",\"The node is stopped while quick sync restores the chain data. Block production is paused.\":\"Le nœud est arrêté pendant la restauration. La production de blocs est en pause.\",\"Chain validation failed — block production is not healthy.\":\"Échec de validation de la chaîne ; la production est défaillante.\",\"🔧 Repair node data\":\"🔧 Réparer les données du nœud\",\"Block submissions rejected: could not burn VHP.\":\"Blocs refusés : impossible de brûler des VHP.\",\"Last observed block submission was rejected.\":\"Le dernier bloc observé a été refusé.\",\"Open block_producer logs for the failure details. Running services and a registered key do not guarantee accepted blocks.\":\"Ouvrez les journaux block_producer pour les détails. Des services actifs et une clé enregistrée ne garantissent pas l’acceptation des blocs.\",\"Getting your node back up — this takes a minute. You don't need to do anything.\":\"Récupération du nœud ; cela prend une minute. Vous n’avez rien à faire.\",\"The node is not confirmed healthy ({0}). Block production may be interrupted. Check the chain logs{1}.\":\"Le bon état du nœud n’est pas confirmé ({0}). La production peut être interrompue. Vérifiez les journaux{1}.\",\"status unavailable\":\"état indisponible\",\"; automatic recovery is enabled\":\"; récupération automatique activée\",\"; automatic recovery is off\":\"; récupération automatique désactivée\",\"✓ Your node is running and healthy.{0}\":\"✓ Votre nœud fonctionne correctement.{0}\",\"Start the node to sync the chain.\":\"Démarrez le nœud pour synchroniser la chaîne.\",\"Waiting for local RPC… (services may still be starting)\":\"En attente du RPC local… (les services peuvent démarrer)\",\"Head block time: {0}\":\"Heure du dernier bloc : {0}\",\"Producer address configured\":\"Adresse producteur configurée\",\"Choose a local or external producer address above.\":\"Choisissez ci-dessus une adresse producteur locale ou externe.\",\"VHP staked at your address\":\"VHP engagés à votre adresse\",\"Checking your VHP… no need to unlock — it's read from your public address.\":\"Vérification des VHP ; aucun déverrouillage requis, l’adresse publique suffit.\",\"Node stopping for quick sync\":\"Arrêt du nœud pour synchronisation rapide\",\"Node stopped for quick sync\":\"Nœud arrêté pour synchronisation rapide\",\"Node running\":\"Nœud en cours\",\"Wait for the restore to finish, then start the node.\":\"Attendez la fin de la restauration, puis démarrez le nœud.\",\"Start the node above.\":\"Démarrez le nœud ci-dessus.\",\"Signing key generated\":\"Clé de signature générée\",\"Generated automatically by the node on first start.\":\"Générée automatiquement par le nœud au premier démarrage.\",\"Signing key registered on chain\":\"Clé de signature enregistrée sur la chaîne\",\"Register it with the button below (needs unlocked wallet + mana).\":\"Enregistrez-la avec le bouton ci-dessous (portefeuille déverrouillé et mana requis).\",\"Last observed block submission failed\":\"La dernière tentative de bloc observée a échoué\",\"VHP burn rejected. Approve a production allowance in Koin Vault; registration alone does not confirm successful production.\":\"Combustion VHP refusée. Autorisez un quota de production dans Koin Vault ; l’enregistrement seul ne confirme pas la production.\",\"Check block_producer logs for the rejection reason.\":\"Consultez les journaux block_producer pour le motif du refus.\",\"External producer registration verified. The node holds only its hot production key.\":\"Enregistrement du producteur externe vérifié. Le nœud ne détient que sa clé active de production.\",\"Use External signing above to register this hot key with your separate wallet.\":\"Utilisez Signature externe ci-dessus pour enregistrer cette clé avec votre portefeuille séparé.\",\"Signing key registered on chain.\":\"Clé de signature enregistrée sur la chaîne.\",\"⚠️ A different key is registered on chain for this address. Register the current node key to replace it.\":\"⚠️ Une autre clé est enregistrée pour cette adresse. Enregistrez la clé actuelle du nœud pour la remplacer.\",\"The signing key appears after the node's first start.\":\"La clé de signature apparaît après le premier démarrage du nœud.\",\"Unlock your wallet to register.\":\"Déverrouillez votre portefeuille pour enregistrer.\",\"Block production is paused for quick sync.\":\"La production est en pause pour la synchronisation rapide.\",\"The node is stopped; no blocks are being produced here.\":\"Le nœud est arrêté ; aucun bloc n’est produit ici.\",\"Production also requires an in-sync node with block production enabled.\":\"La production nécessite aussi un nœud synchronisé avec la production activée.\",\"Resume\":\"Reprendre\",\"Continue?\":\"Continuer ?\",\"Enter a recipient address\":\"Saisissez une adresse de destinataire\",\"Enter an amount to send\":\"Saisissez un montant à envoyer\",\"Send real ETH?\":\"Envoyer de véritables ETH ?\",\"on Ethereum Mainnet. This is irreversible. Continue?\":\"sur le réseau principal Ethereum. C’est irréversible. Continuer ?\",\"Send it\":\"Envoyer\",\"Sent ✓\":\"Envoyé ✓\",\"Preparing…\":\"Préparation…\",\"Endpoint saved\":\"Point d’accès enregistré\",\"Automatic burns and transfers are disabled for your external producer. Use Node → External signing for each funds operation.\":\"Les combustions et transferts automatiques sont désactivés pour le producteur externe. Utilisez Nœud → Signature externe pour chaque opération de fonds.\",\"⚙️ Configuration\":\"⚙️ Configuration\",\"Enable automatic returns\":\"Activer les retours automatiques\",\"Return percentage:\":\"Pourcentage de retour :\",\"of new rewards\":\"des nouvelles récompenses\",\"What to do with returned {0}\":\"Que faire des {0} retournés\",\"♻️ Compound — burn back into VHP (keeps node producing)\":\"♻️ Réinvestir : brûler en VHP pour continuer à produire\",\"📤 Send to another address\":\"📤 Envoyer à une autre adresse\",\"Send returns to\":\"Envoyer les retours à\",\"Only required when the destination changes\":\"Requis uniquement si la destination change\",\"Minimum return ({0})\":\"Retour minimum ({0})\",\"Max per return ({0})\":\"Maximum par retour ({0})\",\"0 = no limit\":\"0 = sans limite\",\"Check every (minutes)\":\"Vérifier tous les (minutes)\",\"Check now\":\"Vérifier maintenant\",\"Max per return\":\"Maximum par retour\",\"📊 Status\":\"📊 État\",\"🧾 Return history\":\"🧾 Historique des retours\",\"When\":\"Quand\",\"Returned\":\"Retourné\",\"Mode\":\"Mode\",\"Return settings saved\":\"Paramètres de retour enregistrés\",\"no wallet\":\"sans portefeuille\",\"wallet locked\":\"portefeuille verrouillé\",\"RPC error\":\"erreur RPC\",\"no history RPC\":\"sans RPC d’historique\",\"reading history…\":\"lecture de l’historique…\",\"tracking started\":\"suivi démarré\",\"low liquid KOIN\":\"peu de KOIN liquides\",\"waiting for mana\":\"en attente de mana\",\"tx failed\":\"transaction échouée\",\"config error\":\"erreur de configuration\",\"no checks yet\":\"aucune vérification\",\"Engine\":\"Moteur\",\"Last check\":\"Dernière vérification\",\"Next automatic check\":\"Prochaine vérification automatique\",\"Lifetime rewards\":\"Récompenses cumulées\",\"(Dashboard)\":\"(Tableau de bord)\",\"Rewards since enabled\":\"Récompenses depuis l’activation\",\"Pending return\":\"Retour en attente\",\"No returns yet.\":\"Aucun retour pour l’instant.\",\"Network, RPC and wallet management.\":\"Gestion du réseau, RPC et portefeuille.\",\"🌐 Network\":\"🌐 Réseau\",\"🔌 Custom RPC (optional)\":\"🔌 RPC personnalisé (facultatif)\",\"Save settings\":\"Enregistrer les paramètres\",\"🔐 Wallet security\":\"🔐 Sécurité du portefeuille\",\"Reveal private key\":\"Afficher la clé privée\",\"Remove wallet from this device\":\"Retirer le portefeuille de cet appareil\",\"Files live in\":\"Les fichiers se trouvent dans\",\"open ↗\":\"ouvrir ↗\",\"local node RPC\":\"RPC du nœud local\",\"{0} RPC URL\":\"URL RPC de {0}\",\"Settings saved\":\"Paramètres enregistrés\",\"No wallet on this device\":\"Aucun portefeuille sur cet appareil\",\"Enter your password. Never share this key or enter it on websites.\":\"Saisissez votre mot de passe. Ne partagez jamais cette clé et ne la saisissez pas sur des sites web.\",\"⚠️ Remove wallet\":\"⚠️ Retirer le portefeuille\",\"This deletes the encrypted key file from this device.\":\"Ceci supprime le fichier de clé chiffrée de cet appareil.\",\"Without a backup of the private key, the funds are lost forever.\":\"Sans sauvegarde de la clé privée, les fonds sont perdus définitivement.\",\"to confirm\":\"pour confirmer\",\"Remove wallet\":\"Retirer le portefeuille\",\"Wallet removed from this device\":\"Portefeuille retiré de cet appareil\",\"Failed to start UI: {0}\":\"Échec du démarrage de l’interface : {0}\",\"This machine\":\"Cet ordinateur\",\"{0} — the desktop updater isn't available in this copy.\":\"{0} — la mise à jour de l’application n’est pas disponible dans cette copie.\",\"{0} — couldn't contact the desktop updater. Restart the app and try again.\":\"{0} — impossible de contacter le service de mise à jour. Redémarrez l’application et réessayez.\",\"{0} — up to date. Checked just now.\":\"{0} — à jour. Vérification à l’instant.\",\"Koinos AI {0} is available — downloading it now. You'll be asked before restarting.\":\"Koinos AI {0} est disponible — téléchargement en cours. Votre accord sera demandé avant le redémarrage.\",\"Koinos AI {0} is ready and will install when you close the app.\":\"Koinos AI {0} est prêt et sera installé à la fermeture de l’application.\",\"Koinos AI {0} is available and ready to download.\":\"Koinos AI {0} est disponible au téléchargement.\",\"{0} — updates install themselves.\":\"{0} — les mises à jour s’installent automatiquement.\",\"{0} — up to date ({1}), installed from source.\":\"{0} — à jour ({1}), installé à partir du code source.\",\"{0} — installed from source, {1}. {2}\":\"{0} — installé à partir du code source, {1}. {2}\",\"Open wallet\":\"Ouvrir le portefeuille\",\"Set up wallet\":\"Configurer le portefeuille\",\"Wallet balance unavailable\":\"Solde du portefeuille indisponible\",\"Testnet balance has no USD value\":\"Le solde du réseau de test n’a pas de valeur en USD\",\"KOIN price is out of date\":\"Le prix du KOIN n’est plus à jour\",\"KOIN price unavailable\":\"Prix du KOIN indisponible\",\"Estimated wallet value in USD\":\"Valeur estimée du portefeuille en USD\",\"KOIN\":\"KOIN\",\"KOIN · Earnings & wallet\":\"KOIN · Gains et portefeuille\",\"Contribute AI capacity, track network rewards and manage your KOIN wallet.\":\"Fournissez de la capacité IA, suivez les récompenses du réseau et gérez votre portefeuille KOIN.\",\"KOIN rewards are in preparation\":\"Les récompenses KOIN sont en préparation\",\"This Test build measures availability without paying KOIN rewards. Purchases and claims will open after contract verification. Your existing mainnet wallet remains available below.\":\"Cette version Test mesure la disponibilité sans verser de récompenses KOIN. Les achats et les retraits de récompenses seront ouverts après vérification des contrats. Votre portefeuille du réseau principal reste disponible ci-dessous.\",\"Launch policy: up to 5% of the free reward pool per day; 70% for verified availability and 30% for paid work. Unused rewards remain in the pool.\":\"Politique de lancement : jusqu’à 5 % du solde libre du fonds par jour ; 70 % pour la disponibilité vérifiée et 30 % pour le travail payé. Les récompenses inutilisées restent dans le fonds.\",\"AI usage credits\":\"Crédits d’utilisation IA\",\"Credits will be prepaid with KOIN. Unused funds stay reserved; only consumed usage is split: 60% to rewards, 25% to mining and 15% to operations.\":\"Les crédits seront prépayés en KOIN. Les fonds inutilisés restent réservés ; seule l’utilisation consommée est répartie : 60 % aux récompenses, 25 % au minage et 15 % au fonctionnement.\",\"Purchases not active\":\"Achats non activés\",\"Claims not active\":\"Retraits de récompenses non activés\",\"Legacy test KAI\":\"Ancien KAI de test\",\"Historical test balances are separate from KOIN. No conversion or distribution has been applied.\":\"Les anciens soldes de test sont séparés de KOIN. Aucune conversion ni distribution n’a été effectuée.\",\"Available to claim\":\"Disponible au retrait\",\"Usage credits\":\"Crédits d’utilisation\",\"Not active\":\"Non activé\",\"Availability estimate (simulation)\":\"Estimation de disponibilité (simulation)\",\"Paid-work estimate (simulation)\":\"Estimation du travail payé (simulation)\",\"Awaiting verified data\":\"En attente de données vérifiées\",\"Capacity status\":\"État de la capacité\",\"Verified for shadow scoring\":\"Vérifié pour le calcul simulé\",\"Awaiting capacity verification\":\"En attente de vérification de capacité\",\"Local-Only mode\":\"Mode local uniquement\",\"No capacity report\":\"Aucun rapport de capacité\",\"Awaiting master integration\":\"En attente de l’intégration du nœud maître\",\"Legacy test KAI balance\":\"Ancien solde KAI de test\",\"Legacy prepaid balance\":\"Ancien solde prépayé\",\"Legacy epoch\":\"Ancienne époque\",\"Online — serving{0}\":\"En ligne — en service{0}\",\"Preview a spending review\":\"Aperçu de la vérification des dépenses\",\"See the model, maximum request cost and session limits before reviewing an example. Prices are illustrative; paid requests are not active.\":\"Consultez le modèle, le coût maximal de la requête et les limites de session avant de vérifier un exemple. Les prix sont indicatifs ; les requêtes payantes ne sont pas actives.\",\"Preview review\":\"Voir un exemple de vérification\",\"Review the example in the desktop dialog.\":\"Vérifiez l’exemple dans la fenêtre de l’application.\",\"Example reviewed. No request was signed or sent.\":\"Exemple vérifié. Aucune requête n’a été signée ni envoyée.\",\"Preview cancelled. No KOIN was spent.\":\"Aperçu annulé. Aucun KOIN n’a été dépensé.\",\"Preview unavailable. Please try again.\":\"Aperçu indisponible. Veuillez réessayer.\",\"Example prices only. No KOIN will be spent.\":\"Prix donnés à titre d’exemple. Aucun KOIN ne sera dépensé.\",\"Simulation only. No KOIN will be spent.\":\"Simulation uniquement. Aucun KOIN ne sera dépensé.\",\"Tariff version\":\"Version du tarif\",\"Input tokens\":\"Tokens d’entrée\",\"Maximum output tokens\":\"Nombre maximal de tokens de sortie\",\"Maximum request cost\":\"Coût maximal de la requête\",\"Per-request limit\":\"Limite par requête\",\"Session available\":\"Montant disponible pour la session\",\"Session total limit\":\"Limite totale de la session\",\"Requests remaining\":\"Requêtes restantes\",\"Review expires (UTC)\":\"Expiration de la vérification (UTC)\",\"Session\":\"Session\",\"Quote\":\"Devis\",\"Reviewing does not sign or submit a request.\":\"La vérification ne signe ni n’envoie de requête.\",\"KOIN · Review preview\":\"KOIN · Aperçu de la vérification\",\"Review one simulated request\":\"Vérifier une requête simulée\",\"Mark example reviewed\":\"Marquer l’exemple comme vérifié\",\"KOIN session rehearsal\":\"Essai de session KOIN\",\"Approve a bounded session once. This developer rehearsal does not enable paid chat or move KOIN.\":\"Approuvez une seule fois une session limitée. Cet essai pour développeurs n’active pas le chat payant et ne déplace aucun KOIN.\",\"Review session limits\":\"Vérifier les limites de session\",\"Retry saved approval\":\"Réessayer l’approbation enregistrée\",\"Refresh session\":\"Actualiser la session\",\"Revoke session approval\":\"Révoquer l’approbation de session\",\"Stop new requests for this session?\":\"Arrêter les nouvelles requêtes de cette session ?\",\"Dispatched work stays reserved. This does not refund on-chain credits.\":\"Le travail attribué reste réservé. Cela ne rembourse pas les crédits sur la chaîne.\",\"Approve one bounded rehearsal session\":\"Approuver une session d’essai limitée\",\"This signs a session approval for accounting tests. No KOIN will be spent.\":\"Ceci signe une approbation de session pour des tests comptables. Aucun KOIN ne sera dépensé.\",\"Maximum requests\":\"Nombre maximal de requêtes\",\"Session expires (UTC)\":\"Expiration de la session (UTC)\",\"Spending grant\":\"Autorisation de dépense\",\"Credits contract\":\"Contrat de crédits\",\"Contract bytecode\":\"Bytecode du contrat\",\"Tariff policy\":\"Politique tarifaire\",\"Requests within these limits reuse this approval. Revoking it stops new requests.\":\"Les requêtes respectant ces limites réutilisent cette approbation. Sa révocation arrête les nouvelles requêtes.\",\"Live payments require a separate authorization and are not enabled by this signature.\":\"Les paiements réels nécessitent une autorisation distincte et ne sont pas activés par cette signature.\",\"Approve session rehearsal\":\"Approuver l’essai de session\",\"No session approval saved. Review the limits to begin.\":\"Aucune approbation de session enregistrée. Vérifiez les limites pour commencer.\",\"Session approved for accounting rehearsal. Paid chat remains disabled.\":\"Session approuvée pour l’essai comptable. Le chat payant reste désactivé.\",\"Session approval revoked. Dispatched work stays reserved.\":\"Approbation de session révoquée. Le travail attribué reste réservé.\",\"Session approval expired.\":\"L’approbation de session a expiré.\",\"Session action cancelled.\":\"Action de session annulée.\",\"The session result is uncertain. Refresh or retry the saved approval.\":\"Le résultat de la session est incertain. Actualisez ou réessayez l’approbation enregistrée.\",\"The account grant is unavailable. New requests are blocked.\":\"L’autorisation du compte est indisponible. Les nouvelles requêtes sont bloquées.\",\"Session accounting needs reconciliation. New requests are blocked.\":\"La comptabilité de la session doit être rapprochée. Les nouvelles requêtes sont bloquées.\",\"Session rehearsal unavailable. Retry the saved approval if a response was lost.\":\"Essai de session indisponible. Réessayez l’approbation enregistrée si une réponse a été perdue.\",\"Input price per 1M tokens\":\"Prix d’entrée par million de tokens\",\"Output price per 1M tokens\":\"Prix de sortie par million de tokens\"},\"de\":{\"Minimize\":\"Minimieren\",\"Maximize\":\"Maximieren\",\"Close\":\"Schließen\",\"THINK · BUILD · GROW\":\"DENKEN · BAUEN · WACHSEN\",\"Main navigation\":\"Hauptnavigation\",\"Workspace\":\"Arbeitsbereich\",\"Chat with KAI\":\"Mit KAI chatten\",\"Brain\":\"Gedächtnis\",\"Workflows\":\"Arbeitsabläufe\",\"Connections\":\"Verbindungen\",\"Agents\":\"Agenten\",\"Documents\":\"Dokumente\",\"Compare models\":\"Modelle vergleichen\",\"Your toolkit\":\"Deine Werkzeuge\",\"Model library\":\"Modellbibliothek\",\"Tools\":\"Werkzeuge\",\"Tasks\":\"Aufgaben\",\"Local API\":\"Lokale API\",\"Developer tools\":\"Entwicklerwerkzeuge\",\"Contribute\":\"Mitwirken\",\"Earn KAI\":\"KAI verdienen\",\"Launch KAI\":\"KAI öffnen\",\"A little help, always close\":\"Hilfe ist immer in der Nähe\",\"Connecting…\":\"Verbindung wird hergestellt…\",\"Settings\":\"Einstellungen\",\"Network\":\"Netzwerk\",\"Send feedback\":\"Feedback senden\",\"Your workspace. Your choice of AI.\":\"Dein Arbeitsbereich. Deine KI.\",\"YOUR AI WORKSPACE\":\"DEIN KI-ARBEITSBEREICH\",\"A little curiosity goes a long way.\":\"Ein wenig Neugier bringt dich weiter.\",\"Welcome to Koinos AI\":\"Willkommen bei Koinos AI\",\"Let’s find your first local model. You can also connect OpenAI or Anthropic in desktop Settings, or explore the network.\":\"Finden wir dein erstes lokales Modell. Du kannst auch OpenAI oder Anthropic in den App-Einstellungen verbinden oder das Netzwerk erkunden.\",\"Download & start\":\"Herunterladen und starten\",\"Starting…\":\"Wird gestartet…\",\"Start a new chat\":\"Neuen Chat starten\",\"+ New chat\":\"+ Neuer Chat\",\"Search chats…\":\"Chats durchsuchen…\",\"Chats\":\"Chats\",\"Conversations\":\"Unterhaltungen\",\"Make room for your next idea.\":\"Mach Platz für deine nächste Idee.\",\"YOUR EVERYDAY SIDEKICK\":\"DEIN BEGLEITER IM ALLTAG\",\"Hi, I’m KAI\":\"Hallo, ich bin KAI\",\"Let’s do something amazing.\":\"Lass uns etwas Großartiges schaffen.\",\"Ask a question, explore an idea, or get a hand with your next project.\":\"Stelle eine Frage, erkunde eine Idee oder hol dir Hilfe für dein nächstes Projekt.\",\"Help me understand something new. Ask me what I’m curious about.\":\"Hilf mir, etwas Neues zu verstehen. Frag mich, worauf ich neugierig bin.\",\"Answer a question\":\"Eine Frage beantworten\",\"Make the complicated click.\":\"Kompliziertes verständlich machen.\",\"Help me turn an idea into a project. Ask me what I want to build.\":\"Hilf mir, aus einer Idee ein Projekt zu machen. Frag mich, was ich bauen möchte.\",\"Help me build\":\"Hilf mir beim Bauen\",\"Big ideas start small.\":\"Große Ideen fangen klein an.\",\"Let’s brainstorm some fresh ideas. Ask me what I’m working on.\":\"Lass uns neue Ideen sammeln. Frag mich, woran ich arbeite.\",\"Find a fresh idea\":\"Eine neue Idee finden\",\"A different way to think.\":\"Eine andere Denkweise.\",\"Choose your AI below. Local, network, or your own desktop connection.\":\"Wähle unten deine KI: lokal, im Netzwerk oder über deine eigene Desktop-Verbindung.\",\"How to answer: plain chat, multi-step web research, an agent that uses tools, or a whole AI team\":\"Antwortmodus: Chat, Webrecherche, Agent mit Werkzeugen oder KI-Team\",\"Chat\":\"Chat\",\"Research\":\"Recherche\",\"Agent\":\"Agent\",\"Research team\":\"Rechercheteam\",\"Analyst team (code)\":\"Analyseteam (Code)\",\"Write & review team\":\"Schreib- und Prüfungsteam\",\"Choose this machine, Koinos Network, or a private desktop provider\":\"Wähle diesen Computer, Koinos Network oder einen privaten Desktop-Anbieter\",\"Which model answers\":\"Antwortendes Modell\",\"How the AI should answer\":\"Wie die KI antworten soll\",\"Default style\":\"Standardstil\",\"Concise\":\"Kurz und bündig\",\"Explain simply\":\"Einfach erklären\",\"Code helper\":\"Programmierhilfe\",\"Custom…\":\"Benutzerdefiniert…\",\"Your message to KAI\":\"Deine Nachricht an KAI\",\"Ask KAI anything, or dream something up…\":\"Frag KAI etwas oder denk dir etwas Neues aus…\",\"Attach a text file as context\":\"Textdatei als Kontext anhängen\",\"Web search: the AI looks things up live (your search query leaves this machine)\":\"Websuche: Die KI sucht aktuelle Informationen (deine Suchanfrage verlässt diesen Computer)\",\"Voice input: speak, and it's typed for you — transcribed on this machine, audio never leaves it\":\"Spracheingabe: Sprich, und der Text wird auf diesem Computer transkribiert; das Audio verlässt ihn nie\",\"Send\":\"Senden\",\"Stop\":\"Stoppen\",\"Remove attachment\":\"Anhang entfernen\",\"Describe how the AI should behave, e.g. “You are a pirate. Answer everything in character.”\":\"Beschreibe das Verhalten der KI, z. B.: „Du bist ein Pirat. Antworte immer in dieser Rolle.“\",\"+ New\":\"+ Neu\",\"Title\":\"Titel\",\"Write here. Select some text (or nothing, for the whole document) and use the AI bar below — suggestions preview first, and only Apply changes your words.\":\"Schreibe hier. Markiere Text (oder nichts für das ganze Dokument) und nutze die KI-Leiste. Vorschläge werden zuerst angezeigt; erst Anwenden ändert deinen Text.\",\"Model for suggestions\":\"Modell für Vorschläge\",\"Improve\":\"Verbessern\",\"Fix grammar\":\"Grammatik korrigieren\",\"Shorten\":\"Kürzen\",\"Expand\":\"Erweitern\",\"Continue\":\"Weiter\",\"…or tell it what to do (e.g. “make this friendlier”)\":\"…oder sag, was zu tun ist (z. B. „formuliere das freundlicher“)\",\"Go\":\"Los\",\"Suggestion\":\"Vorschlag\",\"Apply\":\"Anwenden\",\"Discard\":\"Verwerfen\",\"One prompt, two models, blind. Answers stream one at a time (they share the machine), then you reveal which was which. Pick winners to learn which model earns its size.\":\"Eine Frage, zwei zunächst unbekannte Modelle. Antworten erscheinen nacheinander, da beide diesen Computer nutzen. Decke danach die Modelle auf und wähle die bessere Antwort.\",\"Ask both models the same thing…\":\"Stelle beiden Modellen dieselbe Frage…\",\"Run both\":\"Beide ausführen\",\"Answer 1\":\"Antwort 1\",\"Answer 2\":\"Antwort 2\",\"Reveal models\":\"Modelle aufdecken\",\"Which answer was better?\":\"Welche Antwort war besser?\",\"Tie\":\"Unentschieden\",\"Scheduled tasks\":\"Geplante Aufgaben\",\"A prompt that runs itself — hourly, daily, or weekly — and drops its answer into your chats. Tasks run while Koinos AI is open, on whichever model you choose, with the same privacy rules as typed chat.\":\"Eine Anweisung wird stündlich, täglich oder wöchentlich ausgeführt und legt ihre Antwort in deinen Chats ab. Aufgaben laufen, solange Koinos AI geöffnet ist, mit dem gewählten Modell und denselben Datenschutzregeln wie im Chat.\",\"Name (e.g. Morning writing prompt)\":\"Name (z. B. Morgendliche Schreibübung)\",\"The prompt to run, e.g. “Give me one unusual writing prompt and a first line.”\":\"Anweisung, z. B.: „Gib mir eine ungewöhnliche Schreibidee und einen ersten Satz.“\",\"Every hour\":\"Stündlich\",\"Every 6 hours\":\"Alle 6 Stunden\",\"Daily\":\"Täglich\",\"Weekly\":\"Wöchentlich\",\"Mon\":\"Mo\",\"Tue\":\"Di\",\"Wed\":\"Mi\",\"Thu\":\"Do\",\"Fri\":\"Fr\",\"Sat\":\"Sa\",\"Sun\":\"So\",\"Add task\":\"Aufgabe hinzufügen\",\"Network status\":\"Netzwerkstatus\",\"A live look at the Koinos network — the computers online right now and the models they serve. Refreshes every 15 seconds while open.\":\"Die verbundenen Computer im Koinos-Netzwerk und ihre Modelle in Echtzeit. Aktualisierung alle 15 Sekunden, solange diese Ansicht geöffnet ist.\",\"Computers online\":\"Computer online\",\"Model classes live\":\"Aktive Modellklassen\",\"Jobs waiting\":\"Wartende Aufträge\",\"Models on the network\":\"Modelle im Netzwerk\",\"Computers\":\"Computer\",\"Tools & accounts\":\"Werkzeuge und Konten\",\"Give your AI abilities: tool servers (MCP), a memory that lasts across chats, and your email & calendar. Everything asks before acting until you say otherwise.\":\"Ergänze Werkzeugserver (MCP), ein Gedächtnis über Chats hinweg, E-Mail und Kalender. Aktionen fragen nach Erlaubnis, bis du etwas anderes festlegst.\",\"Privacy mode is\":\"Der Datenschutzmodus ist\",\"Local-Only\":\"Nur lokal\",\": tools that talk to the internet (including email & calendar) are switched off. Change it in Local API → Privacy.\":\": Internetwerkzeuge (einschließlich E-Mail und Kalender) sind deaktiviert. Ändere dies unter Lokale API → Datenschutz.\",\"Tool servers\":\"Werkzeugserver\",\"Add\":\"Hinzufügen\",\"Add your own (URL or command)\":\"Eigenen hinzufügen (URL oder Befehl)\",\"Name, e.g. My tools\":\"Name, z. B. Meine Werkzeuge\",\"https://… (an MCP server URL)\":\"https://… (URL eines MCP-Servers)\",\"or a local command, e.g. npx -y @modelcontextprotocol/server-fetch\":\"oder ein lokaler Befehl, z. B. npx -y @modelcontextprotocol/server-fetch\",\"Add server\":\"Server hinzufügen\",\"Manage everything KAI remembers in Brain → Memories.\":\"Verwalte alles, was KAI sich merkt, unter Gedächtnis → Erinnerungen.\",\"Email\":\"E-Mail\",\"Calendar\":\"Kalender\",\"Models\":\"Modelle\",\"Trusted models, verified by checksum before first use. Chat picks any model that's on this machine; bigger models answer better and download once.\":\"Vertrauenswürdige Modelle, vor der ersten Nutzung per Prüfsumme geprüft. Der Chat kann jedes Modell auf diesem Computer nutzen; größere Modelle antworten meist besser und werden einmal heruntergeladen.\",\"Import your own model\":\"Eigenes Modell importieren\",\"Any GGUF file on this machine. It's verified (hashed) once and used in place — nothing is copied or uploaded.\":\"Jede GGUF-Datei auf diesem Computer. Sie wird einmal geprüft und am vorhandenen Ort genutzt; nichts wird kopiert oder hochgeladen.\",\"Full path to a .gguf file\":\"Vollständiger Pfad zur .gguf-Datei\",\"Import\":\"Importieren\",\"Choose file…\":\"Datei wählen…\",\"Earn with your hardware\":\"Mit deiner Hardware verdienen\",\"Run approved AI jobs for the network and earn KAI. Alpha runs on the Koinos testnet — rewards are test tokens while the network hardens.\":\"Bearbeite genehmigte KI-Aufträge für das Netzwerk und verdiene KAI. Die Alpha nutzt das Koinos-Testnetz: Belohnungen sind Test-Token, während das Netzwerk verbessert wird.\",\"Create your earning account\":\"Verdienstkonto erstellen\",\"A wallet is created on this machine. Its key never leaves your computer and is never shared with apps or the network.\":\"Auf diesem Computer wird eine Wallet erstellt. Ihr Schlüssel verlässt ihn nie und wird weder mit Apps noch mit dem Netzwerk geteilt.\",\"Choose a password (min 8 chars)\":\"Passwort wählen (mind. 8 Zeichen)\",\"show\":\"anzeigen\",\"Confirm password\":\"Passwort bestätigen\",\"Create\":\"Erstellen\",\"Backup key — shown only once. Write it down, then continue:\":\"Sicherungsschlüssel: Wird nur einmal angezeigt. Notiere ihn, bevor du fortfährst:\",\"I saved it\":\"Ich habe ihn gespeichert\",\"Unlock your earning account\":\"Verdienstkonto entsperren\",\"Wallet password\":\"Wallet-Passwort\",\"Unlock\":\"Entsperren\",\"Forgot your password? Restore with your backup code\":\"Passwort vergessen? Mit dem Sicherungscode wiederherstellen\",\"Restore from backup code\":\"Mit Sicherungscode wiederherstellen\",\"Enter the backup code you wrote down when the account was created, and choose a new password. Your address and balance stay the same.\":\"Gib den bei der Kontoerstellung notierten Sicherungscode ein und wähle ein neues Passwort. Adresse und Guthaben bleiben gleich.\",\"Backup code\":\"Sicherungscode\",\"New password (min 8 chars)\":\"Neues Passwort (mind. 8 Zeichen)\",\"Confirm new password\":\"Neues Passwort bestätigen\",\"Restore\":\"Wiederherstellen\",\"Offline\":\"Offline\",\"Scheduler URL (from the project)\":\"Koordinator-URL (vom Projekt)\",\"Start Earning\":\"Verdienst starten\",\"Stopping is immediate — no job runs after you press Stop.\":\"Der Stopp wirkt sofort: Nach dem Klick auf Stoppen wird kein Auftrag mehr ausgeführt.\",\"Network usage & balance\":\"Netzwerknutzung und Guthaben\",\"Network AI is billed like any modern AI API — by input and output tokens, per model — and settles in KAI underneath. Add funds by converting KAI at the current reference price, or keep earning: serving the network covers your own usage.\":\"Netzwerk-KI wird pro Modell nach Eingabe- und Ausgabe-Token berechnet und in KAI abgerechnet. Wandle KAI zum aktuellen Referenzpreis in Guthaben um oder verdiene weiter: Dienste für das Netzwerk decken deine eigene Nutzung.\",\"KAI to convert\":\"KAI zum Umwandeln\",\"Add funds\":\"Guthaben hinzufügen\",\"Your wallet stays unlocked on this computer.\":\"Deine Wallet bleibt auf diesem Computer entsperrt.\",\"Lock wallet\":\"Wallet sperren\",\"Show backup code\":\"Sicherungscode anzeigen\",\"Wallet password (required to reveal)\":\"Wallet-Passwort (zum Anzeigen erforderlich)\",\"Reveal\":\"Anzeigen\",\"Wallet — send & receive on Koinos mainnet\":\"Wallet: Senden und Empfangen im Koinos-Hauptnetz\",\"Your Koinos AI wallet is a real Koinos address: share it to receive KOIN or VHP, and send either with your wallet password. This is real mainnet value — check the recipient address character by character. Works on every machine, node or not.\":\"Deine Koinos-AI-Wallet ist eine echte Koinos-Adresse. Teile sie, um KOIN oder VHP zu empfangen, und sende sie mit deinem Wallet-Passwort. Es handelt sich um echte Werte im Hauptnetz: Prüfe die Empfängeradresse Zeichen für Zeichen. Funktioniert mit und ohne Knoten.\",\"Your Koinos address\":\"Deine Koinos-Adresse\",\"Copy address\":\"Adresse kopieren\",\"Show balances\":\"Guthaben anzeigen\",\"Token to send\":\"Zu sendender Token\",\"Recipient address (1…)\":\"Empfängeradresse (1…)\",\"Amount\":\"Betrag\",\"Wallet password (required to send)\":\"Wallet-Passwort (zum Senden erforderlich)\",\"Dashboard\":\"Übersicht\",\"Wallet\":\"Wallet\",\"Fund node\":\"Knoten finanzieren\",\"Burn KOIN → VHP\":\"KOIN verbrennen → VHP\",\"Node\":\"Knoten\",\"Reward returns\":\"Belohnungsrückführung\",\"Node settings\":\"Knoteneinstellungen\",\"App settings\":\"App-Einstellungen\",\"Your account, and the parts of the app that are off until you turn them on.\":\"Dein Konto und die Funktionen, die erst nach deiner Aktivierung eingeschaltet werden.\",\"Desktop AI connections\":\"Desktop-KI-Verbindungen\",\"Use your own OpenAI or Anthropic API account in chat and desktop KAI. Chats, attachments and relevant app tool results go directly to your chosen provider. API usage is billed by that provider. Keys are encrypted on this computer and are never offered to the Koinos Network.\":\"Nutze dein OpenAI- oder Anthropic-API-Konto im Chat und in Desktop-KAI. Chats, Anhänge und relevante Werkzeugergebnisse gehen direkt an den gewählten Anbieter. Dieser berechnet die API-Nutzung. Schlüssel werden auf diesem Computer verschlüsselt und nie Koinos Network angeboten.\",\"Not connected\":\"Nicht verbunden\",\"API key\":\"API-Schlüssel\",\"Paste your API key\":\"API-Schlüssel einfügen\",\"Model ID\":\"Modell-ID\",\"(optional — or refresh models after saving)\":\"(optional; Modelle können auch nach dem Speichern aktualisiert werden)\",\"A model ID from your provider account\":\"Eine Modell-ID aus deinem Anbieterkonto\",\"Save connection\":\"Verbindung speichern\",\"Test & refresh models\":\"Modelle testen und aktualisieren\",\"Use in chat\":\"Im Chat verwenden\",\"Remove\":\"Entfernen\",\"Get an API key ↗\":\"API-Schlüssel erhalten ↗\",\"Available in desktop chat, Research, Agent and KAI. Teams, scheduled tasks, the local API and network earning continue using their existing models. Stop cancels an active provider reply.\":\"Verfügbar im Desktop-Chat, in Recherche, Agent und KAI. Teams, geplante Aufgaben, lokale API und Netzwerkverdienst nutzen weiterhin ihre bisherigen Modelle. Stoppen bricht die aktive Anbieterantwort ab.\",\"Checking…\":\"Wird geprüft…\",\"Check for updates\":\"Nach Updates suchen\",\"Koinos AI account\":\"Koinos-AI-Konto\",\"One account across your devices: sign in once, link this wallet, and your balance and claims follow you. Sign-in happens at koinosai.com with a passkey, email code, or Google — the app never asks for a password, it just shows a short code.\":\"Ein Konto für alle Geräte: Melde dich an und verknüpfe diese Wallet, um Guthaben und Ansprüche mitzunehmen. Die Anmeldung erfolgt auf koinosai.com per Passkey, E-Mail-Code oder Google. Die App zeigt einen kurzen Code und fragt nie nach deinem Anmeldepasswort.\",\"Sign in / create account\":\"Anmelden / Konto erstellen\",\"On any device, open\":\"Öffne auf einem beliebigen Gerät\",\", sign in, and type this code:\":\", melde dich an und gib diesen Code ein:\",\"Waiting for approval…\":\"Warten auf Genehmigung…\",\"Link this wallet\":\"Diese Wallet verknüpfen\",\"Sign out on this device\":\"Auf diesem Gerät abmelden\",\"Use Koinos AI on the web\":\"Koinos AI im Web nutzen\",\"Chat and Docs in a browser, signed in to this same account — useful on a machine that cannot run models. The website has no key of its own, so it can only spend what you authorise here: a cap, and a date it stops. This app signs that once, with this wallet, and you can end it from either side at any time. A grant is permission, not funds — this wallet still needs KAI on the network to draw against, same as the app.\":\"Nutze Chat und Dokumente im Browser mit demselben Konto, auch ohne lokale Modelle. Die Website darf nur das hier Genehmigte ausgeben: bis zu einem Limit und einem Ablaufdatum. Diese App signiert die Erlaubnis mit deiner Wallet; du kannst sie auf beiden Seiten widerrufen. Die Erlaubnis stellt kein Guthaben bereit: Die Wallet benötigt KAI im Netzwerk.\",\"How it works\":\"So funktioniert es\",\"Spend up to\":\"Ausgaben bis\",\"for 7 days\":\"für 7 Tage\",\"for 30 days\":\"für 30 Tage\",\"for 90 days\":\"für 90 Tage\",\"Authorise\":\"Genehmigen\",\"In US dollars of model usage — the same rates the Network tab shows. Nothing is transferred now; the site draws against this as it is used.\":\"In US-Dollar für Modellnutzung, zu denselben Preisen wie im Netzwerk-Tab. Jetzt wird nichts übertragen; die Website nutzt die Erlaubnis entsprechend dem Verbrauch.\",\"Open the web app\":\"Web-App öffnen\",\"End web access\":\"Webzugriff beenden\",\"Closing the window\":\"Beim Schließen des Fensters\",\"Keep running in the notification area\":\"Im Infobereich weiterlaufen\",\"Closing the window tucks Koinos AI down by the clock instead of shutting it down, so your node stays connected and keeps earning. Click that icon to bring the window back, or right-click it and choose Quit to stop the app completely. Switch this off and the X closes the app outright, the way it used to.\":\"Beim Schließen bleibt Koinos AI neben der Uhr aktiv, damit dein Knoten verbunden bleibt und weiter verdient. Klicke auf das Symbol zum Öffnen oder rechts darauf und auf Beenden zum vollständigen Schließen. Deaktiviere diese Option, damit das X die App beendet.\",\"Optional sections\":\"Optionale Bereiche\",\"Each of these adds its own entry to the sidebar. All of them are off until you switch them on, and switching one off only hides it — nothing you made is deleted.\":\"Jede Funktion ergänzt einen Eintrag in der Seitenleiste und bleibt bis zur Aktivierung aus. Deaktivieren blendet sie nur aus; nichts von deinen erstellten Inhalten wird gelöscht.\",\"Run Koinos Node\":\"Koinos Node ausführen\",\"Runs a real Koinos node on this machine, with a wallet, funding, swaps and block-production rewards. Uses your existing Koinos AI wallet. Node networking is independent of AI Privacy; Local-Only can stay on.\":\"Betreibt einen echten Koinos-Knoten auf diesem Computer mit Wallet, Finanzierung, Tausch und Blockproduktionsbelohnungen. Nutzt deine vorhandene Koinos-AI-Wallet. Das Knotennetzwerk ist unabhängig vom KI-Datenschutz; Nur lokal kann aktiviert bleiben.\",\"Run Koinos node\":\"Koinos-Knoten ausführen\",\"Koinos Node is on — it is in the sidebar now.\":\"Koinos Node ist aktiviert und erscheint jetzt in der Seitenleiste.\",\"Adds a\":\"Ergänzt einen Bereich\",\"Developer Tools\":\"Entwicklerwerkzeuge\",\"section to the sidebar: build your own multi-agent systems, watch them run in a live playground, define custom pipelines, and benchmark your model. Everything there obeys the same privacy and permission rules as the rest of the app.\":\"in der Seitenleiste: Erstelle Mehragentensysteme, beobachte ihre Ausführung, definiere Pipelines und bewerte dein Modell. Es gelten dieselben Datenschutz- und Berechtigungsregeln wie in der übrigen App.\",\"Adds\":\"Ergänzt\",\"to the sidebar: the coding agent, working on folders you choose. Worth knowing exactly what it can do — inside a project you add, it can write files and run commands as you. It never does either without showing you the change or the exact command first and waiting for your yes, and it never touches anything outside that folder.\":\"in der Seitenleiste: Ein Programmieragent arbeitet in deinen gewählten Ordnern. In hinzugefügten Projekten kann er Dateien schreiben und Befehle unter deinem Benutzerkonto ausführen. Er zeigt vorher die Änderung oder den genauen Befehl und wartet auf deine Zustimmung. Außerhalb des Ordners verändert er nichts.\",\"Your local OpenAI-compatible API\":\"Deine lokale OpenAI-kompatible API\",\"Point any OpenAI SDK or tool at this machine. No cloud, no per-token bill.\":\"Verbinde jedes OpenAI-SDK oder Werkzeug mit diesem Computer. Ohne Cloud und ohne Kosten pro Token.\",\"Network & privacy\":\"Netzwerk und Datenschutz\",\"Local-Only is the default: AI requests stay on this machine. Koinos Node and explicit wallet actions use the blockchain independently. Local-First and Network unlock the “Koinos Network” model — requests overflow to network providers through the scheduler.\":\"Nur lokal ist die Standardeinstellung: KI-Anfragen bleiben auf diesem Computer. Koinos Node und ausdrückliche Wallet-Aktionen nutzen die Blockchain unabhängig davon. Lokal bevorzugt und Netzwerk aktivieren das Modell Koinos Network und die Weiterleitung an Netzwerkanbieter über den Koordinator.\",\"Network requests run on other people's computers: the provider serving your request can read what it contains\":\"Netzwerkanfragen laufen auf fremden Computern: Der Anbieter kann ihren Inhalt lesen\",\"— nothing is stored by the serving path, but treat anything sent off this machine as visible to that provider.\":\": Die Verarbeitung speichert nichts, aber betrachte alles, was diesen Computer verlässt, als für den Anbieter sichtbar.\",\"Local-Only (AI requests stay on this machine)\":\"Nur lokal (KI-Anfragen bleiben auf diesem Computer)\",\"Local-First (local when possible, network when needed — first 25k tokens/epoch free)\":\"Lokal bevorzugt (lokal wenn möglich, Netzwerk bei Bedarf; erste 25.000 Token pro Epoche kostenlos)\",\"API keys\":\"API-Schlüssel\",\"Create key\":\"Schlüssel erstellen\",\"Without keys, apps on this computer connect freely. Creating the first key requires every API call to present one — the built-in chat keeps working either way.\":\"Ohne Schlüssel können sich Apps auf diesem Computer frei verbinden. Sobald du den ersten Schlüssel erstellst, muss jeder API-Aufruf einen vorlegen. Der integrierte Chat funktioniert in beiden Fällen weiter.\",\"Copy it now — it is shown only once:\":\"Jetzt kopieren: Wird nur einmal angezeigt:\",\"Remote access\":\"Fernzugriff\",\"Use your API from anywhere — a phone, a server, another computer. The app keeps an outbound connection to koinosai.com (nothing to install, no router setup) and your API key works at the address below. Requests are answered by\":\"Nutze deine API von einem Telefon, Server oder anderen Computer. Die App hält eine ausgehende Verbindung zu koinosai.com, ohne Installation oder Routereinstellungen. Dein Schlüssel funktioniert unter der folgenden Adresse. Anfragen beantwortet\",\"this computer\":\"dieser Computer\",\", so it works while the app is running. An API key is required — without one the switch refuses, so your API is never open to the internet. Heads up: remote traffic passes through koinosai.com on its way here.\":\", daher muss die App geöffnet sein. Ein API-Schlüssel ist erforderlich; ohne ihn lässt sich der Zugriff nicht aktivieren. Deine API ist nie ungeschützt im Internet. Der Fernzugriff läuft über koinosai.com.\",\"Projects\":\"Projekte\",\"Connect GitHub\":\"GitHub verbinden\",\"Point it at a folder and tell it what to do. It shows you every change before anything happens.\":\"Wähle einen Ordner und sage, was zu tun ist. Jede Änderung wird vor der Ausführung angezeigt.\",\"Select a folder\":\"Ordner auswählen\",\"Work on something already on this machine\":\"An etwas auf diesem Computer arbeiten\",\"Clone from GitHub\":\"Von GitHub klonen\",\"Copy a repository down and start on it\":\"Repository herunterladen und loslegen\",\"Choose a folder\":\"Ordner wählen\",\"Type or paste a full path\":\"Vollständigen Pfad eingeben oder einfügen\",\"Use this folder\":\"Diesen Ordner verwenden\",\"Clone a repository\":\"Repository klonen\",\"owner/name — or the full GitHub URL\":\"Eigentümer/Name oder vollständige GitHub-URL\",\"Select a folder…\":\"Ordner auswählen…\",\"no folder chosen yet\":\"noch kein Ordner ausgewählt\",\"Folder to clone into — full path\":\"Zielordner: vollständiger Pfad\",\"Clone and start\":\"Klonen und starten\",\"Rename\":\"Umbenennen\",\"Forget\":\"Vergessen\",\"Branch name / commit message / PR title\":\"Branchname / Commit-Nachricht / PR-Titel\",\"Branch\":\"Branch\",\"Project name\":\"Projektname\",\"Save\":\"Speichern\",\"Cancel\":\"Abbrechen\",\"What should it do? (Enter to send, Shift+Enter for a new line)\":\"Was soll erledigt werden? (Enter sendet, Umschalt+Enter fügt eine Zeile ein)\",\"Plan first\":\"Zuerst planen\",\"Model\":\"Modell\",\"Which model does the work. Koinos Code runs on this machine only — the agent reads your project's files into the prompt, and those do not leave the computer.\":\"Welches Modell die Arbeit erledigt. Koinos Code läuft nur auf diesem Computer: Projektdateien werden in die Anweisung eingelesen und verlassen den Computer nicht.\",\"Tools…\":\"Werkzeuge…\",\"Tools this project may use\":\"Zulässige Werkzeuge für dieses Projekt\",\"Build and run your own agent systems on this machine's API — from a one-line pipeline to a team of named agents that talk, use tools, and ask you questions.\":\"Erstelle und betreibe Agentensysteme über die API dieses Computers, von einfachen Pipelines bis zu Teams, die kommunizieren, Werkzeuge nutzen und dir Fragen stellen.\",\"Developer tools sections\":\"Bereiche der Entwicklerwerkzeuge\",\"Multi-agent\":\"Mehrere Agenten\",\"Playground\":\"Testumgebung\",\"Pipelines\":\"Pipelines\",\"Benchmark\":\"Benchmark\",\"Named agents share one conversation. Pick how the floor moves — round robin, a model moderator, or explicit handoffs — and how it ends. A\":\"Benannte Agenten teilen eine Unterhaltung. Wähle die Reihenfolge (abwechselnd, KI-Moderator oder ausdrückliche Übergaben) und das Ende. Ein\",\"human\":\"menschlicher\",\"agent pauses the run and asks you. Hard ceilings always hold: 60 messages, 120 model calls, 6 tool actions per turn. Apps can POST the same spec to\":\"Agent pausiert den Ablauf und fragt dich. Es gelten Grenzen von 60 Nachrichten, 120 Modellaufrufen und 6 Werkzeugaktionen pro Zug. Apps können dieselbe Spezifikation per POST senden an\",\"Team name\":\"Teamname\",\"e.g. Research duo\":\"z. B. Rechercheduo\",\"Turn order\":\"Zugreihenfolge\",\"Round robin — agents speak in order\":\"Abwechselnd: Agenten sprechen der Reihe nach\",\"Selector — a model picks who speaks next\":\"Auswahl: Ein Modell bestimmt den nächsten Sprecher\",\"Handoff — the speaker passes the floor by name\":\"Übergabe: Der Sprecher übergibt namentlich\",\"+ Add agent\":\"+ Agent hinzufügen\",\"Max messages\":\"Max. Nachrichten\",\"Max model calls\":\"Max. Modellaufrufe\",\"End phrase\":\"Abschlussphrase\",\"Team JSON\":\"Team-JSON\",\"Update JSON from builder\":\"JSON aus dem Editor aktualisieren\",\"Update the JSON after changing the builder. Saving and running use this JSON.\":\"Aktualisiere das JSON nach Änderungen im Editor. Speichern und Ausführen verwenden dieses JSON.\",\"Save team\":\"Team speichern\",\"Saved teams\":\"Gespeicherte Teams\",\"Load\":\"Laden\",\"Delete\":\"Löschen\",\"Run a team and watch the conversation live. When a human agent's turn comes, the box below asks you — the run waits (up to its timeout) for your words.\":\"Starte ein Team und verfolge die Unterhaltung live. Ist ein menschlicher Agent an der Reihe, fragt das Feld unten nach deiner Antwort; der Ablauf wartet bis zur Zeitgrenze.\",\"Team\":\"Team\",\"Task\":\"Aufgabe\",\"What should the team do?\":\"Was soll das Team tun?\",\"Run\":\"Ausführen\",\"Your message to the team\":\"Deine Nachricht an das Team\",\"It's your turn — type your message\":\"Du bist dran: Schreibe deine Nachricht\",\"The simple track: one pipeline of typed stages (plan → work → write → critique → revise). Budgets cap at the built-in ceilings (4 sub-tasks, 4 actions per worker, 24 model calls) no matter what the spec asks. Also at\":\"Eine Pipeline aus Schritten: planen → arbeiten → schreiben → prüfen → überarbeiten. Es gelten höchstens 4 Teilaufgaben, 4 Aktionen pro Bearbeiter und 24 Modellaufrufe, unabhängig von der Spezifikation. Auch verfügbar unter\",\"Pipeline name\":\"Pipeline-Name\",\"e.g. Research pipeline\":\"z. B. Recherchepipeline\",\"Stages\":\"Schritte\",\"plan\":\"planen\",\"work\":\"arbeiten\",\"write (always)\":\"schreiben (immer)\",\"critique\":\"prüfen\",\"revise\":\"überarbeiten\",\"loading tools…\":\"Werkzeuge werden geladen…\",\"Sub-tasks\":\"Teilaufgaben\",\"Actions per worker\":\"Aktionen pro Bearbeiter\",\"Worker goal (optional)\":\"Ziel des Bearbeiters (optional)\",\"What each worker should do\":\"Was jeder Bearbeiter tun soll\",\"Pipeline JSON\":\"Pipeline-JSON\",\"Update the JSON after changing the builder. Running uses this JSON.\":\"Aktualisiere das JSON nach Änderungen im Editor. Die Ausführung verwendet dieses JSON.\",\"What should the pipeline do?\":\"Was soll die Pipeline tun?\",\"Run team\":\"Team ausführen\",\"Scores the current model on a fixed suite of objective tasks — arithmetic, instruction following, JSON output, extraction, and a tool-using agent case. Same tasks every run, so scores compare across models and app versions. Also at\":\"Bewertet das Modell mit festen Aufgaben: Rechnen, Befolgen von Anweisungen, JSON-Ausgabe, Extraktion und Werkzeugnutzung. Dieselben Aufgaben ermöglichen Vergleiche zwischen Modellen und Versionen. Auch unter\",\"Run benchmark\":\"Benchmark ausführen\",\"Goes straight to the Koinos AI team. Crashes, confusion, ideas — all welcome.\":\"Geht direkt an das Koinos-AI-Team. Fehler, Unklarheiten und Ideen sind willkommen.\",\"What happened? What did you expect?\":\"Was ist passiert? Was hattest du erwartet?\",\"Email (optional — for a reply)\":\"E-Mail (optional, für eine Antwort)\",\"Include the app's diagnostic log (recommended — no chat content, no keys)\":\"Diagnoseprotokoll einschließen (empfohlen; ohne Chatinhalte oder Schlüssel)\",\"Language\":\"Sprache\",\"App language\":\"App-Sprache\",\"Choose your language\":\"Wähle deine Sprache\",\"Welcome to Koinos AI. Select your language to get started.\":\"Willkommen bei Koinos AI. Wähle deine Sprache, um loszulegen.\",\"You can change this later in Settings.\":\"Du kannst dies später in den Einstellungen ändern.\",\"Choose the language used for menus, settings, and setup. You can change it at any time.\":\"Wähle die Sprache für Menüs, Einstellungen und die Ersteinrichtung. Du kannst sie jederzeit ändern.\",\"Language saved.\":\"Sprache gespeichert.\",\"Could not save the language. Please try again.\":\"Die Sprache konnte nicht gespeichert werden. Bitte versuche es erneut.\",\"Could not load the language setting. Choose a language and try again.\":\"Die Spracheinstellung konnte nicht geladen werden. Wähle eine Sprache und versuche es erneut.\",\"Core unreachable\":\"Core nicht erreichbar\",\"Downloading model… {0}%\":\"Modell wird heruntergeladen… {0}%\",\"Downloading engine… {0}%\":\"Engine wird heruntergeladen… {0}%\",\"Setting up engine… (one time — takes a few minutes, the app stays usable)\":\"Engine wird eingerichtet… (einmalig; dauert einige Minuten, die App bleibt nutzbar)\",\"Loading model…\":\"Modell wird geladen…\",\"Model loaded\":\"Modell geladen\",\"Ready (model loads on first message)\":\"Bereit (Modell wird bei der ersten Nachricht geladen)\",\"Setup needed\":\"Einrichtung erforderlich\",\"No models in catalog\":\"Keine Modelle im Katalog\",\"Desktop provider ready\":\"Desktop-Anbieter bereit\",\"Model load failed{0}\":\"Modell konnte nicht geladen werden{0}\",\"System\":\"System\",\"Memory\":\"Speicher\",\"None detected — running on CPU\":\"Keine erkannt; Ausführung auf der CPU\",\"From a first thought to the final draft.\":\"Vom ersten Gedanken zum fertigen Entwurf.\",\"One question. A few different perspectives.\":\"Eine Frage. Mehrere Perspektiven.\",\"Find the right mind for the job.\":\"Finde das passende Modell für die Aufgabe.\",\"Build a service. Connect with other agents.\":\"Erstelle einen Dienst. Verbinde dich mit anderen Agenten.\",\"Your world, remembered.\":\"Deine Welt, im Gedächtnis.\",\"Give your routines to KAI.\":\"Überlasse KAI deine Routinen.\",\"Your accounts, your control.\":\"Deine Konten, deine Kontrolle.\",\"Put your ideas in motion.\":\"Setze deine Ideen in Bewegung.\",\"Give your AI a few more abilities.\":\"Gib deiner KI mehr Möglichkeiten.\",\"Your models, connected to your workflow.\":\"Deine Modelle, verbunden mit deinem Arbeitsablauf.\",\"Let your compute contribute.\":\"Lass deine Rechenleistung mitwirken.\",\"Make this space your own.\":\"Gestalte diesen Bereich nach deinen Wünschen.\",\"Connected on your terms.\":\"Verbunden nach deinen Regeln.\",\"Build something you want to exist.\":\"Baue etwas, das du dir wünschst.\",\"Everything you need to get hands-on.\":\"Alles, was du zum Loslegen brauchst.\",\"Your wallet. Your node. Your contribution.\":\"Deine Wallet. Dein Knoten. Dein Beitrag.\",\"Let’s get you ready.\":\"Machen wir dich startklar.\",\"Copy\":\"Kopieren\",\"Copy message\":\"Nachricht kopieren\",\"Copied\":\"Kopiert\",\"Edit\":\"Bearbeiten\",\"Refresh\":\"Aktualisieren\",\"Retry\":\"Erneut versuchen\",\"Back\":\"Zurück\",\"← Back\":\"← Zurück\",\"Next\":\"Weiter\",\"Done\":\"Fertig\",\"Ready\":\"Bereit\",\"Loading…\":\"Wird geladen…\",\"Working…\":\"Wird verarbeitet…\",\"Saving…\":\"Wird gespeichert…\",\"Saved\":\"Gespeichert\",\"Failed\":\"Fehlgeschlagen\",\"Error\":\"Fehler\",\"Unknown error\":\"Unbekannter Fehler\",\"Running\":\"Läuft\",\"Stopped\":\"Gestoppt\",\"stopped\":\"gestoppt\",\"running\":\"läuft\",\"Paused\":\"Pausiert\",\"Pending\":\"Ausstehend\",\"Enabled\":\"Aktiviert\",\"Disabled\":\"Deaktiviert\",\"On\":\"Ein\",\"Off\":\"Aus\",\"Online\":\"Online\",\"Connected\":\"Verbunden\",\"Connect\":\"Verbinden\",\"Disconnect\":\"Trennen\",\"Start\":\"Starten\",\"Stop Earning\":\"Verdienst stoppen\",\"Details\":\"Details\",\"Name\":\"Name\",\"Description\":\"Beschreibung\",\"Status\":\"Status\",\"Type\":\"Typ\",\"Action\":\"Aktion\",\"Actions\":\"Aktionen\",\"Address\":\"Adresse\",\"Balance\":\"Guthaben\",\"Balances\":\"Guthaben\",\"Password\":\"Passwort\",\"Confirm\":\"Bestätigen\",\"Confirm transaction\":\"Transaktion bestätigen\",\"Transaction\":\"Transaktion\",\"Transactions\":\"Transaktionen\",\"Receive\":\"Empfangen\",\"Sent\":\"Gesendet\",\"Received\":\"Empfangen\",\"Recipient\":\"Empfänger\",\"Fee\":\"Gebühr\",\"Amount to send\":\"Zu sendender Betrag\",\"Available\":\"Verfügbar\",\"Not available\":\"Nicht verfügbar\",\"Copy to clipboard\":\"In die Zwischenablage kopieren\",\"Export\":\"Exportieren\",\"Download\":\"Herunterladen\",\"Install\":\"Installieren\",\"Uninstall\":\"Deinstallieren\",\"Update\":\"Aktualisieren\",\"Open\":\"Öffnen\",\"Search\":\"Suchen\",\"Clear\":\"Leeren\",\"New\":\"Neu\",\"Yes\":\"Ja\",\"No\":\"Nein\",\"None\":\"Keine\",\"Never\":\"Nie\",\"Not yet\":\"Noch nicht\",\"Optional\":\"Optional\",\"Required\":\"Erforderlich\",\"Advanced\":\"Erweitert\",\"General\":\"Allgemein\",\"Security\":\"Sicherheit\",\"Privacy\":\"Datenschutz\",\"Overview\":\"Überblick\",\"Activity\":\"Aktivität\",\"History\":\"Verlauf\",\"Today\":\"Heute\",\"Yesterday\":\"Gestern\",\"Total\":\"Gesamt\",\"Options\":\"Optionen\",\"Default\":\"Standard\",\"Configure\":\"Konfigurieren\",\"Manage\":\"Verwalten\",\"View\":\"Ansehen\",\"Reset\":\"Zurücksetzen\",\"Restart\":\"Neustarten\",\"Test builds\":\"Testversionen\",\"What's new\":\"Neuigkeiten\",\"Couldn't check — Core is not answering.\":\"Prüfung nicht möglich: Core antwortet nicht.\",\"Memories\":\"Erinnerungen\",\"Memory graph\":\"Erinnerungskarte\",\"Goals & tasks\":\"Ziele und Aufgaben\",\"Sources\":\"Quellen\",\"Sync & changes\":\"Synchronisierung und Änderungen\",\"Awareness\":\"Beobachtung\",\"Orchestration\":\"Koordination\",\"My workflows\":\"Meine Arbeitsabläufe\",\"Run history\":\"Ausführungsverlauf\",\"Templates\":\"Vorlagen\",\"Discover workflows\":\"Arbeitsabläufe entdecken\",\"Explore apps\":\"Apps erkunden\",\"Connection settings\":\"Verbindungseinstellungen\",\"Custom APIs\":\"Eigene APIs\",\"Models & other tools\":\"Modelle und weitere Werkzeuge\",\"KAI Brain\":\"KAI-Gedächtnis\",\"A memory of your world, built from what you choose to share.\":\"Ein Gedächtnis deiner Welt, aufgebaut aus dem, was du teilen möchtest.\",\"Teach KAI a routine. Review the steps, then run it whenever you need.\":\"Bring KAI einen Ablauf bei. Prüfe die Schritte und starte ihn bei Bedarf.\",\"Connect the apps you use and choose what KAI can do with them.\":\"Verbinde deine Apps und wähle, was KAI damit tun darf.\",\"Open the installed KAI desktop app\":\"Öffne die installierte KAI-App\",\"Brain, private API connections, and durable workflows are available in Koinos AI Test.\":\"Gedächtnis, private API-Verbindungen und dauerhafte Arbeitsabläufe sind in Koinos AI Test verfügbar.\",\"Your companion data is locked\":\"Die Begleiterdaten sind gesperrt\",\"Unlock your original OS keychain and restart KAI. Your saved data will stay intact.\":\"Entsperre den ursprünglichen Systemschlüsselbund und starte KAI neu. Deine gespeicherten Daten bleiben erhalten.\",\"Add memory\":\"Erinnerung hinzufügen\",\"Edit memory\":\"Erinnerung bearbeiten\",\"Your notes\":\"Deine Notizen\",\"Source removed\":\"Quelle entfernt\",\"Read source text\":\"Quelltext lesen\",\"A little more understanding, every day.\":\"Jeden Tag etwas mehr Verständnis.\",\"Memories, sources and priorities connected in one private place.\":\"Erinnerungen, Quellen und Prioritäten an einem privaten Ort verbunden.\",\"Export Markdown\":\"Markdown exportieren\",\"Topics\":\"Themen\",\"To review\":\"Zu prüfen\",\"Observing\":\"Beobachtet\",\"Assisting\":\"Unterstützt\",\"Run a check\":\"Prüfung ausführen\",\"Open activity\":\"Aktivität öffnen\",\"Your daily briefing\":\"Dein Tagesüberblick\",\"Build briefing\":\"Überblick erstellen\",\"Worth a look\":\"Einen Blick wert\",\"You're all caught up\":\"Alles erledigt\",\"Your memory activity\":\"Aktivität deiner Erinnerungen\",\"Use relevant Brain memories in private replies\":\"Relevante Erinnerungen in privaten Antworten verwenden\",\"Your memories\":\"Deine Erinnerungen\",\"See how your world connects\":\"Entdecke die Verbindungen in deiner Welt\",\"Search exact source text and your saved knowledge.\":\"Durchsuche Originaltexte und dein gespeichertes Wissen.\",\"Import file\":\"Datei importieren\",\"Source\":\"Quelle\",\"Topic\":\"Thema\",\"All sources\":\"Alle Quellen\",\"All topics\":\"Alle Themen\",\"Updated since\":\"Aktualisiert seit\",\"People, topics, projects…\":\"Personen, Themen, Projekte…\",\"Add a goal\":\"Ziel hinzufügen\",\"Goal\":\"Ziel\",\"Goals\":\"Ziele\",\"Priority\":\"Priorität\",\"Due date\":\"Fälligkeitsdatum\",\"High\":\"Hoch\",\"Medium\":\"Mittel\",\"Low\":\"Niedrig\",\"Completed\":\"Abgeschlossen\",\"Complete\":\"Abschließen\",\"Add source\":\"Quelle hinzufügen\",\"Sync now\":\"Jetzt synchronisieren\",\"Sync\":\"Synchronisieren\",\"Auto-sync\":\"Automatisch synchronisieren\",\"Local model\":\"Lokales Modell\",\"Source excerpts\":\"Quellenauszüge\",\"New workflow\":\"Neuer Arbeitsablauf\",\"Import workflow\":\"Arbeitsablauf importieren\",\"Scheduled prompts\":\"Geplante Anweisungen\",\"Manual\":\"Manuell\",\"Schedule on\":\"Zeitplan aktiviert\",\"Schedule off\":\"Zeitplan deaktiviert\",\"Draft · review required\":\"Entwurf · Prüfung erforderlich\",\"Review & resume\":\"Prüfen und fortsetzen\",\"Cancel run\":\"Ausführung abbrechen\",\"Your first run starts here\":\"Hier beginnt deine erste Ausführung\",\"Run a saved workflow to see its progress and results.\":\"Starte einen gespeicherten Ablauf, um Fortschritt und Ergebnisse zu sehen.\",\"Make room for the work you enjoy\":\"Schaffe Platz für die Arbeit, die dir Freude macht\",\"Start from a template\":\"Mit einer Vorlage beginnen\",\"Project briefing\":\"Projektüberblick\",\"Weekly goal review\":\"Wöchentlicher Zielüberblick\",\"API digest\":\"API-Zusammenfassung\",\"AI models\":\"KI-Modelle\",\"Provider settings\":\"Anbietereinstellungen\",\"Local model library\":\"Lokale Modellbibliothek\",\"MCP, email & calendars\":\"MCP, E-Mail und Kalender\",\"Open Tools\":\"Werkzeuge öffnen\",\"Add connection\":\"Verbindung hinzufügen\",\"Manual use only\":\"Nur manuelle Nutzung\",\"Background reads allowed\":\"Lesen im Hintergrund erlaubt\",\"Background reads off\":\"Lesen im Hintergrund deaktiviert\",\"Open & test\":\"Öffnen und testen\",\"Connect a custom API\":\"Eigene API verbinden\",\"Start with an API template\":\"Mit einer API-Vorlage beginnen\",\"Source content\":\"Quelleninhalt\",\"Workflow builder\":\"Ablaufeditor\",\"API connection\":\"API-Verbindung\",\"Use connection\":\"Verbindung nutzen\",\"Add a Brain source\":\"Gedächtnisquelle hinzufügen\",\"Start workflow\":\"Arbeitsablauf starten\",\"Run input (optional)\":\"Ausführungseingabe (optional)\",\"Start run\":\"Ausführung starten\",\"Category\":\"Kategorie\",\"Pinned\":\"Angeheftet\",\"Content\":\"Inhalt\",\"Save memory\":\"Erinnerung speichern\",\"Save goal\":\"Ziel speichern\",\"Save workflow\":\"Arbeitsablauf speichern\",\"Add step\":\"Schritt hinzufügen\",\"New step\":\"Neuer Schritt\",\"Step\":\"Schritt\",\"Steps\":\"Schritte\",\"Schedule\":\"Zeitplan\",\"Trigger\":\"Auslöser\",\"Result\":\"Ergebnis\",\"Results\":\"Ergebnisse\",\"Input\":\"Eingabe\",\"Output\":\"Ausgabe\",\"Approval\":\"Genehmigung\",\"Approve\":\"Genehmigen\",\"Reject\":\"Ablehnen\",\"Deny\":\"Verweigern\",\"Allow once\":\"Einmal erlauben\",\"Always allow\":\"Immer erlauben\",\"Permissions\":\"Berechtigungen\",\"Run now\":\"Jetzt ausführen\",\"Test connection\":\"Verbindung testen\",\"Test action\":\"Aktion testen\",\"Use template\":\"Vorlage verwenden\",\"Search apps\":\"Apps suchen\",\"Search apps…\":\"Apps suchen…\",\"All apps\":\"Alle Apps\",\"Connected apps\":\"Verbundene Apps\",\"Reconnect\":\"Erneut verbinden\",\"Remove connection\":\"Verbindung entfernen\",\"View details\":\"Details ansehen\",\"Local-First\":\"Lokal bevorzugt\",\"🔊 Read\":\"🔊 Vorlesen\",\"⏹ Stop\":\"⏹ Stoppen\",\"📌 Remember\":\"📌 Merken\",\"📌 Remembered\":\"📌 Gemerkt\",\"Open result ↗\":\"Ergebnis öffnen ↗\",\"Quick syncing\":\"Schnellsynchronisierung\",\"Quick Sync\":\"Schnellsynchronisierung\",\"Quick sync\":\"Schnellsynchronisierung\",\"Node Details\":\"Knotendetails\",\"Node details\":\"Knotendetails\",\"Node Value\":\"Knotenwert\",\"Profit & Return\":\"Gewinn und Rendite\",\"Network Details\":\"Netzwerkdetails\",\"Koinos Network\":\"Koinos-Netzwerk\",\"Node status\":\"Knotenstatus\",\"Start node\":\"Knoten starten\",\"Stop node\":\"Knoten stoppen\",\"Producer wallet custody\":\"Verwahrung der Produzenten-Wallet\",\"External signing\":\"Externe Signatur\",\"Connect Koin Vault\":\"Koin Vault verbinden\",\"Connect KOIN Vault\":\"KOIN Vault verbinden\",\"Prepare transaction\":\"Transaktion vorbereiten\",\"Import signed transaction\":\"Signierte Transaktion importieren\",\"Broadcast\":\"Übertragen\",\"Copy unsigned JSON\":\"Unsigniertes JSON kopieren\",\"Download unsigned JSON\":\"Unsigniertes JSON herunterladen\",\"Paste signed JSON\":\"Signiertes JSON einfügen\",\"Registered\":\"Registriert\",\"Not registered\":\"Nicht registriert\",\"Register\":\"Registrieren\",\"Producer\":\"Produzent\",\"Block height\":\"Blockhöhe\",\"Local height\":\"Lokale Höhe\",\"Network height\":\"Netzwerkhöhe\",\"Progress\":\"Fortschritt\",\"Syncing\":\"Synchronisierung\",\"Synced\":\"Synchronisiert\",\"Healthy\":\"Funktionsfähig\",\"Unhealthy\":\"Fehlerhaft\",\"Services\":\"Dienste\",\"No services running.\":\"Keine Dienste laufen.\",\"Data folder\":\"Datenordner\",\"Open data folder\":\"Datenordner öffnen\",\"Change data folder\":\"Datenordner ändern\",\"Logs\":\"Protokolle\",\"View logs\":\"Protokolle anzeigen\",\"Copy logs\":\"Protokolle kopieren\",\"Rewards\":\"Belohnungen\",\"Reburn\":\"Erneut verbrennen\",\"Distribute\":\"Verteilen\",\"Distribution\":\"Verteilung\",\"Reinvest\":\"Reinvestieren\",\"Percentage\":\"Prozentsatz\",\"Last 24 hours\":\"Letzte 24 Stunden\",\"Last 7 days\":\"Letzte 7 Tage\",\"Last 30 days\":\"Letzte 30 Tage\",\"Mainnet\":\"Hauptnetz\",\"Testnet\":\"Testnetz\",\"Desktop\":\"Desktop\",\"Open Koinos AI\":\"Koinos AI öffnen\",\"Launch KAI companion\":\"KAI-Begleiter öffnen\",\"Hide KAI companion\":\"KAI-Begleiter ausblenden\",\"Quit Koinos AI\":\"Koinos AI beenden\",\"KAI · Your desktop companion\":\"KAI · Dein Desktop-Begleiter\",\"KAI desktop companion\":\"KAI-Desktop-Begleiter\",\"Talk with KAI\":\"Mit KAI sprechen\",\"DESKTOP COMPANION\":\"DESKTOP-BEGLEITER\",\"Connecting to your app…\":\"Verbindung mit deiner App…\",\"New conversation\":\"Neue Unterhaltung\",\"Keep KAI on the desktop\":\"KAI auf dem Desktop behalten\",\"Collapse conversation\":\"Unterhaltung einklappen\",\"Choose KAI's model\":\"KAIs Modell wählen\",\"Enable local listening for Hey KAI\":\"Lokales Zuhören für Hey KAI aktivieren\",\"Hey KAI off\":\"Hey KAI aus\",\"Voice & listening\":\"Stimme und Zuhören\",\"Voice and listening settings\":\"Stimm- und Zuhöreinstellungen\",\"A little voice. A lot of personality.\":\"Eine kleine Stimme. Viel Persönlichkeit.\",\"Close voice settings\":\"Stimmeinstellungen schließen\",\"KAI's voice\":\"KAIs Stimme\",\"Computer voice\":\"Computerstimme\",\"Pocket voices · English\":\"Pocket-Stimmen · Englisch\",\"One download, about 201 MB. Speech stays on your computer.\":\"Ein Download von etwa 201 MB. Die Sprachausgabe bleibt auf deinem Computer.\",\"Download Pocket voices\":\"Pocket-Stimmen herunterladen\",\"Try Azelma\":\"Azelma ausprobieren\",\"Voice credits\":\"Stimmnachweise\",\"Use fast Cute KAI\":\"Schnelles Cute KAI verwenden\",\"Refresh voices\":\"Stimmen aktualisieren\",\"Add Windows voices ↗\":\"Windows-Stimmen hinzufügen ↗\",\"Install speech voices in Windows Settings, then refresh this list. Available voices depend on your Windows installation.\":\"Installiere Stimmen in den Windows-Einstellungen und aktualisiere diese Liste. Die verfügbaren Stimmen hängen von deiner Windows-Installation ab.\",\"Voice character\":\"Stimmcharakter\",\"Cute KAI · bright & squeaky\":\"Cute KAI · hell und quietschend\",\"Classic KAI · deeper, softly robotic\":\"Classic KAI · tiefer, sanft robotisch\",\"Natural · original sound\":\"Natürlich · Originalklang\",\"Squeak\":\"Quietschend\",\"Playful\":\"Verspielt\",\"Voice squeak\":\"Quietschender Stimmklang\",\"Gentle\":\"Sanft\",\"Extra squeaky\":\"Sehr quietschend\",\"Reply timing\":\"Antwortzeitpunkt\",\"Quick start · first sentence\":\"Schnellstart · erster Satz\",\"Head start · two sentences\":\"Mit Vorlauf · zwei Sätze\",\"Whole reply · continuous playback\":\"Ganze Antwort · durchgehende Wiedergabe\",\"Hear a hello\":\"Begrüßung anhören\",\"Get natural voices\":\"Natürliche Stimmen herunterladen\",\"Try Cute KAI with Bella. Hear a hello instantly, then download the local voice once for conversations.\":\"Probiere Cute KAI mit Bella. Höre sofort eine Begrüßung und lade die lokale Stimme einmal für Gespräche herunter.\",\"Just say “Hey KAI”\":\"Sag einfach „Hey KAI“\",\"Tap the mic and talk, or turn on Hey KAI and say your question. KAI listens for a finished thought before sending. Keep talking after KAI answers—you have a minute for follow-ups.\":\"Tippe auf das Mikrofon und sprich, oder aktiviere Hey KAI und stelle deine Frage. KAI wartet vor dem Senden auf einen abgeschlossenen Gedanken. Nach der Antwort hast du eine Minute für weitere Fragen.\",\"Conversation pauses\":\"Gesprächspausen\",\"Quick · short pauses\":\"Schnell · kurze Pausen\",\"Natural · room to pause\":\"Natürlich · Raum für Pausen\",\"Patient · more time to think\":\"Geduldig · mehr Zeit zum Nachdenken\",\"KAI combines a quiet pause with local semantic turn detection, so a breath in the middle of a thought is less likely to cut you off. If it waits, keep talking or tap the mic to send now. Saying “KAI” during a reply still stops it as soon as the name is recognized.\":\"KAI kombiniert Pausen mit lokaler semantischer Erkennung, damit ein Atemzug dich nicht unterbricht. Wenn KAI wartet, sprich weiter oder tippe zum Senden auf das Mikrofon. „KAI“ während einer Antwort stoppt sie, sobald der Name erkannt wird.\",\"Microphone sensitivity\":\"Mikrofonempfindlichkeit\",\"TV nearby · less sensitive\":\"Fernseher in der Nähe · weniger empfindlich\",\"Everyday room · balanced\":\"Normaler Raum · ausgewogen\",\"Quiet room · more sensitive\":\"Ruhiger Raum · empfindlicher\",\"Microphone level\":\"Mikrofonpegel\",\"Microphone off\":\"Mikrofon aus\",\"Local speech detection starts with the microphone.\":\"Die lokale Spracherkennung beginnt mit dem Mikrofon.\",\"With the mic on, background sound should stay below the listening level and your voice should rise above it. Move closer or choose a more sensitive setting if KAI misses you.\":\"Bei aktivem Mikrofon sollte Hintergrundgeräusch unter und deine Stimme über der Hörschwelle liegen. Gehe näher heran oder erhöhe die Empfindlichkeit, falls KAI dich nicht erkennt.\",\"Say “KAI” to interrupt\":\"Sag „KAI“ zum Unterbrechen\",\"While KAI is answering, say “KAI” on its own or “KAI” followed by your new question. It stops when it recognizes the name. After the reply, just keep talking—follow-ups need no name.\":\"Während KAI antwortet, sag „KAI“ allein oder mit deiner neuen Frage. Die Antwort stoppt, wenn der Name erkannt wird. Nach der Antwort kannst du ohne Namensnennung weitersprechen.\",\"KAI does not identify your voice yet. Loud background dialogue can still sound like a question. The mic button always lets you stop a reply and ask directly.\":\"KAI erkennt deine Stimme noch nicht persönlich. Laute Hintergrundgespräche können wie Fragen wirken. Mit dem Mikrofonknopf kannst du die Antwort stoppen und direkt fragen.\",\"The chat can stay closed. Say “That’s all” to end the conversation, or “Stop listening” to turn the mic off. Audio stays on this computer; accepted questions go to your selected chat model. Hiding KAI turns the mic off.\":\"Der Chat kann geschlossen bleiben. Sage „That’s all“ zum Beenden oder „Stop listening“ zum Ausschalten des Mikrofons. Audio bleibt auf diesem Computer; akzeptierte Fragen gehen an das gewählte Modell. KAI auszublenden schaltet das Mikrofon aus.\",\"KAI Eyes settings\":\"KAI-Eyes-Einstellungen\",\"Let KAI see what you mean.\":\"Lass KAI sehen, was du meinst.\",\"Close KAI Eyes settings\":\"KAI-Eyes-Einstellungen schließen\",\"Screen and camera vision are session-only. KAI keeps six small frames in memory, attaches only the freshest view to a turn, and discards everything when you turn it off or hide KAI.\":\"Bildschirm- und Kamerasicht gelten nur für diese Sitzung. KAI hält sechs kleine Bilder im Speicher, hängt nur das neueste an eine Nachricht und verwirft alles beim Deaktivieren oder Ausblenden.\",\"Screen\":\"Bildschirm\",\"See the display KAI is sitting on\":\"Den Bildschirm sehen, auf dem KAI sitzt\",\"Camera\":\"Kamera\",\"See what you choose to show KAI\":\"Sehen, was du KAI zeigen möchtest\",\"Choose a vision-capable brain, then turn on a source.\":\"Wähle ein Modell mit Bildverarbeitung und aktiviere eine Quelle.\",\"A visible indicator stays on for the entire capture session. Frames never enter chat history or the Koinos Network. Local-Only still blocks private online models. Desktop clicks and typing remain a separate, per-task permission.\":\"Während der gesamten Aufnahme bleibt ein Hinweis sichtbar. Bilder gelangen nie in den Chatverlauf oder zu Koinos Network. Nur lokal blockiert weiterhin private Online-Modelle. Klicken und Tippen erfordern eine separate Erlaubnis pro Aufgabe.\",\"Conversation\":\"Unterhaltung\",\"A LITTLE ROBOT. A LOT OF HELP.\":\"EIN KLEINER ROBOTER. VIEL HILFE.\",\"Hey, I'm KAI\":\"Hallo, ich bin KAI\",\"Your app, a question away. Ask about your wallet, models, node, or the world outside.\":\"Deine App, nur eine Frage entfernt. Frage nach deiner Wallet, Modellen, deinem Knoten oder der Welt draußen.\",\"Check my KAI earnings\":\"Meine KAI-Einnahmen prüfen\",\"Explore my models\":\"Meine Modelle erkunden\",\"Open my Pictures folder\":\"Meinen Bilderordner öffnen\",\"Ask KAI anything…\":\"Frag KAI etwas…\",\"Talk to KAI\":\"Mit KAI sprechen\",\"Start voice input\":\"Spracheingabe starten\",\"Enter to send\":\"Enter zum Senden\",\"Stop response\":\"Antwort stoppen\",\"Send message\":\"Nachricht senden\",\"Read KAI's replies aloud\":\"KAIs Antworten vorlesen\",\"Voice replies off\":\"Sprachantworten aus\",\"Open full app\":\"Vollständige App öffnen\",\"Set up KAI's Pocket voice\":\"KAIs Pocket-Stimme einrichten\",\"Add KAI’s Pocket voice\":\"KAIs Pocket-Stimme hinzufügen\",\"Later\":\"Später\",\"Set up KAI's natural voice\":\"KAIs natürliche Stimme einrichten\",\"Meet KAI’s natural voice\":\"Lerne KAIs natürliche Stimme kennen\",\"Get natural voice\":\"Natürliche Stimme herunterladen\",\"Let KAI hear you\":\"Lass KAI dich hören\",\"Set up listening\":\"Zuhören einrichten\",\"Dismiss message\":\"Nachricht schließen\",\"KAI Eyes capture active\":\"KAI-Eyes-Aufnahme aktiv\",\"KAI Eyes is active · click to review\":\"KAI Eyes ist aktiv · zum Prüfen klicken\",\"Screen on\":\"Bildschirm an\",\"Here when you need me\":\"Hier, wenn du mich brauchst\",\"KAI. Click to chat, or drag to move.\":\"KAI. Klicken zum Chatten, ziehen zum Verschieben.\",\"Click to chat · Drag to move\":\"Klicken zum Chatten · Ziehen zum Verschieben\",\"Open chat\":\"Chat öffnen\",\"Open or minimize chat\":\"Chat öffnen oder minimieren\",\"Hey KAI listening off\":\"Hey-KAI-Zuhören aus\",\"Toggle Hey KAI listening\":\"Hey-KAI-Zuhören umschalten\",\"KAI options\":\"KAI-Optionen\",\"Say hello 👋\":\"Hallo sagen 👋\",\"Desktop control\":\"Desktop-Steuerung\",\"Animation on\":\"Animation an\",\"Open full app ↗\":\"Vollständige App öffnen ↗\",\"Hide KAI to tray\":\"KAI im Infobereich ausblenden\",\"Transaction ID copied (no explorer for this network)\":\"Transaktions-ID kopiert (kein Explorer für dieses Netzwerk)\",\"Producer data unavailable\":\"Produzentendaten nicht verfügbar\",\"💵 Profit & projected return\":\"💵 Gewinn und erwartete Rendite\",\"Koinos network\":\"Koinos-Netzwerk\",\"View block producers ↗\":\"Blockproduzenten ansehen ↗\",\"📡 Activity feed\":\"📡 Aktivität\",\"Can't reach the app\":\"App nicht erreichbar\",\"Active producers · ~24h\":\"Aktive Produzenten · ~24 Std.\",\"Produced within the last 28,800 blocks\":\"Produktion in den letzten 28.800 Blöcken\",\"Recent producers · 2h\":\"Kürzlich aktive Produzenten · 2 Std.\",\"Produced within 2 hours · green status\":\"Produktion in 2 Stunden · grüner Status\",\"Tracked producer accounts\":\"Erfasste Produzentenkonten\",\"Recent producers plus VHP holders\":\"Kürzlich aktive Produzenten und VHP-Inhaber\",\"Last known data · refresh unavailable\":\"Letzte bekannte Daten · Aktualisierung nicht verfügbar\",\"Mainnet only\":\"Nur Hauptnetz\",\"Counts unavailable · retrying…\":\"Zahlen nicht verfügbar · erneuter Versuch…\",\"Loading counts…\":\"Zahlen werden geladen…\",\"Stopping node\":\"Knoten wird gestoppt\",\"Node stopped\":\"Knoten gestoppt\",\"Quick sync in progress\":\"Schnellsynchronisierung läuft\",\"Needs attention\":\"Aufmerksamkeit erforderlich\",\"Docker not ready — finish setup on the Node tab\":\"Docker ist nicht bereit; Einrichtung im Knoten-Tab abschließen\",\"Set up node\":\"Knoten einrichten\",\"{0}{1} blocks\":\"{0}{1} Blöcke\",\"in sync\":\"synchronisiert\",\"syncing\":\"wird synchronisiert\",\"producing stake\":\"Einsatz für die Blockproduktion\",\"recharges over time\":\"lädt sich mit der Zeit auf\",\"Net worth\":\"Nettowert\",\"Blocks produced\":\"Produzierte Blöcke\",\"Total rewards\":\"Gesamtbelohnungen\",\"VHP consumed\":\"Verbrauchte VHP\",\"spent producing\":\"für Produktion verbraucht\",\"Profit\":\"Gewinn\",\"rewards − VHP spent\":\"Belohnungen minus verbrauchte VHP\",\"Total burned\":\"Insgesamt verbrannt\",\"Deposits in\":\"Eingegangene Einzahlungen\",\"at current rate\":\"bei aktueller Rate\",\"enable reburn to compound\":\"erneutes Verbrennen zum Aufzinsen aktivieren\",\"no reburn set\":\"erneutes Verbrennen nicht eingerichtet\",\"Daily profit\":\"Tagesgewinn\",\"Weekly profit\":\"Wochengewinn\",\"Monthly profit\":\"Monatsgewinn\",\"Yearly return\":\"Jahresrendite\",\"Yearly + reburn\":\"Jährlich mit Wiederanlage\",\"history syncing — longer windows still catching up\":\"Verlauf wird synchronisiert; längere Zeiträume werden noch nachgeladen\",\"Create a wallet (Wallet tab) to see activity.\":\"Erstelle eine Wallet im Wallet-Tab, um die Aktivität zu sehen.\",\"Activity history isn't available on {0} — it needs a history RPC (works on mainnet).\":\"Der Verlauf ist auf {0} nicht verfügbar; ein Verlaufs-RPC ist erforderlich (im Hauptnetz verfügbar).\",\"No activity yet. When your node produces a block, it appears here.\":\"Noch keine Aktivität. Von deinem Knoten produzierte Blöcke erscheinen hier.\",\"totals still syncing…\":\"Gesamtwerte werden synchronisiert…\",\"Block\":\"Block\",\"Deposit\":\"Einzahlung\",\"Burned → VHP\":\"Verbrannt → VHP\",\"Sent out\":\"Gesendet\",\"Node starting…\":\"Knoten wird gestartet…\",\"Stopping…\":\"Wird gestoppt…\",\"Stopping node…\":\"Knoten wird gestoppt…\",\"Welcome 👋\":\"Willkommen 👋\",\"Set up a Koinos wallet to get started. It takes a few seconds — your key is generated locally and encrypted with a password on this computer.\":\"Richte zuerst eine Koinos-Wallet ein. Das dauert nur Sekunden: Der Schlüssel wird lokal erzeugt und auf diesem Computer mit einem Passwort verschlüsselt.\",\"🆕 Create a new wallet\":\"🆕 Neue Wallet erstellen\",\"Password (min {0} characters)\":\"Passwort (mind. {0} Zeichen)\",\"Create wallet\":\"Wallet erstellen\",\"You'll be shown a private key backup right after — write it down and keep it safe.\":\"Danach wird der private Sicherungsschlüssel angezeigt: Notiere ihn und bewahre ihn sicher auf.\",\"📥 Import an existing wallet\":\"📥 Vorhandene Wallet importieren\",\"Private key (WIF)\":\"Privater Schlüssel (WIF)\",\"New password for this device\":\"Neues Passwort für dieses Gerät\",\"Import wallet\":\"Wallet importieren\",\"The key is encrypted with your password and stored only on this machine.\":\"Der Schlüssel wird mit deinem Passwort verschlüsselt und nur auf diesem Computer gespeichert.\",\"Unlock your wallet\":\"Deine Wallet entsperren\",\"Unlocking is required to burn, send, register the producer key, and for automatic reward returns.\":\"Entsperren ist zum Verbrennen, Senden, Registrieren des Produzentenschlüssels und zur automatischen Belohnungsrückführung erforderlich.\",\"Enter\":\"Eingeben\",\"🔒 Lock\":\"🔒 Sperren\",\"Your address — share it to receive {0} or VHP.\":\"Deine Adresse: Teile sie, um {0} oder VHP zu empfangen.\",\"{0} (liquid)\":\"{0} (liquide)\",\"spendable + fuels mana\":\"verfügbar und erzeugt Mana\",\"virtual hash power for block production\":\"virtuelle Hashleistung für die Blockproduktion\",\"recharges over time, spent by transactions\":\"lädt sich auf und wird für Transaktionen verbraucht\",\"⟠ Ethereum & USDT\":\"⟠ Ethereum und USDT\",\"funding wallet\":\"Finanzierungs-Wallet\",\"Your Ethereum funding address, derived from this same wallet key. Receive ETH or USDT here to fund the node, or send them back out.\":\"Deine Ethereum-Finanzierungsadresse wird vom selben Schlüssel abgeleitet. Empfange ETH oder USDT zur Finanzierung des Knotens oder sende sie weiter.\",\"Send only\":\"Sende ausschließlich\",\"ETH or USDT on Ethereum Mainnet\":\"ETH oder USDT im Ethereum-Hauptnetz\",\"to this address. Other networks/tokens may be lost.\":\"an diese Adresse. Andere Token oder Netzwerke können zum Verlust führen.\",\"Send ETH\":\"ETH senden\",\"Send USDT\":\"USDT senden\",\"Bridge→KOIN\":\"Brücke → KOIN\",\"Explorer ↗\":\"Explorer ↗\",\"Wallet locked\":\"Wallet gesperrt\",\"Address copied\":\"Adresse kopiert\",\"ETH address copied\":\"ETH-Adresse kopiert\",\"Recipient Ethereum address\":\"Ethereum-Empfängeradresse\",\"Amount (ETH)\":\"Betrag (ETH)\",\"Max\":\"Max.\",\"Enter a recipient and amount\":\"Empfänger und Betrag eingeben\",\"Sending…\":\"Wird gesendet…\",\"Getting quote…\":\"Kurs wird abgerufen…\",\"Not enough ETH for amount + gas (balance {0})\":\"Nicht genug ETH für Betrag und Gas (Guthaben {0})\",\"Not enough ETH (after gas)\":\"Nicht genug ETH nach Gas\",\"Amount (USDT)\":\"Betrag (USDT)\",\"Gas is paid in ETH — keep a little ETH in this address.\":\"Gas wird in ETH bezahlt; halte etwas ETH auf dieser Adresse bereit.\",\"Not enough USDT.\":\"Nicht genug USDT.\",\"Not enough ETH for gas.\":\"Nicht genug ETH für Gas.\",\"No USDT balance\":\"Kein USDT-Guthaben\",\"Send vKOIN\":\"vKOIN senden\",\"Amount (vKOIN)\":\"Betrag (vKOIN)\",\"Not enough vKOIN.\":\"Nicht genug vKOIN.\",\"No vKOIN balance\":\"Kein vKOIN-Guthaben\",\"Bridge vKOIN → KOIN\":\"Brücke vKOIN → KOIN\",\"native KOIN\":\"native KOIN\",\"Bridge to KOIN\":\"Brücke zu KOIN nutzen\",\"Enter a vKOIN amount\":\"vKOIN-Betrag eingeben\",\"Passwords don't match\":\"Die Passwörter stimmen nicht überein\",\"Creating…\":\"Wird erstellt…\",\"🔑 Back up your private key now\":\"🔑 Privaten Schlüssel jetzt sichern\",\"This is the only time it will be shown automatically. Anyone with this key controls the wallet — write it down and store it offline.\":\"Sie wird nur dieses eine Mal automatisch angezeigt. Wer diesen Schlüssel besitzt, kontrolliert die Wallet: Notiere ihn und bewahre ihn offline auf.\",\"Address:\":\"Adresse:\",\"Copy key\":\"Schlüssel kopieren\",\"I saved my key\":\"Ich habe meinen Schlüssel gesichert\",\"Importing…\":\"Wird importiert…\",\"Unlocking…\":\"Wird entsperrt…\",\"Wallet unlocked\":\"Wallet entsperrt\",\"Send tokens\":\"Token senden\",\"Token\":\"Token\",\"Recipient address\":\"Empfängeradresse\",\"Transfer\":\"Übertragen\",\"External producer mode: prepare and sign burns through Node → External signing. KAI will not use the earning wallet.\":\"Externer Produzent: Bereite Verbrennungen unter Knoten → Externe Signatur vor und signiere sie. KAI verwendet nicht die Verdienst-Wallet.\",\"Burn {0} → VHP\":\"{0} verbrennen → VHP\",\"Burning converts liquid {0} into Virtual Hash Power (VHP) — the stake that lets your node produce blocks and earn rewards.\":\"Verbrennen wandelt liquide {0} in virtuelle Hashleistung (VHP) um, den Einsatz, mit dem dein Knoten Blöcke produzieren und Belohnungen verdienen kann.\",\"Create a wallet first (Wallet tab).\":\"Erstelle zuerst eine Wallet im Wallet-Tab.\",\"Unlock your wallet to burn (Wallet tab).\":\"Entsperre zum Verbrennen deine Wallet im Wallet-Tab.\",\"Burning converts liquid {0} into VHP 1:1. VHP is consumed slowly while producing blocks, and you earn {1} rewards in return.\":\"Verbrennen wandelt liquide {0} im Verhältnis 1:1 in VHP um. VHP wird bei der Blockproduktion langsam verbraucht, dafür erhältst du Belohnungen in {1}.\",\"🔥 Burn\":\"🔥 Verbrennen\",\"Balance:\":\"Guthaben:\",\"Amount to burn ({0})\":\"Zu verbrennender Betrag ({0})\",\"You will receive: —\":\"Du erhältst: —\",\"Burn {0}\":\"{0} verbrennen\",\"ℹ️ How it works\":\"ℹ️ So funktioniert es\",\"Amount exceeds your balance.\":\"Der Betrag übersteigt dein Guthaben.\",\"Not enough mana to burn this much right now (about {0} {1} available). Burning spends mana, which recharges over ~5 days — burn less or wait.\":\"Nicht genug Mana für diesen Betrag (etwa {0} {1} verfügbar). Mana lädt sich in etwa 5 Tagen auf; verbrenne weniger oder warte.\",\"This leaves less than {0} {1} liquid. You need liquid {2} for mana to keep transacting.\":\"Es bleiben weniger als {0} {1} liquide. Du benötigst liquide {2} für Mana, um weiter Transaktionen auszuführen.\",\"Enter an amount to burn\":\"Zu verbrennenden Betrag eingeben\",\"Confirm burn\":\"Verbrennung bestätigen\",\"You are about to\":\"Du wirst jetzt\",\"permanently burn\":\"dauerhaft verbrennen\",\"and receive\":\"und erhalten\",\"VHP is only useful for producing blocks with a node. It converts back to {0} gradually through block rewards.\":\"VHP dient nur zur Blockproduktion mit einem Knoten. Es wird durch Blockbelohnungen allmählich wieder zu {0}.\",\"Burn\":\"Verbrennen\",\"Burning…\":\"Wird verbrannt…\",\"Waiting for your approval in Koin Vault…\":\"Warten auf deine Genehmigung in Koin Vault…\",\"Sending request to Koin Vault…\":\"Anfrage wird an Koin Vault gesendet…\",\"Wallet is submitting your transaction…\":\"Die Wallet übermittelt deine Transaktion…\",\"You rejected the request. Nothing was submitted by this request.\":\"Du hast die Anfrage abgelehnt. Durch sie wurde nichts übermittelt.\",\"Transaction verified on-chain. For registration, click Verify registration before starting the node.\":\"Transaktion auf der Blockchain geprüft. Klicke für die Registrierung vor dem Knotenstart auf Registrierung prüfen.\",\"Connected. Use this producer wallet, generate a hot key, then sign its registration below.\":\"Verbunden. Verwende diese Produzenten-Wallet, erzeuge einen aktiven Schlüssel und signiere unten seine Registrierung.\",\"Scan with Koin Vault → Connect App. This connection expires in 30 minutes.\":\"Scanne mit Koin Vault → Connect App. Diese Verbindung läuft nach 30 Minuten ab.\",\"Mainnet · No wallet connected.\":\"Hauptnetz · Keine Wallet verbunden.\",\"Koinos node\":\"Koinos-Knoten\",\"📁 Data folder\":\"📁 Datenordner\",\"⚡ Quick sync\":\"⚡ Schnellsynchronisierung\",\"Runs the official Koinos microservices with Docker. First start downloads images and syncs the chain — this can take a while.\":\"Betreibt die offiziellen Koinos-Mikrodienste mit Docker. Beim ersten Start werden Images heruntergeladen und die Blockchain synchronisiert; das kann dauern.\",\"Your KAI earning wallet stays separate from an external producer. Stop the node before changing custody or rotating its hot key.\":\"Deine KAI-Verdienst-Wallet bleibt vom externen Produzenten getrennt. Stoppe den Knoten, bevor du die Verwahrung änderst oder den aktiven Schlüssel wechselst.\",\"Wallet mode\":\"Wallet-Modus\",\"Local earning wallet (hot wallet)\":\"Lokale Verdienst-Wallet (Hot Wallet)\",\"External/cold producer wallet\":\"Externe/kalte Produzenten-Wallet\",\"Watch-only producer address\":\"Produzentenadresse nur beobachten\",\"Public Koinos address only — never a private key\":\"Nur öffentliche Koinos-Adresse; niemals ein privater Schlüssel\",\"Save custody mode\":\"Verwahrungsmodus speichern\",\"Generate hot key\":\"Aktiven Schlüssel erzeugen\",\"Rotate hot key…\":\"Aktiven Schlüssel wechseln…\",\"Verify registration\":\"Registrierung prüfen\",\"Hot block-production public key\":\"Öffentlicher aktiver Blockproduktionsschlüssel\",\"Block-production public key\":\"Öffentlicher Blockproduktionsschlüssel\",\"Generate a hot key to view its public key\":\"Erzeuge einen aktiven Schlüssel, um seinen öffentlichen Schlüssel zu sehen\",\"Copy public key\":\"Öffentlichen Schlüssel kopieren\",\"Connect your phone, use its wallet as your producer, then approve registration, burns and transfers with your fingerprint or device passkey. Your node keeps running after the phone disconnects.\":\"Verbinde dein Telefon, nutze seine Wallet als Produzent und bestätige Registrierungen, Verbrennungen und Übertragungen per Fingerabdruck oder Passkey. Der Knoten läuft nach dem Trennen des Telefons weiter.\",\"Use this producer wallet\":\"Diese Produzenten-Wallet verwenden\",\"Disconnect / cancel approval\":\"Trennen / Genehmigung abbrechen\",\"Scan with Koin Vault Connect App\":\"Mit Koin Vault Connect App scannen\",\"Open Koin Vault → Connect App → scan this QR and approve. Keep the wallet open for transaction requests.\":\"Öffne Koin Vault → Connect App, scanne diesen QR-Code und bestätige. Halte die Wallet für Transaktionsanfragen offen.\",\"Open Koin Vault\":\"Koin Vault öffnen\",\"Copy connection link\":\"Verbindungslink kopieren\",\"Operation\":\"Vorgang\",\"Register hot public key\":\"Öffentlichen aktiven Schlüssel registrieren\",\"Allow VHP for block production\":\"VHP für Blockproduktion freigeben\",\"Burn KOIN to this producer's VHP\":\"KOIN für VHP dieses Produzenten verbrennen\",\"Transfer tokens\":\"Token übertragen\",\"Use full VHP balance\":\"Gesamtes VHP-Guthaben verwenden\",\"Also allow my full VHP balance for production\":\"Auch mein gesamtes VHP-Guthaben zur Produktion freigeben\",\"Includes the new VHP. Both changes use one phone approval.\":\"Schließt die neuen VHP ein. Beide Änderungen benötigen eine Bestätigung am Telefon.\",\"Koinos address\":\"Koinos-Adresse\",\"For Koin Vault production, approve a VHP allowance after registering the hot key. Choose a limited amount up to your VHP balance, or 0 to revoke.\":\"Genehmige für Koin-Vault-Produktion nach der Schlüsselregistrierung ein VHP-Limit. Wähle einen Betrag bis zu deinem VHP-Guthaben oder 0 zum Widerrufen.\",\"Review and sign with Koin Vault\":\"Mit Koin Vault prüfen und signieren\",\"External signing: registration, burns and transfers\":\"Externe Signatur: Registrierungen, Verbrennungen und Übertragungen\",\"Open Kondor signer\":\"Kondor-Signierer öffnen\",\"Copy signer link\":\"Signiererlink kopieren\",\"Signing and backup guide\":\"Anleitung für Signatur und Sicherung\",\"Prepare and download the unsigned JSON here. On your secure computer, open https://koinosai.com/producer-signer/ in the browser with Kondor, load the file, review and sign. Bring the signed JSON back and import it below. Your private key stays in Kondor. The offline helper remains available in the guide. Drafts last 15 minutes by default. For dual boot, select the 24-hour window before preparing; after restarting KAI, use Resume saved draft.\":\"Bereite hier das unsignierte JSON vor und lade es herunter. Öffne auf dem sicheren Computer https://koinosai.com/producer-signer/ mit Kondor, lade die Datei, prüfe und signiere sie. Bringe das signierte JSON zurück und importiere es unten. Der private Schlüssel bleibt in Kondor. Die Anleitung enthält auch den Offline-Helfer. Entwürfe gelten 15 Minuten. Wähle für Dual-Boot vorher 24 Stunden; nutze nach dem Neustart Gespeicherten Entwurf fortsetzen.\",\"Amount (burn/transfer)\":\"Betrag (Verbrennung/Übertragung)\",\"Token (transfer)\":\"Token (Übertragung)\",\"Recipient (transfer)\":\"Empfänger (Übertragung)\",\"Dual-boot / offline signing — keep this draft for 24 hours\":\"Dual-Boot / Offline-Signatur: Entwurf 24 Stunden behalten\",\"Resume saved draft\":\"Gespeicherten Entwurf fortsetzen\",\"Prepare unsigned transaction\":\"Unsignierte Transaktion vorbereiten\",\"Unsigned transaction — take this file to the secure computer\":\"Unsignierte Transaktion: Diese Datei auf den sicheren Computer übertragen\",\"Import signed JSON\":\"Signiertes JSON importieren\",\"Signed transaction JSON returned by your external signer\":\"Vom externen Signierer zurückgegebenes signiertes Transaktions-JSON\",\"Paste signed transaction JSON only\":\"Nur signiertes Transaktions-JSON einfügen\",\"I reviewed the actual operations, recipient, amount and network on my signing machine.\":\"Ich habe die tatsächlichen Vorgänge, den Empfänger, Betrag und das Netzwerk auf meinem Signiercomputer geprüft.\",\"Broadcast signed transaction\":\"Signierte Transaktion übertragen\",\"Previous chain backups\":\"Frühere Blockchain-Sicherungen\",\"Manage backups\":\"Sicherungen verwalten\",\"Quick Sync keeps the previous chain data. After the restored node is working, remove old backups here to reclaim space.\":\"Die Schnellsynchronisierung behält die bisherigen Daten. Lösche alte Sicherungen hier, wenn der wiederhergestellte Knoten funktioniert, um Speicherplatz freizugeben.\",\"📡 Status\":\"📡 Status\",\"Recover after an unexpected stop\":\"Nach unerwartetem Stopp wiederherstellen\",\"— manual stops and quick sync keep the node stopped.\":\": Manuelle Stopps und Schnellsynchronisierung lassen den Knoten gestoppt.\",\"⛏️ Block production setup\":\"⛏️ Blockproduktion einrichten\",\"Register signing key\":\"Signierschlüssel registrieren\",\"📜 Logs\":\"📜 Protokolle\",\"all services\":\"alle Dienste\",\"Checking the signed transaction and submitting to the network…\":\"Signierte Transaktion wird geprüft und ans Netzwerk übermittelt…\",\"Custody saved. Automatic returns are off. Verify registration before starting production.\":\"Verwahrung gespeichert. Automatische Rückführungen sind deaktiviert. Prüfe die Registrierung vor der Produktion.\",\"Hot key ready. Back up private.key and public.key securely from:\":\"Aktiver Schlüssel bereit. Sichere private.key und public.key sicher aus:\",\"Rotate hot production key?\":\"Aktiven Produktionsschlüssel wechseln?\",\"Stop the node first. KAI will preserve a local backup of the old hot key. Register the new public key with your external wallet before restarting production.\":\"Stoppe zuerst den Knoten. KAI sichert den alten Schlüssel lokal. Registriere den neuen öffentlichen Schlüssel mit deiner externen Wallet, bevor du die Produktion neu startest.\",\"Rotate key\":\"Schlüssel wechseln\",\"Registration does not match yet. Sign and confirm the registration, then check again.\":\"Die Registrierung stimmt noch nicht überein. Signiere und bestätige sie und prüfe erneut.\",\"Koin Vault producer saved. Generate a hot key, then register it with Koin Vault below.\":\"Koin-Vault-Produzent gespeichert. Erzeuge einen aktiven Schlüssel und registriere ihn unten mit Koin Vault.\",\"Create a connection QR first.\":\"Erstelle zuerst einen Verbindungs-QR-Code.\",\"Click \\\"Use this producer wallet\\\" above first (stop the node if it is running), then generate a hot key before registering it.\":\"Klicke zuerst auf „Diese Produzenten-Wallet verwenden“ (stoppe einen laufenden Knoten), und erzeuge vor der Registrierung einen aktiven Schlüssel.\",\"Preparing review…\":\"Prüfung wird vorbereitet…\",\"Review the request in KAI, then click Request wallet approval to send it to your phone.\":\"Prüfe die Anfrage in KAI und klicke auf Wallet-Genehmigung anfordern, um sie ans Telefon zu senden.\",\"Set the official Proof-of-Burn contract's spending allowance to\":\"Ausgabenlimit des offiziellen Proof-of-Burn-Vertrags setzen auf\",\"This replaces the remaining allowance. Block production consumes it as VHP converts to KOIN rewards. Renew it when exhausted; set 0 to revoke it. No tokens move now. Your hot key gains no transfer permission.\":\"Dies ersetzt das verbleibende Limit. Die Produktion verbraucht es beim Umwandeln von VHP in KOIN. Erneuere es bei Verbrauch oder setze 0 zum Widerrufen. Jetzt werden keine Token bewegt. Dein aktiver Schlüssel erhält keine Übertragungsberechtigung.\",\"Register this node's hot public key:\":\"Öffentlichen aktiven Schlüssel dieses Knotens registrieren:\",\"Permanently burn\":\"Dauerhaft verbrennen\",\"for the same amount of VHP in your producer wallet.\":\"für denselben VHP-Betrag in deiner Produzenten-Wallet.\",\"Also set the official PoB production allowance to\":\"Auch das offizielle PoB-Produktionslimit setzen auf\",\": current VHP plus this burn. Both changes succeed together. This replaces the remaining allowance; later deposits need a new approval.\":\": aktuelle VHP plus diese Verbrennung. Beide Änderungen erfolgen gemeinsam. Das verbleibende Limit wird ersetzt; spätere Einzahlungen benötigen eine neue Genehmigung.\",\"to:\":\"an:\",\"Review Koin Vault request\":\"Koin-Vault-Anfrage prüfen\",\"Mainnet · Producer:\":\"Hauptnetz · Produzent:\",\"Next, review the same details in Koin Vault and approve with your fingerprint or device passkey. Wallet approval submits the transaction.\":\"Prüfe dieselben Angaben in Koin Vault und bestätige per Fingerabdruck oder Passkey. Die Bestätigung in der Wallet übermittelt die Transaktion.\",\"Request wallet approval\":\"Wallet-Genehmigung anfordern\",\"Prepared only — nothing signed or broadcast. Review decoded operations on your separate signing machine.\":\"Nur vorbereitet: Nichts wurde signiert oder übertragen. Prüfe die dekodierten Vorgänge auf deinem separaten Signiercomputer.\",\"Prepare a transaction first.\":\"Bereite zuerst eine Transaktion vor.\",\"Invalid mana\":\"Ungültiges Mana\",\"Choose or paste a valid signed transaction JSON file.\":\"Wähle eine gültige signierte Transaktions-JSON-Datei oder füge sie ein.\",\"Choose a signed JSON file smaller than 100 KB.\":\"Wähle eine signierte JSON-Datei unter 100 KB.\",\"External transaction\":\"Externe Transaktion\",\"The app will keep your node running automatically.\":\"Die App hält deinen Knoten automatisch am Laufen.\",\"Automatic restart is off — you'll restart the node yourself.\":\"Automatischer Neustart ist deaktiviert; du startest den Knoten selbst neu.\",\"Measuring backups…\":\"Sicherungsgrößen werden ermittelt…\",\"Delete backup\":\"Sicherung löschen\",\"Size unavailable\":\"Größe nicht verfügbar\",\"No previous chain backups.\":\"Keine früheren Blockchain-Sicherungen.\",\"Delete previous chain backup?\":\"Frühere Blockchain-Sicherung löschen?\",\"This permanently deletes {0}. Confirm the restored node is working before removing your rollback copy. Active chain data, wallets and keys are kept.\":\"Dies löscht {0} dauerhaft. Prüfe, ob der wiederhergestellte Knoten funktioniert, bevor du die Rückfallkopie entfernst. Aktive Blockchain-Daten, Wallets und Schlüssel bleiben erhalten.\",\"⚡ Quick sync from official backup\":\"⚡ Schnellsynchronisierung aus offizieller Sicherung\",\"Downloads the Koinos Foundation chain snapshot and installs it, so the node catches up in hours instead of syncing for days. Your wallet, node config, and peer identity are not touched; current chain data is set aside for rollback.\":\"Lädt den Blockchain-Snapshot der Koinos Foundation herunter und installiert ihn, damit der Knoten in Stunden statt Tagen aufholt. Wallet, Konfiguration und Knotenidentität bleiben unverändert; bisherige Daten werden für eine Rückkehr gesichert.\",\"Snapshot size\":\"Snapshot-Größe\",\"{0} (compressed)\":\"{0} (komprimiert)\",\"Snapshot date\":\"Snapshot-Datum\",\"Free disk space\":\"Freier Speicherplatz\",\"{0} (needs ~{1} during restore)\":\"{0} (benötigt ~{1} während der Wiederherstellung)\",\"The download is verified against the published SHA-256 and the archive layout is checked before anything is installed. You can cancel at any time and resume later.\":\"Der Download wird mit dem veröffentlichten SHA-256 geprüft und das Archiv vor der Installation überprüft. Du kannst jederzeit abbrechen und später fortsetzen.\",\"Resumable\":\"Fortsetzbar\",\"{0} already downloaded\":\"{0} bereits heruntergeladen\",\"Free space looks below the recommended headroom — the restore may fail mid-way. Free up disk first if possible.\":\"Der freie Speicher scheint unter der empfohlenen Reserve zu liegen; die Wiederherstellung könnte abbrechen. Schaffe möglichst vorher Platz.\",\"The node is running — it will be stopped before the restore and can be started again right after.\":\"Der Knoten läuft. Er wird vor der Wiederherstellung gestoppt und kann danach wieder gestartet werden.\",\"Start quick sync\":\"Schnellsynchronisierung starten\",\"Quick sync started — progress shows on this page\":\"Schnellsynchronisierung gestartet; Fortschritt wird hier angezeigt\",\"Start Koinos node\":\"Koinos-Knoten starten\",\"Enable block production (uses producer address\":\"Blockproduktion aktivieren (verwendet die Adresse\",\"as producer)\":\"als Produzent)\",\"The node runs in Docker in the background and keeps running even if you close this app. First sync downloads the whole chain.\":\"Der Knoten läuft im Hintergrund in Docker und bleibt auch beim Schließen der App aktiv. Die erste Synchronisierung lädt die gesamte Blockchain.\",\"not configured\":\"nicht konfiguriert\",\"Node starting — pulling images and launching services…\":\"Knotenstart: Images werden geladen und Dienste gestartet…\",\"Registering…\":\"Wird registriert…\",\"Producer key registration\":\"Registrierung des Produzentenschlüssels\",\"(no output)\":\"(keine Ausgabe)\",\"Docker isn't available.\":\"Docker ist nicht verfügbar.\",\"Docker install guide ↗\":\"Docker-Installationsanleitung ↗\",\"Downloading Docker Desktop{0}\":\"Docker Desktop wird heruntergeladen{0}\",\"🧰 Set up requirements\":\"🧰 Voraussetzungen einrichten\",\"one time · {0}\":\"einmalig · {0}\",\"Re-check\":\"Erneut prüfen\",\"Download cancelled\":\"Download abgebrochen\",\"Restart Windows?\":\"Windows neu starten?\",\"Windows needs to restart to finish enabling WSL 2. This will restart your computer in 60 seconds — save any open work first. You can cancel during the countdown.\":\"Windows muss zum Aktivieren von WSL 2 neu starten. Der Computer startet in 60 Sekunden neu; speichere deine Arbeit. Während des Countdowns kannst du abbrechen.\",\"Not now\":\"Jetzt nicht\",\"Restart in 60s\":\"In 60 Sek. neu starten\",\"Windows will restart in 60 seconds.\":\"Windows startet in 60 Sekunden neu.\",\"Restart cancelled\":\"Neustart abgebrochen\",\"Preparing snapshot restore\":\"Wiederherstellung wird vorbereitet\",\"Downloading snapshot\":\"Snapshot wird heruntergeladen\",\"Verifying checksum\":\"Prüfsumme wird geprüft\",\"Inspecting archive\":\"Archiv wird geprüft\",\"Extracting chain data\":\"Blockchain-Daten werden entpackt\",\"Installing chain data\":\"Blockchain-Daten werden installiert\",\"Cleaning up\":\"Wird aufgeräumt\",\"Restore complete\":\"Wiederherstellung abgeschlossen\",\"Restoring chain data\":\"Blockchain-Daten werden wiederhergestellt\",\"Quick sync:\":\"Schnellsynchronisierung:\",\"Cancelling quick sync — the download can be resumed later\":\"Schnellsynchronisierung wird abgebrochen; Download später fortsetzbar\",\"in progress…\":\"läuft…\",\"{0} failed:\":\"{0} fehlgeschlagen:\",\"stopping for quick sync\":\"Stopp für Schnellsynchronisierung\",\"stopped · quick syncing\":\"gestoppt · Schnellsynchronisierung\",\"needs attention\":\"Aufmerksamkeit erforderlich\",\"(recovered {0}× recently)\":\"(kürzlich {0}-mal wiederhergestellt)\",\"{0} Automatic recovery will not restart it during quick sync. Start the node after the restore finishes.\":\"{0} Die automatische Wiederherstellung startet ihn während der Schnellsynchronisierung nicht neu. Starte den Knoten danach.\",\"The node is stopping for a snapshot restore.\":\"Der Knoten wird zur Snapshot-Wiederherstellung gestoppt.\",\"The node is stopped while quick sync restores the chain data. Block production is paused.\":\"Der Knoten ist während der Datenwiederherstellung gestoppt. Die Blockproduktion ist pausiert.\",\"Chain validation failed — block production is not healthy.\":\"Blockchain-Validierung fehlgeschlagen; Blockproduktion ist nicht funktionsfähig.\",\"🔧 Repair node data\":\"🔧 Knotendaten reparieren\",\"Block submissions rejected: could not burn VHP.\":\"Blöcke abgelehnt: VHP konnte nicht verbrannt werden.\",\"Last observed block submission was rejected.\":\"Die letzte beobachtete Blockübermittlung wurde abgelehnt.\",\"Open block_producer logs for the failure details. Running services and a registered key do not guarantee accepted blocks.\":\"Öffne die block_producer-Protokolle für Details. Laufende Dienste und ein registrierter Schlüssel garantieren keine akzeptierten Blöcke.\",\"Getting your node back up — this takes a minute. You don't need to do anything.\":\"Dein Knoten wird wiederhergestellt; das dauert etwa eine Minute. Du musst nichts tun.\",\"The node is not confirmed healthy ({0}). Block production may be interrupted. Check the chain logs{1}.\":\"Die Funktionsfähigkeit des Knotens ist nicht bestätigt ({0}). Die Produktion kann unterbrochen sein. Prüfe die Protokolle{1}.\",\"status unavailable\":\"Status nicht verfügbar\",\"; automatic recovery is enabled\":\"; automatische Wiederherstellung aktiviert\",\"; automatic recovery is off\":\"; automatische Wiederherstellung deaktiviert\",\"✓ Your node is running and healthy.{0}\":\"✓ Dein Knoten läuft und ist funktionsfähig.{0}\",\"Start the node to sync the chain.\":\"Starte den Knoten zum Synchronisieren der Blockchain.\",\"Waiting for local RPC… (services may still be starting)\":\"Warten auf lokalen RPC… (Dienste starten möglicherweise noch)\",\"Head block time: {0}\":\"Zeit des neuesten Blocks: {0}\",\"Producer address configured\":\"Produzentenadresse eingerichtet\",\"Choose a local or external producer address above.\":\"Wähle oben eine lokale oder externe Produzentenadresse.\",\"VHP staked at your address\":\"VHP auf deiner Adresse eingesetzt\",\"Checking your VHP… no need to unlock — it's read from your public address.\":\"Dein VHP wird geprüft; kein Entsperren nötig, die öffentliche Adresse genügt.\",\"Node stopping for quick sync\":\"Knoten wird für Schnellsynchronisierung gestoppt\",\"Node stopped for quick sync\":\"Knoten für Schnellsynchronisierung gestoppt\",\"Node running\":\"Knoten läuft\",\"Wait for the restore to finish, then start the node.\":\"Warte auf das Ende der Wiederherstellung und starte dann den Knoten.\",\"Start the node above.\":\"Starte den Knoten oben.\",\"Signing key generated\":\"Signierschlüssel erzeugt\",\"Generated automatically by the node on first start.\":\"Wird beim ersten Start automatisch vom Knoten erzeugt.\",\"Signing key registered on chain\":\"Signierschlüssel auf der Blockchain registriert\",\"Register it with the button below (needs unlocked wallet + mana).\":\"Registriere sie mit dem Knopf unten (entsperrte Wallet und Mana erforderlich).\",\"Last observed block submission failed\":\"Letzter beobachteter Blockversuch fehlgeschlagen\",\"VHP burn rejected. Approve a production allowance in Koin Vault; registration alone does not confirm successful production.\":\"VHP-Verbrennung abgelehnt. Genehmige ein Produktionslimit in Koin Vault; Registrierung allein bestätigt keine erfolgreiche Produktion.\",\"Check block_producer logs for the rejection reason.\":\"Prüfe die block_producer-Protokolle auf den Ablehnungsgrund.\",\"External producer registration verified. The node holds only its hot production key.\":\"Registrierung des externen Produzenten geprüft. Der Knoten hält nur seinen aktiven Produktionsschlüssel.\",\"Use External signing above to register this hot key with your separate wallet.\":\"Nutze oben Externe Signatur, um diesen Schlüssel mit deiner separaten Wallet zu registrieren.\",\"Signing key registered on chain.\":\"Signierschlüssel auf der Blockchain registriert.\",\"⚠️ A different key is registered on chain for this address. Register the current node key to replace it.\":\"⚠️ Für diese Adresse ist ein anderer Schlüssel registriert. Registriere den aktuellen Knotenschlüssel, um ihn zu ersetzen.\",\"The signing key appears after the node's first start.\":\"Der Signierschlüssel erscheint nach dem ersten Start des Knotens.\",\"Unlock your wallet to register.\":\"Entsperre deine Wallet zum Registrieren.\",\"Block production is paused for quick sync.\":\"Die Blockproduktion ist wegen Schnellsynchronisierung pausiert.\",\"The node is stopped; no blocks are being produced here.\":\"Der Knoten ist gestoppt; hier werden keine Blöcke produziert.\",\"Production also requires an in-sync node with block production enabled.\":\"Produktion erfordert auch einen synchronisierten Knoten mit aktivierter Blockproduktion.\",\"Resume\":\"Fortsetzen\",\"Continue?\":\"Fortfahren?\",\"Enter a recipient address\":\"Empfängeradresse eingeben\",\"Enter an amount to send\":\"Zu sendenden Betrag eingeben\",\"Send real ETH?\":\"Echte ETH senden?\",\"on Ethereum Mainnet. This is irreversible. Continue?\":\"im Ethereum-Hauptnetz. Dies ist unumkehrbar. Fortfahren?\",\"Send it\":\"Senden\",\"Sent ✓\":\"Gesendet ✓\",\"Preparing…\":\"Wird vorbereitet…\",\"Endpoint saved\":\"Endpunkt gespeichert\",\"Automatic burns and transfers are disabled for your external producer. Use Node → External signing for each funds operation.\":\"Automatische Verbrennungen und Übertragungen sind für den externen Produzenten deaktiviert. Nutze Knoten → Externe Signatur für jeden Geldvorgang.\",\"⚙️ Configuration\":\"⚙️ Konfiguration\",\"Enable automatic returns\":\"Automatische Rückführung aktivieren\",\"Return percentage:\":\"Rückführungsanteil:\",\"of new rewards\":\"der neuen Belohnungen\",\"What to do with returned {0}\":\"Verwendung der zurückgeführten {0}\",\"♻️ Compound — burn back into VHP (keeps node producing)\":\"♻️ Wiederanlegen: In VHP verbrennen, um weiter zu produzieren\",\"📤 Send to another address\":\"📤 An eine andere Adresse senden\",\"Send returns to\":\"Rückführungen senden an\",\"Only required when the destination changes\":\"Nur bei Änderung des Ziels erforderlich\",\"Minimum return ({0})\":\"Mindest-Rückführung ({0})\",\"Max per return ({0})\":\"Maximum je Rückführung ({0})\",\"0 = no limit\":\"0 = unbegrenzt\",\"Check every (minutes)\":\"Prüfintervall (Minuten)\",\"Check now\":\"Jetzt prüfen\",\"Max per return\":\"Maximum je Rückführung\",\"📊 Status\":\"📊 Status\",\"🧾 Return history\":\"🧾 Rückführungsverlauf\",\"When\":\"Wann\",\"Returned\":\"Zurückgeführt\",\"Mode\":\"Modus\",\"Return settings saved\":\"Rückführungseinstellungen gespeichert\",\"no wallet\":\"keine Wallet\",\"wallet locked\":\"Wallet gesperrt\",\"RPC error\":\"RPC-Fehler\",\"no history RPC\":\"kein Verlaufs-RPC\",\"reading history…\":\"Verlauf wird gelesen…\",\"tracking started\":\"Erfassung gestartet\",\"low liquid KOIN\":\"wenig liquide KOIN\",\"waiting for mana\":\"warten auf Mana\",\"tx failed\":\"Transaktion fehlgeschlagen\",\"config error\":\"Konfigurationsfehler\",\"no checks yet\":\"noch keine Prüfungen\",\"Engine\":\"Engine\",\"Last check\":\"Letzte Prüfung\",\"Next automatic check\":\"Nächste automatische Prüfung\",\"Lifetime rewards\":\"Gesamtbelohnungen\",\"(Dashboard)\":\"(Übersicht)\",\"Rewards since enabled\":\"Belohnungen seit Aktivierung\",\"Pending return\":\"Ausstehende Rückführung\",\"No returns yet.\":\"Noch keine Rückführungen.\",\"Network, RPC and wallet management.\":\"Netzwerk-, RPC- und Wallet-Verwaltung.\",\"🌐 Network\":\"🌐 Netzwerk\",\"🔌 Custom RPC (optional)\":\"🔌 Eigener RPC (optional)\",\"Save settings\":\"Einstellungen speichern\",\"🔐 Wallet security\":\"🔐 Wallet-Sicherheit\",\"Reveal private key\":\"Privaten Schlüssel anzeigen\",\"Remove wallet from this device\":\"Wallet von diesem Gerät entfernen\",\"Files live in\":\"Dateien befinden sich in\",\"open ↗\":\"öffnen ↗\",\"local node RPC\":\"RPC des lokalen Knotens\",\"{0} RPC URL\":\"{0}-RPC-URL\",\"Settings saved\":\"Einstellungen gespeichert\",\"No wallet on this device\":\"Keine Wallet auf diesem Gerät\",\"Enter your password. Never share this key or enter it on websites.\":\"Gib dein Passwort ein. Teile diesen Schlüssel niemals und gib ihn nicht auf Websites ein.\",\"⚠️ Remove wallet\":\"⚠️ Wallet entfernen\",\"This deletes the encrypted key file from this device.\":\"Dies löscht die verschlüsselte Schlüsseldatei von diesem Gerät.\",\"Without a backup of the private key, the funds are lost forever.\":\"Ohne Sicherung des privaten Schlüssels sind die Guthaben für immer verloren.\",\"to confirm\":\"zum Bestätigen\",\"Remove wallet\":\"Wallet entfernen\",\"Wallet removed from this device\":\"Wallet von diesem Gerät entfernt\",\"Failed to start UI: {0}\":\"Oberfläche konnte nicht gestartet werden: {0}\",\"This machine\":\"Dieser Computer\",\"{0} — the desktop updater isn't available in this copy.\":\"{0} — die Aktualisierungsfunktion ist in dieser Kopie nicht verfügbar.\",\"{0} — couldn't contact the desktop updater. Restart the app and try again.\":\"{0} — der Aktualisierungsdienst ist nicht erreichbar. Starte die App neu und versuche es erneut.\",\"{0} — up to date. Checked just now.\":\"{0} — auf dem neuesten Stand. Gerade geprüft.\",\"Koinos AI {0} is available — downloading it now. You'll be asked before restarting.\":\"Koinos AI {0} ist verfügbar und wird heruntergeladen. Vor dem Neustart wirst du gefragt.\",\"Koinos AI {0} is ready and will install when you close the app.\":\"Koinos AI {0} ist bereit und wird beim Schließen der App installiert.\",\"Koinos AI {0} is available and ready to download.\":\"Koinos AI {0} ist zum Herunterladen verfügbar.\",\"{0} — updates install themselves.\":\"{0} — Updates werden automatisch installiert.\",\"{0} — up to date ({1}), installed from source.\":\"{0} — auf dem neuesten Stand ({1}), aus dem Quellcode installiert.\",\"{0} — installed from source, {1}. {2}\":\"{0} — aus dem Quellcode installiert, {1}. {2}\",\"Open wallet\":\"Wallet öffnen\",\"Set up wallet\":\"Wallet einrichten\",\"Wallet balance unavailable\":\"Wallet-Guthaben nicht verfügbar\",\"Testnet balance has no USD value\":\"Testnetz-Guthaben hat keinen USD-Wert\",\"KOIN price is out of date\":\"Der KOIN-Preis ist veraltet\",\"KOIN price unavailable\":\"KOIN-Preis nicht verfügbar\",\"Estimated wallet value in USD\":\"Geschätzter Wallet-Wert in USD\",\"KOIN\":\"KOIN\",\"KOIN · Earnings & wallet\":\"KOIN · Einnahmen und Wallet\",\"Contribute AI capacity, track network rewards and manage your KOIN wallet.\":\"Stelle KI-Kapazität bereit, verfolge Netzwerkvergütungen und verwalte dein KOIN-Wallet.\",\"KOIN rewards are in preparation\":\"KOIN-Vergütungen werden vorbereitet\",\"This Test build measures availability without paying KOIN rewards. Purchases and claims will open after contract verification. Your existing mainnet wallet remains available below.\":\"Diese Test-Version misst die Verfügbarkeit, zahlt aber noch keine KOIN-Vergütungen aus. Käufe und Auszahlungen werden nach der Vertragsprüfung freigeschaltet. Dein Mainnet-Wallet bleibt unten verfügbar.\",\"Launch policy: up to 5% of the free reward pool per day; 70% for verified availability and 30% for paid work. Unused rewards remain in the pool.\":\"Startregeln: täglich bis zu 5 % des freien Vergütungspools; 70 % für geprüfte Verfügbarkeit und 30 % für bezahlte Arbeit. Nicht genutzte Vergütungen bleiben im Pool.\",\"AI usage credits\":\"Guthaben für KI-Nutzung\",\"Credits will be prepaid with KOIN. Unused funds stay reserved; only consumed usage is split: 60% to rewards, 25% to mining and 15% to operations.\":\"Guthaben wird mit KOIN vorausbezahlt. Ungenutzte Mittel bleiben reserviert; nur verbrauchte Nutzung wird aufgeteilt: 60 % für Vergütungen, 25 % für Mining und 15 % für den Betrieb.\",\"Purchases not active\":\"Käufe noch nicht aktiv\",\"Claims not active\":\"Auszahlungen noch nicht aktiv\",\"Legacy test KAI\":\"Bisheriges Test-KAI\",\"Historical test balances are separate from KOIN. No conversion or distribution has been applied.\":\"Bisherige Testguthaben sind von KOIN getrennt. Es wurde keine Umwandlung oder Verteilung durchgeführt.\",\"Available to claim\":\"Zur Auszahlung verfügbar\",\"Usage credits\":\"Nutzungsguthaben\",\"Not active\":\"Noch nicht aktiv\",\"Availability estimate (simulation)\":\"Verfügbarkeitsschätzung (Simulation)\",\"Paid-work estimate (simulation)\":\"Schätzung für bezahlte Arbeit (Simulation)\",\"Awaiting verified data\":\"Warten auf geprüfte Daten\",\"Capacity status\":\"Kapazitätsstatus\",\"Verified for shadow scoring\":\"Für simulierte Bewertung geprüft\",\"Awaiting capacity verification\":\"Warten auf Kapazitätsprüfung\",\"Local-Only mode\":\"Nur-lokal-Modus\",\"No capacity report\":\"Kein Kapazitätsbericht\",\"Awaiting master integration\":\"Warten auf die Integration des Master-Knotens\",\"Legacy test KAI balance\":\"Bisheriges Test-KAI-Guthaben\",\"Legacy prepaid balance\":\"Bisheriges vorausbezahltes Guthaben\",\"Legacy epoch\":\"Bisherige Epoche\",\"Online — serving{0}\":\"Online — im Einsatz{0}\",\"Preview a spending review\":\"Vorschau einer Ausgabenprüfung\",\"See the model, maximum request cost and session limits before reviewing an example. Prices are illustrative; paid requests are not active.\":\"Sieh dir Modell, maximale Anfragekosten und Sitzungslimits anhand eines Beispiels an. Die Preise dienen nur der Veranschaulichung; kostenpflichtige Anfragen sind nicht aktiv.\",\"Preview review\":\"Prüfung als Beispiel ansehen\",\"Review the example in the desktop dialog.\":\"Prüfe das Beispiel im Dialog der Desktop-App.\",\"Example reviewed. No request was signed or sent.\":\"Beispiel geprüft. Es wurde keine Anfrage signiert oder gesendet.\",\"Preview cancelled. No KOIN was spent.\":\"Vorschau abgebrochen. Es wurde kein KOIN ausgegeben.\",\"Preview unavailable. Please try again.\":\"Vorschau nicht verfügbar. Bitte erneut versuchen.\",\"Example prices only. No KOIN will be spent.\":\"Nur Beispielpreise. Es wird kein KOIN ausgegeben.\",\"Simulation only. No KOIN will be spent.\":\"Nur eine Simulation. Es wird kein KOIN ausgegeben.\",\"Tariff version\":\"Tarifversion\",\"Input tokens\":\"Eingabetokens\",\"Maximum output tokens\":\"Maximale Ausgabetokens\",\"Maximum request cost\":\"Maximale Anfragekosten\",\"Per-request limit\":\"Limit pro Anfrage\",\"Session available\":\"Verfügbares Sitzungsguthaben\",\"Session total limit\":\"Gesamtlimit der Sitzung\",\"Requests remaining\":\"Verbleibende Anfragen\",\"Review expires (UTC)\":\"Prüfung gültig bis (UTC)\",\"Session\":\"Sitzung\",\"Quote\":\"Angebot\",\"Reviewing does not sign or submit a request.\":\"Bei der Prüfung wird keine Anfrage signiert oder gesendet.\",\"KOIN · Review preview\":\"KOIN · Prüfungsvorschau\",\"Review one simulated request\":\"Eine simulierte Anfrage prüfen\",\"Mark example reviewed\":\"Beispiel als geprüft markieren\",\"KOIN session rehearsal\":\"KOIN-Sitzungstest\",\"Approve a bounded session once. This developer rehearsal does not enable paid chat or move KOIN.\":\"Genehmigen Sie einmal eine begrenzte Sitzung. Dieser Entwicklertest aktiviert keinen kostenpflichtigen Chat und bewegt keine KOIN.\",\"Review session limits\":\"Sitzungslimits prüfen\",\"Retry saved approval\":\"Gespeicherte Genehmigung erneut versuchen\",\"Refresh session\":\"Sitzung aktualisieren\",\"Revoke session approval\":\"Sitzungsgenehmigung widerrufen\",\"Stop new requests for this session?\":\"Neue Anfragen für diese Sitzung stoppen?\",\"Dispatched work stays reserved. This does not refund on-chain credits.\":\"Zugewiesene Arbeit bleibt reserviert. Dies erstattet keine Guthaben auf der Blockchain.\",\"Approve one bounded rehearsal session\":\"Eine begrenzte Testsitzung genehmigen\",\"This signs a session approval for accounting tests. No KOIN will be spent.\":\"Dies signiert eine Sitzungsgenehmigung für Abrechnungstests. Es werden keine KOIN ausgegeben.\",\"Maximum requests\":\"Maximale Anfragen\",\"Session expires (UTC)\":\"Sitzung läuft ab (UTC)\",\"Spending grant\":\"Ausgabeberechtigung\",\"Credits contract\":\"Guthabenvertrag\",\"Contract bytecode\":\"Vertragsbytecode\",\"Tariff policy\":\"Tarifrichtlinie\",\"Requests within these limits reuse this approval. Revoking it stops new requests.\":\"Anfragen innerhalb dieser Grenzen nutzen diese Genehmigung. Ein Widerruf stoppt neue Anfragen.\",\"Live payments require a separate authorization and are not enabled by this signature.\":\"Echte Zahlungen erfordern eine separate Genehmigung und werden durch diese Signatur nicht aktiviert.\",\"Approve session rehearsal\":\"Sitzungstest genehmigen\",\"No session approval saved. Review the limits to begin.\":\"Keine Sitzungsgenehmigung gespeichert. Prüfen Sie die Limits, um zu beginnen.\",\"Session approved for accounting rehearsal. Paid chat remains disabled.\":\"Sitzung für Abrechnungstests genehmigt. Kostenpflichtiger Chat bleibt deaktiviert.\",\"Session approval revoked. Dispatched work stays reserved.\":\"Sitzungsgenehmigung widerrufen. Zugewiesene Arbeit bleibt reserviert.\",\"Session approval expired.\":\"Sitzungsgenehmigung abgelaufen.\",\"Session action cancelled.\":\"Sitzungsaktion abgebrochen.\",\"The session result is uncertain. Refresh or retry the saved approval.\":\"Das Sitzungsergebnis ist ungewiss. Aktualisieren Sie oder versuchen Sie die gespeicherte Genehmigung erneut.\",\"The account grant is unavailable. New requests are blocked.\":\"Die Kontoberechtigung ist nicht verfügbar. Neue Anfragen sind gesperrt.\",\"Session accounting needs reconciliation. New requests are blocked.\":\"Die Sitzungsabrechnung muss abgeglichen werden. Neue Anfragen sind gesperrt.\",\"Session rehearsal unavailable. Retry the saved approval if a response was lost.\":\"Sitzungstest nicht verfügbar. Versuchen Sie bei einer verlorenen Antwort die gespeicherte Genehmigung erneut.\",\"Input price per 1M tokens\":\"Eingabepreis pro 1 Mio. Tokens\",\"Output price per 1M tokens\":\"Ausgabepreis pro 1 Mio. Tokens\"}}; })(typeof window === \"object\" ? window : globalThis);\n","plugin-shell.css":"/* Only the surrounding application shell changes: the original workspace fills its own plugin window. */\nhtml,body,#plugin-workspace{height:100%;min-height:0;width:100%;overflow:hidden}#plugin-workspace>.view{height:100%;min-height:0;width:100%;margin:0;padding:0;display:flex;flex-direction:column}.product-v2 #view-code .kc-shell,.product-v2 #view-docs .docs-layout{height:100%;min-height:0;flex:1}.docs-file-actions{display:flex;gap:10px;padding:0 16px 8px}.docs-file-actions .linklike{padding:2px 0;font-size:12px}\n","product-experience.css":"/* KAI pearl/cobalt branding with the simplified credit-first workspace. */\n:root{color-scheme:light;--bg:#f4f7fd;--bg-raised:#ffffff;--bg-input:#ffffff;--border:#dce5f2;--text:#14284e;--text-dim:#61728d;--violet:#155eef;--emerald:#168469;--sky:#096bdc;--danger:#c93d4c;--radius:14px}\n.product-v2{font-family:Inter,\"Segoe UI\",Arial,sans-serif;background:var(--bg);font-size:14px}\n.product-v2 button,.product-v2 input,.product-v2 select,.product-v2 textarea{font:inherit}\n.product-v2 button{border-radius:9px;border:1px solid var(--border);background:#ffffff;color:var(--text);padding:10px 15px;box-shadow:none}\n.product-v2 button.primary{background:#155eef;border-color:#155eef;color:#ffffff;font-weight:650}\n.product-v2 button:disabled{opacity:.45;cursor:not-allowed}\n.product-v2 button:focus-visible,.product-v2 input:focus-visible,.product-v2 select:focus-visible{outline:2px solid #155eef;outline-offset:3px}\n.product-v2 input,.product-v2 select,.product-v2 textarea{color:var(--text);background:var(--bg-input);border-color:var(--border)}\n.product-v2 #sidebar{width:245px;padding:20px 18px 12px;gap:10px;background:#ffffff;border-right:1px solid #dce5f2;overflow-y:hidden;scrollbar-width:thin;box-shadow:none}.product-v2 #product-sidebar-close{display:none}\n.product-v2 .brand{padding:0 10px 7px;min-height:40px}.product-v2 .brand-name{color:#14284e;font-size:18px;letter-spacing:-.4px}.product-v2 .brand-name span{color:#0874ee}.product-v2 .brand-tagline{font-size:9px;color:#61728d;letter-spacing:1px}.product-v2 .brand-mark{background:url(\"brand-mark.svg\") center/contain no-repeat;box-shadow:none}\n.product-sidebar-credits{border:1px solid #d5e4fc;border-radius:14px;background:#edf4ff;padding:14px 15px}.product-eyebrow{font-size:10px!important;letter-spacing:1.25px;text-transform:uppercase;color:#61728d!important;font-weight:700;margin:0 0 8px!important}.product-sidebar-credits>strong{display:block;font-size:29px;font-weight:650;letter-spacing:-1px}.product-sidebar-credits small{font-size:12px;font-weight:500;letter-spacing:0}.product-sidebar-credits>p:not(.product-eyebrow){font-size:10px;color:#61728d;margin:6px 0 15px;line-height:1.6}.product-sidebar-credits>.primary{width:100%;padding:10px 8px;font-size:12px}.product-sidebar-credits .product-text-button{display:block;border:0;background:none;color:#155eef;font-size:10px;margin:8px auto 0;padding:2px}\n.product-v2 #nav{overflow-y:auto;flex:1 1 auto;min-height:96px;gap:3px}.product-v2 #nav-group-workspace,.product-v2 #nav-group-contribute{display:none}.product-v2 #nav-items-workspace,.product-v2 #nav-items-contribute{grid-template-rows:1fr;opacity:1;visibility:visible}.product-v2 .nav-item{background:none;border:0;border-radius:9px;padding:8px 12px;color:#61728d;font-size:12px;min-height:34px;box-shadow:none}.product-v2 .nav-item.active{background:#edf4ff;color:#155eef}.product-v2 .nav-item:hover{background:#e8f1ff;color:#155eef}.product-v2 .nav-group-label{border:0;background:none;color:#61728d;font-size:12px;padding:11px 12px;text-transform:none;letter-spacing:0}.product-v2 .nav-symbol{width:19px;height:19px;color:inherit}.product-v2 #nav-items-contribute{border-top:1px solid #dce5f2;margin-top:7px;padding-top:8px}.product-v2 #nav-items-contribute .soon{display:none}.product-v2 #status-pane{font-size:10px;border:0;background:none;padding:3px 10px}.product-v2 #status-pane .status-sub{font-size:9px}.product-v2 .rail-icons{display:grid;grid-template-columns:1fr 1fr;gap:4px;order:0;border-top:1px solid #dce5f2;padding-top:8px;flex:none}.product-v2 .rail-icon{width:100%;min-width:0;min-height:34px;padding:6px 3px;border:0;background:none;color:#61728d;font-size:10px;white-space:nowrap}.product-v2 .local-note{font-size:8px;color:#61728d}.product-v2 #btn-feedback{font-size:10px;min-height:22px;padding:4px 10px}\n.product-v2 #main{padding:0;background:var(--bg);min-width:0}.product-v2 .workspace-header{height:74px;min-height:74px;padding:0 34px;display:flex;align-items:center;justify-content:flex-start;gap:14px;border-bottom:1px solid #dce5f2;background:var(--bg);box-shadow:none;margin:0}.product-v2 .workspace-header h1{font-size:15px;font-weight:650;color:var(--text);letter-spacing:0;margin:0}.product-v2 .workspace-eyebrow,.product-v2 .workspace-caption{display:none}.product-v2 #product-sidebar-toggle{background:none;border:0;padding:5px;color:#155eef}.product-v2 #launch-kai{margin-left:auto;min-height:0;width:auto;display:flex;gap:7px;padding:5px 11px 5px 5px;border:1px solid #d5e4fc;background:linear-gradient(120deg,#f4f9ff,#e8f2ff);color:#14284e;border-radius:8px;box-shadow:none}.product-v2 #launch-kai strong{font-size:11px;font-weight:650;white-space:nowrap}.product-v2 #launch-kai .kai-avatar{display:block;width:30px;height:30px;flex:0 0 30px!important}.product-v2 #launch-kai small{display:none}\n.product-v2 #view-chat{padding:0;min-height:0}.product-v2 .chat-shell.kc-shell{grid-template-columns:220px minmax(0,1fr);display:grid;border:0;background:var(--bg);height:100%;border-radius:0}.product-v2 .chat-pane{padding:27px 34px 16px;background:var(--bg);display:flex;flex-direction:column;height:100%;min-height:0}.product-v2 .chat-toolbar{padding:8px 0 0;border:0;background:none;min-height:0}.product-v2 .chat-toolbar>span{display:none}.product-v2 #history-toggle{font-size:10px;padding:4px 7px;background:none;color:#61728d;border:0}.product-v2 .composer-options{background:none;border:0;padding:0;display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px}.product-v2 .composer-options select{background:#f5f8fe;border:1px solid #dce5f2;border-radius:8px;font-size:11px;padding:9px 11px;color:#14284e;max-width:200px}.product-v2 #src-pick{background:#edf4ff;color:#155eef}.product-v2 #model-pick{margin-left:auto}.product-v2 #persona-pick{max-width:110px}.product-v2 #messages{background:none;padding:16px 4px;min-height:120px;flex:1}.product-v2 #chat-empty{background:none;border:0;box-shadow:none;padding:20px 0;min-height:100%;display:flex;align-items:center;justify-content:safe center;flex-direction:column}.product-v2 .welcome-hero{display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center;min-height:0}.product-v2 .welcome-character{display:block;position:static;flex-shrink:0;width:150px;height:190px;order:-1}.product-v2 .welcome-copy{max-width:none}.product-v2 .welcome-copy h2{font-size:34px;font-weight:550;letter-spacing:-1.3px;color:var(--text);line-height:1.2;max-width:none}.product-v2 .welcome-copy h3{display:none}.product-v2 .welcome-copy p{color:#61728d;font-size:12px;max-width:none}.product-v2 .welcome-eyebrow{font-size:10px!important;margin-bottom:10px}.product-emblem{width:62px;height:62px;flex:none;border:1px solid #d5e4fc;border-radius:19px;background:#edf4ff;color:#155eef;display:grid;place-items:center;position:relative}.product-emblem img{width:38px;height:38px}.product-v2 .welcome-prompts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:11px;max-width:682px;width:100%;margin-top:30px}.product-v2 .welcome-prompts button{background:#ffffff;border:1px solid #dce5f2;box-shadow:none;border-radius:12px;padding:17px;text-align:left;min-height:95px;color:#14284e}.product-v2 .welcome-prompts strong{font-size:12px;color:#14284e}.product-v2 .welcome-prompts small{font-size:10px;color:#61728d}.product-v2 .welcome-prompts .prompt-symbol{color:#155eef;background:none;font-size:17px}.product-v2 .welcome-prompts b,.product-v2 .welcome-footnote{display:none}.product-v2 #composer{background:#ffffff;border:1px solid #d5e4fc;box-shadow:none;border-radius:16px;padding:15px 17px;margin:8px 0 0}.product-v2 .composer-entry{display:flex;flex-direction:column;gap:12px;background:none;border:0;padding:0}.product-v2 #input{background:none;border:0;box-shadow:none;padding:0;min-height:44px;max-height:180px;color:var(--text);font-size:13px;width:100%}.product-v2 .composer-buttons{display:flex;width:100%;justify-content:flex-start;gap:8px}.product-v2 #btn-send{margin-left:auto;background:#155eef;color:#ffffff;border:0}.product-v2 .composer-buttons button{padding:7px 11px}.product-v2 .msg{box-shadow:none}.product-v2 .msg.user{background:#edf4ff;border-color:#d5e4fc;color:#14284e}.product-v2 .msg.assistant{background:none;border:0;color:#14284e}\n.product-v2 #network-chat-account{border:0;background:none;box-shadow:none;padding:7px 0;font-size:10px}.product-v2 #network-chat-account>div:first-child,.product-v2 .network-chat-funding,.product-v2 #network-chat-reservation{display:none}.product-v2 #network-chat-help{font-size:10px;color:#61728d}.product-v2 #network-chat-status,.product-v2 #network-credit-sources{font-size:10px;color:#61728d}.product-v2 #network-recover{font-size:10px;padding:5px 8px}\n.product-v2 #chats-pane{display:flex;position:static;transform:none;width:auto;min-width:0;min-height:0;max-height:none;height:100%;flex:none;padding:20px 14px;margin:0;gap:8px;flex-direction:column;overflow:hidden;border:0;border-right:1px solid #dce5f2;border-radius:0;background:#fafcff;box-shadow:none}\n.product-v2 #chats-pane .kc-rail-label{display:block;font-size:10px;letter-spacing:1px;color:#61728d;margin:8px 0 0;padding:4px 2px}\n.product-v2 #btn-new-chat{font-size:12px;min-height:38px;background:#ffffff;border:1px solid #d5e4fc;color:#155eef;padding:9px 12px;text-align:left;flex:none}\n.product-v2 #chat-search{width:100%;font-size:11px;padding:8px 10px;min-height:34px;background:#f0f4fa;border:1px solid #dce5f2;flex:none}\n.product-v2 #chat-list{flex:1;overflow-y:auto;min-height:0;scrollbar-width:thin}\n.product-v2 .chat-row{background:none;border:0;color:#61728d;padding:9px 8px;font-size:11px;min-height:34px;flex-shrink:0}\n.product-v2 .chat-row button{padding:0 3px;font-size:11px;min-width:0;background:none;border:0}\n.product-v2 .chat-row.active{background:#edf4ff;color:#155eef}.product-v2 .chat-list-empty{font-size:11px;color:#61728d;padding:8px 0}\n@media(max-width:900px){.product-v2 .chat-shell.kc-shell{grid-template-columns:minmax(0,1fr)}.product-v2 .chat-toolbar{display:flex;padding:0 0 10px}.product-v2 #history-toggle{display:block;border:1px solid #d5e4fc;background:#ffffff;padding:7px 10px;font-size:11px;color:#155eef}.product-v2 #chats-pane{display:none;position:absolute;left:0;top:0;bottom:0;width:228px;max-width:85%;height:auto;z-index:6;padding-top:68px;box-shadow:10px 0 30px #16315c1c}.product-v2 #view-chat.history-open #chats-pane{display:flex}.product-v2 #view-chat.history-open #history-toggle{position:relative;z-index:7}}\n.product-page,.product-earn{padding:29px 34px 26px;overflow:auto}.product-page{height:100%;min-height:0}.product-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:26px}.product-head h1{font-size:31px;font-weight:600;letter-spacing:-1px;line-height:1.15;margin:0 0 9px;color:var(--text)}.product-head p,.product-panel p{font-size:12px;color:var(--text-dim);line-height:1.7;margin:0 0 14px}.product-head button{font-size:11px;white-space:nowrap}.product-two{display:grid;grid-template-columns:1.3fr 1fr;gap:18px;margin-bottom:22px}.product-panel{border:1px solid var(--border);background:var(--bg-raised);border-radius:18px;padding:24px;margin-bottom:18px;min-width:0}.product-two>.product-panel{margin-bottom:0}.product-panel h2{font-size:16px;font-weight:650;margin:0 0 15px;letter-spacing:-.2px;color:var(--text)}.product-row{display:flex;align-items:center;justify-content:space-between;gap:15px}.product-row h2{margin:0}.product-balance{font-size:48px;font-weight:550;letter-spacing:-2px;margin:13px 0 22px;line-height:1.2}.product-balance small{font-size:14px;letter-spacing:0;color:#61728d}.product-credit-track{height:5px;border-radius:8px;background:#155eef;opacity:.65;margin:20px 0 15px}.product-credit-track i{display:none}.product-detail{display:flex;justify-content:space-between;gap:18px;font-size:11px;border-bottom:1px solid #dce5f2;padding:15px 0;color:#14284e}.product-detail strong{color:#14284e;font-size:11px;text-align:right}.product-detail:last-child{border-bottom:0}.product-fine{font-size:10px!important;color:#61728d!important}.product-footer{text-align:center;font-size:10px;color:#61728d;margin:17px 0}.product-footer button{background:none;border:0;text-decoration:underline;font-size:10px;color:#155eef;padding:0}.product-actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:20px}.product-actions button{font-size:11px}.product-divider{height:1px;background:var(--border);margin:22px 0}.product-history{padding:0;overflow:hidden}.product-history>.product-row{padding:20px 23px}.product-history button{padding:5px 8px;background:none;border:0;font-size:10px;color:#61728d}.product-history button.active{background:#e8f1ff;color:#14284e}.product-table-wrap{overflow:auto}.product-history table{border-collapse:collapse;width:100%;font-size:11px;text-align:left}.product-history th{background:#f5f8fe;color:#61728d;font-size:9px;letter-spacing:1px;text-transform:uppercase;font-weight:550;padding:12px 23px}.product-history td{padding:17px 23px;border-top:1px solid #dce5f2;color:#14284e}.product-history td:first-child{color:#14284e}.product-history td:last-child{text-align:right}\n.product-steps{display:flex;gap:35px;list-style:decimal;padding-left:20px;margin:0 0 28px;font-size:11px;color:#61728d}.product-steps .active{color:#155eef}.product-packs{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:24px 0}.product-packs button{border:1px solid #dce5f2;background:#f5f8fe;padding:17px 5px;color:#14284e}.product-packs button.selected{background:#e8f1ff;border-color:#155eef}.product-packs strong{display:block;font-size:24px;font-weight:600}.product-packs small{display:block;font-size:10px;margin-top:7px}.product-panel label{font-size:11px;color:#61728d}.product-input{display:flex;align-items:center;gap:10px;border:1px solid #dce5f2;border-radius:9px;padding:12px 13px;background:#f5f8fe;color:#61728d;margin:8px 0 20px;font-size:12px}.product-input input{border:0!important;background:none!important;outline:none;width:100%;padding:0!important}.product-order{background:#ffffff;border-color:#d5e4fc}.product-order>.primary{width:100%;margin:12px 0}.product-order .product-balance{font-size:32px}.product-order #product-quote-state{margin-top:16px}.product-provider{background:#f0faf6;border-color:#bedfce}.product-provider-state{text-align:center;padding:45px 0 30px}.product-live-dot{width:8px;height:8px;display:inline-block;background:#61728d;border-radius:50%;margin-bottom:19px}.product-provider-state h2{font-size:36px;letter-spacing:1px;font-weight:650;color:#996218;margin:0 0 10px}.product-provider-state h2[data-state=\"online\"]{font-size:46px;color:#168469}.product-v2 #product-provider-toggle{border:1px solid #9f2635;border-radius:10px;background:#b72f40;color:#fff;font-size:14px;font-weight:650;min-height:44px;min-width:150px;padding:11px 20px;box-shadow:0 3px 0 #85212e;cursor:pointer;transition:box-shadow .15s,transform .15s}.product-v2 #product-provider-toggle[aria-checked=\"true\"]{background:#168052;border-color:#10633f;box-shadow:0 3px 0 #0b5132}.product-v2 #product-provider-toggle:hover:not(:disabled){filter:brightness(1.08)}.product-v2 #product-provider-toggle:active:not(:disabled){transform:translateY(2px);box-shadow:0 1px 0 #85212e}.p