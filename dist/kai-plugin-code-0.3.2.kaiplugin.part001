e-hero{grid-template-columns:1fr}.welcome-character{width:95px;height:135px}.welcome-copy{padding-top:140px}.welcome-prompts button{min-height:69px}}\n\n/* Developer Tools: local form rules keep shared API styles from stretching\n   selects and checkboxes into full-width rows. Size against the workspace,\n   including when the desktop sidebar leaves less room than the viewport. */\n#view-devtools { container-type: inline-size; }\n#view-devtools .api-card { gap: 12px; }\n#view-devtools .subtabs { flex-wrap: wrap; gap: 4px; margin: 4px 0 6px; }\n#view-devtools .subtab { padding: 9px 14px; font-size: 13px; }\n#view-devtools .devtab, #dev-builder { display: flex; flex-direction: column; gap: 16px; min-width: 0; }\n#view-devtools .devtab > .hint { max-width: 78ch; }\n#view-devtools .form-row { margin: 0; gap: 10px; min-width: 0; }\n#view-devtools .dev-fields { display: grid; gap: 12px; align-items: end; }\n#view-devtools .dev-team-fields { grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr); }\n#view-devtools .dev-limits { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n#view-devtools .dev-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 12px; font-weight: 600; color: var(--text-dim); }\n#view-devtools .dev-field > input, #view-devtools .dev-field > select,\n#view-devtools #pg-input {\n  flex: none; width: 100%; min-width: 0; min-height: 38px; padding: 8px 10px;\n  border: 1px solid var(--border); border-radius: 9px;\n  background: var(--bg-raised); color: var(--text); font: inherit; font-size: 13px; font-weight: 400;\n}\n#view-devtools .dev-field > select { padding-right: 28px; text-overflow: ellipsis; }\n#view-devtools input:focus-visible, #view-devtools select:focus-visible,\n#view-devtools textarea:focus-visible, #view-devtools summary:focus-visible { outline: 2px solid var(--violet); outline-offset: 2px; }\n#view-devtools button.small { min-height: 36px; padding: 8px 12px; font-size: 12px; }\n#view-devtools .check { white-space: normal; min-width: 0; gap: 8px; line-height: 1.5; }\n#view-devtools input[type=\"checkbox\"] { flex: 0 0 16px; width: 16px; min-width: 16px; height: 16px; padding: 0; margin: 0; }\n#ag-list { display: grid; gap: 12px; }\n#view-devtools .agent-card { display: flex; flex-direction: column; gap: 12px; margin: 0; padding: 16px; min-width: 0; }\n#view-devtools .dev-agent-head { display: grid; grid-template-columns: minmax(0, 1fr) auto auto; align-items: end; }\n#view-devtools .dev-agent-head > .check, #view-devtools .ag-remove { min-height: 38px; }\n#view-devtools .ag-remove { padding: 8px 0 8px 8px; font-size: 12px; }\n#view-devtools textarea { display: block; min-width: 0; max-width: 100%; margin: 0; font: 12px/1.65 ui-monospace, \"Cascadia Mono\", Consolas, monospace; }\n#view-devtools .ag-prompt { min-height: 72px; font: 13px/1.6 system-ui, sans-serif; color: var(--text); }\n#view-devtools .dev-tool-picker { width: 100%; min-width: 0; border-top: 1px solid var(--border); padding-top: 10px; }\n#view-devtools .dev-tool-picker > summary { cursor: pointer; font-size: 12px; font-weight: 600; color: var(--text-dim); padding: 3px 0; }\n#view-devtools .dev-tool-choices { margin-top: 12px; }\n#view-devtools .tool-group { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 6px 16px; align-items: start; }\n#view-devtools .tool-group-head { grid-column: 1 / -1; min-width: 0; flex-wrap: wrap; }\n#view-devtools .tool-group-name, #view-devtools .check > span { overflow-wrap: anywhere; }\n#view-devtools .tool-group .check { align-items: start; padding: 3px 0; }\n#view-devtools .tool-group input { margin-top: 2px; }\n#view-devtools .dev-editor { display: flex; flex-direction: column; gap: 10px; padding-top: 16px; border-top: 1px solid var(--border); min-width: 0; }\n#view-devtools .dev-section-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; font-size: 13px; font-weight: 600; }\n#view-devtools .dev-saved-team { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 10px; padding-top: 16px; border-top: 1px solid var(--border); }\n#view-devtools .dev-stages { border: 0; padding: 0; min-width: 0; }\n#view-devtools .dev-stages legend { font-size: 12px; font-weight: 600; color: var(--text-dim); margin-bottom: 8px; }\n#view-devtools #devb-stages { gap: 10px 20px; }\n#view-devtools #pg-input { flex: 1 1 180px; width: auto; }\n#view-devtools #pg-convo { margin: 0; }\n#view-devtools #pg-convo:empty { display: none; }\n#view-devtools .snippet { max-width: 100%; white-space: pre-wrap; overflow-wrap: anywhere; }\n#view-devtools .pg-msg, #view-devtools .pg-tool, #view-devtools .meta { overflow-wrap: anywhere; }\n@container (max-width: 580px) {\n  #view-devtools .dev-team-fields { grid-template-columns: minmax(0, 1fr); }\n  #view-devtools .dev-limits { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  #view-devtools .dev-limits > :last-child { grid-column: 1 / -1; }\n}\n@container (max-width: 380px) {\n  #view-devtools .subtabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }\n  #view-devtools .subtab { padding: 8px; }\n  #view-devtools .dev-agent-head { grid-template-columns: minmax(0, 1fr) auto; }\n  #view-devtools .dev-agent-head > .dev-field { grid-column: 1 / -1; }\n  #view-devtools .dev-limits, #view-devtools .dev-saved-team { grid-template-columns: minmax(0, 1fr); }\n  #view-devtools .agent-card { padding: 12px; }\n}\n\n/* KAI companion workspaces */\n.companion-hub{max-width:1160px;margin:0 auto;padding:30px 32px 64px;box-sizing:border-box;color:var(--text,#eee)}\n.companion-hub *{box-sizing:border-box}.companion-hub [hidden]{display:none!important}.hub-header{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:14px}.hub-eyebrow{font-size:10px;font-weight:700;letter-spacing:.16em;color:var(--violet);margin-bottom:9px}.hub-header h1{font-size:30px;letter-spacing:-.035em;line-height:1.15;margin:0 0 10px}.hub-header p,.hub-card p,.hub-template p{color:var(--text-dim);line-height:1.6;margin:7px 0 14px;font-size:13px}.hub-badge{display:inline-flex;align-items:center;border:1px solid var(--border,#333);border-radius:20px;padding:4px 9px;font-size:10px;line-height:1.4;white-space:nowrap;color:var(--text-dim)}.hub-tabs{display:flex;gap:4px;border-bottom:1px solid var(--border,#333);padding-bottom:8px;margin-bottom:22px;overflow:auto}.companion-hub button{font-size:12px;line-height:1.3;min-height:34px;border-radius:8px;padding:8px 12px;white-space:normal}.hub-tabs button{border:0;background:transparent;color:var(--text-dim);padding:10px 14px;white-space:nowrap}.hub-tabs button.active{background:var(--bg-raised);color:var(--text,#eee);box-shadow:inset 0 -2px var(--violet)}.hub-notice:empty{display:none}.hub-notice{margin:0 0 16px;padding:11px 13px;background:var(--bg-raised);border-radius:8px;font-size:13px;overflow-wrap:anywhere}.hub-toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin:0 0 18px}.hub-toolbar p{flex:1;color:var(--text-dim);font-size:13px;min-width:180px;margin:0}.hub-toolbar h2{font-size:18px;margin:0}.hub-search{flex:1;min-width:180px}.hub-search input{width:100%}.hub-metrics{display:flex;gap:24px;align-items:center;padding:18px 22px;border:1px solid var(--border,#333);border-radius:12px;margin-bottom:12px;flex-wrap:wrap}.hub-metrics>div{display:flex;align-items:baseline;gap:8px}.hub-metrics b{font-size:25px;letter-spacing:-.03em}.hub-metrics span{font-size:12px;color:var(--text-dim)}.hub-metrics .hub-check{margin:0 0 0 auto}.hub-help{font-size:12px;color:var(--text-dim);line-height:1.6;margin:10px 0 18px}.hub-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:14px}.hub-card,.hub-panel{padding:20px;background:var(--bg-raised);border:1px solid var(--border,#333);border-radius:12px;min-width:0}.hub-card h3{font-size:16px;line-height:1.4;margin:12px 0 8px;overflow-wrap:anywhere}.hub-card small{font-size:11px;color:var(--text-dim);overflow-wrap:anywhere}.hub-card-top{display:flex;align-items:center;justify-content:space-between;gap:8px}.hub-actions{display:flex;gap:7px;flex-wrap:wrap;margin-top:16px}.hub-actions button{min-height:30px;padding:6px 10px;font-size:11px}.hub-tags{display:flex;gap:5px;flex-wrap:wrap}.hub-tags span{padding:2px 7px;font-size:10px;border-radius:5px;background:var(--bg,#15151a);color:var(--text-dim)}.hub-note-excerpt{white-space:pre-wrap;overflow-wrap:anywhere}.hub-tree-root{display:flex;align-items:center;gap:12px;padding:14px 0 24px}.hub-tree-root b,.hub-tree-root small{display:block}.hub-tree-root small{color:var(--text-dim);font-size:12px;margin-top:4px}.hub-orb{width:36px;height:36px;border-radius:50%;background:radial-gradient(circle at 30% 30%,#ddd0ff,#8c60b8 55%,#4d3968);box-shadow:0 0 30px #a58ae025}.hub-tree-branch{margin:0 0 16px 16px;padding-left:20px;border-left:1px solid var(--border,#333)}.hub-tree-branch>summary{cursor:pointer;font-size:14px;font-weight:600;padding:8px 0 14px}.hub-tree-branch>summary span{margin-left:10px;color:var(--text-dim);font-size:11px}.hub-empty{padding:38px 24px;border:1px dashed var(--border,#444);border-radius:12px;text-align:center;grid-column:1/-1}.hub-empty strong{font-size:17px}.hub-empty p{max-width:490px;margin:10px auto 0;font-size:13px;color:var(--text-dim);line-height:1.7}.hub-goal-board{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.hub-goal-board>section>h3{font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:var(--text-dim)}.hub-goal-board .hub-card{margin-bottom:12px}.hub-history>div{display:flex;gap:16px;align-items:center;padding:13px 0;border-bottom:1px solid var(--border,#333);font-size:12px}.hub-history strong{flex:1}.hub-history time{color:var(--text-dim)}.hub-section-title{font-size:16px;margin:30px 0 14px}.hub-template{text-align:left!important;background:transparent!important;border:1px solid var(--border,#333)!important;padding:18px!important;min-width:0}.hub-template:hover{border-color:var(--violet)!important}.hub-template strong{display:flex;justify-content:space-between;font-size:14px}.hub-template p{margin-bottom:0}.hub-mini-flow{display:flex;flex-wrap:wrap;gap:6px;margin-top:15px}.hub-mini-flow span{font-size:10px;border-left:2px solid var(--violet);padding:3px 6px;background:var(--bg,#15151a);border-radius:3px}.hub-run-list{display:grid;gap:12px}.hub-run>summary{display:flex;align-items:center;justify-content:space-between;gap:16px;cursor:pointer}.hub-run summary small{display:block;margin-top:5px}.hub-run-body{margin-top:18px}.hub-run-body>details{padding:10px 0;border-top:1px solid var(--border,#333);font-size:12px}.hub-run pre,.hub-result{white-space:pre-wrap;overflow-wrap:anywhere;max-height:420px;overflow:auto;font-size:12px;padding:12px;background:var(--bg,#15151a);border-radius:8px}.hub-badge.waiting{color:#e4b765}.hub-badge.completed{color:#80bea3}.hub-badge.failed,.hub-badge.interrupted{color:#eb9292}.hub-pending{border-left:2px solid #e4b765;padding-left:14px;margin-top:15px;font-size:12px}.hub-catalog{display:flex;gap:10px;flex-wrap:wrap}.hub-url{overflow-wrap:anywhere}.hub-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-bottom:16px}.hub-field{display:flex;flex-direction:column;gap:7px;min-width:0;font-size:12px}.hub-field>span{color:var(--text-dim);font-weight:500}.hub-full{grid-column:1/-1}.companion-hub input:not([type=checkbox]),.companion-hub select,.companion-hub textarea{width:100%;max-width:100%;min-width:0;padding:10px 11px;font-size:13px;line-height:1.5;border:1px solid var(--border,#383840);border-radius:7px;color:var(--text,#eee);background:var(--bg,#15151a)}.companion-hub textarea{resize:vertical;font-family:inherit}.companion-hub input[type=checkbox]{width:15px!important;min-width:15px!important;height:15px;margin:0;flex:none}.hub-check{display:flex;align-items:center;gap:9px;font-size:12px;line-heigh